import { animate } from "../../../../benchmarks/popular/ports/motion/framer-motion/animation/animate/sequence-entry";

JsValue[] sequence = [];
sequence.push(["#a", record{ opacity: 1.0, scale: [0.5, 1.2, 1.0] }, record{ duration: 0.45 }]);
sequence.push(["#b", record{ opacity: 1.0, y: [0.0 - 40.0, 0.0], scale: 1.0 }, record{ duration: 0.4 }]);
