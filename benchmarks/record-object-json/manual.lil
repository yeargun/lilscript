int measure(int seed) {
    Record<int> values = record{"10": seed + 10, "2": seed + 2, alpha: seed + 1, beta: seed + 3, gamma: seed + 5};
    Record<int> patch = record{beta: seed + 7, delta: seed + 9};
    values.beta = patch.beta ?? 0;
    values.delta = patch.delta ?? 0;
    string[] keys = ["2", "10", "alpha", "beta", "gamma", "delta"];
    int[] entries = [values["2"] ?? 0, values["10"] ?? 0, values.alpha ?? 0, values.beta ?? 0, values.gamma ?? 0, values.delta ?? 0];
    string json = "{\"2\":" + entries[0].toString() + ",\"10\":" + entries[1].toString() + ",\"alpha\":" + entries[2].toString() + ",\"beta\":" + entries[3].toString() + ",\"gamma\":" + entries[4].toString() + ",\"delta\":" + entries[5].toString() + "}";
    int score = keys.length + entries.length + json.length + entries[0] + entries[3];
    if (values.delta != null) {
        score += 1;
    }
    return score;
}

int total = 0;
for (int i = 0; i < 3000; i++) {
    total += measure(i % 97);
}
print(total);
