export void bootLanguages() {
  registerPopularLanguages();
  registerRemainingLanguages();
}

export JsValue bootMonaco() {
  bootLanguages();
  return installMonaco();
}

export Token[] tokenize(string languageId, string text) {
  bootLanguages();
  Lexer? lex = getLexer(languageId);
  if (lex == null) {
    Token[] empty = [];
    return empty;
  }
  return tokenizeText(lex, text);
}

export string[] tokenizePacked(string languageId, string text) {
  bootLanguages();
  Lexer? lex = getLexer(languageId);
  if (lex == null) {
    string[] empty = [];
    return empty;
  }
  return tokenTypes(tokenizeText(lex, text));
}

