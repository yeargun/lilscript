export pure int imin(int a, int b) {
  if (a < b) {
    return a;
  }
  return b;
}

export pure int imax(int a, int b) {
  if (a > b) {
    return a;
  }
  return b;
}

export string sliceOf(string s, int start, int end) {
  int from = start;
  int to = end;
  if (from < 0) {
    from = 0;
  }
  if (to > s.length) {
    to = s.length;
  }
  if (from >= to) {
    return emptyBuf();
  }
  return stringSlice(s, from, to);
}

export string sliceFrom(string s, int start) {
  return sliceOf(s, start, s.length);
}

export string replaceEol(string text, string eol) {
  return stringReplace(text, newRegexp("\\r\\n|\\r|\\n", "g"), eol);
}

export string repeatChar(string ch, int n) {
  string out = emptyBuf();
  int i = 0;
  while (i < n) {
    out = out + ch;
    i = i + 1;
  }
  return out;
}
