export class QuickAccessProvider {
  string prefix;
  string placeholder;

  init(string prefix, string placeholder) {
    this.prefix = prefix;
    this.placeholder = placeholder;
  }

  bool accepts(string value) {
    if (this.prefix.length == 0) {
      return true;
    }
    return value.startsWith(this.prefix);
  }

  string stripPrefix(string value) {
    if (!this.accepts(value)) {
      return value;
    }
    string out = "";
    int i = this.prefix.length;
    while (i < value.length) {
      out = out + value.charAt(i);
      i = i + 1;
    }
    return out;
  }
}

export class QuickAccessController {
  QuickAccessProvider[] providers;
  string defaultPrefix;

  init() {
    this.providers = [];
    this.defaultPrefix = "";
  }

  void register(QuickAccessProvider provider) {
    this.providers.push(provider);
  }

  QuickAccessProvider? providerFor(string value) {
    int i = 0;
    while (i < this.providers.length) {
      if (this.providers[i].accepts(value) && this.providers[i].prefix.length > 0) {
        return this.providers[i];
      }
      i = i + 1;
    }
    i = 0;
    while (i < this.providers.length) {
      if (this.providers[i].prefix.length == 0) {
        return this.providers[i];
      }
      i = i + 1;
    }
    return null;
  }
}

export QuickAccessController createQuickAccessController() {
  return new QuickAccessController();
}

export QuickAccessProvider createQuickAccessProvider(string prefix, string placeholder) {
  return new QuickAccessProvider(prefix, placeholder);
}
