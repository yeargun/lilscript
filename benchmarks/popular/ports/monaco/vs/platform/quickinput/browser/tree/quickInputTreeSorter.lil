export int compareQuickInput(string a, string b) {
  if (a < b) {
    return -1;
  }
  if (a > b) {
    return 1;
  }
  return 0;
}

export string[] sortQuickInput(string[] items) {
  string[] out = [];
  int i = 0;
  while (i < items.length) {
    out.push(items[i]);
    i = i + 1;
  }
  int a = 0;
  while (a < out.length) {
    int b = a + 1;
    while (b < out.length) {
      if (compareQuickInput(out[b], out[a]) < 0) {
        string tmp = out[a];
        out[a] = out[b];
        out[b] = tmp;
      }
      b = b + 1;
    }
    a = a + 1;
  }
  return out;
}
