export class ActionWidget {
  bool visible;
  string[] actions;
  int focusIndex;

  init() {
    this.visible = false;
    this.actions = [];
    this.focusIndex = -1;
  }

  void show(string[] actions) {
    this.actions = actions;
    this.visible = true;
    if (actions.length > 0) {
      this.focusIndex = 0;
    }
  }

  void hide() {
    this.visible = false;
    this.focusIndex = -1;
  }

  string? accept() {
    if (this.focusIndex < 0 || this.focusIndex >= this.actions.length) {
      return null;
    }
    string chosen = this.actions[this.focusIndex];
    this.hide();
    return chosen;
  }
}

export ActionWidget createActionWidget() {
  return new ActionWidget();
}
