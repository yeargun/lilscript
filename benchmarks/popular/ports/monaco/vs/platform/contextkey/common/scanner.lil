export int TokLParen = 0;
export int TokRParen = 1;
export int TokNeg = 2;
export int TokEq = 3;
export int TokNotEq = 4;
export int TokLt = 5;
export int TokLtEq = 6;
export int TokGt = 7;
export int TokGtEq = 8;
export int TokRegexOp = 9;
export int TokRegexStr = 10;
export int TokTrue = 11;
export int TokFalse = 12;
export int TokIn = 13;
export int TokNot = 14;
export int TokAnd = 15;
export int TokOr = 16;
export int TokStr = 17;
export int TokQuotedStr = 18;
export int TokError = 19;
export int TokEOF = 20;

string sliceStr(string s, int start, int end) {
  int from = start;
  int to = end;
  if (from < 0) {
    from = 0;
  }
  if (to > s.length) {
    to = s.length;
  }
  string out = "";
  int i = from;
  while (i < to) {
    out = out + s.charAt(i);
    i = i + 1;
  }
  return out;
}

bool isScanStringChar(int code) {
  if (code >= 48 && code <= 57) {
    return true;
  }
  if (code >= 65 && code <= 90) {
    return true;
  }
  if (code >= 97 && code <= 122) {
    return true;
  }
  if (code == 95 || code == 60 || code == 62 || code == 45 || code == 46) {
    return true;
  }
  if (code == 47 || code == 92 || code == 58 || code == 42 || code == 63 || code == 43) {
    return true;
  }
  if (code == 91 || code == 93 || code == 94 || code == 44 || code == 35 || code == 64) {
    return true;
  }
  if (code == 59 || code == 34 || code == 37 || code == 36) {
    return true;
  }
  if (code > 127) {
    return true;
  }
  return false;
}

bool isFlag(int code) {
  return code == 105 || code == 103 || code == 115 || code == 109 || code == 121 || code == 117;
}

export class ScanToken {
  int type;
  int offset;
  string lexeme;

  init(int type, int offset, string lexeme) {
    this.type = type;
    this.offset = offset;
    this.lexeme = lexeme;
  }
}

export string tokenLexeme(ScanToken token) {
  if (token.type == TokLParen) {
    return "(";
  }
  if (token.type == TokRParen) {
    return ")";
  }
  if (token.type == TokNeg) {
    return "!";
  }
  if (token.type == TokEq) {
    return "==";
  }
  if (token.type == TokNotEq) {
    return "!=";
  }
  if (token.type == TokLt) {
    return "<";
  }
  if (token.type == TokLtEq) {
    return "<=";
  }
  if (token.type == TokGt) {
    return ">";
  }
  if (token.type == TokGtEq) {
    return ">=";
  }
  if (token.type == TokRegexOp) {
    return "=~";
  }
  if (token.type == TokTrue) {
    return "true";
  }
  if (token.type == TokFalse) {
    return "false";
  }
  if (token.type == TokIn) {
    return "in";
  }
  if (token.type == TokNot) {
    return "not";
  }
  if (token.type == TokAnd) {
    return "&&";
  }
  if (token.type == TokOr) {
    return "||";
  }
  if (token.type == TokEOF) {
    return "EOF";
  }
  return token.lexeme;
}

export class Scanner {
  string input;
  int startPos;
  int current;
  ScanToken[] tokens;
  ScanToken[] errors;

  init() {
    this.input = "";
    this.startPos = 0;
    this.current = 0;
    this.tokens = [];
    this.errors = [];
  }

  Scanner reset(string value) {
    this.input = value;
    this.startPos = 0;
    this.current = 0;
    ScanToken[] next = [];
    ScanToken[] errs = [];
    this.tokens = next;
    this.errors = errs;
    return this;
  }

  bool atEnd() {
    return this.current >= this.input.length;
  }

  int advanceCode() {
    int code = this.input.charCodeAt(this.current);
    this.current = this.current + 1;
    return code;
  }

  int peekCode() {
    if (this.atEnd()) {
      return 0;
    }
    return this.input.charCodeAt(this.current);
  }

  bool eat(int expected) {
    if (this.atEnd()) {
      return false;
    }
    if (this.input.charCodeAt(this.current) != expected) {
      return false;
    }
    this.current = this.current + 1;
    return true;
  }

  void addTok(int type, string lexeme) {
    this.tokens.push(new ScanToken(type, this.startPos, lexeme));
  }

  void scanQuoted() {
    while (this.peekCode() != 39 && !this.atEnd()) {
      this.advanceCode();
    }
    if (this.atEnd()) {
      ScanToken err = new ScanToken(TokError, this.startPos, sliceStr(this.input, this.startPos, this.current));
      this.errors.push(err);
      this.tokens.push(err);
      return;
    }
    this.advanceCode();
    this.tokens.push(new ScanToken(TokQuotedStr, this.startPos + 1, sliceStr(this.input, this.startPos + 1, this.current - 1)));
  }

  void scanRegex() {
    int p = this.current;
    bool inEscape = false;
    bool inClass = false;
    bool closed = false;
    while (p < this.input.length) {
      int ch = this.input.charCodeAt(p);
      if (inEscape) {
        inEscape = false;
      } else {
        if (ch == 47 && !inClass) {
          p = p + 1;
          closed = true;
          break;
        }
        if (ch == 91) {
          inClass = true;
        } else {
          if (ch == 92) {
            inEscape = true;
          } else {
            if (ch == 93) {
              inClass = false;
            }
          }
        }
      }
      p = p + 1;
    }
    if (!closed) {
      this.current = p;
      ScanToken err = new ScanToken(TokError, this.startPos, sliceStr(this.input, this.startPos, this.current));
      this.errors.push(err);
      this.tokens.push(err);
      return;
    }
    while (p < this.input.length && isFlag(this.input.charCodeAt(p))) {
      p = p + 1;
    }
    this.current = p;
    this.addTok(TokRegexStr, sliceStr(this.input, this.startPos, this.current));
  }

  void scanString() {
    int pos = this.startPos;
    while (pos < this.input.length && isScanStringChar(this.input.charCodeAt(pos))) {
      pos = pos + 1;
    }
    this.current = pos;
    string lexeme = sliceStr(this.input, this.startPos, this.current);
    if (lexeme == "not") {
      this.addTok(TokNot, lexeme);
    } else {
      if (lexeme == "in") {
        this.addTok(TokIn, lexeme);
      } else {
        if (lexeme == "false") {
          this.addTok(TokFalse, lexeme);
        } else {
          if (lexeme == "true") {
            this.addTok(TokTrue, lexeme);
          } else {
            this.addTok(TokStr, lexeme);
          }
        }
      }
    }
  }

  ScanToken[] scan() {
    while (!this.atEnd()) {
      this.startPos = this.current;
      int ch = this.advanceCode();
      if (ch == 40) {
        this.addTok(TokLParen, "(");
      } else {
        if (ch == 41) {
          this.addTok(TokRParen, ")");
        } else {
          if (ch == 33) {
            if (this.eat(61)) {
              this.eat(61);
              this.addTok(TokNotEq, "!=");
            } else {
              this.addTok(TokNeg, "!");
            }
          } else {
            if (ch == 39) {
              this.scanQuoted();
            } else {
              if (ch == 47) {
                this.scanRegex();
              } else {
                if (ch == 61) {
                  if (this.eat(61)) {
                    this.eat(61);
                    this.addTok(TokEq, "==");
                  } else {
                    if (this.eat(126)) {
                      this.addTok(TokRegexOp, "=~");
                    } else {
                      this.addTok(TokError, "=");
                    }
                  }
                } else {
                  if (ch == 60) {
                    if (this.eat(61)) {
                      this.addTok(TokLtEq, "<=");
                    } else {
                      this.addTok(TokLt, "<");
                    }
                  } else {
                    if (ch == 62) {
                      if (this.eat(61)) {
                        this.addTok(TokGtEq, ">=");
                      } else {
                        this.addTok(TokGt, ">");
                      }
                    } else {
                      if (ch == 38) {
                        if (this.eat(38)) {
                          this.addTok(TokAnd, "&&");
                        } else {
                          this.addTok(TokError, "&");
                        }
                      } else {
                        if (ch == 124) {
                          if (this.eat(124)) {
                            this.addTok(TokOr, "||");
                          } else {
                            this.addTok(TokError, "|");
                          }
                        } else {
                          if (ch == 32 || ch == 13 || ch == 9 || ch == 10 || ch == 160) {
                            ch = ch;
                          } else {
                            this.scanString();
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
    this.startPos = this.current;
    this.addTok(TokEOF, "EOF");
    return this.tokens;
  }
}

export Scanner createScanner() {
  return new Scanner();
}

export ScanToken[] scanContextKeys(string input) {
  Scanner scanner = new Scanner();
  scanner.reset(input);
  return scanner.scan();
}
