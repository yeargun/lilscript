int undoRedoGroupSeq = 1;
int undoRedoSourceSeq = 1;

export class UndoRedoGroup {
  int id;
  int order;

  init(int id) {
    this.id = id;
    this.order = 1;
  }

  int nextOrder() {
    if (this.id == 0) {
      return 0;
    }
    int current = this.order;
    this.order = this.order + 1;
    return current;
  }
}

export class UndoRedoSource {
  int id;
  int order;

  init(int id) {
    this.id = id;
    this.order = 1;
  }

  int nextOrder() {
    if (this.id == 0) {
      return 0;
    }
    int current = this.order;
    this.order = this.order + 1;
    return current;
  }
}

export class ResourceEditStackSnapshot {
  string resource;
  int[] elements;

  init(string resource, int[] elements) {
    this.resource = resource;
    this.elements = elements;
  }
}

export UndoRedoGroup createUndoRedoGroup() {
  int id = undoRedoGroupSeq;
  undoRedoGroupSeq = undoRedoGroupSeq + 1;
  return new UndoRedoGroup(id);
}

export UndoRedoSource createUndoRedoSource() {
  int id = undoRedoSourceSeq;
  undoRedoSourceSeq = undoRedoSourceSeq + 1;
  return new UndoRedoSource(id);
}

export UndoRedoGroup noneUndoRedoGroup() {
  return new UndoRedoGroup(0);
}

export string IUndoRedoServiceId = "undoRedoService";
