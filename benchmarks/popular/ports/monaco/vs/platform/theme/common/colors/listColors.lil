export class ListColorsRegistry {
  string[] ids;

  init() {
    this.ids = [];
  }

  string register(string id) {
    if (!this.ids.includes(id)) {
      this.ids.push(id);
    }
    return id;
  }

  bool has(string id) {
    return this.ids.includes(id);
  }

  string asCssVariableName(string id) {
    string out = "--vscode-";
    int i = 0;
    while (i < id.length) {
      string ch = id.charAt(i);
      if (ch == ".") {
        out = out + "-";
      } else {
        out = out + ch;
      }
      i = i + 1;
    }
    return out;
  }
}

ListColorsRegistry colors = new ListColorsRegistry();

export ListColorsRegistry getListColorsRegistry() {
  return colors;
}

