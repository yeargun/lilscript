import { domCreateElement, appendChild, setClassName, classListAdd, classListRemove, setAttribute, setTabIndex, addEventListener, preventDefault, stopPropagation, eventKeyCode, focusElement } from "../../../../../js-host";

string boolAttr(bool value) {
  if (value) {
    return "true";
  }
  return "false";
}

export class ToggleStyles {
  string inputActiveOptionBorder;
  string inputActiveOptionForeground;
  string inputActiveOptionBackground;

  init(string border, string foreground, string background) {
    this.inputActiveOptionBorder = border;
    this.inputActiveOptionForeground = foreground;
    this.inputActiveOptionBackground = background;
  }
}

export ToggleStyles unthemedToggleStyles = new ToggleStyles("#007ACC00", "#FFFFFF", "#0E639C50");

export class Toggle {
  JsValue domNode;
  bool checked;
  bool enabledFlag;
  string title;
  string iconClass;
  ToggleStyles styles;
  bool notFocusable;
  (func(bool)->void)[] changeListeners;
  (func(JsValue)->void)[] keyDownListeners;

  init(string title, bool isChecked, string iconClass, string actionClassName, bool notFocusable, ToggleStyles styles) {
    this.title = title;
    this.checked = isChecked;
    this.enabledFlag = true;
    this.iconClass = iconClass;
    this.styles = styles;
    this.notFocusable = notFocusable;
    this.changeListeners = [];
    this.keyDownListeners = [];
    this.domNode = domCreateElement("div");
    setClassName(this.domNode, "monaco-custom-toggle");
    if (iconClass.length > 0) {
      classListAdd(this.domNode, "codicon");
      classListAdd(this.domNode, iconClass);
    }
    if (actionClassName.length > 0) {
      classListAdd(this.domNode, actionClassName);
    }
    if (isChecked) {
      classListAdd(this.domNode, "checked");
    }
    if (!notFocusable) {
      setTabIndex(this.domNode, 0);
    }
    setAttribute(this.domNode, "role", "checkbox");
    setAttribute(this.domNode, "aria-checked", boolAttr(isChecked));
    this.setTitle(title);
    this.applyStyles();
    Toggle owner = this;
    addEventListener(this.domNode, "click", (JsValue event) => {
      if (owner.enabledFlag) {
        owner.setChecked(!owner.checked);
        owner.fireChange(false);
        preventDefault(event);
        stopPropagation(event);
      }
    }, false);
    addEventListener(this.domNode, "keydown", (JsValue event) => {
      if (!owner.enabledFlag) {
        return;
      }
      int key = eventKeyCode(event);
      if (key == 32 || key == 13) {
        owner.setChecked(!owner.checked);
        owner.fireChange(true);
        preventDefault(event);
        stopPropagation(event);
        return;
      }
      int i = 0;
      while (i < owner.keyDownListeners.length) {
        owner.keyDownListeners[i](event);
        i = i + 1;
      }
    }, false);
  }

  void applyStyles() {
    if (this.checked) {
      this.domNode["style"]["borderColor"] = this.styles.inputActiveOptionBorder;
      this.domNode["style"]["color"] = this.styles.inputActiveOptionForeground;
      this.domNode["style"]["backgroundColor"] = this.styles.inputActiveOptionBackground;
    } else {
      this.domNode["style"]["borderColor"] = "";
      this.domNode["style"]["color"] = "inherit";
      this.domNode["style"]["backgroundColor"] = "";
    }
  }

  void fireChange(bool viaKeyboard) {
    int i = 0;
    while (i < this.changeListeners.length) {
      this.changeListeners[i](viaKeyboard);
      i = i + 1;
    }
  }

  void setChecked(bool value) {
    this.checked = value;
    setAttribute(this.domNode, "aria-checked", boolAttr(value));
    if (value) {
      classListAdd(this.domNode, "checked");
    } else {
      classListRemove(this.domNode, "checked");
    }
    this.applyStyles();
  }

  func()->void onChange(func(bool)->void listener) {
    this.changeListeners.push(listener);
    Toggle owner = this;
    return () => {
      int index = owner.changeListeners.indexOf(listener);
      if (index >= 0) {
        owner.changeListeners.splice(index, 1);
      }
    };
  }

  func()->void onKeyDown(func(JsValue)->void listener) {
    this.keyDownListeners.push(listener);
    Toggle owner = this;
    return () => {
      int index = owner.keyDownListeners.indexOf(listener);
      if (index >= 0) {
        owner.keyDownListeners.splice(index, 1);
      }
    };
  }

  bool enabled() {
    return this.enabledFlag;
  }

  void focus() {
    focusElement(this.domNode);
  }

  int width() {
    return 22;
  }

  void enable() {
    this.enabledFlag = true;
    setAttribute(this.domNode, "aria-disabled", "false");
    classListRemove(this.domNode, "disabled");
    if (!this.notFocusable) {
      setTabIndex(this.domNode, 0);
    }
  }

  void disable() {
    this.enabledFlag = false;
    setAttribute(this.domNode, "aria-disabled", "true");
    classListAdd(this.domNode, "disabled");
    if (!this.notFocusable) {
      setTabIndex(this.domNode, -1);
    }
  }

  void setTitle(string title) {
    this.title = title;
    setAttribute(this.domNode, "title", title);
    setAttribute(this.domNode, "aria-label", title);
  }

  void setIcon(string iconClass) {
    if (this.iconClass.length > 0) {
      classListRemove(this.domNode, this.iconClass);
    }
    this.iconClass = iconClass;
    if (iconClass.length > 0) {
      classListAdd(this.domNode, iconClass);
    }
  }
}

export class Checkbox {
  Toggle toggle;

  init(string title, bool isChecked, ToggleStyles styles) {
    this.toggle = new Toggle(title, isChecked, "codicon-check", "monaco-custom-checkbox", false, styles);
  }
}

export Toggle createToggle(string title, bool isChecked, string iconClass = "", string actionClassName = "", bool notFocusable = false) {
  return new Toggle(title, isChecked, iconClass, actionClassName, notFocusable, unthemedToggleStyles);
}

export Checkbox createCheckbox(string title, bool isChecked) {
  return new Checkbox(title, isChecked, unthemedToggleStyles);
}
