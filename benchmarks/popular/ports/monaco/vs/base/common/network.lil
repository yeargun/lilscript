export JsValue createSchemas() {
  JsValue result = JS.object();
  result["inMemory"] = SchemasInMemory;
  result["vscode"] = SchemasVscode;
  result["internal"] = SchemasInternal;
  result["walkThrough"] = SchemasWalkThrough;
  result["walkThroughSnippet"] = SchemasWalkThroughSnippet;
  result["http"] = SchemasHttp;
  result["https"] = SchemasHttps;
  result["file"] = SchemasFile;
  result["mailto"] = SchemasMailto;
  result["untitled"] = SchemasUntitled;
  result["data"] = SchemasData;
  result["command"] = SchemasCommand;
  result["vscodeRemote"] = SchemasVscodeRemote;
  result["vscodeRemoteResource"] = SchemasVscodeRemoteResource;
  result["vscodeManagedRemoteResource"] = SchemasVscodeManagedRemoteResource;
  result["vscodeUserData"] = SchemasVscodeUserData;
  result["vscodeCustomEditor"] = SchemasVscodeCustomEditor;
  result["vscodeNotebookCell"] = SchemasVscodeNotebookCell;
  result["vscodeNotebookCellMetadata"] = SchemasVscodeNotebookCellMetadata;
  result["vscodeNotebookCellMetadataDiff"] = SchemasVscodeNotebookCellMetadataDiff;
  result["vscodeNotebookCellOutput"] = SchemasVscodeNotebookCellOutput;
  result["vscodeNotebookCellOutputDiff"] = SchemasVscodeNotebookCellOutputDiff;
  result["vscodeNotebookMetadata"] = SchemasVscodeNotebookMetadata;
  result["vscodeInteractiveInput"] = SchemasVscodeInteractiveInput;
  result["vscodeSettings"] = SchemasVscodeSettings;
  result["vscodeWorkspaceTrust"] = SchemasVscodeWorkspaceTrust;
  result["vscodeTerminal"] = SchemasVscodeTerminal;
  result["vscodeImageCarousel"] = SchemasVscodeImageCarousel;
