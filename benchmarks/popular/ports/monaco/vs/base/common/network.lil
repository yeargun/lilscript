  result["accessibleView"] = SchemasAccessibleView;
  result["chatEditingSnapshotScheme"] = SchemasChatEditingSnapshot;
  result["chatEditingModel"] = SchemasChatEditingModel;
  result["copilotPr"] = SchemasCopilotPr;
  return result;
}

export bool matchesScheme(string target, string scheme) {
  string expected = scheme.toLowerCase() + ":";
  return target.toLowerCase().startsWith(expected);
}

export bool matchesUriScheme(string targetScheme, string scheme) {
  return targetScheme.toLowerCase() == scheme.toLowerCase();
}

export bool matchesSomeScheme(string target, string[] schemes) {
  int i = 0;
  while (i < schemes.length) {
    if (matchesScheme(target, schemes[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}
