  result["vscodeChatCodeCompareBlock"] = SchemasVscodeChatCodeCompareBlock;
  result["vscodeChatEditor"] = SchemasVscodeChatEditor;
  result["vscodeChatInput"] = SchemasVscodeChatInput;
  result["vscodeLocalChatSession"] = SchemasVscodeLocalChatSession;
  result["webviewPanel"] = SchemasWebviewPanel;
  result["vscodeWebview"] = SchemasVscodeWebview;
  result["vscodeBrowser"] = SchemasVscodeBrowser;
