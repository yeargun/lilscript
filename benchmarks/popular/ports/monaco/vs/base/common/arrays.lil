export void removeFastWithoutKeepingOrder(int[] array, int index) {
  int last = array.length - 1;
  if (index < last) {
    array[index] = array[last];
  }
  array.pop();
}

export bool intArrayEquals(int[] one, int[] other) {
  if (one.length != other.length) {
    return false;
  }
  int i = 0;
  while (i < one.length) {
    if (one[i] != other[i]) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

export int binarySearch2(int length, func(int)->int compareToKey) {
  int low = 0;
  int high = length - 1;
  while (low <= high) {
    int mid = (low + high) / 2;
    int comp = compareToKey(mid);
    if (comp < 0) {
      low = mid + 1;
    } else if (comp > 0) {
      high = mid - 1;
    } else {
      return mid;
    }
  }
  return -(low + 1);
}

export int binarySearch(int[] array, int key) {
  return binarySearch2(array.length, (int i) => array[i] - key);
}

export int[] coalesceInts(int[] array) {
  int[] out = [];
  int i = 0;
  while (i < array.length) {
    if (array[i] != 0) {
      out.push(array[i]);
    }
    i = i + 1;
  }
  return out;
}

export int[] distinctInts(int[] array) {
  int[] out = [];
  int i = 0;
  while (i < array.length) {
    bool seen = false;
    int j = 0;
    while (j < out.length) {
      if (out[j] == array[i]) {
        seen = true;
        break;
      }
      j = j + 1;
    }
    if (!seen) {
      out.push(array[i]);
    }
    i = i + 1;
  }
  return out;
}

export int[] intRange(int from, int to) {
  int[] result = [];
  if (from <= to) {
    int i = from;
    while (i < to) {
      result.push(i);
      i = i + 1;
    }
  } else {
    int i = from;
    while (i > to) {
      result.push(i);
      i = i - 1;
    }
  }
  return result;
}

export int[] arrayInsert(int[] target, int insertIndex, int[] insertArr) {
  int[] out = [];
  int i = 0;
  while (i < insertIndex && i < target.length) {
    out.push(target[i]);
    i = i + 1;
  }
  int j = 0;
  while (j < insertArr.length) {
    out.push(insertArr[j]);
    j = j + 1;
  }
  while (i < target.length) {
    out.push(target[i]);
    i = i + 1;
  }
  return out;
}

export void pushToStart(int[] arr, int value) {
  int index = arr.indexOf(value);
  if (index > -1) {
    arr.splice(index, 1);
    arr.push(value);
    int i = arr.length - 1;
    while (i > 0) {
      arr[i] = arr[i - 1];
      i = i - 1;
    }
    arr[0] = value;
  }
}

export void pushToEnd(int[] arr, int value) {
  int index = arr.indexOf(value);
  if (index > -1) {
    arr.splice(index, 1);
    arr.push(value);
  }
}

export void pushMany(int[] arr, int[] items) {
  int i = 0;
  while (i < items.length) {
    arr.push(items[i]);
    i = i + 1;
  }
}

export int getActualStartIndex(int[] array, int start) {
  if (start < 0) {
    int n = start + array.length;
    if (n < 0) {
      return 0;
    }
    return n;
  }
  if (start > array.length) {
    return array.length;
  }
  return start;
}

export void insertInto(int[] array, int start, int[] newItems) {
  int startIdx = getActualStartIndex(array, start);
  int originalLength = array.length;
  int newItemsLength = newItems.length;
  int i = originalLength - 1;
  while (i >= startIdx) {
    if (i + newItemsLength >= array.length) {
      array.push(array[i]);
    } else {
      array[i + newItemsLength] = array[i];
    }
    i = i - 1;
  }
  int j = 0;
  while (j < newItemsLength) {
    int dest = j + startIdx;
    if (dest >= array.length) {
      array.push(newItems[j]);
    } else {
      array[dest] = newItems[j];
    }
    j = j + 1;
  }
}

export int[] spliceInts(int[] array, int start, int deleteCount, int[] newItems) {
  int index = getActualStartIndex(array, start);
  int[] result = array.splice(index, deleteCount);
  insertInto(array, index, newItems);
  return result;
}

export int compareResultGreaterThan = 1;
export int compareResultLessThan = -1;
export int compareResultEqual = 0;

export bool compareIsLessThan(int result) {
  return result < 0;
}

export bool compareIsGreaterThan(int result) {
  return result > 0;
}

export int numberComparator(int a, int b) {
  return a - b;
}

export int sumInts(int[] array) {
  int acc = 0;
  int i = 0;
  while (i < array.length) {
    acc = acc + array[i];
    i = i + 1;
  }
  return acc;
}

export class ArrayQueue {
  int[] items;
  int firstIdx;
  int lastIdx;

  init(int[] items) {
    this.items = items;
    this.firstIdx = 0;
    this.lastIdx = items.length - 1;
  }

  int length() {
    return this.lastIdx - this.firstIdx + 1;
  }

  int peek() {
    if (this.length() == 0) {
      return 0;
    }
    return this.items[this.firstIdx];
  }

  int dequeue() {
    int result = this.items[this.firstIdx];
    this.firstIdx = this.firstIdx + 1;
    return result;
  }

  int[] takeCount(int count) {
    int[] result = [];
    int i = 0;
    while (i < count && this.firstIdx + i <= this.lastIdx) {
      result.push(this.items[this.firstIdx + i]);
      i = i + 1;
    }
    this.firstIdx = this.firstIdx + count;
    return result;
  }
}

export class Permutation {
  int[] indexMap;

  init(int[] indexMap) {
    this.indexMap = indexMap;
  }

  int[] apply(int[] arr) {
    int[] out = [];
    int i = 0;
    while (i < this.indexMap.length) {
      out.push(arr[this.indexMap[i]]);
      i = i + 1;
    }
    return out;
  }

  Permutation inverse() {
    int[] inverseIndexMap = [];
    int i = 0;
    while (i < this.indexMap.length) {
      inverseIndexMap.push(0);
      i = i + 1;
    }
    i = 0;
    while (i < this.indexMap.length) {
      inverseIndexMap[this.indexMap[i]] = i;
      i = i + 1;
    }
    return new Permutation(inverseIndexMap);
  }
}
