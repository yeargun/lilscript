export Color colorWhite() {
  return colorFromRgba(new RGBA(255, 255, 255, 1.0));
}

export Color colorBlack() {
  return colorFromRgba(new RGBA(0, 0, 0, 1.0));
}

export Color colorRed() {
  return colorFromRgba(new RGBA(255, 0, 0, 1.0));
}

export Color colorBlue() {
  return colorFromRgba(new RGBA(0, 0, 255, 1.0));
}

export Color colorGreen() {
  return colorFromRgba(new RGBA(0, 255, 0, 1.0));
}

export Color colorCyan() {
  return colorFromRgba(new RGBA(0, 255, 255, 1.0));
}

export Color colorLightgrey() {
  return colorFromRgba(new RGBA(211, 211, 211, 1.0));
}

export Color colorTransparent() {
  return colorFromRgba(new RGBA(0, 0, 0, 0.0));
}

export Color parseNamedKeyword(string css) {
  ColorLookup[] xs = namedCssColors();
  int i = 0;
  while (i < xs.length) {
    if (xs[i].name == css) {
      return colorFromRgba(new RGBA(xs[i].r, xs[i].g, xs[i].b, 1.0));
    }
    i = i + 1;
  }
  return colorTransparent();
}

export bool namedKeywordExists(string css) {
  ColorLookup[] xs = namedCssColors();
  int i = 0;
  while (i < xs.length) {
    if (xs[i].name == css) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

export Color parseHex(string hex) {
  int length = hex.length;
  if (length == 0 || hex.charCodeAt(0) != 35) {
    return colorTransparent();
  }
  if (length == 7) {
    int r = 16 * parseHexDigit(hex.charCodeAt(1)) + parseHexDigit(hex.charCodeAt(2));
    int g = 16 * parseHexDigit(hex.charCodeAt(3)) + parseHexDigit(hex.charCodeAt(4));
    int b = 16 * parseHexDigit(hex.charCodeAt(5)) + parseHexDigit(hex.charCodeAt(6));
    return colorFromRgba(new RGBA(r, g, b, 1.0));
  }
  if (length == 9) {
    int r = 16 * parseHexDigit(hex.charCodeAt(1)) + parseHexDigit(hex.charCodeAt(2));
    int g = 16 * parseHexDigit(hex.charCodeAt(3)) + parseHexDigit(hex.charCodeAt(4));
    int b = 16 * parseHexDigit(hex.charCodeAt(5)) + parseHexDigit(hex.charCodeAt(6));
    int a = 16 * parseHexDigit(hex.charCodeAt(7)) + parseHexDigit(hex.charCodeAt(8));
    return colorFromRgba(new RGBA(r, g, b, (a * 1.0) / 255.0));
  }
  if (length == 4) {
    int r = parseHexDigit(hex.charCodeAt(1));
    int g = parseHexDigit(hex.charCodeAt(2));
    int b = parseHexDigit(hex.charCodeAt(3));
    return colorFromRgba(new RGBA(16 * r + r, 16 * g + g, 16 * b + b, 1.0));
  }
  if (length == 5) {
    int r = parseHexDigit(hex.charCodeAt(1));
    int g = parseHexDigit(hex.charCodeAt(2));
    int b = parseHexDigit(hex.charCodeAt(3));
    int a = parseHexDigit(hex.charCodeAt(4));
    return colorFromRgba(new RGBA(16 * r + r, 16 * g + g, 16 * b + b, ((16 * a + a) * 1.0) / 255.0));
  }
  return colorTransparent();
}

export Color parseCssColor(string css) {
  if (css == "transparent") {
    return colorTransparent();
  }
  if (css.startsWith("#")) {
    return parseHex(css);
  }
  if (namedKeywordExists(css)) {
    return parseNamedKeyword(css);
  }
  return colorTransparent();
}

export Color colorFromHex(string hex) {
  Color parsed = parseHex(hex);
  if (hex.length == 0 || hex.charCodeAt(0) != 35) {
    return colorRed();
  }
  if (hex.length != 4 && hex.length != 5 && hex.length != 7 && hex.length != 9) {
    return colorRed();
  }
  return parsed;
}

export Color getLighterColor(Color baseColor, Color relative, float factor) {
  if (baseColor.isLighterThan(relative)) {
    return baseColor;
  }
  float f = factor;
  if (f == 0.0) {
    f = 0.5;
  }
  float lum1 = baseColor.getRelativeLuminance();
  float lum2 = relative.getRelativeLuminance();
  if (lum2 == 0.0) {
    return baseColor.lighten(f);
  }
  f = f * (lum2 - lum1) / lum2;
  return baseColor.lighten(f);
}

export Color getDarkerColor(Color baseColor, Color relative, float factor) {
  if (baseColor.isDarkerThan(relative)) {
    return baseColor;
  }
  float f = factor;
  if (f == 0.0) {
    f = 0.5;
  }
  float lum1 = baseColor.getRelativeLuminance();
  float lum2 = relative.getRelativeLuminance();
  if (lum1 == 0.0) {
    return baseColor.darken(f);
  }
  f = f * (lum1 - lum2) / lum1;
  return baseColor.darken(f);
}
