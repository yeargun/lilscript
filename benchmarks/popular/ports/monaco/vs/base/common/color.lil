int clampInt(int value, int min, int max) {
  int v = value;
  if (v < min) {
    v = min;
  }
  if (v > max) {
    v = max;
  }
  return v;
}

float clampFloat(float value, float min, float max) {
  float v = value;
  if (v < min) {
    v = min;
  }
  if (v > max) {
    v = max;
  }
  return v;
}

float roundFloat(float value, int decimalPoints) {
  float decimal = 1.0;
  int i = 0;
  while (i < decimalPoints) {
    decimal = decimal * 10.0;
    i = i + 1;
  }
  return (value * decimal).round() / decimal;
}

export class RGBA {
  int r;
  int g;
  int b;
  float a;

  init(int r, int g, int b, float a) {
    this.r = clampInt(r, 0, 255);
    this.g = clampInt(g, 0, 255);
    this.b = clampInt(b, 0, 255);
    this.a = roundFloat(clampFloat(a, 0.0, 1.0), 3);
  }
}

export bool rgbaEquals(RGBA a, RGBA b) {
  return a.r == b.r && a.g == b.g && a.b == b.b && a.a == b.a;
}

export class HSLA {
  int h;
  float s;
  float l;
  float a;

  init(int h, float s, float l, float a) {
    this.h = clampInt(h, 0, 360);
    this.s = roundFloat(clampFloat(s, 0.0, 1.0), 3);
    this.l = roundFloat(clampFloat(l, 0.0, 1.0), 3);
    this.a = roundFloat(clampFloat(a, 0.0, 1.0), 3);
  }
}

export bool hslaEquals(HSLA a, HSLA b) {
  return a.h == b.h && a.s == b.s && a.l == b.l && a.a == b.a;
}

float hue2rgb(float p, float q, float t) {
  float x = t;
  if (x < 0.0) {
    x = x + 1.0;
  }
  if (x > 1.0) {
    x = x - 1.0;
  }
  if (x < 1.0 / 6.0) {
    return p + (q - p) * 6.0 * x;
  }
  if (x < 0.5) {
    return q;
  }
  if (x < 2.0 / 3.0) {
    return p + (q - p) * (2.0 / 3.0 - x) * 6.0;
  }
  return p;
}

export HSLA hslaFromRgba(RGBA rgba) {
  float r = (rgba.r * 1.0) / 255.0;
  float g = (rgba.g * 1.0) / 255.0;
  float b = (rgba.b * 1.0) / 255.0;
  float max = r.max(g).max(b);
  float min = r.min(g).min(b);
  int h = 0;
  float s = 0.0;
  float l = (min + max) / 2.0;
  float chroma = max - min;
  if (chroma > 0.0) {
    if (l <= 0.5) {
      s = chroma / (2.0 * l);
    } else {
      s = chroma / (2.0 - 2.0 * l);
    }
    if (s > 1.0) {
      s = 1.0;
    }
    if (max == r) {
      float hf = (g - b) / chroma;
      if (g < b) {
        hf = hf + 6.0;
      }
      h = (hf * 60.0).round().toInt();
    } else if (max == g) {
      h = (((b - r) / chroma + 2.0) * 60.0).round().toInt();
    } else {
      h = (((r - g) / chroma + 4.0) * 60.0).round().toInt();
    }
  }
  return new HSLA(h, s, l, rgba.a);
}

export RGBA hslaToRgba(HSLA hsla) {
  float h = (hsla.h * 1.0) / 360.0;
  float s = hsla.s;
  float l = hsla.l;
  float r = l;
  float g = l;
  float b = l;
  if (s != 0.0) {
    float q = l + s - l * s;
    if (l < 0.5) {
      q = l * (1.0 + s);
    }
    float p = 2.0 * l - q;
    r = hue2rgb(p, q, h + 1.0 / 3.0);
    g = hue2rgb(p, q, h);
    b = hue2rgb(p, q, h - 1.0 / 3.0);
  }
  return new RGBA((r * 255.0).round().toInt(), (g * 255.0).round().toInt(), (b * 255.0).round().toInt(), hsla.a);
}

export class HSVA {
  int h;
  float s;
  float v;
  float a;

  init(int h, float s, float v, float a) {
    this.h = clampInt(h, 0, 360);
    this.s = roundFloat(clampFloat(s, 0.0, 1.0), 3);
    this.v = roundFloat(clampFloat(v, 0.0, 1.0), 3);
    this.a = roundFloat(clampFloat(a, 0.0, 1.0), 3);
  }
}

export bool hsvaEquals(HSVA a, HSVA b) {
  return a.h == b.h && a.s == b.s && a.v == b.v && a.a == b.a;
}

export HSVA hsvaFromRgba(RGBA rgba) {
  float r = (rgba.r * 1.0) / 255.0;
  float g = (rgba.g * 1.0) / 255.0;
  float b = (rgba.b * 1.0) / 255.0;
  float cmax = r.max(g).max(b);
  float cmin = r.min(g).min(b);
  float delta = cmax - cmin;
  float s = 0.0;
  if (cmax != 0.0) {
    s = delta / cmax;
  }
  float m = 0.0;
  if (delta != 0.0) {
    if (cmax == r) {
      m = (g - b) / delta;
      m = m - (m / 6.0).floor() * 6.0;
      if (m < 0.0) {
        m = m + 6.0;
      }
    } else if (cmax == g) {
      m = (b - r) / delta + 2.0;
    } else {
      m = (r - g) / delta + 4.0;
    }
  }
  return new HSVA((m * 60.0).round().toInt(), s, cmax, rgba.a);
}

export RGBA hsvaToRgba(HSVA hsva) {
  float h = hsva.h * 1.0;
  float s = hsva.s;
  float v = hsva.v;
  float c = v * s;
  float hv = h / 60.0;
  float rem = hv - (hv / 2.0).floor() * 2.0;
  float x = c * (1.0 - (rem - 1.0).abs());
  float m = v - c;
  float r = 0.0;
  float g = 0.0;
  float b = 0.0;
  if (h < 60.0) {
    r = c;
    g = x;
  } else if (h < 120.0) {
    r = x;
    g = c;
  } else if (h < 180.0) {
    g = c;
    b = x;
  } else if (h < 240.0) {
    g = x;
    b = c;
  } else if (h < 300.0) {
    r = x;
    b = c;
  } else {
    r = c;
    b = x;
  }
  return new RGBA(((r + m) * 255.0).round().toInt(), ((g + m) * 255.0).round().toInt(), ((b + m) * 255.0).round().toInt(), hsva.a);
}

export class Color {
  RGBA rgba;
  bool hasHsla;
  HSLA hslaValue;
  bool hasHsva;
  HSVA hsvaValue;
  string css;
  bool hasCss;

  init(RGBA rgba) {
    this.rgba = rgba;
    this.hasHsla = false;
    this.hslaValue = new HSLA(0, 0.0, 0.0, 1.0);
    this.hasHsva = false;
    this.hsvaValue = new HSVA(0, 0.0, 0.0, 1.0);
    this.css = "";
    this.hasCss = false;
  }

  HSLA hsla() {
    if (this.hasHsla) {
      return this.hslaValue;
    }
    HSLA next = hslaFromRgba(this.rgba);
    this.hslaValue = next;
    this.hasHsla = true;
    return next;
  }

  HSVA hsva() {
    if (this.hasHsva) {
      return this.hsvaValue;
    }
    HSVA next = hsvaFromRgba(this.rgba);
    this.hsvaValue = next;
    this.hasHsva = true;
    return next;
  }

  bool equals(Color other) {
    return rgbaEquals(this.rgba, other.rgba) && hslaEquals(this.hsla(), other.hsla()) && hsvaEquals(this.hsva(), other.hsva());
  }

  float relativeLuminanceForComponent(int color) {
    float c = (color * 1.0) / 255.0;
    if (c <= 0.03928) {
      return c / 12.92;
    }
    float base = (c + 0.055) / 1.055;
    return (base.log() * 2.4).exp();
  }

  float getRelativeLuminance() {
    float R = this.relativeLuminanceForComponent(this.rgba.r);
    float G = this.relativeLuminanceForComponent(this.rgba.g);
    float B = this.relativeLuminanceForComponent(this.rgba.b);
    return roundFloat(0.2126 * R + 0.7152 * G + 0.0722 * B, 4);
  }

  bool isLighter() {
    float yiq = (this.rgba.r * 299 + this.rgba.g * 587 + this.rgba.b * 114) * 1.0 / 1000.0;
    return yiq >= 128.0;
  }

  bool isLighterThan(Color another) {
    return this.getRelativeLuminance() > another.getRelativeLuminance();
  }

  bool isDarkerThan(Color another) {
    return this.getRelativeLuminance() < another.getRelativeLuminance();
  }

  Color lighten(float factor) {
    HSLA cur = this.hsla();
    return colorFromHsla(new HSLA(cur.h, cur.s, cur.l + cur.l * factor, cur.a));
  }

  Color darken(float factor) {
    HSLA cur = this.hsla();
    return colorFromHsla(new HSLA(cur.h, cur.s, cur.l - cur.l * factor, cur.a));
  }

  Color transparent(float factor) {
    return colorFromRgba(new RGBA(this.rgba.r, this.rgba.g, this.rgba.b, this.rgba.a * factor));
  }

  bool isTransparent() {
    return this.rgba.a == 0.0;
  }

  bool isOpaque() {
    return this.rgba.a == 1.0;
  }

  Color opposite() {
    return colorFromRgba(new RGBA(255 - this.rgba.r, 255 - this.rgba.g, 255 - this.rgba.b, this.rgba.a));
  }

  Color mix(Color color, float factor) {
    float normalize = clampFloat(factor, 0.0, 1.0);
    RGBA a = this.rgba;
    RGBA b = color.rgba;
    return colorFromRgba(new RGBA(
      (a.r * 1.0 + (b.r - a.r) * 1.0 * normalize).toInt(),
      (a.g * 1.0 + (b.g - a.g) * 1.0 * normalize).toInt(),
      (a.b * 1.0 + (b.b - a.b) * 1.0 * normalize).toInt(),
      a.a + (b.a - a.a) * normalize
    ));
  }

  Color makeOpaque(Color opaqueBackground) {
    if (this.isOpaque() || opaqueBackground.rgba.a != 1.0) {
      return this;
    }
    float a = this.rgba.a;
    return colorFromRgba(new RGBA(
      (opaqueBackground.rgba.r * 1.0 - a * (opaqueBackground.rgba.r - this.rgba.r) * 1.0).toInt(),
      (opaqueBackground.rgba.g * 1.0 - a * (opaqueBackground.rgba.g - this.rgba.g) * 1.0).toInt(),
      (opaqueBackground.rgba.b * 1.0 - a * (opaqueBackground.rgba.b - this.rgba.b) * 1.0).toInt(),
      1.0
    ));
  }

  int toNumber32Bit() {
    int alpha = (this.rgba.a * 255.0).toInt();
    return ((this.rgba.r << 24) | (this.rgba.g << 16) | (this.rgba.b << 8) | alpha) >>> 0;
  }
}

export Color colorFromRgba(RGBA rgba) {
  return new Color(rgba);
}

export Color colorFromHsla(HSLA hsla) {
  Color color = new Color(hslaToRgba(hsla));
  color.hslaValue = hsla;
  color.hasHsla = true;
  return color;
}

export Color colorFromHsva(HSVA hsva) {
  Color color = new Color(hsvaToRgba(hsva));
  color.hsvaValue = hsva;
  color.hasHsva = true;
  return color;
}

string twoDigitHex(int n) {
  string hex = n.toString(16);
  if (hex.length != 2) {
    return "0" + hex;
  }
  return hex;
}

export string formatHex(Color color) {
  return "#" + twoDigitHex(color.rgba.r) + twoDigitHex(color.rgba.g) + twoDigitHex(color.rgba.b);
}

export string formatHexA(Color color, bool compact) {
  if (compact && color.rgba.a == 1.0) {
    return formatHex(color);
  }
  int alpha = (color.rgba.a * 255.0).round().toInt();
  return formatHex(color) + twoDigitHex(alpha);
}

string floatToFixed2(float value) {
  int cents = (value * 100.0).round().toInt();
  if (cents < 0) {
    cents = 0;
  }
  string frac = (cents % 100).toString();
  if (frac.length == 1) {
    frac = "0" + frac;
  }
  return (cents / 100).toString() + "." + frac;
}

export string formatRGBA(Color color) {
  return "rgba(" + color.rgba.r.toString() + ", " + color.rgba.g.toString() + ", " + color.rgba.b.toString() + ", " + floatToFixed2(color.rgba.a) + ")";
}

export string formatRGB(Color color) {
  if (color.rgba.a == 1.0) {
    return "rgb(" + color.rgba.r.toString() + ", " + color.rgba.g.toString() + ", " + color.rgba.b.toString() + ")";
  }
  return formatRGBA(color);
}

export string formatColor(Color color) {
  if (color.isOpaque()) {
    return formatHex(color);
  }
  return formatRGBA(color);
}

int parseHexDigit(int charCode) {
  if (charCode >= 48 && charCode <= 57) {
    return charCode - 48;
  }
  if (charCode >= 97 && charCode <= 102) {
    return charCode - 97 + 10;
  }
  if (charCode >= 65 && charCode <= 70) {
    return charCode - 65 + 10;
  }
  return 0;
}

class ColorLookup {
  string name;
  int r;
  int g;
  int b;

  init(string name, int r, int g, int b) {
    this.name = name;
    this.r = r;
    this.g = g;
    this.b = b;
  }
}

