int CHAR_UPPERCASE_A = 65;
int CHAR_LOWERCASE_A = 97;
int CHAR_UPPERCASE_Z = 90;
int CHAR_LOWERCASE_Z = 122;
int CHAR_DOT = 46;
int CHAR_FORWARD_SLASH = 47;
int CHAR_BACKWARD_SLASH = 92;
int CHAR_COLON = 58;

string pathSlice(string path, int start, int end) {
  int from = start;
  int to = end;
  if (from < 0) {
    from = 0;
  }
  if (to > path.length) {
    to = path.length;
  }
  string out = "";
  int i = from;
  while (i < to) {
    out = out + path.charAt(i);
    i = i + 1;
  }
  return out;
}

bool isPosixSep(int code) {
  return code == CHAR_FORWARD_SLASH;
}

bool isWinSep(int code) {
  return code == CHAR_FORWARD_SLASH || code == CHAR_BACKWARD_SLASH;
}

bool isWindowsDeviceRoot(int code) {
  return (code >= CHAR_UPPERCASE_A && code <= CHAR_UPPERCASE_Z) || (code >= CHAR_LOWERCASE_A && code <= CHAR_LOWERCASE_Z);
}

int lastIndexOfChar(string s, string ch) {
  int i = s.length - 1;
  while (i >= 0) {
    if (s.charAt(i) == ch) {
      return i;
    }
    i = i - 1;
  }
  return -1;
}

string normalizeString(string path, bool allowAboveRoot, string separator, bool posixOnly) {
  string res = "";
  int lastSegmentLength = 0;
  int lastSlash = -1;
  int dots = 0;
  int code = 0;
  int i = 0;
  while (i <= path.length) {
    if (i < path.length) {
      code = path.charCodeAt(i);
    } else {
      bool alreadySep = false;
      if (posixOnly) {
        alreadySep = isPosixSep(code);
      } else {
        alreadySep = isWinSep(code);
      }
      if (alreadySep) {
        break;
      }
      code = CHAR_FORWARD_SLASH;
    }
    bool sep = false;
    if (posixOnly) {
      sep = isPosixSep(code);
    } else {
      sep = isWinSep(code);
    }
    if (sep) {
      if (lastSlash == i - 1 || dots == 1) {
      } else if (dots == 2) {
        bool keepDots = res.length < 2 || lastSegmentLength != 2 || res.charCodeAt(res.length - 1) != CHAR_DOT || res.charCodeAt(res.length - 2) != CHAR_DOT;
        if (keepDots) {
          if (res.length > 2) {
            int lastSlashIndex = lastIndexOfChar(res, separator);
            if (lastSlashIndex == -1) {
              res = "";
              lastSegmentLength = 0;
            } else {
              res = pathSlice(res, 0, lastSlashIndex);
              int prev = lastIndexOfChar(res, separator);
              lastSegmentLength = res.length - 1 - prev;
            }
            lastSlash = i;
            dots = 0;
            i = i + 1;
            continue;
          } else if (res.length != 0) {
            res = "";
            lastSegmentLength = 0;
            lastSlash = i;
            dots = 0;
            i = i + 1;
            continue;
          }
        }
        if (allowAboveRoot) {
          if (res.length > 0) {
            res = res + separator + "..";
          } else {
            res = "..";
          }
          lastSegmentLength = 2;
        }
      } else {
        string part = pathSlice(path, lastSlash + 1, i);
        if (res.length > 0) {
          res = res + separator + part;
        } else {
          res = part;
        }
        lastSegmentLength = i - lastSlash - 1;
      }
      lastSlash = i;
      dots = 0;
    } else if (code == CHAR_DOT && dots != -1) {
      dots = dots + 1;
    } else {
      dots = -1;
    }
    i = i + 1;
  }
  return res;
}

export bool posixIsAbsolute(string path) {
  return path.length > 0 && path.charCodeAt(0) == CHAR_FORWARD_SLASH;
}

export string posixNormalize(string path) {
  if (path.length == 0) {
    return ".";
  }
  bool isAbsolute = path.charCodeAt(0) == CHAR_FORWARD_SLASH;
  bool trailingSeparator = path.charCodeAt(path.length - 1) == CHAR_FORWARD_SLASH;
  string normalized = normalizeString(path, !isAbsolute, "/", true);
  if (normalized.length == 0) {
    if (isAbsolute) {
      return "/";
    }
    if (trailingSeparator) {
      return "./";
    }
    return ".";
  }
  if (trailingSeparator) {
    normalized = normalized + "/";
  }
  if (isAbsolute) {
    return "/" + normalized;
  }
  return normalized;
}

export string posixJoin(string[] paths) {
  if (paths.length == 0) {
    return ".";
  }
  string joined = "";
  int i = 0;
  while (i < paths.length) {
    string arg = paths[i];
    if (arg.length > 0) {
      if (joined.length == 0) {
        joined = arg;
      } else {
        joined = joined + "/" + arg;
      }
    }
    i = i + 1;
  }
  if (joined.length == 0) {
    return ".";
  }
  return posixNormalize(joined);
}

export string posixResolve(string[] pathSegments) {
  string resolvedPath = "";
  bool resolvedAbsolute = false;
  int i = pathSegments.length - 1;
  while (i >= 0 && !resolvedAbsolute) {
    string path = pathSegments[i];
    if (path.length != 0) {
      resolvedPath = path + "/" + resolvedPath;
      resolvedAbsolute = path.charCodeAt(0) == CHAR_FORWARD_SLASH;
    }
    i = i - 1;
  }
  if (!resolvedAbsolute) {
    resolvedPath = "/" + resolvedPath;
    resolvedAbsolute = true;
  }
  resolvedPath = normalizeString(resolvedPath, !resolvedAbsolute, "/", true);
  if (resolvedAbsolute) {
    return "/" + resolvedPath;
  }
  if (resolvedPath.length > 0) {
    return resolvedPath;
  }
  return ".";
}

export string posixDirname(string path) {
  if (path.length == 0) {
    return ".";
  }
  bool hasRoot = path.charCodeAt(0) == CHAR_FORWARD_SLASH;
  int end = -1;
  bool matchedSlash = true;
  int i = path.length - 1;
  while (i >= 1) {
    if (path.charCodeAt(i) == CHAR_FORWARD_SLASH) {
      if (!matchedSlash) {
        end = i;
        break;
      }
    } else {
      matchedSlash = false;
    }
    i = i - 1;
  }
  if (end == -1) {
    if (hasRoot) {
      return "/";
    }
    return ".";
  }
  if (hasRoot && end == 1) {
    return "//";
  }
  return pathSlice(path, 0, end);
}

export string posixBasename(string path) {
  int start = 0;
  int end = -1;
  bool matchedSlash = true;
  int i = path.length - 1;
  while (i >= 0) {
    if (path.charCodeAt(i) == CHAR_FORWARD_SLASH) {
      if (!matchedSlash) {
        start = i + 1;
        break;
      }
    } else if (end == -1) {
      matchedSlash = false;
      end = i + 1;
    }
    i = i - 1;
  }
  if (end == -1) {
    return "";
  }
  return pathSlice(path, start, end);
}

export string posixExtname(string path) {
  int startDot = -1;
  int startPart = 0;
  int end = -1;
  bool matchedSlash = true;
  int preDotState = 0;
  int i = path.length - 1;
  while (i >= 0) {
    int code = path.charCodeAt(i);
    if (code == CHAR_FORWARD_SLASH) {
      if (!matchedSlash) {
        startPart = i + 1;
        break;
      }
      i = i - 1;
      continue;
    }
    if (end == -1) {
      matchedSlash = false;
      end = i + 1;
    }
    if (code == CHAR_DOT) {
      if (startDot == -1) {
        startDot = i;
      } else if (preDotState != 1) {
        preDotState = 1;
      }
    } else if (startDot != -1) {
      preDotState = -1;
    }
    i = i - 1;
  }
  if (startDot == -1 || end == -1 || preDotState == 0 || (preDotState == 1 && startDot == end - 1 && startDot == startPart + 1)) {
    return "";
  }
  return pathSlice(path, startDot, end);
}

export string posixRelative(string fromPath, string toPath) {
  if (fromPath == toPath) {
    return "";
  }
  string[] fromSegs = [];
  fromSegs.push(fromPath);
  string[] toSegs = [];
  toSegs.push(toPath);
  string from = posixResolve(fromSegs);
  string to = posixResolve(toSegs);
  if (from == to) {
    return "";
  }
  int fromStart = 1;
  int fromEnd = from.length;
  int fromLen = fromEnd - fromStart;
  int toStart = 1;
  int toLen = to.length - toStart;
  int length = fromLen;
  if (toLen < fromLen) {
    length = toLen;
  }
  int lastCommonSep = -1;
  int i = 0;
  while (i < length) {
    int fromCode = from.charCodeAt(fromStart + i);
    if (fromCode != to.charCodeAt(toStart + i)) {
      break;
    }
    if (fromCode == CHAR_FORWARD_SLASH) {
      lastCommonSep = i;
    }
    i = i + 1;
  }
  if (i == length) {
    if (toLen > length) {
      if (to.charCodeAt(toStart + i) == CHAR_FORWARD_SLASH) {
        return pathSlice(to, toStart + i + 1, to.length);
      }
      if (i == 0) {
        return pathSlice(to, toStart + i, to.length);
      }
    } else if (fromLen > length) {
      if (from.charCodeAt(fromStart + i) == CHAR_FORWARD_SLASH) {
        lastCommonSep = i;
      } else if (i == 0) {
        lastCommonSep = 0;
      }
    }
  }
  string out = "";
  i = fromStart + lastCommonSep + 1;
  while (i <= fromEnd) {
    if (i == fromEnd || from.charCodeAt(i) == CHAR_FORWARD_SLASH) {
      if (out.length == 0) {
        out = "..";
      } else {
        out = out + "/..";
      }
    }
    i = i + 1;
  }
  return out + pathSlice(to, toStart + lastCommonSep, to.length);
}

export class PathObject {
  string dir;
  string root;
  string base;
  string name;
  string ext;

  init() {
    this.dir = "";
    this.root = "";
    this.base = "";
    this.name = "";
    this.ext = "";
  }
}

export PathObject posixParse(string path) {
  PathObject ret = new PathObject();
  if (path.length == 0) {
    return ret;
  }
  bool isAbsolute = path.charCodeAt(0) == CHAR_FORWARD_SLASH;
  int start = 0;
  if (isAbsolute) {
    ret.root = "/";
    start = 1;
  }
  int startDot = -1;
  int startPart = start;
  int end = -1;
  bool matchedSlash = true;
  int i = path.length - 1;
  int preDotState = 0;
  while (i >= start) {
    int code = path.charCodeAt(i);
    if (code == CHAR_FORWARD_SLASH) {
      if (!matchedSlash) {
        startPart = i + 1;
        break;
      }
      i = i - 1;
      continue;
    }
    if (end == -1) {
      matchedSlash = false;
      end = i + 1;
    }
    if (code == CHAR_DOT) {
      if (startDot == -1) {
        startDot = i;
      } else if (preDotState != 1) {
        preDotState = 1;
      }
    } else if (startDot != -1) {
      preDotState = -1;
    }
    i = i - 1;
  }
  if (end != -1) {
    if (startDot == -1 || preDotState == 0 || (preDotState == 1 && startDot == end - 1 && startDot == startPart + 1)) {
      ret.base = pathSlice(path, startPart, end);
      ret.name = ret.base;
    } else {
      ret.name = pathSlice(path, startPart, startDot);
      ret.base = pathSlice(path, startPart, end);
      ret.ext = pathSlice(path, startDot, end);
    }
  }
  if (startPart > 0 && startPart != start) {
    ret.dir = pathSlice(path, 0, startPart - 1);
  } else if (isAbsolute) {
    ret.dir = "/";
  }
  return ret;
}

export string posixFormat(PathObject pathObject) {
  string dir = pathObject.dir;
  if (dir.length == 0) {
    dir = pathObject.root;
  }
  string base = pathObject.base;
  if (base.length == 0) {
    string ext = pathObject.ext;
    if (ext.length > 0 && ext.charAt(0) != ".") {
      ext = "." + ext;
    }
    base = pathObject.name + ext;
  }
  if (dir.length == 0) {
    return base;
  }
  if (dir == pathObject.root) {
    return dir + base;
  }
  return dir + "/" + base;
}

export bool win32IsAbsolute(string path) {
  int len = path.length;
  if (len == 0) {
    return false;
  }
  int code = path.charCodeAt(0);
  if (isWinSep(code)) {
    return true;
  }
  return isWindowsDeviceRoot(code) && len > 2 && path.charCodeAt(1) == CHAR_COLON && isWinSep(path.charCodeAt(2));
}

export string win32Normalize(string path) {
  if (path.length == 0) {
    return ".";
  }
  int len = path.length;
  int code = path.charCodeAt(0);
  bool isAbsolute = win32IsAbsolute(path);
  bool trailingSeparator = isWinSep(path.charCodeAt(len - 1));
  string device = "";
  int offset = 0;
  if (isWindowsDeviceRoot(code) && len > 1 && path.charCodeAt(1) == CHAR_COLON) {
    device = pathSlice(path, 0, 2);
    offset = 2;
    if (len > 2 && isWinSep(path.charCodeAt(2))) {
      isAbsolute = true;
    }
  }
  string tail = pathSlice(path, offset, path.length);
  string normalized = normalizeString(tail, !isAbsolute, "\\", false);
  if (normalized.length == 0) {
    if (device.length > 0) {
      if (isAbsolute) {
        return device + "\\";
      }
      return device;
    }
    if (isAbsolute) {
      return "\\";
    }
    if (trailingSeparator) {
      return ".\\";
    }
    return ".";
  }
  if (trailingSeparator) {
    normalized = normalized + "\\";
  }
  if (device.length > 0) {
    if (isAbsolute) {
      return device + "\\" + normalized;
    }
    return device + normalized;
  }
  if (isAbsolute) {
    return "\\" + normalized;
  }
  return normalized;
}

export string win32Join(string[] paths) {
  if (paths.length == 0) {
    return ".";
  }
  string joined = "";
  int i = 0;
  while (i < paths.length) {
    string arg = paths[i];
    if (arg.length > 0) {
      if (joined.length == 0) {
        joined = arg;
      } else {
        joined = joined + "\\" + arg;
      }
    }
    i = i + 1;
  }
  if (joined.length == 0) {
    return ".";
  }
  return win32Normalize(joined);
}

export string posixSep() {
  return "/";
}

export string posixDelimiter() {
  return ":";
}

export string win32Sep() {
  return "\\";
}

export string win32Delimiter() {
  return ";";
}
