export bool iterableIsEmpty(int[] items) {
  return items.length == 0;
}

export int iterableFirst(int[] items) {
  if (items.length == 0) {
    return 0;
  }
  return items[0];
}

export bool iterableSome(int[] items, func(int, int)->bool predicate) {
  int i = 0;
  while (i < items.length) {
    if (predicate(items[i], i)) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

export bool iterableEvery(int[] items, func(int, int)->bool predicate) {
  int i = 0;
  while (i < items.length) {
    if (!predicate(items[i], i)) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

export int iterableFind(int[] items, func(int)->bool predicate) {
  int i = 0;
  while (i < items.length) {
    if (predicate(items[i])) {
      return items[i];
    }
    i = i + 1;
  }
  return 0;
}

export int[] iterableFilter(int[] items, func(int)->bool predicate) {
  int[] out = [];
  int i = 0;
  while (i < items.length) {
    if (predicate(items[i])) {
      out.push(items[i]);
    }
    i = i + 1;
  }
  return out;
}

export int[] iterableMap(int[] items, func(int, int)->int fn) {
  int[] out = [];
  int i = 0;
  while (i < items.length) {
    out.push(fn(items[i], i));
    i = i + 1;
  }
  return out;
}

export int iterableReduce(int[] items, func(int, int)->int reducer, int initialValue) {
  int value = initialValue;
  int i = 0;
  while (i < items.length) {
    value = reducer(value, items[i]);
    i = i + 1;
  }
  return value;
}

export int iterableLength(int[] items) {
  return items.length;
}

export int[] iterableSlice(int[] arr, int from, int to) {
  int start = from;
  int end = to;
  if (start < 0 - arr.length) {
    start = 0;
  }
  if (start < 0) {
    start = start + arr.length;
  }
  if (end < 0) {
    end = end + arr.length;
  } else if (end > arr.length) {
    end = arr.length;
  }
  int[] out = [];
  int i = start;
  while (i < end) {
    out.push(arr[i]);
    i = i + 1;
  }
  return out;
}

export int[] iterableReverse(int[] array) {
  int[] out = [];
  int i = array.length - 1;
  while (i >= 0) {
    out.push(array[i]);
    i = i - 1;
  }
  return out;
}

export int[] iterableConcat(int[] a, int[] b) {
  int[] out = [];
  int i = 0;
  while (i < a.length) {
    out.push(a[i]);
    i = i + 1;
  }
  i = 0;
  while (i < b.length) {
    out.push(b[i]);
    i = i + 1;
  }
  return out;
}
