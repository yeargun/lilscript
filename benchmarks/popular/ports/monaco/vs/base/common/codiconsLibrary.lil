export int getCodicon(string id) {
  registerCodicons();
  int? value = codiconCodepoints.get(id);
  if (value != null) {
    return value;
  }
  return 0;
}

export string[] getCodiconIds() {
  registerCodicons();
  return codiconNames.slice();
}

export int getCodiconCount() {
  registerCodicons();
  return codiconNames.length;
}
