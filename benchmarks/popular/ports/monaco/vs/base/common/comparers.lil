int compareStrings(string a, string b) {
  if (a == b) {
    return 0;
  }
  if (a < b) {
    return -1;
  }
  return 1;
}

bool isDigitChar(string ch) {
  return ch >= "0" && ch <= "9";
}

int parseDigits(string s, int start) {
  int n = 0;
  int i = start;
  while (i < s.length && isDigitChar(s.charAt(i))) {
    n = n * 10 + (s.charCodeAt(i) - 48);
    i = i + 1;
  }
  return n;
}

int digitSpan(string s, int start) {
  int i = start;
  while (i < s.length && isDigitChar(s.charAt(i))) {
    i = i + 1;
  }
  return i - start;
}

export int compareFileNames(string one, string other) {
  string a = one.toLowerCase();
  string b = other.toLowerCase();
  int i = 0;
  int j = 0;
  while (i < a.length && j < b.length) {
    string ca = a.charAt(i);
    string cb = b.charAt(j);
    if (isDigitChar(ca) && isDigitChar(cb)) {
      int na = parseDigits(a, i);
      int nb = parseDigits(b, j);
      if (na != nb) {
        if (na < nb) {
          return -1;
        }
        return 1;
      }
      int da = digitSpan(a, i);
      int db = digitSpan(b, j);
      if (da != db) {
        if (da < db) {
          return -1;
        }
        return 1;
      }
      i = i + da;
      j = j + db;
      continue;
    }
    if (ca != cb) {
      return compareStrings(ca, cb);
    }
    i = i + 1;
    j = j + 1;
  }
  if (a.length == b.length) {
    return compareStrings(one, other);
  }
  if (a.length < b.length) {
    return -1;
  }
  return 1;
}

export int compareByPrefix(string one, string other, string lookFor) {
  string elementAName = one.toLowerCase();
  string elementBName = other.toLowerCase();
  bool elementAPrefixMatch = elementAName.startsWith(lookFor);
  bool elementBPrefixMatch = elementBName.startsWith(lookFor);
  if (elementAPrefixMatch != elementBPrefixMatch) {
    if (elementAPrefixMatch) {
      return -1;
    }
    return 1;
  }
  if (elementAPrefixMatch && elementBPrefixMatch) {
    if (elementAName.length < elementBName.length) {
      return -1;
    }
    if (elementAName.length > elementBName.length) {
      return 1;
    }
  }
  return 0;
}

export int compareAnything(string one, string other, string lookFor) {
  string elementAName = one.toLowerCase();
  string elementBName = other.toLowerCase();
  int prefixCompare = compareByPrefix(one, other, lookFor);
  if (prefixCompare != 0) {
    return prefixCompare;
  }
  bool elementASuffixMatch = elementAName.endsWith(lookFor);
  bool elementBSuffixMatch = elementBName.endsWith(lookFor);
  if (elementASuffixMatch != elementBSuffixMatch) {
    if (elementASuffixMatch) {
      return -1;
    }
    return 1;
  }
  int r = compareFileNames(elementAName, elementBName);
  if (r != 0) {
    return r;
  }
  return compareStrings(elementAName, elementBName);
}
