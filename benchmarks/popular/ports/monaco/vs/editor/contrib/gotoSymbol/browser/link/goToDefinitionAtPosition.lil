
export class TextRange {
  int startLineNumber;
  int startColumn;
  int endLineNumber;
  int endColumn;

  init(int startLineNumber, int startColumn, int endLineNumber, int endColumn) {
    this.startLineNumber = startLineNumber;
    this.startColumn = startColumn;
    this.endLineNumber = endLineNumber;
    this.endColumn = endColumn;
  }
}

export class TextPos {
  int lineNumber;
  int column;

  init(int lineNumber, int column) {
    this.lineNumber = lineNumber;
    this.column = column;
  }
}

bool posBefore(TextPos a, TextPos b) {
  if (a.lineNumber < b.lineNumber) {
    return true;
  }
  if (a.lineNumber > b.lineNumber) {
    return false;
  }
  return a.column < b.column;
}

bool rangeContainsPos(TextRange range, int lineNumber, int column) {
  if (lineNumber < range.startLineNumber || lineNumber > range.endLineNumber) {
    return false;
  }
  if (lineNumber == range.startLineNumber && column < range.startColumn) {
    return false;
  }
  if (lineNumber == range.endLineNumber && column > range.endColumn) {
    return false;
  }
  return true;
}

export TextRange createTextRange(int startLine, int startColumn, int endLine, int endColumn) {
  return new TextRange(startLine, startColumn, endLine, endColumn);
}

export TextPos createTextPos(int lineNumber, int column) {
  return new TextPos(lineNumber, column);
}

bool isIdentChar(string ch) {
  int code = ch.charCodeAt(0);
  if (code >= 97 && code <= 122) {
    return true;
  }
  if (code >= 65 && code <= 90) {
    return true;
  }
  if (code >= 48 && code <= 57) {
    return true;
  }
  return ch == "_" || ch == "$";
}

string sliceChars(string text, int start, int end) {
  string out = "";
  int i = start;
  if (i < 0) {
    i = 0;
  }
  int last = end;
  if (last > text.length) {
    last = text.length;
  }
  while (i < last) {
    out = out + text.charAt(i);
    i = i + 1;
  }
  return out;
}

string wordAt(string line, int column) {
  int i = column - 1;
  if (i < 0) {
    i = 0;
  }
  if (i > line.length) {
    i = line.length;
  }
  int start = i;
  while (start > 0 && isIdentChar(line.charAt(start - 1))) {
    start = start - 1;
  }
  int end = i;
  while (end < line.length && isIdentChar(line.charAt(end))) {
    end = end + 1;
  }
  return sliceChars(line, start, end);
}

int wordStart(string line, int column) {
  int i = column - 1;
  if (i < 0) {
    i = 0;
  }
  if (i > line.length) {
    i = line.length;
  }
  while (i > 0 && isIdentChar(line.charAt(i - 1))) {
    i = i - 1;
  }
  return i + 1;
}

int wordEnd(string line, int column) {
  int i = column - 1;
  if (i < 0) {
    i = 0;
  }
  if (i > line.length) {
    i = line.length;
  }
  while (i < line.length && isIdentChar(line.charAt(i))) {
    i = i + 1;
  }
  return i + 1;
}

int leadingIndent(string line) {
  int i = 0;
  while (i < line.length) {
    string ch = line.charAt(i);
    if (ch != " " && ch != "\t") {
      break;
    }
    i = i + 1;
  }
  return i;
}

export int SYMBOL_FILE = 0;
export int SYMBOL_MODULE = 1;
export int SYMBOL_NAMESPACE = 2;
export int SYMBOL_PACKAGE = 3;
export int SYMBOL_CLASS = 4;
export int SYMBOL_METHOD = 5;
export int SYMBOL_PROPERTY = 6;
export int SYMBOL_FIELD = 7;
export int SYMBOL_CONSTRUCTOR = 8;
export int SYMBOL_FUNCTION = 11;
export int SYMBOL_VARIABLE = 12;
export int SYMBOL_CONSTANT = 13;

export class DocumentSymbol {
  string name;
  int kind;
  TextRange range;
  TextRange selectionRange;
  DocumentSymbol[] children;

  init(string name, int kind, TextRange range, TextRange selectionRange) {
    this.name = name;
    this.kind = kind;
    this.range = range;
    this.selectionRange = selectionRange;
    this.children = [];
  }
}

export class LocationLink {
  string uri;
  TextRange range;
  string preview;

  init(string uri, TextRange range, string preview) {
    this.uri = uri;
    this.range = range;
    this.preview = preview;
  }
}

int kindFromLine(string line) {
  int i = leadingIndent(line);
  string trimmed = sliceChars(line, i, line.length);
  if (trimmed.startsWith("class ") || trimmed.startsWith("interface ")) {
    return SYMBOL_CLASS;
  }
  if (trimmed.startsWith("function ") || trimmed.startsWith("def ") || trimmed.indexOf("function") >= 0) {
    return SYMBOL_FUNCTION;
  }
  if (trimmed.startsWith("const ") || trimmed.startsWith("let ") || trimmed.startsWith("var ")) {
    return SYMBOL_VARIABLE;
  }
  return SYMBOL_FIELD;
}

export DocumentSymbol[] documentSymbolsFromLines(string[] lines) {
  DocumentSymbol[] symbols = [];
  int line = 1;
  while (line <= lines.length) {
    string content = lines[line - 1];
    int indent = leadingIndent(content);
    string w = wordAt(content, indent + 1);
    int kind = kindFromLine(content);
    if (w.length > 0 && (kind == SYMBOL_CLASS || kind == SYMBOL_FUNCTION || kind == SYMBOL_VARIABLE)) {
      int start = wordStart(content, indent + 1);
      int end = wordEnd(content, indent + 1);
      symbols.push(new DocumentSymbol(w, kind, new TextRange(line, 1, line, content.length + 1), new TextRange(line, start, line, end)));
    }
    line = line + 1;
  }
  return symbols;
}

export LocationLink[] referencesForWord(string[] lines, string word) {
  LocationLink[] refs = [];
  if (word.length == 0) {
    return refs;
  }
  int line = 1;
  while (line <= lines.length) {
    string content = lines[line - 1];
    int col = 1;
    while (col <= content.length) {
      string cur = wordAt(content, col);
      if (cur == word) {
        int start = wordStart(content, col);
        int end = wordEnd(content, col);
        refs.push(new LocationLink("", new TextRange(line, start, line, end), content));
        col = end;
      } else {
        col = col + 1;
      }
    }
    line = line + 1;
  }
  return refs;
}

export DocumentSymbol[] filterSymbols(DocumentSymbol[] symbols, string query) {
  DocumentSymbol[] result = [];
  string q = query.toLowerCase();
  int i = 0;
  while (i < symbols.length) {
    if (q.length == 0 || symbols[i].name.toLowerCase().indexOf(q) >= 0) {
      result.push(symbols[i]);
    }
    i = i + 1;
  }
  return result;
}

export DocumentSymbol createDocumentSymbol(string name, int kind, int line) {
  return new DocumentSymbol(name, kind, new TextRange(line, 1, line, name.length + 1), new TextRange(line, 1, line, name.length + 1));
}
