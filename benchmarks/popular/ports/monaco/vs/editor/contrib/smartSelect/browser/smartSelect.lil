
export class TextRange {
  int startLineNumber;
  int startColumn;
  int endLineNumber;
  int endColumn;

  init(int startLineNumber, int startColumn, int endLineNumber, int endColumn) {
    this.startLineNumber = startLineNumber;
    this.startColumn = startColumn;
    this.endLineNumber = endLineNumber;
    this.endColumn = endColumn;
  }
}

export class TextPos {
  int lineNumber;
  int column;

  init(int lineNumber, int column) {
    this.lineNumber = lineNumber;
    this.column = column;
  }
}

bool posBefore(TextPos a, TextPos b) {
  if (a.lineNumber < b.lineNumber) {
    return true;
  }
  if (a.lineNumber > b.lineNumber) {
    return false;
  }
  return a.column < b.column;
}

bool rangeContainsPos(TextRange range, int lineNumber, int column) {
  if (lineNumber < range.startLineNumber || lineNumber > range.endLineNumber) {
    return false;
  }
  if (lineNumber == range.startLineNumber && column < range.startColumn) {
    return false;
  }
  if (lineNumber == range.endLineNumber && column > range.endColumn) {
    return false;
  }
  return true;
}

export TextRange createTextRange(int startLine, int startColumn, int endLine, int endColumn) {
  return new TextRange(startLine, startColumn, endLine, endColumn);
}

export TextPos createTextPos(int lineNumber, int column) {
  return new TextPos(lineNumber, column);
}

bool isIdentChar(string ch) {
  int code = ch.charCodeAt(0);
  if (code >= 97 && code <= 122) {
    return true;
  }
  if (code >= 65 && code <= 90) {
    return true;
  }
  if (code >= 48 && code <= 57) {
    return true;
  }
  return ch == "_" || ch == "$";
}

string sliceChars(string text, int start, int end) {
  string out = "";
  int i = start;
  if (i < 0) {
    i = 0;
  }
  int last = end;
  if (last > text.length) {
    last = text.length;
  }
  while (i < last) {
    out = out + text.charAt(i);
    i = i + 1;
  }
  return out;
}

string wordAt(string line, int column) {
  int i = column - 1;
  if (i < 0) {
    i = 0;
  }
  if (i > line.length) {
    i = line.length;
  }
  int start = i;
  while (start > 0 && isIdentChar(line.charAt(start - 1))) {
    start = start - 1;
  }
  int end = i;
  while (end < line.length && isIdentChar(line.charAt(end))) {
    end = end + 1;
  }
  return sliceChars(line, start, end);
}

int wordStart(string line, int column) {
  int i = column - 1;
  if (i < 0) {
    i = 0;
  }
  if (i > line.length) {
    i = line.length;
  }
  while (i > 0 && isIdentChar(line.charAt(i - 1))) {
    i = i - 1;
  }
  return i + 1;
}

int wordEnd(string line, int column) {
  int i = column - 1;
  if (i < 0) {
    i = 0;
  }
  if (i > line.length) {
    i = line.length;
  }
  while (i < line.length && isIdentChar(line.charAt(i))) {
    i = i + 1;
  }
  return i + 1;
}

int leadingIndent(string line) {
  int i = 0;
  while (i < line.length) {
    string ch = line.charAt(i);
    if (ch != " " && ch != "\t") {
      break;
    }
    i = i + 1;
  }
  return i;
}

export TextRange wordSelection(string line, int lineNumber, int column) {
  return new TextRange(lineNumber, wordStart(line, column), lineNumber, wordEnd(line, column));
}

export TextRange? bracketSelection(string text, int offset) {
  string open = "([{";
  string close = ")]}";
  int i = offset;
  if (i >= text.length) {
    i = text.length - 1;
  }
  while (i >= 0) {
    string ch = text.charAt(i);
    int kind = open.indexOf(ch);
    if (kind >= 0) {
      int depth = 1;
      int j = i + 1;
      while (j < text.length) {
        string cur = text.charAt(j);
        if (cur == open.charAt(kind)) {
          depth = depth + 1;
        } else if (cur == close.charAt(kind)) {
          depth = depth - 1;
          if (depth == 0) {
            return new TextRange(1, i + 1, 1, j + 2);
          }
        }
        j = j + 1;
      }
    }
    i = i - 1;
  }
  return null;
}

export TextRange[] growSelections(string[] lines, TextRange current) {
  TextRange[] result = [];
  result.push(current);
  if (current.startLineNumber >= 1 && current.startLineNumber <= lines.length) {
    string line = lines[current.startLineNumber - 1];
    TextRange word = wordSelection(line, current.startLineNumber, current.startColumn);
    if (word.startColumn != current.startColumn || word.endColumn != current.endColumn) {
      result.push(word);
    }
    result.push(new TextRange(current.startLineNumber, 1, current.startLineNumber, line.length + 1));
  }
  return result;
}

export TextRange createSmartRange(int sl, int sc, int el, int ec) {
  return new TextRange(sl, sc, el, ec);
}
