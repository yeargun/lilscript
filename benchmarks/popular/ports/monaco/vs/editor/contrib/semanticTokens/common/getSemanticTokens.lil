export string SEMANTIC_HIGHLIGHTING_SETTING_ID = "editor.semanticHighlighting";

export class SemanticToken {
  int line;
  int startChar;
  int length;
  int tokenType;
  int tokenModifiers;

  init(int line, int startChar, int length, int tokenType, int tokenModifiers) {
    this.line = line;
    this.startChar = startChar;
    this.length = length;
    this.tokenType = tokenType;
    this.tokenModifiers = tokenModifiers;
  }
}

export SemanticToken[] decodeSemanticTokens(int[] data) {
  SemanticToken[] tokens = [];
  int i = 0;
  int line = 0;
  int start = 0;
  while (i + 4 < data.length) {
    line = line + data[i];
    if (data[i] != 0) {
      start = 0;
    }
    start = start + data[i + 1];
    tokens.push(new SemanticToken(line, start, data[i + 2], data[i + 3], data[i + 4]));
    i = i + 5;
  }
  return tokens;
}

export SemanticToken[] tokensInViewport(SemanticToken[] tokens, int startLine, int endLine) {
  SemanticToken[] result = [];
  int i = 0;
  while (i < tokens.length) {
    if (tokens[i].line >= startLine && tokens[i].line <= endLine) {
      result.push(tokens[i]);
    }
    i = i + 1;
  }
  return result;
}

export bool isSemanticColoringEnabled(bool setting, bool themeEnabled) {
  return setting && themeEnabled;
}

export SemanticToken createSemanticToken(int line, int startChar, int length, int tokenType) {
  return new SemanticToken(line, startChar, length, tokenType, 0);
}
