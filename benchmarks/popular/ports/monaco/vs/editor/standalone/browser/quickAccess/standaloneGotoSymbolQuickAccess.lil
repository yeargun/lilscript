export class StandaloneGotoSymbolQuickAccess {
  string prefix;
  string[] symbols;

  init() {
    this.prefix = "@";
    this.symbols = [];
  }

  void setSymbols(string[] symbols) {
    this.symbols = symbols;
  }

  string[] getPicks(string filter) {
    string q = filter;
    if (q.length > 0 && q.charAt(0) == "@") {
      string rest = "";
      int i = 1;
      while (i < q.length) {
        rest = rest + q.charAt(i);
        i = i + 1;
      }
      q = rest;
    }
    string[] out = [];
    int n = 0;
    while (n < this.symbols.length) {
      if (q.length == 0 || this.symbols[n].toLowerCase().includes(q.toLowerCase())) {
        out.push(this.symbols[n]);
      }
      n = n + 1;
    }
    return out;
  }
}

export StandaloneGotoSymbolQuickAccess createStandaloneGotoSymbolQuickAccess() {
  return new StandaloneGotoSymbolQuickAccess();
}
