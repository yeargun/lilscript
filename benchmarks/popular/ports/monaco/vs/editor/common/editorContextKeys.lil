export class EditorContextKey {
  string key;
  bool defaultValue;
  bool negated;

  init(string key, bool defaultValue, bool negated) {
    this.key = key;
    this.defaultValue = defaultValue;
    this.negated = negated;
  }

  EditorContextKey toNegated() {
    return new EditorContextKey(this.key, !this.defaultValue, !this.negated);
  }

  bool matches(bool value) {
    if (this.negated) {
      return !value;
    }
    return value;
  }
}

