import { lastNonWhitespaceIndex } from "../../../base/common/strings";
import { editDelete } from "../core/editOperation";
import { IdentifiedSingleEdit } from "../core/editOperation";
import { Pos } from "../../../../base/position";
import { createRange } from "../../../../base/range";

void sortCursors(Pos[] cursors) {
  int i = 1;
  while (i < cursors.length) {
    Pos key = cursors[i];
    int j = i - 1;
    while (j >= 0) {
      bool after = false;
      if (cursors[j].lineNumber == key.lineNumber) {
        after = cursors[j].column > key.column;
      } else {
        after = cursors[j].lineNumber > key.lineNumber;
      }
      if (!after) {
        break;
      }
      cursors[j + 1] = cursors[j];
      j = j - 1;
    }
    cursors[j + 1] = key;
    i = i + 1;
  }
}

export IdentifiedSingleEdit[] trimTrailingWhitespace(string[] lines, Pos[] cursors) {
  sortCursors(cursors);
  int i = cursors.length - 2;
  while (i >= 0) {
    if (cursors[i].lineNumber == cursors[i + 1].lineNumber) {
      cursors.splice(i, 1);
    }
    i = i - 1;
  }
  IdentifiedSingleEdit[] r = [];
  int cursorIndex = 0;
  int cursorLen = cursors.length;
  int lineNumber = 1;
  while (lineNumber <= lines.length) {
    string lineContent = lines[lineNumber - 1];
    int maxLineColumn = lineContent.length + 1;
    int minEditColumn = 0;
    if (cursorIndex < cursorLen && cursors[cursorIndex].lineNumber == lineNumber) {
      minEditColumn = cursors[cursorIndex].column;
      cursorIndex = cursorIndex + 1;
      if (minEditColumn == maxLineColumn) {
        lineNumber = lineNumber + 1;
        continue;
      }
    }
    if (lineContent.length == 0) {
      lineNumber = lineNumber + 1;
      continue;
    }
    int lastWs = lastNonWhitespaceIndex(lineContent, lineContent.length - 1);
    int fromColumn = 0;
    if (lastWs == -1) {
      fromColumn = 1;
    } else if (lastWs != lineContent.length - 1) {
      fromColumn = lastWs + 2;
    } else {
      lineNumber = lineNumber + 1;
      continue;
    }
    if (minEditColumn > fromColumn) {
      fromColumn = minEditColumn;
    }
    r.push(editDelete(createRange(lineNumber, fromColumn, lineNumber, maxLineColumn)));
    lineNumber = lineNumber + 1;
  }
  return r;
}
