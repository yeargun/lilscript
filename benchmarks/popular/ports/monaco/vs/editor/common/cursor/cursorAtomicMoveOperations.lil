export enum AtomicTabDirection {
  Left,
  Right,
  Nearest
}

int atomicNextTabStop(int visibleColumn, int tabSize) {
  if (tabSize <= 0) {
    return visibleColumn + 1;
  }
  return visibleColumn + tabSize - visibleColumn % tabSize;
}

export int[] whitespaceVisibleColumn(string lineContent, int position, int tabSize) {
  int visibleColumn = 0;
  int previousTabStopPosition = -1;
  int previousTabStopVisibleColumn = -1;
  int i = 0;
  while (i < lineContent.length) {
    if (i == position) {
      return [previousTabStopPosition, previousTabStopVisibleColumn, visibleColumn];
    }
    if (tabSize > 0 && visibleColumn % tabSize == 0) {
      previousTabStopPosition = i;
      previousTabStopVisibleColumn = visibleColumn;
    }
    int code = lineContent.charCodeAt(i);
    if (code == 32) {
      visibleColumn = visibleColumn + 1;
    } else if (code == 9) {
      visibleColumn = atomicNextTabStop(visibleColumn, tabSize);
    } else {
      return [-1, -1, -1];
    }
    i = i + 1;
  }
  if (position == lineContent.length) {
    return [previousTabStopPosition, previousTabStopVisibleColumn, visibleColumn];
  }
  return [-1, -1, -1];
}

export int atomicPosition(
  string lineContent,
  int position,
  int tabSize,
  AtomicTabDirection direction
) {
  int[] columns = whitespaceVisibleColumn(lineContent, position, tabSize);
  int previousPosition = columns[0];
  int previousVisibleColumn = columns[1];
  int visibleColumn = columns[2];
  if (visibleColumn < 0) {
    return -1;
  }
  bool moveLeft = false;
  if (direction == AtomicTabDirection.Left) {
    moveLeft = true;
  } else if (direction == AtomicTabDirection.Right) {
    moveLeft = false;
  } else {
    if (tabSize > 0 && visibleColumn % tabSize == 0) {
      return position;
    }
    moveLeft = tabSize > 0 && visibleColumn % tabSize <= tabSize / 2;
  }
  if (moveLeft) {
    if (previousPosition < 0) {
      return -1;
    }
    int currentVisibleColumn = previousVisibleColumn;
    int i = previousPosition;
    while (i < lineContent.length) {
      if (currentVisibleColumn == previousVisibleColumn + tabSize) {
        return previousPosition;
      }
      int code = lineContent.charCodeAt(i);
      if (code == 32) {
        currentVisibleColumn = currentVisibleColumn + 1;
      } else if (code == 9) {
        currentVisibleColumn = atomicNextTabStop(currentVisibleColumn, tabSize);
      } else {
        return -1;
      }
      i = i + 1;
    }
    if (currentVisibleColumn == previousVisibleColumn + tabSize) {
      return previousPosition;
    }
    return -1;
  }
  int targetVisibleColumn = atomicNextTabStop(visibleColumn, tabSize);
  int currentVisibleColumn = visibleColumn;
  int i = position;
  while (i < lineContent.length) {
    if (currentVisibleColumn == targetVisibleColumn) {
      return i;
    }
    int code = lineContent.charCodeAt(i);
    if (code == 32) {
      currentVisibleColumn = currentVisibleColumn + 1;
    } else if (code == 9) {
      currentVisibleColumn = atomicNextTabStop(currentVisibleColumn, tabSize);
    } else {
      return -1;
    }
    i = i + 1;
  }
  if (currentVisibleColumn == targetVisibleColumn) {
    return lineContent.length;
  }
  return -1;
}
