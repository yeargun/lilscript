export class EditorWhitespace {
  int id;
  int afterLineNumber;
  int ordinal;
  int height;
  int minWidth;
  int prefixSum;

  init(int id, int afterLineNumber, int ordinal, int height, int minWidth) {
    this.id = id;
    this.afterLineNumber = afterLineNumber;
    this.ordinal = ordinal;
    this.height = height;
    this.minWidth = minWidth;
    this.prefixSum = 0;
  }
}

export class LayoutLineHeight {
  string decorationId;
  int startLineNumber;
  int endLineNumber;
  int lineHeight;

  init(string decorationId, int startLineNumber, int endLineNumber, int lineHeight) {
    this.decorationId = decorationId;
    this.startLineNumber = startLineNumber;
    this.endLineNumber = endLineNumber;
    this.lineHeight = lineHeight;
  }
}

export class LinesViewportData {
  int startLineNumber;
  int endLineNumber;
  int[] relativeVerticalOffset;
  int centeredLineNumber;
  int completelyVisibleStartLineNumber;
  int completelyVisibleEndLineNumber;
  int lineHeight;
  int bigNumbersDelta;

  init(int startLineNumber, int endLineNumber, int[] relativeVerticalOffset, int centeredLineNumber, int completelyVisibleStartLineNumber, int completelyVisibleEndLineNumber, int lineHeight, int bigNumbersDelta) {
    this.startLineNumber = startLineNumber;
    this.endLineNumber = endLineNumber;
    this.relativeVerticalOffset = relativeVerticalOffset;
    this.centeredLineNumber = centeredLineNumber;
    this.completelyVisibleStartLineNumber = completelyVisibleStartLineNumber;
    this.completelyVisibleEndLineNumber = completelyVisibleEndLineNumber;
    this.lineHeight = lineHeight;
    this.bigNumbersDelta = bigNumbersDelta;
  }
}

export class WhitespaceViewportData {
  int id;
  int afterLineNumber;
  int verticalOffset;
  int height;

  init(int id, int afterLineNumber, int verticalOffset, int height) {
    this.id = id;
    this.afterLineNumber = afterLineNumber;
    this.verticalOffset = verticalOffset;
    this.height = height;
  }
}

export class LinesLayout {
  int lineCount;
  int defaultLineHeight;
  int paddingTop;
  int paddingBottom;
  int lastWhitespaceId;
  EditorWhitespace[] whitespaces;
  LayoutLineHeight[] customLineHeights;

  init(int lineCount, int defaultLineHeight, int paddingTop, int paddingBottom) {
    this.lineCount = lineCount;
    this.defaultLineHeight = defaultLineHeight;
    this.paddingTop = paddingTop;
    this.paddingBottom = paddingBottom;
    this.lastWhitespaceId = 0;
    this.whitespaces = [];
    this.customLineHeights = [];
  }

  int compareWhitespace(EditorWhitespace a, EditorWhitespace b) {
    if (a.afterLineNumber != b.afterLineNumber) {
      return a.afterLineNumber - b.afterLineNumber;
    }
    return a.ordinal - b.ordinal;
  }

  void sortWhitespaces() {
    int i = 1;
    while (i < this.whitespaces.length) {
      EditorWhitespace key = this.whitespaces[i];
      int j = i - 1;
      while (j >= 0 && this.compareWhitespace(this.whitespaces[j], key) > 0) {
        this.whitespaces[j + 1] = this.whitespaces[j];
        j = j - 1;
      }
      this.whitespaces[j + 1] = key;
      i = i + 1;
    }
    this.recomputeWhitespacePrefixSums();
  }

  void recomputeWhitespacePrefixSums() {
    int total = 0;
    int i = 0;
    while (i < this.whitespaces.length) {
      total = total + this.whitespaces[i].height;
      this.whitespaces[i].prefixSum = total;
      i = i + 1;
    }
  }

  int insertWhitespace(int afterLineNumber, int ordinal, int heightInPx, int minWidth) {
    this.lastWhitespaceId = this.lastWhitespaceId + 1;
    this.whitespaces.push(new EditorWhitespace(this.lastWhitespaceId, afterLineNumber, ordinal, heightInPx, minWidth));
    this.sortWhitespaces();
    return this.lastWhitespaceId;
  }

  bool changeOneWhitespace(int id, int newAfterLineNumber, int newHeight) {
    int i = 0;
    while (i < this.whitespaces.length) {
      if (this.whitespaces[i].id == id) {
        this.whitespaces[i].afterLineNumber = newAfterLineNumber;
        this.whitespaces[i].height = newHeight;
        this.sortWhitespaces();
        return true;
      }
      i = i + 1;
    }
    return false;
  }

  bool removeWhitespace(int id) {
    int i = 0;
    while (i < this.whitespaces.length) {
      if (this.whitespaces[i].id == id) {
        this.whitespaces.splice(i, 1);
        this.recomputeWhitespacePrefixSums();
        return true;
      }
      i = i + 1;
    }
    return false;
  }

  void insertOrChangeCustomLineHeight(string decorationId, int startLineNumber, int endLineNumber, int lineHeight) {
    this.removeCustomLineHeight(decorationId);
    this.customLineHeights.push(new LayoutLineHeight(decorationId, startLineNumber, endLineNumber, lineHeight));
  }

  void removeCustomLineHeight(string decorationId) {
    int i = this.customLineHeights.length - 1;
    while (i >= 0) {
      if (this.customLineHeights[i].decorationId == decorationId) {
        this.customLineHeights.splice(i, 1);
      }
      i = i - 1;
    }
  }

  void setDefaultLineHeight(int lineHeight) {
    this.defaultLineHeight = lineHeight;
  }

  void setPadding(int paddingTop, int paddingBottom) {
    this.paddingTop = paddingTop;
    this.paddingBottom = paddingBottom;
  }

  void onFlushed(int lineCount) {
    this.lineCount = lineCount;
  }

  int getLineHeightForLineNumber(int lineNumber) {
    int height = this.defaultLineHeight;
    int i = 0;
    while (i < this.customLineHeights.length) {
      LayoutLineHeight custom = this.customLineHeights[i];
      if (lineNumber >= custom.startLineNumber && lineNumber <= custom.endLineNumber && custom.lineHeight > height) {
        height = custom.lineHeight;
      }
      i = i + 1;
    }
    return height;
  }

  int getAccumulatedLineHeight(int lineNumber) {
    int total = 0;
    int i = 1;
    while (i <= lineNumber) {
      total = total + this.getLineHeightForLineNumber(i);
      i = i + 1;
    }
    return total;
  }

  int getWhitespaceAccumulatedHeightBeforeLineNumber(int lineNumber) {
    int total = 0;
    int i = 0;
    while (i < this.whitespaces.length && this.whitespaces[i].afterLineNumber < lineNumber) {
      total = total + this.whitespaces[i].height;
      i = i + 1;
    }
    return total;
  }

  int getVerticalOffsetForLineNumber(int lineNumber, bool includeViewZones = false) {
    int target = lineNumber;
    if (target < 1) {
      target = 1;
    }
    if (target > this.lineCount) {
      target = this.lineCount;
    }
    int whitespaceLine = target;
    if (includeViewZones) {
      whitespaceLine = target - 1;
    }
    return this.paddingTop + this.getAccumulatedLineHeight(target - 1) + this.getWhitespaceAccumulatedHeightBeforeLineNumber(whitespaceLine);
  }

  int getVerticalOffsetAfterLineNumber(int lineNumber, bool includeViewZones = false) {
    int whitespaceLine = lineNumber;
    if (includeViewZones) {
      whitespaceLine = lineNumber + 1;
    }
    return this.paddingTop + this.getAccumulatedLineHeight(lineNumber) + this.getWhitespaceAccumulatedHeightBeforeLineNumber(whitespaceLine);
  }

  int getWhitespacesTotalHeight() {
    if (this.whitespaces.length == 0) {
      return 0;
    }
    return this.whitespaces[this.whitespaces.length - 1].prefixSum;
  }

  int getLinesTotalHeight() {
    return this.paddingTop + this.getAccumulatedLineHeight(this.lineCount) + this.getWhitespacesTotalHeight() + this.paddingBottom;
  }

  int getWhitespaceMinWidth() {
    int width = 0;
    int i = 0;
    while (i < this.whitespaces.length) {
      if (this.whitespaces[i].minWidth > width) {
        width = this.whitespaces[i].minWidth;
      }
      i = i + 1;
    }
    return width;
  }

  int getLineNumberAtOrAfterVerticalOffset(int verticalOffset) {
    if (verticalOffset <= this.paddingTop) {
      return 1;
    }
    int low = 1;
    int high = this.lineCount;
    while (low < high) {
      int mid = (low + high) / 2;
      int top = this.getVerticalOffsetForLineNumber(mid);
      int bottom = top + this.getLineHeightForLineNumber(mid);
      if (verticalOffset >= bottom) {
        low = mid + 1;
      } else {
        high = mid;
      }
    }
    return low;
  }

  LinesViewportData getLinesViewportData(int verticalOffset1, int verticalOffset2) {
    int startLine = this.getLineNumberAtOrAfterVerticalOffset(verticalOffset1);
    int endLine = startLine;
    int[] offsets = [];
    int current = startLine;
    while (current <= this.lineCount) {
      int top = this.getVerticalOffsetForLineNumber(current);
      offsets.push(top);
      endLine = current;
      if (top + this.getLineHeightForLineNumber(current) >= verticalOffset2) {
        break;
      }
      current = current + 1;
    }
    int completeStart = startLine;
    if (this.getVerticalOffsetForLineNumber(startLine) < verticalOffset1 && completeStart < endLine) {
      completeStart = completeStart + 1;
    }
    int completeEnd = endLine;
    if (this.getVerticalOffsetForLineNumber(endLine) + this.getLineHeightForLineNumber(endLine) > verticalOffset2 && completeEnd > completeStart) {
      completeEnd = completeEnd - 1;
    }
    int centerOffset = verticalOffset1 + (verticalOffset2 - verticalOffset1) / 2;
    int centered = this.getLineNumberAtOrAfterVerticalOffset(centerOffset);
    int bigNumbersDelta = 0;
    int firstTop = this.getVerticalOffsetForLineNumber(startLine);
    if (firstTop >= 500000) {
      bigNumbersDelta = (firstTop / 500000) * 500000;
      bigNumbersDelta = (bigNumbersDelta / this.defaultLineHeight) * this.defaultLineHeight;
      int i = 0;
      while (i < offsets.length) {
        offsets[i] = offsets[i] - bigNumbersDelta;
        i = i + 1;
      }
    }
    return new LinesViewportData(startLine, endLine, offsets, centered, completeStart, completeEnd, this.defaultLineHeight, bigNumbersDelta);
  }

  int getVerticalOffsetForWhitespaceIndex(int whitespaceIndex) {
    EditorWhitespace whitespace = this.whitespaces[whitespaceIndex];
    int previousWhitespace = whitespace.prefixSum - whitespace.height;
    return this.paddingTop + this.getAccumulatedLineHeight(whitespace.afterLineNumber) + previousWhitespace;
  }

  WhitespaceViewportData? getWhitespaceAtVerticalOffset(int verticalOffset) {
    int i = 0;
    while (i < this.whitespaces.length) {
      int top = this.getVerticalOffsetForWhitespaceIndex(i);
      if (verticalOffset >= top && verticalOffset < top + this.whitespaces[i].height) {
        return new WhitespaceViewportData(this.whitespaces[i].id, this.whitespaces[i].afterLineNumber, top, this.whitespaces[i].height);
      }
      if (top > verticalOffset) {
        return null;
      }
      i = i + 1;
    }
    return null;
  }

  WhitespaceViewportData[] getWhitespaceViewportData(int verticalOffset1, int verticalOffset2) {
    WhitespaceViewportData[] result = [];
    int i = 0;
    while (i < this.whitespaces.length) {
      int top = this.getVerticalOffsetForWhitespaceIndex(i);
      int bottom = top + this.whitespaces[i].height;
      if (bottom > verticalOffset1 && top < verticalOffset2) {
        result.push(new WhitespaceViewportData(this.whitespaces[i].id, this.whitespaces[i].afterLineNumber, top, this.whitespaces[i].height));
      }
      i = i + 1;
    }
    return result;
  }

  void onLinesDeleted(int fromLineNumber, int toLineNumber) {
    int count = toLineNumber - fromLineNumber + 1;
    this.lineCount = this.lineCount - count;
    int i = 0;
    while (i < this.whitespaces.length) {
      if (this.whitespaces[i].afterLineNumber >= fromLineNumber && this.whitespaces[i].afterLineNumber <= toLineNumber) {
        this.whitespaces[i].afterLineNumber = fromLineNumber - 1;
      } else {
        if (this.whitespaces[i].afterLineNumber > toLineNumber) {
          this.whitespaces[i].afterLineNumber = this.whitespaces[i].afterLineNumber - count;
        }
      }
      i = i + 1;
    }
    i = 0;
    while (i < this.customLineHeights.length) {
      LayoutLineHeight custom = this.customLineHeights[i];
      if (custom.startLineNumber > toLineNumber) {
        custom.startLineNumber = custom.startLineNumber - count;
        custom.endLineNumber = custom.endLineNumber - count;
      } else {
        if (custom.endLineNumber >= fromLineNumber) {
          custom.endLineNumber = custom.endLineNumber - count;
          if (custom.endLineNumber < fromLineNumber) {
            custom.endLineNumber = fromLineNumber;
          }
        }
      }
      i = i + 1;
    }
    this.sortWhitespaces();
  }

  void onLinesInserted(int fromLineNumber, int toLineNumber) {
    int count = toLineNumber - fromLineNumber + 1;
    this.lineCount = this.lineCount + count;
    int i = 0;
    while (i < this.whitespaces.length) {
      if (this.whitespaces[i].afterLineNumber >= fromLineNumber) {
        this.whitespaces[i].afterLineNumber = this.whitespaces[i].afterLineNumber + count;
      }
      i = i + 1;
    }
    i = 0;
    while (i < this.customLineHeights.length) {
      LayoutLineHeight custom = this.customLineHeights[i];
      if (custom.startLineNumber >= fromLineNumber) {
        custom.startLineNumber = custom.startLineNumber + count;
        custom.endLineNumber = custom.endLineNumber + count;
      } else {
        if (custom.endLineNumber >= fromLineNumber - 1) {
          custom.endLineNumber = custom.endLineNumber + count;
        }
      }
      i = i + 1;
    }
    this.sortWhitespaces();
  }

  bool isAfterLines(int verticalOffset) {
    return verticalOffset > this.getLinesTotalHeight();
  }

  bool isInTopPadding(int verticalOffset) {
    return this.paddingTop > 0 && verticalOffset < this.paddingTop;
  }

  bool isInBottomPadding(int verticalOffset) {
    return this.paddingBottom > 0 && verticalOffset >= this.getLinesTotalHeight() - this.paddingBottom;
  }

  int getWhitespacesCount() {
    return this.whitespaces.length;
  }
}

export LinesLayout createLinesLayout(int lineCount, int defaultLineHeight, int paddingTop = 0, int paddingBottom = 0) {
  return new LinesLayout(lineCount, defaultLineHeight, paddingTop, paddingBottom);
}

export LayoutLineHeight createLayoutLineHeight(string decorationId, int startLineNumber, int endLineNumber, int lineHeight) {
  return new LayoutLineHeight(decorationId, startLineNumber, endLineNumber, lineHeight);
}
