export class ColorZone {
  int from;
  int to;
  int colorId;

  init(int from, int to, int colorId) {
    this.from = from;
    this.to = to;
    this.colorId = colorId;
  }
}

export class OverviewRulerZone {
  int startLineNumber;
  int endLineNumber;
  int heightInLines;
  string color;
  ColorZone? colorZone;

  init(int startLineNumber, int endLineNumber, int heightInLines, string color) {
    this.startLineNumber = startLineNumber;
    this.endLineNumber = endLineNumber;
    this.heightInLines = heightInLines;
    this.color = color;
    this.colorZone = null;
  }
}

export class OverviewZoneManager {
  func(int)->int getVerticalOffsetForLine;
  OverviewRulerZone[] zones;
  int lineHeight;
  int domWidth;
  int domHeight;
  int outerHeight;
  float pixelRatio;
  string[] colors;

  init(func(int)->int getVerticalOffsetForLine) {
    this.getVerticalOffsetForLine = getVerticalOffsetForLine;
    this.zones = [];
    this.lineHeight = 0;
    this.domWidth = 0;
    this.domHeight = 0;
    this.outerHeight = 0;
    this.pixelRatio = 1.0;
    this.colors = [""];
  }

  void setZones(OverviewRulerZone[] zones) {
    this.zones = zones;
    int i = 1;
    while (i < this.zones.length) {
      OverviewRulerZone key = this.zones[i];
      int j = i - 1;
      while (j >= 0 && this.compareZones(this.zones[j], key) > 0) {
        this.zones[j + 1] = this.zones[j];
        j = j - 1;
      }
      this.zones[j + 1] = key;
      i = i + 1;
    }
  }

  int compareZones(OverviewRulerZone a, OverviewRulerZone b) {
    if (a.color < b.color) {
      return -1;
    }
    if (a.color > b.color) {
      return 1;
    }
    if (a.startLineNumber != b.startLineNumber) {
      return a.startLineNumber - b.startLineNumber;
    }
    if (a.heightInLines != b.heightInLines) {
      return a.heightInLines - b.heightInLines;
    }
    return a.endLineNumber - b.endLineNumber;
  }

  int compareColorZones(ColorZone a, ColorZone b) {
    if (a.colorId != b.colorId) {
      return a.colorId - b.colorId;
    }
    if (a.from != b.from) {
      return a.from - b.from;
    }
    return a.to - b.to;
  }

  int colorId(string color) {
    int i = 1;
    while (i < this.colors.length) {
      if (this.colors[i] == color) {
        return i;
      }
      i = i + 1;
    }
    this.colors.push(color);
    return this.colors.length - 1;
  }

  bool setLineHeight(int lineHeight) {
    if (this.lineHeight == lineHeight) {
      return false;
    }
    this.lineHeight = lineHeight;
    return true;
  }

  void setPixelRatio(float pixelRatio) {
    this.pixelRatio = pixelRatio;
  }

  bool setDOMWidth(int width) {
    if (this.domWidth == width) {
      return false;
    }
    this.domWidth = width;
    return true;
  }

  bool setDOMHeight(int height) {
    if (this.domHeight == height) {
      return false;
    }
    this.domHeight = height;
    return true;
  }

  bool setOuterHeight(int outerHeight) {
    if (this.outerHeight == outerHeight) {
      return false;
    }
    this.outerHeight = outerHeight;
    return true;
  }

  int getDOMWidth() {
    return this.domWidth;
  }

  int getCanvasWidth() {
    return (this.domWidth * this.pixelRatio).floor().toInt();
  }

  int getDOMHeight() {
    return this.domHeight;
  }

  int getCanvasHeight() {
    return (this.domHeight * this.pixelRatio).floor().toInt();
  }

  int getOuterHeight() {
    return this.outerHeight;
  }

  string[] getId2Color() {
    return this.colors;
  }

  ColorZone[] resolveColorZones() {
    ColorZone[] allZones = [];
    int totalHeight = this.getCanvasHeight();
    float ratio = 0.0;
    if (this.outerHeight > 0) {
      ratio = totalHeight / this.outerHeight;
    }
    int halfMinimumHeight = (4.0 * this.pixelRatio / 2.0).floor().toInt();
    int i = 0;
    while (i < this.zones.length) {
      OverviewRulerZone zone = this.zones[i];
      int offset1 = this.getVerticalOffsetForLine(zone.startLineNumber);
      int offset2 = 0;
      if (zone.heightInLines == 0) {
        offset2 = this.getVerticalOffsetForLine(zone.endLineNumber) + this.lineHeight;
      } else {
        offset2 = offset1 + zone.heightInLines * this.lineHeight;
      }
      int y1 = (ratio * offset1).floor().toInt();
      int y2 = (ratio * offset2).floor().toInt();
      int center = (y1 + y2) / 2;
      int halfHeight = y2 - center;
      if (halfHeight < halfMinimumHeight) {
        halfHeight = halfMinimumHeight;
      }
      if (center - halfHeight < 0) {
        center = halfHeight;
      }
      if (center + halfHeight > totalHeight) {
        center = totalHeight - halfHeight;
      }
      ColorZone colorZone = new ColorZone(center - halfHeight, center + halfHeight, this.colorId(zone.color));
      zone.colorZone = colorZone;
      allZones.push(colorZone);
      i = i + 1;
    }
    i = 1;
    while (i < allZones.length) {
      ColorZone key = allZones[i];
      int j = i - 1;
      while (j >= 0 && this.compareColorZones(allZones[j], key) > 0) {
        allZones[j + 1] = allZones[j];
        j = j - 1;
      }
      allZones[j + 1] = key;
      i = i + 1;
    }
    ColorZone[] merged = [];
    i = 0;
    while (i < allZones.length) {
      ColorZone current = allZones[i];
      if (merged.length > 0 && merged[merged.length - 1].colorId == current.colorId && current.from <= merged[merged.length - 1].to + 1) {
        if (current.to > merged[merged.length - 1].to) {
          merged[merged.length - 1].to = current.to;
        }
      } else {
        merged.push(new ColorZone(current.from, current.to, current.colorId));
      }
      i = i + 1;
    }
    return merged;
  }
}

export OverviewZoneManager createOverviewZoneManager(func(int)->int getVerticalOffsetForLine) {
  return new OverviewZoneManager(getVerticalOffsetForLine);
}

export OverviewRulerZone createOverviewRulerZone(int startLineNumber, int endLineNumber, int heightInLines, string color) {
  return new OverviewRulerZone(startLineNumber, endLineNumber, heightInLines, color);
}

export ColorZone createColorZone(int from, int to, int colorId) {
  return new ColorZone(from, to, colorId);
}
