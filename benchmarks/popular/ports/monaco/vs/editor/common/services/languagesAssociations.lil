import { hostCall, jsUndefined, regexTest, sliceOf } from "../../../../js-host";

class LanguageAssociation {
  string id;
  string mime;
  string filename;
  string extension;
  string filepattern;
  JsValue firstline;

  init(JsValue source) {
    this.id = JS.string(source["id"]);
    this.mime = JS.string(source["mime"]);
    this.filename = "";
    this.extension = "";
    this.filepattern = "";
    this.firstline = source["firstline"];
    if (source["filename"] != null) {
      this.filename = JS.string(source["filename"]).toLowerCase();
    }
    if (source["extension"] != null) {
      this.extension = JS.string(source["extension"]).toLowerCase();
    }
    if (source["filepattern"] != null) {
      this.filepattern = JS.string(source["filepattern"]).toLowerCase();
    }
  }
}

LanguageAssociation[] registeredAssociations = [];

bool globMatches(string pattern, string value) {
  int patternIndex = 0;
  int valueIndex = 0;
  int star = -1;
  int retry = 0;
  while (valueIndex < value.length) {
    if (patternIndex < pattern.length &&
      (pattern.charCodeAt(patternIndex) == 63 ||
        pattern.charCodeAt(patternIndex) == value.charCodeAt(valueIndex))) {
      patternIndex = patternIndex + 1;
      valueIndex = valueIndex + 1;
    } else if (patternIndex < pattern.length && pattern.charCodeAt(patternIndex) == 42) {
      star = patternIndex;
      retry = valueIndex;
      patternIndex = patternIndex + 1;
    } else if (star >= 0) {
      retry = retry + 1;
      valueIndex = retry;
      patternIndex = star + 1;
    } else {
      return false;
    }
  }
  while (patternIndex < pattern.length && pattern.charCodeAt(patternIndex) == 42) {
    patternIndex = patternIndex + 1;
  }
  return patternIndex == pattern.length;
}

export void registerPlatformLanguageAssociation(JsValue association, bool warnOnOverwrite = false) {
  registeredAssociations.push(new LanguageAssociation(association));
}

export void clearPlatformLanguageAssociations() {
  registeredAssociations = [];
}

export string[] getLanguageIds(JsValue resource, string firstLine = "") {
  string[] result = [];
  string path = "";
  if (resource != null) {
    if (resource["fsPath"] != null) {
      path = JS.string(resource["fsPath"]);
    } else if (resource["path"] != null) {
      path = JS.string(resource["path"]);
    }
  }
  path = path.toLowerCase();
  int slash = path.lastIndexOf("/");
  string filename = path;
  if (slash >= 0) {
    filename = sliceOf(path, slash + 1, path.length);
  }
  LanguageAssociation? exact = null;
  LanguageAssociation? pattern = null;
  LanguageAssociation? extension = null;
  int i = registeredAssociations.length - 1;
  while (i >= 0) {
    LanguageAssociation association = registeredAssociations[i];
    if (exact == null && association.filename.length > 0 && association.filename == filename) {
      exact = association;
    }
    if (pattern == null && association.filepattern.length > 0 &&
      globMatches(association.filepattern, filename)) {
      pattern = association;
    }
    if (association.extension.length > 0 && filename.endsWith(association.extension)) {
      if (extension == null || association.extension.length > extension.extension.length) {
        extension = association;
      }
    }
    i = i - 1;
  }
  LanguageAssociation? selected = exact;
  if (selected == null) {
    selected = pattern;
  }
  if (selected == null) {
    selected = extension;
  }
  if (selected == null && firstLine.length > 0) {
    i = registeredAssociations.length - 1;
    while (i >= 0) {
      LanguageAssociation association = registeredAssociations[i];
      if (association.firstline != null &&
        hostCall(association.firstline, "test", firstLine, jsUndefined(), jsUndefined()).truthy()) {
        selected = association;
        break;
      }
      i = i - 1;
    }
  }
  if (selected != null) {
    result.push(selected.id);
    result.push("plaintext");
  } else {
    result.push("unknown");
  }
  return result;
}
