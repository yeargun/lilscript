    this.documentSymbolProvider = new LanguageFeatureRegistry();
    this.inlayHintsProvider = new LanguageFeatureRegistry();
    this.colorProvider = new LanguageFeatureRegistry();
    this.codeLensProvider = new LanguageFeatureRegistry();
    this.documentFormattingEditProvider = new LanguageFeatureRegistry();
    this.documentRangeFormattingEditProvider = new LanguageFeatureRegistry();
    this.onTypeFormattingEditProvider = new LanguageFeatureRegistry();
    this.signatureHelpProvider = new LanguageFeatureRegistry();
    this.hoverProvider = new LanguageFeatureRegistry();
    this.documentHighlightProvider = new LanguageFeatureRegistry();
    this.multiDocumentHighlightProvider = new LanguageFeatureRegistry();
    this.selectionRangeProvider = new LanguageFeatureRegistry();
    this.foldingRangeProvider = new LanguageFeatureRegistry();
    this.linkProvider = new LanguageFeatureRegistry();
    this.inlineCompletionsProvider = new LanguageFeatureRegistry();
    this.completionProvider = new LanguageFeatureRegistry();
    this.linkedEditingRangeProvider = new LanguageFeatureRegistry();
    this.documentRangeSemanticTokensProvider = new LanguageFeatureRegistry();
    this.documentSemanticTokensProvider = new LanguageFeatureRegistry();
    this.documentDropEditProvider = new LanguageFeatureRegistry();
