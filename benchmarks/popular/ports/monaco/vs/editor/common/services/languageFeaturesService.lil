import { LanguageFeatureRegistry } from "../languageFeatureRegistry";

export class LanguageFeaturesService {
  LanguageFeatureRegistry referenceProvider;
  LanguageFeatureRegistry renameProvider;
  LanguageFeatureRegistry newSymbolNamesProvider;
  LanguageFeatureRegistry codeActionProvider;
  LanguageFeatureRegistry definitionProvider;
  LanguageFeatureRegistry typeDefinitionProvider;
  LanguageFeatureRegistry declarationProvider;
  LanguageFeatureRegistry implementationProvider;
  LanguageFeatureRegistry documentSymbolProvider;
  LanguageFeatureRegistry inlayHintsProvider;
  LanguageFeatureRegistry colorProvider;
  LanguageFeatureRegistry codeLensProvider;
  LanguageFeatureRegistry documentFormattingEditProvider;
  LanguageFeatureRegistry documentRangeFormattingEditProvider;
  LanguageFeatureRegistry onTypeFormattingEditProvider;
  LanguageFeatureRegistry signatureHelpProvider;
  LanguageFeatureRegistry hoverProvider;
  LanguageFeatureRegistry documentHighlightProvider;
