  LanguageFeatureRegistry linkedEditingRangeProvider;
  LanguageFeatureRegistry documentRangeSemanticTokensProvider;
  LanguageFeatureRegistry documentSemanticTokensProvider;
  LanguageFeatureRegistry documentDropEditProvider;
  LanguageFeatureRegistry documentPasteEditProvider;

  init() {
    this.referenceProvider = new LanguageFeatureRegistry();
    this.renameProvider = new LanguageFeatureRegistry();
    this.newSymbolNamesProvider = new LanguageFeatureRegistry();
    this.codeActionProvider = new LanguageFeatureRegistry();
    this.definitionProvider = new LanguageFeatureRegistry();
