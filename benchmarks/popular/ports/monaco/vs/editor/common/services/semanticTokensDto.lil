export int[] encodeSemanticTokensDto(JsValue semanticTokens) {
  int[] result = [];
  result.push(JS.number(semanticTokens["id"]).toInt());
  string type = JS.string(semanticTokens["type"]);
  if (type == "full") {
    result.push(1);
    JsValue data = semanticTokens["data"];
    int length = JS.number(data["length"]).toInt();
    result.push(length);
    int i = 0;
    while (i < length) {
      result.push(JS.number(data[i]).toInt());
      i = i + 1;
    }
    return result;
  }
  result.push(2);
  JsValue deltas = semanticTokens["deltas"];
  int deltaCount = JS.number(deltas["length"]).toInt();
  result.push(deltaCount);
  int i = 0;
  while (i < deltaCount) {
    JsValue delta = deltas[i];
    result.push(JS.number(delta["start"]).toInt());
    result.push(JS.number(delta["deleteCount"]).toInt());
    JsValue data = delta["data"];
    int length = 0;
    if (data != null) {
      length = JS.number(data["length"]).toInt();
    }
    result.push(length);
    int j = 0;
    while (j < length) {
      result.push(JS.number(data[j]).toInt());
      j = j + 1;
    }
    i = i + 1;
  }
  return result;
}
