import { OffsetRange } from "../../../core/ranges/offsetRange";
import { Array2D } from "../utils";
import { DiffAlgorithmResult, SequenceDiff, trivialDiff } from "./diffAlgorithm";

export class DynamicProgrammingDiffing {
  DiffAlgorithmResult compute(int[] sequence1, int[] sequence2) {
    if (sequence1.length == 0 || sequence2.length == 0) {
      return trivialDiff(sequence1.length, sequence2.length);
    }
    Array2D lengths = new Array2D(sequence1.length + 1, sequence2.length + 1);
    int i = 1;
    while (i <= sequence1.length) {
      int j = 1;
      while (j <= sequence2.length) {
        if (sequence1[i - 1] == sequence2[j - 1]) {
          lengths.set(i, j, lengths.get(i - 1, j - 1) + 1.0);
        } else {
          float above = lengths.get(i - 1, j);
          float left = lengths.get(i, j - 1);
          if (above >= left) {
            lengths.set(i, j, above);
          } else {
            lengths.set(i, j, left);
          }
        }
        j = j + 1;
      }
      i = i + 1;
    }
    int[] matched1Reversed = [];
    int[] matched2Reversed = [];
    i = sequence1.length;
    int j = sequence2.length;
    while (i > 0 && j > 0) {
      if (sequence1[i - 1] == sequence2[j - 1]) {
        matched1Reversed.push(i - 1);
        matched2Reversed.push(j - 1);
        i = i - 1;
        j = j - 1;
      } else if (lengths.get(i - 1, j) >= lengths.get(i, j - 1)) {
        i = i - 1;
      } else {
        j = j - 1;
      }
    }
    SequenceDiff[] result = [];
    int previous1 = 0;
    int previous2 = 0;
    int matchIndex = matched1Reversed.length - 1;
    while (matchIndex >= 0) {
      int matched1 = matched1Reversed[matchIndex];
      int matched2 = matched2Reversed[matchIndex];
      if (previous1 != matched1 || previous2 != matched2) {
        result.push(new SequenceDiff(
          new OffsetRange(previous1, matched1),
          new OffsetRange(previous2, matched2)
        ));
      }
      previous1 = matched1 + 1;
      previous2 = matched2 + 1;
      matchIndex = matchIndex - 1;
    }
    if (previous1 != sequence1.length || previous2 != sequence2.length) {
      result.push(new SequenceDiff(
        new OffsetRange(previous1, sequence1.length),
        new OffsetRange(previous2, sequence2.length)
      ));
    }
    return new DiffAlgorithmResult(result, false);
  }
}

export DynamicProgrammingDiffing createDynamicProgrammingDiffing() {
  return new DynamicProgrammingDiffing();
}
