export enum PositionAffinity {
  Left,
  Right,
  None,
  LeftOfInjectedText,
  RightOfInjectedText
}

export enum InjectedTextCursorStops {
  Both,
  Right,
  Left,
  None
}

export class ProjectionPosition {
  int lineNumber;
  int column;

  init(int lineNumber, int column) {
    this.lineNumber = lineNumber;
    this.column = column;
  }
}

export class InjectionOption {
  string content;
  InjectedTextCursorStops cursorStops;

  init(string content, InjectedTextCursorStops cursorStops) {
    this.content = content;
    this.cursorStops = cursorStops;
  }
}

class InjectedTextInfo {
  int injectedTextIndex;
  int offsetInInputWithInjections;
  int length;

  init(int injectedTextIndex, int offsetInInputWithInjections, int length) {
    this.injectedTextIndex = injectedTextIndex;
    this.offsetInInputWithInjections = offsetInInputWithInjections;
    this.length = length;
  }
}

export class InjectedText {
  InjectionOption options;

  init(InjectionOption options) {
    this.options = options;
  }
}

export class OutputPosition {
  int outputLineIndex;
  int outputOffset;

  init(int outputLineIndex, int outputOffset) {
    this.outputLineIndex = outputLineIndex;
    this.outputOffset = outputOffset;
  }

  string toString() {
    return this.outputLineIndex.toString() + ":" + this.outputOffset.toString();
  }

  ProjectionPosition toPosition(int baseLineNumber) {
    return new ProjectionPosition(
      baseLineNumber + this.outputLineIndex,
      this.outputOffset + 1
    );
  }
}

bool hasRightCursorStop(InjectedTextCursorStops cursorStops) {
  return cursorStops == InjectedTextCursorStops.Right
    || cursorStops == InjectedTextCursorStops.Both;
}

bool hasLeftCursorStop(InjectedTextCursorStops cursorStops) {
  return cursorStops == InjectedTextCursorStops.Left
    || cursorStops == InjectedTextCursorStops.Both;
}

export class ModelLineProjectionData {
  int[] injectionOffsets;
  InjectionOption[] injectionOptions;
  int[] breakOffsets;
  int[] breakOffsetsVisibleColumn;
  int wrappedTextIndentLength;

  init(
    int[] injectionOffsets,
    InjectionOption[] injectionOptions,
    int[] breakOffsets,
    int[] breakOffsetsVisibleColumn,
    int wrappedTextIndentLength
  ) {
    this.injectionOffsets = injectionOffsets;
    this.injectionOptions = injectionOptions;
    this.breakOffsets = breakOffsets;
    this.breakOffsetsVisibleColumn = breakOffsetsVisibleColumn;
    this.wrappedTextIndentLength = wrappedTextIndentLength;
  }

  int getOutputLineCount() {
    return this.breakOffsets.length;
  }

  int getMinOutputOffset(int outputLineIndex) {
    if (outputLineIndex > 0) {
      return this.wrappedTextIndentLength;
    }
    return 0;
  }

  int getLineLength(int outputLineIndex) {
    int startOffset = 0;
    if (outputLineIndex > 0) {
      startOffset = this.breakOffsets[outputLineIndex - 1];
    }
    int lineLength = this.breakOffsets[outputLineIndex] - startOffset;
    if (outputLineIndex > 0) {
      lineLength = lineLength + this.wrappedTextIndentLength;
    }
    return lineLength;
  }

  int getMaxOutputOffset(int outputLineIndex) {
    return this.getLineLength(outputLineIndex);
  }

  int translateToInputOffset(int outputLineIndex, int outputOffset) {
    int adjustedOutputOffset = outputOffset;
    if (outputLineIndex > 0) {
      adjustedOutputOffset = adjustedOutputOffset - this.wrappedTextIndentLength;
      if (adjustedOutputOffset < 0) {
        adjustedOutputOffset = 0;
      }
    }
    int offsetWithInjections = adjustedOutputOffset;
    if (outputLineIndex > 0) {
      offsetWithInjections = this.breakOffsets[outputLineIndex - 1] + adjustedOutputOffset;
    }
    int inputOffset = offsetWithInjections;
    int i = 0;
    while (i < this.injectionOffsets.length) {
      if (inputOffset > this.injectionOffsets[i]) {
        int end = this.injectionOffsets[i] + this.injectionOptions[i].content.length;
        if (inputOffset < end) {
          inputOffset = this.injectionOffsets[i];
        } else {
          inputOffset = inputOffset - this.injectionOptions[i].content.length;
        }
      } else {
        break;
      }
      i = i + 1;
    }
    return inputOffset;
  }

  OutputPosition translateToOutputPosition(int inputOffset, PositionAffinity affinity) {
    int inputOffsetWithInjections = inputOffset;
    int i = 0;
    while (i < this.injectionOffsets.length) {
      if (inputOffset < this.injectionOffsets[i]) {
        break;
      }
      if (
        affinity != PositionAffinity.Right
        && inputOffset == this.injectionOffsets[i]
      ) {
        break;
      }
      inputOffsetWithInjections = inputOffsetWithInjections
        + this.injectionOptions[i].content.length;
      i = i + 1;
    }
    return this.offsetInInputWithInjectionsToOutputPosition(
      inputOffsetWithInjections,
      affinity
    );
  }

  OutputPosition offsetInInputWithInjectionsToOutputPosition(
    int inputOffsetWithInjections,
    PositionAffinity affinity
  ) {
    int low = 0;
    int high = this.breakOffsets.length - 1;
    int middle = 0;
    int middleStart = 0;
    while (low <= high) {
      middle = low + ((high - low) / 2);
      int middleStop = this.breakOffsets[middle];
      middleStart = 0;
      if (middle > 0) {
        middleStart = this.breakOffsets[middle - 1];
      }
      if (affinity == PositionAffinity.Left) {
        if (inputOffsetWithInjections <= middleStart) {
          high = middle - 1;
        } else if (inputOffsetWithInjections > middleStop) {
          low = middle + 1;
        } else {
          break;
        }
      } else {
        if (inputOffsetWithInjections < middleStart) {
          high = middle - 1;
        } else if (inputOffsetWithInjections >= middleStop) {
          low = middle + 1;
        } else {
          break;
        }
      }
    }
    int outputOffset = inputOffsetWithInjections - middleStart;
    if (middle > 0) {
      outputOffset = outputOffset + this.wrappedTextIndentLength;
    }
    return new OutputPosition(middle, outputOffset);
  }

  int outputPositionToOffsetInInputWithInjections(int outputLineIndex, int outputOffset) {
    int adjustedOutputOffset = outputOffset;
    if (outputLineIndex > 0) {
      adjustedOutputOffset = adjustedOutputOffset - this.wrappedTextIndentLength;
      if (adjustedOutputOffset < 0) {
        adjustedOutputOffset = 0;
      }
      return this.breakOffsets[outputLineIndex - 1] + adjustedOutputOffset;
    }
    return adjustedOutputOffset;
  }

  InjectedTextInfo? getInjectedTextAtOffset(int offsetInInputWithInjections) {
    int totalInjectedTextLengthBefore = 0;
    int i = 0;
    while (i < this.injectionOffsets.length) {
      int length = this.injectionOptions[i].content.length;
      int start = this.injectionOffsets[i] + totalInjectedTextLengthBefore;
      int end = start + length;
      if (start > offsetInInputWithInjections) {
        break;
      }
      if (offsetInInputWithInjections <= end) {
        return new InjectedTextInfo(i, start, length);
      }
      totalInjectedTextLengthBefore = totalInjectedTextLengthBefore + length;
      i = i + 1;
    }
    return null;
  }

  int normalizeOffsetInInputWithInjectionsAroundInjections(
    int offsetInInputWithInjections,
    PositionAffinity affinity
  ) {
    InjectedTextInfo? injectedText = this.getInjectedTextAtOffset(offsetInInputWithInjections);
    if (injectedText == null) {
      return offsetInInputWithInjections;
    }
    InjectedTextInfo info = injectedText;
    if (affinity == PositionAffinity.None) {
      if (
        offsetInInputWithInjections == info.offsetInInputWithInjections + info.length
        && hasRightCursorStop(this.injectionOptions[info.injectedTextIndex].cursorStops)
      ) {
        return info.offsetInInputWithInjections + info.length;
      }
      int result = info.offsetInInputWithInjections;
      if (hasLeftCursorStop(this.injectionOptions[info.injectedTextIndex].cursorStops)) {
        return result;
      }
      int index = info.injectedTextIndex - 1;
      while (
        index >= 0
        && this.injectionOffsets[index] == this.injectionOffsets[info.injectedTextIndex]
      ) {
        if (hasRightCursorStop(this.injectionOptions[index].cursorStops)) {
          break;
        }
        result = result - this.injectionOptions[index].content.length;
        if (hasLeftCursorStop(this.injectionOptions[index].cursorStops)) {
          break;
        }
        index = index - 1;
      }
      return result;
    }
    if (
      affinity == PositionAffinity.Right
      || affinity == PositionAffinity.RightOfInjectedText
    ) {
      int result = info.offsetInInputWithInjections + info.length;
      int index = info.injectedTextIndex;
      while (
        index + 1 < this.injectionOffsets.length
        && this.injectionOffsets[index + 1] == this.injectionOffsets[index]
      ) {
        result = result + this.injectionOptions[index + 1].content.length;
        index = index + 1;
      }
      return result;
    }
    int result = info.offsetInInputWithInjections;
    int index = info.injectedTextIndex;
    while (
      index > 0
      && this.injectionOffsets[index - 1] == this.injectionOffsets[index]
    ) {
      result = result - this.injectionOptions[index - 1].content.length;
      index = index - 1;
    }
    return result;
  }

  OutputPosition normalizeOutputPosition(
    int outputLineIndex,
    int outputOffset,
    PositionAffinity affinity
  ) {
    int offset = this.outputPositionToOffsetInInputWithInjections(
      outputLineIndex,
      outputOffset
    );
    int normalizedOffset = this.normalizeOffsetInInputWithInjectionsAroundInjections(
      offset,
      affinity
    );
    if (normalizedOffset != offset) {
      return this.offsetInInputWithInjectionsToOutputPosition(normalizedOffset, affinity);
    }
    if (
      affinity == PositionAffinity.Left
      && outputLineIndex > 0
      && outputOffset == this.getMinOutputOffset(outputLineIndex)
    ) {
      return new OutputPosition(
        outputLineIndex - 1,
        this.getMaxOutputOffset(outputLineIndex - 1)
      );
    }
    if (
      affinity == PositionAffinity.Right
      && outputLineIndex < this.getOutputLineCount() - 1
      && outputOffset == this.getMaxOutputOffset(outputLineIndex)
    ) {
      return new OutputPosition(
        outputLineIndex + 1,
        this.getMinOutputOffset(outputLineIndex + 1)
      );
    }
    return new OutputPosition(outputLineIndex, outputOffset);
  }

  InjectedText? getInjectedText(int outputLineIndex, int outputOffset) {
    int offset = this.outputPositionToOffsetInInputWithInjections(
      outputLineIndex,
      outputOffset
    );
    InjectedTextInfo? info = this.getInjectedTextAtOffset(offset);
    if (info == null) {
      return null;
    }
    InjectedTextInfo value = info;
    return new InjectedText(this.injectionOptions[value.injectedTextIndex]);
  }
}
