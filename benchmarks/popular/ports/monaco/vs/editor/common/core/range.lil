pure int rangeMin(int a, int b) {
  if (a < b) {
    return a;
  }
  return b;
}

pure int rangeMax(int a, int b) {
  if (a > b) {
    return a;
  }
  return b;
}

export class Position {
  int lineNumber;
  int column;

  init(int lineNumber, int column) {
    this.lineNumber = lineNumber;
    this.column = column;
  }

  bool equals(Position other) {
    return this.lineNumber == other.lineNumber && this.column == other.column;
  }

  int compare(Position other) {
    if (this.lineNumber == other.lineNumber) {
      return this.column - other.column;
    }
    return this.lineNumber - other.lineNumber;
  }
}

export class Range {
  int startLineNumber;
  int startColumn;
  int endLineNumber;
  int endColumn;

  init(int startLineNumber, int startColumn, int endLineNumber, int endColumn) {
    if (startLineNumber > endLineNumber || (startLineNumber == endLineNumber && startColumn > endColumn)) {
      this.startLineNumber = endLineNumber;
      this.startColumn = endColumn;
      this.endLineNumber = startLineNumber;
      this.endColumn = startColumn;
    } else {
      this.startLineNumber = startLineNumber;
      this.startColumn = startColumn;
      this.endLineNumber = endLineNumber;
      this.endColumn = endColumn;
    }
  }

  bool isEmpty() {
    return this.startLineNumber == this.endLineNumber && this.startColumn == this.endColumn;
  }

  bool containsPosition(Position position) {
    if (position.lineNumber < this.startLineNumber || position.lineNumber > this.endLineNumber) {
      return false;
    }
    if (position.lineNumber == this.startLineNumber && position.column < this.startColumn) {
      return false;
    }
    if (position.lineNumber == this.endLineNumber && position.column > this.endColumn) {
      return false;
    }
    return true;
  }

  bool strictContainsPosition(Position position) {
    if (!this.containsPosition(position)) {
      return false;
    }
    if (position.lineNumber == this.startLineNumber && position.column == this.startColumn) {
      return false;
    }
    return position.lineNumber != this.endLineNumber || position.column != this.endColumn;
  }

  bool containsRange(Range other) {
    if (other.startLineNumber < this.startLineNumber || other.endLineNumber > this.endLineNumber) {
      return false;
    }
    if (other.startLineNumber == this.startLineNumber && other.startColumn < this.startColumn) {
      return false;
    }
    if (other.endLineNumber == this.endLineNumber && other.endColumn > this.endColumn) {
      return false;
    }
    return true;
  }

  bool strictContainsRange(Range other) {
    if (!this.containsRange(other)) {
      return false;
    }
    bool sameStart = other.startLineNumber == this.startLineNumber && other.startColumn == this.startColumn;
    bool sameEnd = other.endLineNumber == this.endLineNumber && other.endColumn == this.endColumn;
    return !sameStart && !sameEnd;
  }

  Range plusRange(Range other) {
    int startLineNumber = this.startLineNumber;
    int startColumn = this.startColumn;
    int endLineNumber = this.endLineNumber;
    int endColumn = this.endColumn;
    if (other.startLineNumber < startLineNumber) {
      startLineNumber = other.startLineNumber;
      startColumn = other.startColumn;
    } else if (other.startLineNumber == startLineNumber) {
      startColumn = rangeMin(startColumn, other.startColumn);
    }
    if (other.endLineNumber > endLineNumber) {
      endLineNumber = other.endLineNumber;
      endColumn = other.endColumn;
    } else if (other.endLineNumber == endLineNumber) {
      endColumn = rangeMax(endColumn, other.endColumn);
    }
    return new Range(startLineNumber, startColumn, endLineNumber, endColumn);
  }

  Range? intersectRanges(Range other) {
    int startLineNumber = this.startLineNumber;
    int startColumn = this.startColumn;
    int endLineNumber = this.endLineNumber;
    int endColumn = this.endColumn;
    if (startLineNumber < other.startLineNumber) {
      startLineNumber = other.startLineNumber;
      startColumn = other.startColumn;
    } else if (startLineNumber == other.startLineNumber) {
      startColumn = rangeMax(startColumn, other.startColumn);
    }
    if (endLineNumber > other.endLineNumber) {
      endLineNumber = other.endLineNumber;
      endColumn = other.endColumn;
    } else if (endLineNumber == other.endLineNumber) {
      endColumn = rangeMin(endColumn, other.endColumn);
    }
    if (startLineNumber > endLineNumber) {
      return null;
    }
    if (startLineNumber == endLineNumber && startColumn > endColumn) {
      return null;
    }
    return new Range(startLineNumber, startColumn, endLineNumber, endColumn);
  }

  bool equalsRange(Range other) {
    return this.startLineNumber == other.startLineNumber
      && this.startColumn == other.startColumn
      && this.endLineNumber == other.endLineNumber
      && this.endColumn == other.endColumn;
  }

  Position getStartPosition() {
    return new Position(this.startLineNumber, this.startColumn);
  }

  Position getEndPosition() {
    return new Position(this.endLineNumber, this.endColumn);
  }

  Range setStartPosition(int lineNumber, int column) {
    return new Range(lineNumber, column, this.endLineNumber, this.endColumn);
  }

  Range setEndPosition(int lineNumber, int column) {
    return new Range(this.startLineNumber, this.startColumn, lineNumber, column);
  }

  Range collapseToStart() {
    return new Range(this.startLineNumber, this.startColumn, this.startLineNumber, this.startColumn);
  }

  Range collapseToEnd() {
    return new Range(this.endLineNumber, this.endColumn, this.endLineNumber, this.endColumn);
  }

  Range delta(int lineCount) {
    return new Range(
      this.startLineNumber + lineCount,
      this.startColumn,
      this.endLineNumber + lineCount,
      this.endColumn
    );
  }

  bool isSingleLine() {
    return this.startLineNumber == this.endLineNumber;
  }

  string toString() {
    return "["
      + this.startLineNumber.toString()
      + ","
      + this.startColumn.toString()
      + " -> "
      + this.endLineNumber.toString()
      + ","
      + this.endColumn.toString()
      + "]";
  }
}

export Range createRange(int startLineNumber, int startColumn, int endLineNumber, int endColumn) {
  return new Range(startLineNumber, startColumn, endLineNumber, endColumn);
}

export Range rangeFromPositions(Position start, Position end) {
  return new Range(start.lineNumber, start.column, end.lineNumber, end.column);
}

export Range liftRange(JsValue value) {
  return new Range(
    JS.number(value["startLineNumber"]).toInt(),
    JS.number(value["startColumn"]).toInt(),
    JS.number(value["endLineNumber"]).toInt(),
    JS.number(value["endColumn"]).toInt()
  );
}

export bool isIRange(JsValue value) {
  if (!value.truthy()) {
    return false;
  }
  return value["startLineNumber"].truthy()
    && value["startColumn"].truthy()
    && value["endLineNumber"].truthy()
    && value["endColumn"].truthy();
}

export bool rangeEquals(Range a, Range b) {
  return a.equalsRange(b);
}

export bool rangesIntersectingOrTouching(Range a, Range b) {
  if (a.endLineNumber < b.startLineNumber || (a.endLineNumber == b.startLineNumber && a.endColumn < b.startColumn)) {
    return false;
  }
  if (b.endLineNumber < a.startLineNumber || (b.endLineNumber == a.startLineNumber && b.endColumn < a.startColumn)) {
    return false;
  }
  return true;
}

export bool rangesIntersecting(Range a, Range b) {
  if (a.endLineNumber < b.startLineNumber || (a.endLineNumber == b.startLineNumber && a.endColumn <= b.startColumn)) {
    return false;
  }
  if (b.endLineNumber < a.startLineNumber || (b.endLineNumber == a.startLineNumber && b.endColumn <= a.startColumn)) {
    return false;
  }
  return true;
}

export int rangeCompareRangesUsingStarts(Range a, Range b) {
  if (a.startLineNumber != b.startLineNumber) {
    return a.startLineNumber - b.startLineNumber;
  }
  if (a.startColumn != b.startColumn) {
    return a.startColumn - b.startColumn;
  }
  if (a.endLineNumber != b.endLineNumber) {
    return a.endLineNumber - b.endLineNumber;
  }
  return a.endColumn - b.endColumn;
}

export int rangeCompareRangesUsingEnds(Range a, Range b) {
  if (a.endLineNumber != b.endLineNumber) {
    return a.endLineNumber - b.endLineNumber;
  }
  if (a.endColumn != b.endColumn) {
    return a.endColumn - b.endColumn;
  }
  if (a.startLineNumber != b.startLineNumber) {
    return a.startLineNumber - b.startLineNumber;
  }
  return a.startColumn - b.startColumn;
}
