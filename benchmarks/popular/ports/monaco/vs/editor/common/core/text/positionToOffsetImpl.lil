import { Pos } from "../../../../../base/position";
import { Rng, createRange } from "../../../../../base/range";
import { OffsetRange } from "../ranges/offsetRange";

int[] lineStartsOf(string text) {
  int[] starts = [];
  starts.push(0);
  int i = 0;
  while (i < text.length) {
    if (text.charCodeAt(i) == 10) {
      starts.push(i + 1);
    }
    i = i + 1;
  }
  return starts;
}

export class PositionOffsetTransformer {
  string text;
  int[] lineStarts;

  init(string text) {
    this.text = text;
    this.lineStarts = lineStartsOf(text);
  }

  int getOffset(Pos position) {
    int line = position.lineNumber;
    if (line < 1) {
      line = 1;
    }
    if (line > this.lineStarts.length) {
      line = this.lineStarts.length;
    }
    int start = this.lineStarts[line - 1];
    int col = position.column - 1;
    if (col < 0) {
      col = 0;
    }
    return start + col;
  }

  Pos getPosition(int offset) {
    int n = this.text.length;
    int off = offset;
    if (off < 0) {
      off = 0;
    }
    if (off > n) {
      off = n;
    }
    int line = 1;
    int i = 1;
    while (i < this.lineStarts.length && this.lineStarts[i] <= off) {
      line = i + 1;
      i = i + 1;
    }
    int start = this.lineStarts[line - 1];
    return new Pos(line, off - start + 1);
  }

  OffsetRange getOffsetRange(Rng range) {
    return new OffsetRange(this.getOffset(new Pos(range.startLineNumber, range.startColumn)), this.getOffset(new Pos(range.endLineNumber, range.endColumn)));
  }

  Rng getRange(OffsetRange offsetRange) {
    Pos start = this.getPosition(offsetRange.start);
    Pos end = this.getPosition(offsetRange.endExclusive);
    return createRange(start.lineNumber, start.column, end.lineNumber, end.column);
  }
}

export void ensureTransformerReady() {
}
