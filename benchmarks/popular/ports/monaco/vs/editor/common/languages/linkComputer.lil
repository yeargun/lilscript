import { hostCall, jsUndefined, sliceOf } from "../../../../js-host";

export class StateMachine {
  Map<int, int> transitions;

  init(int[][] edges) {
    this.transitions = new Map();
    int i = 0;
    while (i < edges.length) {
      int[] edge = edges[i];
      this.transitions.set(edge[0] * 65536 + edge[1], edge[2]);
      i = i + 1;
    }
  }

  int nextState(int currentState, int characterCode) {
    int? value = this.transitions.get(currentState * 65536 + characterCode);
    if (value == null) {
      return 0;
    }
    return value;
  }
}

bool startsAt(string text, int offset, string prefix) {
  if (offset + prefix.length > text.length) {
    return false;
  }
  int i = 0;
  while (i < prefix.length) {
    int actual = text.charCodeAt(offset + i);
    int expected = prefix.charCodeAt(i);
    if (actual >= 65 && actual <= 90) {
      actual = actual + 32;
    }
    if (actual != expected) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

bool terminatesLink(int code) {
  return code == 9 || code == 10 || code == 13 || code == 32 || code == 34 ||
    code == 39 || code == 60 || code == 62 || code == 124 || code == 12289 ||
    code == 12290 || code == 65377 || code == 65380;
}

int trimLinkEnd(string line, int start, int end) {
  int result = end;
  while (result > start) {
    int code = line.charCodeAt(result - 1);
    if (code == 46 || code == 44 || code == 59 || code == 58) {
      result = result - 1;
    } else {
      break;
    }
  }
  if (start > 0 && result > start) {
    int before = line.charCodeAt(start - 1);
    int last = line.charCodeAt(result - 1);
    if ((before == 40 && last == 41) || (before == 91 && last == 93) || (before == 123 && last == 125)) {
      result = result - 1;
    }
  }
  return result;
}

JsValue createLink(string line, int lineNumber, int start, int end) {
  JsValue range = JS.object();
  range["startLineNumber"] = lineNumber;
  range["startColumn"] = start + 1;
  range["endLineNumber"] = lineNumber;
  range["endColumn"] = end + 1;
  JsValue link = JS.object();
  link["range"] = range;
  link["url"] = sliceOf(line, start, end);
  return link;
}

export class LinkComputer {
  JsValue[] computeLinks(JsValue model) {
    JsValue[] links = [];
    int lineCount = JS.number(hostCall(model, "getLineCount", jsUndefined(), jsUndefined(), jsUndefined())).toInt();
    int lineNumber = 1;
    while (lineNumber <= lineCount) {
      string line = JS.string(hostCall(model, "getLineContent", lineNumber, jsUndefined(), jsUndefined()));
      int i = 0;
      while (i < line.length) {
        bool begins = startsAt(line, i, "http://") || startsAt(line, i, "https://") || startsAt(line, i, "file://");
        if (!begins) {
          i = i + 1;
        } else {
          int end = i;
          int openParens = 0;
          int openSquares = 0;
          int openCurlies = 0;
          while (end < line.length) {
            int code = line.charCodeAt(end);
            if (terminatesLink(code)) {
              break;
            }
            if (code == 40) {
              openParens = openParens + 1;
            } else if (code == 41) {
              if (openParens == 0) {
                break;
              }
              openParens = openParens - 1;
            } else if (code == 91) {
              openSquares = openSquares + 1;
            } else if (code == 93) {
              if (openSquares == 0) {
                break;
              }
              openSquares = openSquares - 1;
            } else if (code == 123) {
              openCurlies = openCurlies + 1;
            } else if (code == 125) {
              if (openCurlies == 0) {
                break;
              }
              openCurlies = openCurlies - 1;
            }
            end = end + 1;
          }
          int trimmed = trimLinkEnd(line, i, end);
          if (trimmed > i + 7) {
            links.push(createLink(line, lineNumber, i, trimmed));
          }
          if (end <= i) {
            i = i + 1;
          } else {
            i = end;
          }
        }
      }
      lineNumber = lineNumber + 1;
    }
    return links;
  }
}

export JsValue[] computeLinks(JsValue model) {
  if (model == null) {
    return [];
  }
  return new LinkComputer().computeLinks(model);
}

export LinkComputer createLinkComputer() {
  return new LinkComputer();
}
