import { sliceOf, concat2, replaceEol, emptyBuf, stringFromCharCode1 } from "../../../../../js-host";

export class StringBuffer {
  string buffer;
  int[] lineStarts;

  init(string buffer, int[] lineStarts) {
    this.buffer = buffer;
    this.lineStarts = lineStarts;
  }
}

export class PieceTreeTextBuffer {
  StringBuffer[] chunks;
  string bom;
  string eol;
  bool containsRTL;
  bool containsUnusualLineTerminators;
  bool isBasicASCII;

  init(
    StringBuffer[] chunks,
    string bom,
    string eol,
    bool containsRTL,
    bool containsUnusualLineTerminators,
    bool isBasicASCII
  ) {
    this.chunks = chunks;
    this.bom = bom;
    this.eol = eol;
    this.containsRTL = containsRTL;
    this.containsUnusualLineTerminators = containsUnusualLineTerminators;
    this.isBasicASCII = isBasicASCII;
  }

  string getValue() {
    string result = emptyBuf();
    int i = 0;
    while (i < this.chunks.length) {
      result = concat2(result, this.chunks[i].buffer);
      i = i + 1;
    }
    return result;
  }
}

export int[] createLineStartsFast(string text) {
  int[] starts = [0];
  int i = 0;
  while (i < text.length) {
    int code = text.charCodeAt(i);
    if (code == 13) {
      if (i + 1 < text.length && text.charCodeAt(i + 1) == 10) {
        i = i + 1;
      }
      starts.push(i + 1);
    } else if (code == 10) {
      starts.push(i + 1);
    }
    i = i + 1;
  }
  return starts;
}

bool isRtlCode(int code) {
  return (code >= 1424 && code <= 1919) || (code >= 2048 && code <= 2303);
}

export class PieceTreeTextBufferBuilder {
  StringBuffer[] chunks;
  string bom;
  bool hasPreviousChar;
  int previousChar;
  int cr;
  int lf;
  int crlf;
  bool containsRTL;
  bool containsUnusualLineTerminators;
  bool isBasicASCII;

  init() {
    this.chunks = [];
    this.bom = emptyBuf();
    this.hasPreviousChar = false;
    this.previousChar = 0;
    this.cr = 0;
    this.lf = 0;
    this.crlf = 0;
    this.containsRTL = false;
    this.containsUnusualLineTerminators = false;
    this.isBasicASCII = true;
  }

  void acceptChunk(string chunk) {
    if (chunk.length == 0) {
      return;
    }
    string text = chunk;
    if (this.chunks.length == 0 && this.bom.length == 0 && text.charCodeAt(0) == 65279) {
      this.bom = sliceOf(text, 0, 1);
      text = sliceOf(text, 1, text.length);
      if (text.length == 0) {
        return;
      }
    }
    if (this.hasPreviousChar) {
      text = concat2(stringFromCharCode1(this.previousChar * 1.0), text);
      this.hasPreviousChar = false;
    }
    int last = text.charCodeAt(text.length - 1);
    if (last == 13 || (last >= 55296 && last <= 56319)) {
      this.hasPreviousChar = true;
      this.previousChar = last;
      text = sliceOf(text, 0, text.length - 1);
    }
    if (text.length > 0) {
      this.acceptChunkContent(text);
    }
  }

  void acceptChunkContent(string text) {
    int[] starts = [0];
    int i = 0;
    while (i < text.length) {
      int code = text.charCodeAt(i);
      if (code > 127) {
        this.isBasicASCII = false;
        if (isRtlCode(code)) {
          this.containsRTL = true;
        }
        if (code == 8232 || code == 8233) {
          this.containsUnusualLineTerminators = true;
        }
      }
      if (code == 13) {
        if (i + 1 < text.length && text.charCodeAt(i + 1) == 10) {
          this.crlf = this.crlf + 1;
          i = i + 1;
        } else {
          this.cr = this.cr + 1;
        }
        starts.push(i + 1);
      } else if (code == 10) {
        this.lf = this.lf + 1;
        starts.push(i + 1);
      }
      i = i + 1;
    }
    this.chunks.push(new StringBuffer(text, starts));
  }

  void finishPending() {
    if (this.hasPreviousChar) {
      this.acceptChunkContent(stringFromCharCode1(this.previousChar * 1.0));
      this.hasPreviousChar = false;
    }
    if (this.chunks.length == 0) {
      this.chunks.push(new StringBuffer(emptyBuf(), [0]));
    }
  }

  string detectedEOL() {
    int total = this.cr + this.lf + this.crlf;
    if (total == 0) {
      return "\n";
    }
    if ((this.cr + this.crlf) * 2 > total) {
      return "\r\n";
    }
    return "\n";
  }

  PieceTreeTextBuffer finish(bool normalizeEOL) {
    this.finishPending();
    string eol = this.detectedEOL();
    StringBuffer[] result = [];
    int i = 0;
    while (i < this.chunks.length) {
      string text = this.chunks[i].buffer;
      if (normalizeEOL) {
        text = replaceEol(text, eol);
      }
      result.push(new StringBuffer(text, createLineStartsFast(text)));
      i = i + 1;
    }
    return new PieceTreeTextBuffer(
      result,
      this.bom,
      eol,
      this.containsRTL,
      this.containsUnusualLineTerminators,
      this.isBasicASCII
    );
  }
}

export PieceTreeTextBufferBuilder createPieceTreeTextBufferBuilder() {
  return new PieceTreeTextBufferBuilder();
}

export PieceTreeTextBuffer buildPieceTreeTextBuffer(string value, bool normalizeEOL) {
  PieceTreeTextBufferBuilder builder = new PieceTreeTextBufferBuilder();
  builder.acceptChunk(value);
  return builder.finish(normalizeEOL);
}
