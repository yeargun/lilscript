import { sliceOf, concat2, replaceEol, stringSplit, emptyBuf } from "../../../../../js-host";

export class Position {
  int lineNumber;
  int column;

  init(int lineNumber, int column) {
    this.lineNumber = lineNumber;
    this.column = column;
  }
}

export class Range {
  int startLineNumber;
  int startColumn;
  int endLineNumber;
  int endColumn;

  init(int startLineNumber, int startColumn, int endLineNumber, int endColumn) {
    this.startLineNumber = startLineNumber;
    this.startColumn = startColumn;
    this.endLineNumber = endLineNumber;
    this.endColumn = endColumn;
  }

  bool isEmpty() {
    return this.startLineNumber == this.endLineNumber && this.startColumn == this.endColumn;
  }
}

export class EditOperation {
  Range range;
  string text;
  bool forceMoveMarkers;
  bool isAutoWhitespaceEdit;
  bool isTracked;
  int sortIndex;

  init(
    Range range,
    string text,
    bool forceMoveMarkers,
    bool isAutoWhitespaceEdit,
    bool isTracked,
    int sortIndex
  ) {
    this.range = range;
    this.text = text;
    this.forceMoveMarkers = forceMoveMarkers;
    this.isAutoWhitespaceEdit = isAutoWhitespaceEdit;
    this.isTracked = isTracked;
    this.sortIndex = sortIndex;
  }
}

export class ContentChange {
  Range range;
  int rangeLength;
  string text;
  int rangeOffset;
  bool forceMoveMarkers;

  init(Range range, int rangeLength, string text, int rangeOffset, bool forceMoveMarkers) {
    this.range = range;
    this.rangeLength = rangeLength;
    this.text = text;
    this.rangeOffset = rangeOffset;
    this.forceMoveMarkers = forceMoveMarkers;
  }
}

export class BufferEditResult {
  EditOperation[] reverseEdits;
  ContentChange[] changes;
  int[] trimAutoWhitespaceLineNumbers;

  init(EditOperation[] reverseEdits, ContentChange[] changes, int[] trimAutoWhitespaceLineNumbers) {
    this.reverseEdits = reverseEdits;
    this.changes = changes;
    this.trimAutoWhitespaceLineNumbers = trimAutoWhitespaceLineNumbers;
  }
}

export class PieceTreeTextBuffer {
  string value;
  string bom;
  string eol;
  bool mightContainRTLFlag;
  bool mightContainUnusualLineTerminatorsFlag;
  bool mightContainNonBasicASCIIFlag;

  init(
    string value,
    string bom,
    string eol,
    bool containsRTL,
    bool containsUnusualLineTerminators,
    bool isBasicASCII
  ) {
    this.value = value;
    this.bom = bom;
    this.eol = eol;
    this.mightContainRTLFlag = containsRTL;
    this.mightContainUnusualLineTerminatorsFlag = containsUnusualLineTerminators;
    this.mightContainNonBasicASCIIFlag = !isBasicASCII;
  }

  bool mightContainRTL() {
    return this.mightContainRTLFlag;
  }

  bool mightContainUnusualLineTerminators() {
    return this.mightContainUnusualLineTerminatorsFlag;
  }

  void resetMightContainUnusualLineTerminators() {
    this.mightContainUnusualLineTerminatorsFlag = false;
  }

  bool mightContainNonBasicASCII() {
    return this.mightContainNonBasicASCIIFlag;
  }

  string getBOM() {
    return this.bom;
  }

  string getEOL() {
    return this.eol;
  }

  string createSnapshot(bool preserveBOM) {
    if (preserveBOM) {
      return concat2(this.bom, this.value);
    }
    return this.value;
  }

  int getOffsetAt(int lineNumber, int column) {
    int line = 1;
    int offset = 0;
    while (offset < this.value.length && line < lineNumber) {
      int code = this.value.charCodeAt(offset);
      if (code == 13) {
        if (offset + 1 < this.value.length && this.value.charCodeAt(offset + 1) == 10) {
          offset = offset + 1;
        }
        line = line + 1;
      } else if (code == 10) {
        line = line + 1;
      }
      offset = offset + 1;
    }
    int result = offset + column - 1;
    if (result < offset) {
      result = offset;
    }
    if (result > this.value.length) {
      result = this.value.length;
    }
    return result;
  }

  Position getPositionAt(int requestedOffset) {
    int end = requestedOffset;
    if (end < 0) {
      end = 0;
    }
    if (end > this.value.length) {
      end = this.value.length;
    }
    int line = 1;
    int column = 1;
    int i = 0;
    while (i < end) {
      int code = this.value.charCodeAt(i);
      if (code == 13) {
        if (i + 1 < end && this.value.charCodeAt(i + 1) == 10) {
          i = i + 1;
        }
        line = line + 1;
        column = 1;
      } else if (code == 10) {
        line = line + 1;
        column = 1;
      } else {
        column = column + 1;
      }
      i = i + 1;
    }
    return new Position(line, column);
  }

  Range getRangeAt(int start, int length) {
    Position from = this.getPositionAt(start);
    Position to = this.getPositionAt(start + length);
    return new Range(from.lineNumber, from.column, to.lineNumber, to.column);
  }

  string getValueInRange(Range range, int eolPreference = 0) {
    if (range.isEmpty()) {
      return emptyBuf();
    }
    int start = this.getOffsetAt(range.startLineNumber, range.startColumn);
    int end = this.getOffsetAt(range.endLineNumber, range.endColumn);
    string result = sliceOf(this.value, start, end);
    if (eolPreference == 1) {
      return replaceEol(result, "\n");
    }
    if (eolPreference == 2) {
      return replaceEol(result, "\r\n");
    }
    return result;
  }

  int getValueLengthInRange(Range range, int eolPreference = 0) {
    return this.getValueInRange(range, eolPreference).length;
  }

  int getCharacterCountInRange(Range range, int eolPreference = 0) {
    string text = this.getValueInRange(range, eolPreference);
    int result = 0;
    int i = 0;
    while (i < text.length) {
      int code = text.charCodeAt(i);
      if (code >= 55296 && code <= 56319 && i + 1 < text.length) {
        i = i + 1;
      }
      result = result + 1;
      i = i + 1;
    }
    return result;
  }

  int getLength() {
    return this.value.length;
  }

  int getLineCount() {
    int count = 1;
    int i = 0;
    while (i < this.value.length) {
      int code = this.value.charCodeAt(i);
      if (code == 13) {
        if (i + 1 < this.value.length && this.value.charCodeAt(i + 1) == 10) {
          i = i + 1;
        }
        count = count + 1;
      } else if (code == 10) {
        count = count + 1;
      }
      i = i + 1;
    }
    return count;
  }

  string[] getLinesContent() {
    return stringSplit(replaceEol(this.value, "\n"), "\n");
  }

  string getLineContent(int lineNumber) {
    string[] lines = this.getLinesContent();
    if (lineNumber < 1 || lineNumber > lines.length) {
      return emptyBuf();
    }
    return lines[lineNumber - 1];
  }

  int getLineCharCode(int lineNumber, int index) {
    return this.getLineContent(lineNumber).charCodeAt(index);
  }

  int getLineLength(int lineNumber) {
    return this.getLineContent(lineNumber).length;
  }

  int getLineFirstNonWhitespaceColumn(int lineNumber) {
    string text = this.getLineContent(lineNumber);
    int i = 0;
    while (i < text.length) {
      int code = text.charCodeAt(i);
      if (code != 32 && code != 9) {
        return i + 1;
      }
      i = i + 1;
    }
    return 0;
  }

  int getLineLastNonWhitespaceColumn(int lineNumber) {
    string text = this.getLineContent(lineNumber);
    int i = text.length - 1;
    while (i >= 0) {
      int code = text.charCodeAt(i);
      if (code != 32 && code != 9) {
        return i + 2;
      }
      i = i - 1;
    }
    return 0;
  }

  void setEOL(string newEOL) {
    this.value = replaceEol(this.value, newEOL);
    this.eol = newEOL;
  }

  void scanInsertedText(string text) {
    int i = 0;
    while (i < text.length) {
      int code = text.charCodeAt(i);
      if (code > 127) {
        this.mightContainNonBasicASCIIFlag = true;
      }
      if ((code >= 1424 && code <= 1919) || (code >= 2048 && code <= 2303)) {
        this.mightContainRTLFlag = true;
      }
      if (code == 8232 || code == 8233) {
        this.mightContainUnusualLineTerminatorsFlag = true;
      }
      i = i + 1;
    }
  }

  EditOperation[] sortDescending(EditOperation[] operations) {
    EditOperation[] sorted = operations.slice();
    int i = 0;
    while (i < sorted.length) {
      int best = i;
      int bestOffset = this.getOffsetAt(sorted[i].range.startLineNumber, sorted[i].range.startColumn);
      int j = i + 1;
      while (j < sorted.length) {
        int offset = this.getOffsetAt(sorted[j].range.startLineNumber, sorted[j].range.startColumn);
        if (offset > bestOffset || (offset == bestOffset && sorted[j].sortIndex > sorted[best].sortIndex)) {
          best = j;
          bestOffset = offset;
        }
        j = j + 1;
      }
      if (best != i) {
        EditOperation temp = sorted[i];
        sorted[i] = sorted[best];
        sorted[best] = temp;
      }
      i = i + 1;
    }
    return sorted;
  }

  BufferEditResult applyEdits(EditOperation[] rawOperations, bool recordTrimAutoWhitespace, bool computeUndoEdits) {
    EditOperation[] operations = this.sortDescending(rawOperations);
    EditOperation[] reverseEdits = [];
    ContentChange[] changes = [];
    int[] trimLines = [];
    int i = 0;
    while (i < operations.length) {
      EditOperation operation = operations[i];
      Range range = operation.range;
      int start = this.getOffsetAt(range.startLineNumber, range.startColumn);
      int end = this.getOffsetAt(range.endLineNumber, range.endColumn);
      int rangeLength = end - start;
      string oldText = sliceOf(this.value, start, end);
      string validText = replaceEol(operation.text, this.eol);
      if (computeUndoEdits) {
        Position reverseEnd = this.positionAfterText(range.startLineNumber, range.startColumn, validText);
        Range reverseRange = new Range(range.startLineNumber, range.startColumn, reverseEnd.lineNumber, reverseEnd.column);
        reverseEdits.push(new EditOperation(reverseRange, oldText, operation.forceMoveMarkers, false, false, operation.sortIndex));
      }
      this.value = concat2(concat2(sliceOf(this.value, 0, start), validText), sliceOf(this.value, end, this.value.length));
      this.scanInsertedText(validText);
      changes.push(new ContentChange(range, rangeLength, validText, start, operation.forceMoveMarkers));
      if (recordTrimAutoWhitespace && operation.isAutoWhitespaceEdit && range.isEmpty()) {
        int line = range.startLineNumber;
        if (this.getLineFirstNonWhitespaceColumn(line) == 0) {
          trimLines.push(line);
        }
      }
      i = i + 1;
    }
    return new BufferEditResult(reverseEdits, changes, trimLines);
  }

  Position positionAfterText(int lineNumber, int column, string text) {
    int line = lineNumber;
    int col = column;
    int i = 0;
    while (i < text.length) {
      int code = text.charCodeAt(i);
      if (code == 13) {
        if (i + 1 < text.length && text.charCodeAt(i + 1) == 10) {
          i = i + 1;
        }
        line = line + 1;
        col = 1;
      } else if (code == 10) {
        line = line + 1;
        col = 1;
      } else {
        col = col + 1;
      }
      i = i + 1;
    }
    return new Position(line, col);
  }
}

export PieceTreeTextBuffer createPieceTreeTextBuffer(string value, string eol) {
  string normalized = replaceEol(value, eol);
  return new PieceTreeTextBuffer(normalized, emptyBuf(), eol, false, false, true);
}

export EditOperation createEditOperation(
  int startLine,
  int startColumn,
  int endLine,
  int endColumn,
  string text,
  int sortIndex
) {
  return new EditOperation(
    new Range(startLine, startColumn, endLine, endColumn),
    text,
    false,
    false,
    false,
    sortIndex
  );
}
