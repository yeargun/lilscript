import { concat2 } from "../../../../js-host";

export class ActiveIndentGuide {
  int startLineNumber;
  int endLineNumber;
  int indent;

  init(int startLineNumber, int endLineNumber, int indent) {
    this.startLineNumber = startLineNumber;
    this.endLineNumber = endLineNumber;
    this.indent = indent;
  }
}

export class IndentGuideHorizontalLine {
  bool top;
  int endColumn;

  init(bool top, int endColumn) {
    this.top = top;
    this.endColumn = endColumn;
  }
}

export class IndentGuide {
  int visibleColumn;
  int column;
  string className;
  IndentGuideHorizontalLine? horizontalLine;
  int forWrappedLinesAfterColumn;
  int forWrappedLinesBeforeOrAtColumn;

  init(
    int visibleColumn,
    int column,
    string className,
    IndentGuideHorizontalLine? horizontalLine,
    int forWrappedLinesAfterColumn,
    int forWrappedLinesBeforeOrAtColumn
  ) {
    this.visibleColumn = visibleColumn;
    this.column = column;
    this.className = className;
    this.horizontalLine = horizontalLine;
    this.forWrappedLinesAfterColumn = forWrappedLinesAfterColumn;
    this.forWrappedLinesBeforeOrAtColumn = forWrappedLinesBeforeOrAtColumn;
  }
}

export class GuideTextModel {
  string[] lines;
  int tabSize;
  int indentSize;
  bool offSide;

  init(string[] lines, int tabSize, int indentSize, bool offSide) {
    this.lines = lines;
    this.tabSize = tabSize;
    this.indentSize = indentSize;
    if (this.tabSize < 1) {
      this.tabSize = 4;
    }
    if (this.indentSize < 1) {
      this.indentSize = this.tabSize;
    }
    this.offSide = offSide;
  }

  int getLineCount() {
    return this.lines.length;
  }

  string getLineContent(int lineNumber) {
    if (lineNumber < 1 || lineNumber > this.lines.length) {
      return "";
    }
    return this.lines[lineNumber - 1];
  }
}

int computeIndentLevel(string line, int tabSize) {
  int indent = 0;
  int i = 0;
  while (i < line.length) {
    int code = line.charCodeAt(i);
    if (code == 32) {
      indent = indent + 1;
    } else if (code == 9) {
      indent = indent - indent % tabSize + tabSize;
    } else {
      return indent;
    }
    i = i + 1;
  }
  return -1;
}

int indentLevelForWhitespace(int aboveIndent, int belowIndent, int indentSize, bool offSide) {
  if (aboveIndent == -1 || belowIndent == -1) {
    return 0;
  }
  if (aboveIndent < belowIndent) {
    return 1 + aboveIndent / indentSize;
  }
  if (aboveIndent == belowIndent) {
    return (belowIndent + indentSize - 1) / indentSize;
  }
  if (offSide) {
    return (belowIndent + indentSize - 1) / indentSize;
  }
  return 1 + belowIndent / indentSize;
}

export class GuidesTextModelPart {
  GuideTextModel textModel;
  bool disposed;

  init(GuideTextModel textModel) {
    this.textModel = textModel;
    this.disposed = false;
  }

  void dispose() {
    this.disposed = true;
  }

  int computeIndent(int lineNumber) {
    return computeIndentLevel(this.textModel.getLineContent(lineNumber), this.textModel.tabSize);
  }

  int previousContentIndent(int lineNumber) {
    int line = lineNumber - 1;
    while (line >= 1) {
      int indent = this.computeIndent(line);
      if (indent >= 0) {
        return indent;
      }
      line = line - 1;
    }
    return -1;
  }

  int nextContentIndent(int lineNumber) {
    int line = lineNumber + 1;
    while (line <= this.textModel.getLineCount()) {
      int indent = this.computeIndent(line);
      if (indent >= 0) {
        return indent;
      }
      line = line + 1;
    }
    return -1;
  }

  int lineIndentLevel(int lineNumber) {
    int indent = this.computeIndent(lineNumber);
    if (indent >= 0) {
      return (indent + this.textModel.indentSize - 1) / this.textModel.indentSize;
    }
    return indentLevelForWhitespace(
      this.previousContentIndent(lineNumber),
      this.nextContentIndent(lineNumber),
      this.textModel.indentSize,
      this.textModel.offSide
    );
  }

  int[] getLinesIndentGuides(int startLineNumber, int endLineNumber) {
    int[] result = [];
    int start = startLineNumber;
    int end = endLineNumber;
    if (start < 1) {
      start = 1;
    }
    if (end > this.textModel.getLineCount()) {
      end = this.textModel.getLineCount();
    }
    int line = start;
    while (line <= end) {
      result.push(this.lineIndentLevel(line));
      line = line + 1;
    }
    return result;
  }

  ActiveIndentGuide getActiveIndentGuide(int lineNumber, int minLineNumber, int maxLineNumber) {
    int lineCount = this.textModel.getLineCount();
    if (lineNumber < 1) {
      lineNumber = 1;
    }
    if (lineNumber > lineCount) {
      lineNumber = lineCount;
    }
    int initial = this.lineIndentLevel(lineNumber);
    int indent = initial;
    if (lineNumber < lineCount) {
      int below = this.lineIndentLevel(lineNumber + 1);
      if (below == initial + 1) {
        indent = below;
        lineNumber = lineNumber + 1;
      }
    }
    int start = lineNumber;
    int end = lineNumber;
    if (indent <= 0) {
      return new ActiveIndentGuide(start, end, 0);
    }
    int line = lineNumber - 1;
    int distance = 0;
    while (line >= minLineNumber && line >= 1 && distance < 50000) {
      if (this.lineIndentLevel(line) < indent) {
        break;
      }
      start = line;
      line = line - 1;
      distance = distance + 1;
    }
    line = lineNumber + 1;
    distance = 0;
    while (line <= maxLineNumber && line <= lineCount && distance < 50000) {
      if (this.lineIndentLevel(line) < indent) {
        break;
      }
      end = line;
      line = line + 1;
      distance = distance + 1;
    }
    return new ActiveIndentGuide(start, end, indent);
  }

  int getVisibleColumnFromPosition(int lineNumber, int column) {
    string text = this.textModel.getLineContent(lineNumber);
    int visible = 0;
    int i = 0;
    int end = column - 1;
    if (end > text.length) {
      end = text.length;
    }
    while (i < end) {
      if (text.charCodeAt(i) == 9) {
        visible = visible - visible % this.textModel.tabSize + this.textModel.tabSize;
      } else {
        visible = visible + 1;
      }
      i = i + 1;
    }
    return visible + 1;
  }

  IndentGuide[][] getIndentGuideObjects(int startLineNumber, int endLineNumber, string className) {
    IndentGuide[][] result = [];
    int[] levels = this.getLinesIndentGuides(startLineNumber, endLineNumber);
    int i = 0;
    while (i < levels.length) {
      IndentGuide[] lineGuides = [];
      int level = 1;
      while (level <= levels[i]) {
        int visibleColumn = (level - 1) * this.textModel.indentSize + 1;
        lineGuides.push(new IndentGuide(visibleColumn, -1, className, null, -1, -1));
        level = level + 1;
      }
      result.push(lineGuides);
      i = i + 1;
    }
    return result;
  }
}

export class BracketPairGuidesClassNames {
  string activeClassName;

  init() {
    this.activeClassName = "indent-active";
  }

  string getInlineClassName(int nestingLevel, int equalTypeLevel, bool independentColorPoolPerBracketType) {
    int level = nestingLevel;
    if (independentColorPoolPerBracketType) {
      level = equalTypeLevel;
    }
    return this.getInlineClassNameOfLevel(level);
  }

  string getInlineClassNameOfLevel(int level) {
    return concat2("bracket-indent-guide lvl-", (level % 30).toString());
  }
}

export GuideTextModel createGuideTextModel(string[] lines, int tabSize, int indentSize, bool offSide) {
  return new GuideTextModel(lines, tabSize, indentSize, offSide);
}

export GuidesTextModelPart createGuidesTextModelPart(GuideTextModel model) {
  return new GuidesTextModelPart(model);
}
