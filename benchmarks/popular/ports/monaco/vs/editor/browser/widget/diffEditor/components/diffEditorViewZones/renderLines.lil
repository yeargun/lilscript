import { concat2, emptyBuf } from "../../../../../../../js-host";

export class RenderLineInput {
  string lineContent;
  bool isBasicASCII;
  bool containsRTL;
  int tabSize;

  init(string lineContent, bool isBasicASCII, bool containsRTL, int tabSize) {
    this.lineContent = lineContent;
    this.isBasicASCII = isBasicASCII;
    this.containsRTL = containsRTL;
    this.tabSize = tabSize;
  }
}

export string renderLineHtml(RenderLineInput input) {
  string out = emptyBuf();
  int i = 0;
  int col = 0;
  int tabSize = input.tabSize;
  if (tabSize < 1) {
    tabSize = 4;
  }
  while (i < input.lineContent.length) {
    string ch = input.lineContent.charAt(i);
    if (ch == "\t") {
      int spaces = tabSize - (col % tabSize);
      int s = 0;
      while (s < spaces) {
        out = concat2(out, " ");
        s = s + 1;
        col = col + 1;
      }
    } else if (ch == "<") {
      out = concat2(out, "&lt;");
      col = col + 1;
    } else if (ch == ">") {
      out = concat2(out, "&gt;");
      col = col + 1;
    } else if (ch == "&") {
      out = concat2(out, "&amp;");
      col = col + 1;
    } else {
      out = concat2(out, ch);
      col = col + 1;
    }
    i = i + 1;
  }
  return out;
}

export int renderedLineWidth(string lineContent, int tabSize, int charWidth) {
  int col = 0;
  int i = 0;
  int size = tabSize;
  if (size < 1) {
    size = 4;
  }
  while (i < lineContent.length) {
    if (lineContent.charAt(i) == "\t") {
      col = col + (size - (col % size));
    } else {
      col = col + 1;
    }
    i = i + 1;
  }
  return col * charWidth;
}

export RenderLineInput createRenderLineInput(string lineContent, int tabSize) {
  return new RenderLineInput(lineContent, true, false, tabSize);
}
