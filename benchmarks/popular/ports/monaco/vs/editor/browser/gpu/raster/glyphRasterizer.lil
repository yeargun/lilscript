export int FONT_ITALIC = 1;
export int FONT_BOLD = 2;
export int FONT_UNDERLINE = 4;
export int FONT_STRIKETHROUGH = 8;

export class BoundingBox {
  int left;
  int top;
  int right;
  int bottom;

  init(int left, int top, int right, int bottom) {
    this.left = left;
    this.top = top;
    this.right = right;
    this.bottom = bottom;
  }
}

export class OriginOffset {
  int x;
  int y;

  init(int x, int y) {
    this.x = x;
    this.y = y;
  }
}

export class RasterizedGlyph {
  BoundingBox boundingBox;
  OriginOffset originOffset;
  float fontBoundingBoxAscent;
  float fontBoundingBoxDescent;

  init() {
    this.boundingBox = new BoundingBox(0, 0, -1, -1);
    this.originOffset = new OriginOffset(0, 0);
    this.fontBoundingBoxAscent = 0.0;
    this.fontBoundingBoxDescent = 0.0;
  }
}

export class TextMetrics {
  float width;
  float alphabeticBaseline;
  float fontBoundingBoxAscent;
  float fontBoundingBoxDescent;

  init(float width, float alphabeticBaseline, float ascent, float descent) {
    this.width = width;
    this.alphabeticBaseline = alphabeticBaseline;
    this.fontBoundingBoxAscent = ascent;
    this.fontBoundingBoxDescent = descent;
  }
}

export class DecorationStyleSet {
  int id;
  int color;
  bool hasColor;
  bool bold;
  bool hasBold;
  float opacity;
  bool hasOpacity;
  bool strikethrough;
  float strikethroughThickness;
  bool hasThickness;
  int strikethroughColor;
  bool hasStrikethroughColor;

  init(int id) {
    this.id = id;
    this.color = 0;
    this.hasColor = false;
    this.bold = false;
    this.hasBold = false;
    this.opacity = 1.0;
    this.hasOpacity = false;
    this.strikethrough = false;
    this.strikethroughThickness = 1.0;
    this.hasThickness = false;
    this.strikethroughColor = 0;
    this.hasStrikethroughColor = false;
  }
}

export class DecorationStyleCacheLocal {
  int nextId;
  DecorationStyleSet[] byId;

  init() {
    this.nextId = 1;
    this.byId = [];
  }

  DecorationStyleSet? getStyleSet(int id) {
    if (id == 0) {
      return null;
    }
    int i = 0;
    while (i < this.byId.length) {
      if (this.byId[i].id == id) {
        return this.byId[i];
      }
      i = i + 1;
    }
    return null;
  }
}

int iceil(float value) {
  int floored = value.floor().toInt();
  if (value > floored * 1.0) {
    return floored + 1;
  }
  return floored;
}

int iround(float value) {
  if (value >= 0.0) {
    return (value + 0.5).floor().toInt();
  }
  return (value - 0.5).floor().toInt();
}

export class GlyphRasterizer {
  int id;
  float fontSize;
  string fontFamily;
  float devicePixelRatio;
  string antiAliasing;
  RasterizedGlyph workGlyph;
  string lastChars;
  int lastTokenMetadata;
  int lastDecorationStyleSetId;
  TextMetrics textMetrics;
  int canvasWidth;
  int canvasHeight;
  int[] alpha;
  DecorationStyleCacheLocal decorationStyleCache;
  int nextIdSeed;

  init(float fontSize, string fontFamily, float devicePixelRatio, int id) {
    this.id = id;
    this.fontSize = fontSize;
    this.fontFamily = fontFamily;
    this.devicePixelRatio = devicePixelRatio;
    this.antiAliasing = "subpixel";
    this.workGlyph = new RasterizedGlyph();
    this.lastChars = "";
    this.lastTokenMetadata = 0;
    this.lastDecorationStyleSetId = -1;
    float devicePixelFontSize = iceil(fontSize * devicePixelRatio) * 1.0;
    this.textMetrics = new TextMetrics(devicePixelFontSize * 0.6, devicePixelFontSize * 0.8, devicePixelFontSize * 0.8, devicePixelFontSize * 0.2);
    this.canvasWidth = iceil(devicePixelFontSize) * 3;
    this.canvasHeight = this.canvasWidth;
    this.alpha = [];
    this.decorationStyleCache = new DecorationStyleCacheLocal();
    this.nextIdSeed = id;
    int n = this.canvasWidth * this.canvasHeight;
    int i = 0;
    while (i < n) {
      this.alpha.push(0);
      i = i + 1;
    }
  }

  string cacheKey() {
    return this.fontFamily + "_" + iceil(this.fontSize).toString() + "px";
  }

  TextMetrics getTextMetrics(string text) {
    float width = this.textMetrics.width * text.length * 1.0;
    if (text == "\t") {
      width = this.textMetrics.width * 4.0;
    }
    return new TextMetrics(width, this.textMetrics.alphabeticBaseline, this.textMetrics.fontBoundingBoxAscent, this.textMetrics.fontBoundingBoxDescent);
  }

  void clearColor(int r, int g, int b) {
    int offset = 0;
    int n = this.alpha.length;
    while (offset + 3 < n) {
      if (this.alpha[offset] == r && this.alpha[offset + 1] == g && this.alpha[offset + 2] == b) {
        this.alpha[offset + 3] = 0;
      }
      offset = offset + 4;
    }
  }

  void findGlyphBoundingBox(BoundingBox outBoundingBox) {
    int height = this.canvasHeight;
    int width = this.canvasWidth;
    bool found = false;
    int y = 0;
    while (y < height) {
      int x = 0;
      while (x < width) {
        int alphaOffset = y * width * 4 + x * 4 + 3;
        if (alphaOffset < this.alpha.length && this.alpha[alphaOffset] != 0) {
          outBoundingBox.top = y;
          found = true;
          break;
        }
        x = x + 1;
      }
      if (found) {
        break;
      }
      y = y + 1;
    }
    outBoundingBox.left = 0;
    found = false;
    int x2 = 0;
    while (x2 < width) {
      int y2 = 0;
      while (y2 < height) {
        int alphaOffset = y2 * width * 4 + x2 * 4 + 3;
        if (alphaOffset < this.alpha.length && this.alpha[alphaOffset] != 0) {
          outBoundingBox.left = x2;
          found = true;
          break;
        }
        y2 = y2 + 1;
      }
      if (found) {
        break;
      }
      x2 = x2 + 1;
    }
    outBoundingBox.right = width;
    found = false;
    int x3 = width - 1;
    while (x3 >= outBoundingBox.left) {
      int y3 = 0;
      while (y3 < height) {
        int alphaOffset = y3 * width * 4 + x3 * 4 + 3;
        if (alphaOffset < this.alpha.length && this.alpha[alphaOffset] != 0) {
          outBoundingBox.right = x3;
          found = true;
          break;
        }
        y3 = y3 + 1;
      }
      if (found) {
        break;
      }
      x3 = x3 - 1;
    }
    outBoundingBox.bottom = outBoundingBox.top;
    found = false;
    int y4 = height - 1;
    while (y4 >= 0) {
      int x4 = 0;
      while (x4 < width) {
        int alphaOffset = y4 * width * 4 + x4 * 4 + 3;
        if (alphaOffset < this.alpha.length && this.alpha[alphaOffset] != 0) {
          outBoundingBox.bottom = y4;
          found = true;
          break;
        }
        x4 = x4 + 1;
      }
      if (found) {
        break;
      }
      y4 = y4 - 1;
    }
  }

  void stampGlyphAlpha(int originX, int originY, int glyphW, int glyphH) {
    int n = this.alpha.length;
    int i = 0;
    while (i < n) {
      this.alpha[i] = 0;
      i = i + 1;
    }
    int y = 0;
    while (y < glyphH) {
      int x = 0;
      while (x < glyphW) {
        int px = originX + x;
        int py = originY + y;
        if (px >= 0 && py >= 0 && px < this.canvasWidth && py < this.canvasHeight) {
          int alphaOffset = py * this.canvasWidth * 4 + px * 4 + 3;
          if (alphaOffset < this.alpha.length) {
            this.alpha[alphaOffset] = 255;
            this.alpha[alphaOffset - 3] = 255;
            this.alpha[alphaOffset - 2] = 255;
            this.alpha[alphaOffset - 1] = 255;
          }
        }
        x = x + 1;
      }
      y = y + 1;
    }
  }

  RasterizedGlyph rasterizeGlyph(string chars, int tokenMetadata, int decorationStyleSetId) {
    if (chars.length == 0) {
      RasterizedGlyph empty = new RasterizedGlyph();
      empty.boundingBox = new BoundingBox(0, 0, -1, -1);
      return empty;
    }
    if (this.lastChars == chars && this.lastTokenMetadata == tokenMetadata && this.lastDecorationStyleSetId == decorationStyleSetId) {
      return this.workGlyph;
    }
    this.lastChars = chars;
    this.lastTokenMetadata = tokenMetadata;
    this.lastDecorationStyleSetId = decorationStyleSetId;
    int devicePixelFontSize = iceil(this.fontSize * this.devicePixelRatio);
    int canvasDim = devicePixelFontSize * 3;
    if (this.canvasWidth != canvasDim) {
      this.canvasWidth = canvasDim;
      this.canvasHeight = canvasDim;
      this.alpha = [];
      int n = canvasDim * canvasDim;
      int i = 0;
      while (i < n) {
        this.alpha.push(0);
        i = i + 1;
      }
    }
    int subPixelXOffset = (tokenMetadata & 15);
    float subPixel = subPixelXOffset * 1.0 / 10.0;
    int originX = devicePixelFontSize + iround(subPixel);
    int originY = devicePixelFontSize;
    TextMetrics metrics = this.getTextMetrics(chars);
    int glyphW = iceil(metrics.width);
    if (glyphW < 1) {
      glyphW = 1;
    }
    int glyphH = iceil(metrics.fontBoundingBoxAscent + metrics.fontBoundingBoxDescent);
    if (glyphH < 1) {
      glyphH = 1;
    }
    this.stampGlyphAlpha(originX, originY, glyphW, glyphH);
    this.findGlyphBoundingBox(this.workGlyph.boundingBox);
    this.workGlyph.originOffset.x = this.workGlyph.boundingBox.left - originX;
    this.workGlyph.originOffset.y = this.workGlyph.boundingBox.top - originY;
    this.workGlyph.fontBoundingBoxAscent = this.textMetrics.fontBoundingBoxAscent;
    this.workGlyph.fontBoundingBoxDescent = this.textMetrics.fontBoundingBoxDescent;
    return this.workGlyph;
  }

  void dispose() {
    this.alpha = [];
    this.canvasWidth = 1;
    this.canvasHeight = 1;
  }
}

export GlyphRasterizer createGlyphRasterizer(float fontSize, string fontFamily, float devicePixelRatio, int id = 1) {
  return new GlyphRasterizer(fontSize, fontFamily, devicePixelRatio, id);
}
