export class TextAreaEditContextRegistryImpl {
  Map<int, int> mapping;

  init() {
    this.mapping = new Map<int, int>();
  }

  void register(int ownerID, int contextId) {
    this.mapping.set(ownerID, contextId);
  }

  void unregister(int ownerID) {
    this.mapping.delete(ownerID);
  }

  int? get(int ownerID) {
    return this.mapping.get(ownerID);
  }
}

TextAreaEditContextRegistryImpl textAreaEditContextRegistry = new TextAreaEditContextRegistryImpl();

export TextAreaEditContextRegistryImpl createTextAreaEditContextRegistry() {
  return new TextAreaEditContextRegistryImpl();
}

export void registerTextAreaEditContext(int ownerID, int contextId) {
  textAreaEditContextRegistry.register(ownerID, contextId);
}

export void unregisterTextAreaEditContext(int ownerID) {
  textAreaEditContextRegistry.unregister(ownerID);
}

export int? getTextAreaEditContext(int ownerID) {
  return textAreaEditContextRegistry.get(ownerID);
}
