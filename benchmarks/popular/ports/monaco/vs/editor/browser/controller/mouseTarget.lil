export enum MouseTargetType {
  UNKNOWN,
  TEXTAREA,
  GUTTER_GLYPH_MARGIN,
  GUTTER_LINE_NUMBERS,
  GUTTER_LINE_DECORATIONS,
  GUTTER_VIEW_ZONE,
  CONTENT_TEXT,
  CONTENT_EMPTY,
  CONTENT_VIEW_ZONE,
  CONTENT_WIDGET,
  OVERVIEW_RULER,
  SCROLLBAR,
  OVERLAY_WIDGET,
  OUTSIDE_EDITOR
}

export enum PartFingerprint {
  None,
  ContentWidgets,
  OverflowingContentWidgets,
  OverflowGuard,
  OverlayWidgets,
  OverflowingOverlayWidgets,
  ScrollableElement,
  TextArea,
  ViewLines,
  Minimap
}

export class HitPos {
  int lineNumber;
  int column;

  init(int lineNumber, int column) {
    this.lineNumber = lineNumber;
    this.column = column;
  }
}

export class HitRange {
  int startLineNumber;
  int startColumn;
  int endLineNumber;
  int endColumn;

  init(int startLineNumber, int startColumn, int endLineNumber, int endColumn) {
    this.startLineNumber = startLineNumber;
    this.startColumn = startColumn;
    this.endLineNumber = endLineNumber;
    this.endColumn = endColumn;
  }
}

export class EditorLayoutInfo {
  int width;
  int height;
  int glyphMarginLeft;
  int glyphMarginWidth;
  int lineNumbersLeft;
  int lineNumbersWidth;
  int decorationsLeft;
  int decorationsWidth;
  int contentLeft;
  int contentWidth;
  int minimapLeft;
  int minimapWidth;
  int verticalScrollbarWidth;
  int horizontalScrollbarHeight;

  init() {
    this.width = 0;
    this.height = 0;
    this.glyphMarginLeft = 0;
    this.glyphMarginWidth = 0;
    this.lineNumbersLeft = 0;
    this.lineNumbersWidth = 0;
    this.decorationsLeft = 0;
    this.decorationsWidth = 0;
    this.contentLeft = 0;
    this.contentWidth = 0;
    this.minimapLeft = 0;
    this.minimapWidth = 0;
    this.verticalScrollbarWidth = 14;
    this.horizontalScrollbarHeight = 12;
  }
}

export class MouseTarget {
  MouseTargetType kind;
  int mouseColumn;
  int lineNumber;
  int column;
  bool hasPosition;
  string outsidePosition;
  int outsideDistance;
  string widgetId;

  init(MouseTargetType kind, int mouseColumn, int lineNumber, int column, bool hasPosition, string outsidePosition, int outsideDistance, string widgetId) {
    this.kind = kind;
    this.mouseColumn = mouseColumn;
    this.lineNumber = lineNumber;
    this.column = column;
    this.hasPosition = hasPosition;
    this.outsidePosition = outsidePosition;
    this.outsideDistance = outsideDistance;
    this.widgetId = widgetId;
  }
}

int nmax(int a, int b) {
  if (a > b) {
    return a;
  }
  return b;
}

int nmin(int a, int b) {
  if (a < b) {
    return a;
  }
  return b;
}

int iabs(int n) {
  if (n < 0) {
    return 0 - n;
  }
  return n;
}

export MouseTarget createUnknown(int mouseColumn, int lineNumber, int column, bool hasPosition) {
  return new MouseTarget(MouseTargetType.UNKNOWN, mouseColumn, lineNumber, column, hasPosition, "", 0, "");
}

export MouseTarget createTextarea(int mouseColumn) {
  return new MouseTarget(MouseTargetType.TEXTAREA, mouseColumn, 0, 0, false, "", 0, "");
}

export MouseTarget createMargin(MouseTargetType kind, int mouseColumn, int lineNumber, int column) {
  return new MouseTarget(kind, mouseColumn, lineNumber, column, true, "", 0, "");
}

export MouseTarget createContentText(int mouseColumn, int lineNumber, int column) {
  return new MouseTarget(MouseTargetType.CONTENT_TEXT, mouseColumn, lineNumber, column, true, "", 0, "");
}

export MouseTarget createContentEmpty(int mouseColumn, int lineNumber, int column) {
  return new MouseTarget(MouseTargetType.CONTENT_EMPTY, mouseColumn, lineNumber, column, true, "", 0, "");
}

export MouseTarget createContentWidget(int mouseColumn, string widgetId) {
  return new MouseTarget(MouseTargetType.CONTENT_WIDGET, mouseColumn, 0, 0, false, "", 0, widgetId);
}

export MouseTarget createOverlayWidget(int mouseColumn, string widgetId) {
  return new MouseTarget(MouseTargetType.OVERLAY_WIDGET, mouseColumn, 0, 0, false, "", 0, widgetId);
}

export MouseTarget createScrollbar(int mouseColumn, int lineNumber, int column) {
  return new MouseTarget(MouseTargetType.SCROLLBAR, mouseColumn, lineNumber, column, true, "", 0, "");
}

export MouseTarget createOutsideEditor(int mouseColumn, int lineNumber, int column, string outsidePosition, int outsideDistance) {
  return new MouseTarget(MouseTargetType.OUTSIDE_EDITOR, mouseColumn, lineNumber, column, true, outsidePosition, outsideDistance, "");
}

export string typeToString(MouseTargetType kind) {
  if (kind == MouseTargetType.TEXTAREA) {
    return "TEXTAREA";
  }
  if (kind == MouseTargetType.GUTTER_GLYPH_MARGIN) {
    return "GUTTER_GLYPH_MARGIN";
  }
  if (kind == MouseTargetType.GUTTER_LINE_NUMBERS) {
    return "GUTTER_LINE_NUMBERS";
  }
  if (kind == MouseTargetType.GUTTER_LINE_DECORATIONS) {
    return "GUTTER_LINE_DECORATIONS";
  }
  if (kind == MouseTargetType.GUTTER_VIEW_ZONE) {
    return "GUTTER_VIEW_ZONE";
  }
  if (kind == MouseTargetType.CONTENT_TEXT) {
    return "CONTENT_TEXT";
  }
  if (kind == MouseTargetType.CONTENT_EMPTY) {
    return "CONTENT_EMPTY";
  }
  if (kind == MouseTargetType.CONTENT_VIEW_ZONE) {
    return "CONTENT_VIEW_ZONE";
  }
  if (kind == MouseTargetType.CONTENT_WIDGET) {
    return "CONTENT_WIDGET";
  }
  if (kind == MouseTargetType.OVERVIEW_RULER) {
    return "OVERVIEW_RULER";
  }
  if (kind == MouseTargetType.SCROLLBAR) {
    return "SCROLLBAR";
  }
  if (kind == MouseTargetType.OVERLAY_WIDGET) {
    return "OVERLAY_WIDGET";
  }
  if (kind == MouseTargetType.OUTSIDE_EDITOR) {
    return "OUTSIDE_EDITOR";
  }
  return "UNKNOWN";
}

export bool isTextAreaPath(int[] path) {
  return path.length == 2 && path[0] == 3 && path[1] == 7;
}

export bool isChildOfViewLines(int[] path) {
  return path.length >= 4 && path[0] == 3 && path[3] == 8;
}

export bool isStrictChildOfViewLines(int[] path) {
  return path.length > 4 && path[0] == 3 && path[3] == 8;
}

export bool isChildOfScrollableElement(int[] path) {
  return path.length >= 2 && path[0] == 3 && path[1] == 6;
}

export bool isChildOfMinimap(int[] path) {
  return path.length >= 2 && path[0] == 3 && path[1] == 9;
}

export bool isChildOfContentWidgets(int[] path) {
  return path.length >= 4 && path[0] == 3 && path[3] == 1;
}

export bool isChildOfOverflowGuard(int[] path) {
  return path.length >= 1 && path[0] == 3;
}

export bool isChildOfOverflowingContentWidgets(int[] path) {
  return path.length >= 1 && path[0] == 2;
}

export bool isChildOfOverlayWidgets(int[] path) {
  return path.length >= 2 && path[0] == 3 && path[1] == 4;
}

export bool isChildOfOverflowingOverlayWidgets(int[] path) {
  return path.length >= 1 && path[0] == 5;
}

int lineAtVerticalOffset(int mouseVerticalOffset, int lineHeight, int lineCount) {
  if (lineHeight <= 0) {
    return 1;
  }
  int line = mouseVerticalOffset / lineHeight + 1;
  if (line < 1) {
    return 1;
  }
  if (line > lineCount) {
    return lineCount;
  }
  return line;
}

int columnFromOffset(int horizontalOffset, int typicalHalfwidthCharacterWidth, int lineLength) {
  int col = 1;
  if (typicalHalfwidthCharacterWidth > 0) {
    col = horizontalOffset / typicalHalfwidthCharacterWidth + 1;
  }
  if (col < 1) {
    col = 1;
  }
  int maxCol = lineLength + 1;
  if (col > maxCol) {
    col = maxCol;
  }
  return col;
}

int mouseColumnFromOffset(int horizontalOffset, int typicalHalfwidthCharacterWidth) {
  if (typicalHalfwidthCharacterWidth <= 0) {
    return 1;
  }
  int col = horizontalOffset / typicalHalfwidthCharacterWidth + 1;
  if (col < 1) {
    return 1;
  }
  return col;
}

export int getLineNumberAtVerticalOffset(int mouseVerticalOffset, int lineHeight, int lineCount) {
  return lineAtVerticalOffset(mouseVerticalOffset, lineHeight, lineCount);
}

export MouseTarget hitTestFromLayout(EditorLayoutInfo layout, int relativeX, int relativeY, int scrollTop, int lineHeight, int typicalHalfwidthCharacterWidth, int lineCount, int lineLength, int[] targetPath) {
  int mouseVerticalOffset = relativeY + scrollTop;
  if (mouseVerticalOffset < 0) {
    mouseVerticalOffset = 0;
  }
  int lineNumber = lineAtVerticalOffset(mouseVerticalOffset, lineHeight, nmax(1, lineCount));
  int mouseColumn = mouseColumnFromOffset(relativeX - layout.contentLeft, typicalHalfwidthCharacterWidth);
  if (relativeX < 0 || relativeY < 0 || relativeX > layout.width || relativeY > layout.height) {
    string outsidePosition = "below";
    int outsideDistance = 0;
    if (relativeY < 0) {
      outsidePosition = "above";
      outsideDistance = iabs(relativeY);
    } else if (relativeY > layout.height) {
      outsidePosition = "below";
      outsideDistance = relativeY - layout.height;
    } else if (relativeX < 0) {
      outsidePosition = "left";
      outsideDistance = iabs(relativeX);
    } else {
      outsidePosition = "right";
      outsideDistance = relativeX - layout.width;
    }
    int col = columnFromOffset(relativeX - layout.contentLeft, typicalHalfwidthCharacterWidth, lineLength);
    return createOutsideEditor(mouseColumn, lineNumber, col, outsidePosition, outsideDistance);
  }
  if (isTextAreaPath(targetPath)) {
    return createTextarea(mouseColumn);
  }
  if (isChildOfContentWidgets(targetPath) || isChildOfOverflowingContentWidgets(targetPath)) {
    return createContentWidget(mouseColumn, "");
  }
  if (isChildOfOverlayWidgets(targetPath) || isChildOfOverflowingOverlayWidgets(targetPath)) {
    return createOverlayWidget(mouseColumn, "");
  }
  if (isChildOfMinimap(targetPath)) {
    int maxCol = lineLength + 1;
    return createScrollbar(mouseColumn, lineNumber, maxCol);
  }
  int x = relativeX;
  if (x >= layout.glyphMarginLeft && x < layout.glyphMarginLeft + layout.glyphMarginWidth) {
    return createMargin(MouseTargetType.GUTTER_GLYPH_MARGIN, mouseColumn, lineNumber, 1);
  }
  if (x >= layout.lineNumbersLeft && x < layout.lineNumbersLeft + layout.lineNumbersWidth) {
    return createMargin(MouseTargetType.GUTTER_LINE_NUMBERS, mouseColumn, lineNumber, 1);
  }
  if (x >= layout.decorationsLeft && x < layout.decorationsLeft + layout.decorationsWidth) {
    return createMargin(MouseTargetType.GUTTER_LINE_DECORATIONS, mouseColumn, lineNumber, 1);
  }
  int contentLeft = layout.contentLeft;
  int contentRight = layout.contentLeft + layout.contentWidth - layout.verticalScrollbarWidth;
  if (x >= contentRight) {
    int maxCol = lineLength + 1;
    return createScrollbar(mouseColumn, lineNumber, maxCol);
  }
  if (x >= contentLeft && x < contentRight) {
    int horizontal = x - contentLeft;
    int col = columnFromOffset(horizontal, typicalHalfwidthCharacterWidth, lineLength);
    int lineWidth = lineLength * typicalHalfwidthCharacterWidth;
    if (lineLength == 0) {
      return createContentEmpty(mouseColumn, lineNumber, 1);
    }
    if (horizontal >= lineWidth) {
      return createContentEmpty(mouseColumn, lineNumber, lineLength + 1);
    }
    return createContentText(mouseColumn, lineNumber, col);
  }
  if (isChildOfViewLines(targetPath)) {
    int col = columnFromOffset(x - contentLeft, typicalHalfwidthCharacterWidth, lineLength);
    return createContentText(mouseColumn, lineNumber, col);
  }
  return createUnknown(mouseColumn, lineNumber, 1, true);
}

export MouseTarget createMouseTarget(EditorLayoutInfo layout, int mouseX, int mouseY, int editorLeft, int editorTop, int scrollTop, int lineHeight, int typicalHalfwidthCharacterWidth, int lineCount, int lineLength) {
  int[] emptyPath = [];
  return hitTestFromLayout(layout, mouseX - editorLeft, mouseY - editorTop, scrollTop, lineHeight, typicalHalfwidthCharacterWidth, lineCount, lineLength, emptyPath);
}

export EditorLayoutInfo createEditorLayoutInfo() {
  return new EditorLayoutInfo();
}

export MouseTargetFactory createMouseTargetFactory() {
  return new MouseTargetFactory();
}

export class MouseTargetFactory {
  init() {
  }

  MouseTarget createMouseTargetFromLayout(EditorLayoutInfo layout, int relativeX, int relativeY, int scrollTop, int lineHeight, int typicalHalfwidthCharacterWidth, int lineCount, int lineLength, int[] targetPath) {
    return hitTestFromLayout(layout, relativeX, relativeY, scrollTop, lineHeight, typicalHalfwidthCharacterWidth, lineCount, lineLength, targetPath);
  }
}
