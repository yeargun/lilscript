int BLINK_HIDDEN = 0;
int BLINK_BLINK = 1;
int BLINK_SMOOTH = 2;
int BLINK_PHASE = 3;
int BLINK_EXPAND = 4;
int BLINK_SOLID = 5;
int BLINK_INTERVAL = 500;
int CURSOR_LINE = 1;
int CURSOR_LINE_THIN = 4;

int imin(int a, int b) {
  if (a < b) {
    return a;
  }
  return b;
}

export class CursorPosition {
  int lineNumber;
  int column;

  init(int lineNumber, int column) {
    this.lineNumber = lineNumber;
    this.column = column;
  }
}

export class CursorRender {
  int top;
  int left;
  int width;
  int height;
  int plurality;

  init(int top, int left, int width, int height, int plurality) {
    this.top = top;
    this.left = left;
    this.width = width;
    this.height = height;
    this.plurality = plurality;
  }
}

export class ViewCursors {
  bool readOnly;
  int cursorBlinking;
  int cursorStyle;
  bool editorHasFocus;
  bool isComposingInput;
  bool editContextEnabled;
  bool selectionIsEmpty;
  bool blinkingEnabled;
  CursorPosition[] positions;
  CursorRender[] renderData;
  float typicalHalfwidthCharacterWidth;
  int lineCursorWidth;
  int lineHeight;

  init(bool readOnly, int cursorBlinking, int cursorStyle, float typicalHalfwidthCharacterWidth, int lineCursorWidth, int lineHeight) {
    this.readOnly = readOnly;
    this.cursorBlinking = cursorBlinking;
    this.cursorStyle = cursorStyle;
    this.typicalHalfwidthCharacterWidth = typicalHalfwidthCharacterWidth;
    this.lineCursorWidth = lineCursorWidth;
    this.lineHeight = lineHeight;
    this.editorHasFocus = false;
    this.isComposingInput = false;
    this.editContextEnabled = true;
    this.selectionIsEmpty = true;
    this.blinkingEnabled = false;
    this.positions = [new CursorPosition(1, 1)];
    this.renderData = [];
  }

  int getCursorBlinking() {
    if (this.isComposingInput && !this.editContextEnabled) {
      return BLINK_HIDDEN;
    }
    if (!this.editorHasFocus) {
      return BLINK_HIDDEN;
    }
    if (this.readOnly) {
      return BLINK_SOLID;
    }
    return this.cursorBlinking;
  }

  void updateBlinking() {
    int style = this.getCursorBlinking();
    this.blinkingEnabled = style != BLINK_HIDDEN && style != BLINK_SOLID;
  }

  void setPositions(CursorPosition[] positions) {
    if (positions.length == 0) {
      this.positions = [new CursorPosition(1, 1)];
      return;
    }
    this.positions = positions;
  }

  void prepareRender(int scrollTop, int viewportStartLine, int viewportEndLine) {
    this.renderData = [];
    int i = 0;
    while (i < this.positions.length) {
      CursorPosition pos = this.positions[i];
      if (pos.lineNumber >= viewportStartLine && pos.lineNumber <= viewportEndLine) {
        int width = this.lineCursorWidth;
        if (this.cursorStyle == CURSOR_LINE_THIN) {
          width = 1;
        } else {
          if (width <= 0) {
            width = 2;
          }
        }
        int left = ((pos.column - 1) * 1.0 * this.typicalHalfwidthCharacterWidth).round().toInt();
        int top = (pos.lineNumber - 1) * this.lineHeight - scrollTop;
        int plurality = 0;
        if (this.positions.length > 1) {
          if (i == 0) {
            plurality = 1;
          } else {
            plurality = 2;
          }
        }
        this.renderData.push(new CursorRender(top, left, width, this.lineHeight, plurality));
      }
      i = i + 1;
    }
  }
}

export CursorPosition createCursorPosition(int lineNumber, int column) {
  return new CursorPosition(lineNumber, column);
}

export ViewCursors createViewCursors(bool readOnly, int cursorBlinking, int cursorStyle, float typicalHalfwidthCharacterWidth, int lineCursorWidth, int lineHeight) {
  return new ViewCursors(readOnly, cursorBlinking, cursorStyle, typicalHalfwidthCharacterWidth, lineCursorWidth, lineHeight);
}
