int imin(int a, int b) {
  if (a < b) {
    return a;
  }
  return b;
}

int imax(int a, int b) {
  if (a > b) {
    return a;
  }
  return b;
}

export class DecorationToRender {
  int startLineNumber;
  int endLineNumber;
  string className;
  int zIndex;

  init(int startLineNumber, int endLineNumber, string className, int zIndex) {
    this.startLineNumber = startLineNumber;
    this.endLineNumber = endLineNumber;
    this.className = className;
    this.zIndex = zIndex;
  }
}

export class LineDecorationToRender {
  string className;
  int zIndex;

  init(string className, int zIndex) {
    this.className = className;
    this.zIndex = zIndex;
  }
}

int compareDecorations(DecorationToRender a, DecorationToRender b) {
  if (a.className == b.className) {
    if (a.startLineNumber == b.startLineNumber) {
      return a.endLineNumber - b.endLineNumber;
    }
    return a.startLineNumber - b.startLineNumber;
  }
  if (a.className < b.className) {
    return -1;
  }
  return 1;
}

LineDecorationToRender[][] dedupRender(int visibleStartLineNumber, int visibleEndLineNumber, DecorationToRender[] decorations) {
  LineDecorationToRender[][] output = [];
  int lineNumber = visibleStartLineNumber;
  while (lineNumber <= visibleEndLineNumber) {
    LineDecorationToRender[] row = [];
    output.push(row);
    lineNumber = lineNumber + 1;
  }
  if (decorations.length == 0) {
    return output;
  }
  int i = 1;
  while (i < decorations.length) {
    DecorationToRender key = decorations[i];
    int j = i - 1;
    while (j >= 0 && compareDecorations(decorations[j], key) > 0) {
      decorations[j + 1] = decorations[j];
      j = j - 1;
    }
    decorations[j + 1] = key;
    i = i + 1;
  }
  string prevClassName = "";
  int prevEndLineIndex = 0;
  bool hasPrev = false;
  i = 0;
  while (i < decorations.length) {
    DecorationToRender d = decorations[i];
    int startLineIndex = imax(d.startLineNumber, visibleStartLineNumber) - visibleStartLineNumber;
    int endLineIndex = imin(d.endLineNumber, visibleEndLineNumber) - visibleStartLineNumber;
    if (hasPrev && prevClassName == d.className) {
      startLineIndex = imax(prevEndLineIndex + 1, startLineIndex);
      prevEndLineIndex = imax(prevEndLineIndex, endLineIndex);
    } else {
      prevClassName = d.className;
      prevEndLineIndex = endLineIndex;
      hasPrev = true;
    }
    int lineIndex = startLineIndex;
    while (lineIndex <= prevEndLineIndex) {
      if (lineIndex >= 0 && lineIndex < output.length) {
        output[lineIndex].push(new LineDecorationToRender(d.className, d.zIndex));
      }
      lineIndex = lineIndex + 1;
    }
    i = i + 1;
  }
  return output;
}

export class MarginViewLineDecorationsOverlay {
  string[] renderResult;

  init() {
    this.renderResult = [];
  }

  void prepareRender(int visibleStartLineNumber, int visibleEndLineNumber, DecorationToRender[] decorations) {
    LineDecorationToRender[][] toRender = dedupRender(visibleStartLineNumber, visibleEndLineNumber, decorations);
    this.renderResult = [];
    int lineIndex = 0;
    while (lineIndex < toRender.length) {
      LineDecorationToRender[] row = toRender[lineIndex];
      string lineOutput = "";
      int i = 0;
      while (i < row.length) {
        lineOutput = lineOutput + "<div class=\"cmdr " + row[i].className + "\" style=\"\"></div>";
        i = i + 1;
      }
      this.renderResult.push(lineOutput);
      lineIndex = lineIndex + 1;
    }
  }

  string render(int startLineNumber, int lineNumber) {
    int lineIndex = lineNumber - startLineNumber;
    if (lineIndex < 0 || lineIndex >= this.renderResult.length) {
      return "";
    }
    return this.renderResult[lineIndex];
  }
}

export DecorationToRender createMarginDecorationToRender(int startLineNumber, int endLineNumber, string className, int zIndex) {
  return new DecorationToRender(startLineNumber, endLineNumber, className, zIndex);
}

export MarginViewLineDecorationsOverlay createMarginViewLineDecorationsOverlay() {
  return new MarginViewLineDecorationsOverlay();
}
