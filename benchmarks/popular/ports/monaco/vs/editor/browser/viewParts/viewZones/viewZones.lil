int imax(int a, int b) {
  if (a > b) {
    return a;
  }
  return b;
}

export class ViewZone {
  int id;
  int afterLineNumber;
  int ordinal;
  int heightInPx;
  int minWidthInPx;
  bool isInHiddenArea;

  init(int id, int afterLineNumber, int ordinal, int heightInPx, int minWidthInPx) {
    this.id = id;
    this.afterLineNumber = afterLineNumber;
    this.ordinal = ordinal;
    this.heightInPx = heightInPx;
    this.minWidthInPx = minWidthInPx;
    this.isInHiddenArea = false;
  }
}

export class ZoneLayout {
  int id;
  int afterLineNumber;
  int verticalOffset;
  int height;
  int top;

  init(int id, int afterLineNumber, int verticalOffset, int height, int top) {
    this.id = id;
    this.afterLineNumber = afterLineNumber;
    this.verticalOffset = verticalOffset;
    this.height = height;
    this.top = top;
  }
}

export class ViewZones {
  int lineHeight;
  int contentWidth;
  int contentLeft;
  int lastId;
  ViewZone[] zones;

  init(int lineHeight, int contentWidth, int contentLeft) {
    this.lineHeight = lineHeight;
    this.contentWidth = contentWidth;
    this.contentLeft = contentLeft;
    this.lastId = 0;
    this.zones = [];
  }

  int heightInPixels(int heightInPx, int heightInLines) {
    if (heightInPx > 0) {
      return heightInPx;
    }
    if (heightInLines > 0) {
      return this.lineHeight * heightInLines;
    }
    return this.lineHeight;
  }

  int addZone(int afterLineNumber, int ordinal, int heightInPx, int heightInLines, int minWidthInPx) {
    this.lastId = this.lastId + 1;
    int height = this.heightInPixels(heightInPx, heightInLines);
    this.zones.push(new ViewZone(this.lastId, afterLineNumber, ordinal, height, minWidthInPx));
    this.sortZones();
    return this.lastId;
  }

  bool removeZone(int id) {
    int i = 0;
    while (i < this.zones.length) {
      if (this.zones[i].id == id) {
        this.zones.splice(i, 1);
        return true;
      }
      i = i + 1;
    }
    return false;
  }

  void sortZones() {
    int i = 1;
    while (i < this.zones.length) {
      ViewZone key = this.zones[i];
      int j = i - 1;
      while (j >= 0 && (this.zones[j].afterLineNumber > key.afterLineNumber || (this.zones[j].afterLineNumber == key.afterLineNumber && this.zones[j].ordinal > key.ordinal))) {
        this.zones[j + 1] = this.zones[j];
        j = j - 1;
      }
      this.zones[j + 1] = key;
      i = i + 1;
    }
  }

  int whitespaceTotalHeight() {
    int total = 0;
    int i = 0;
    while (i < this.zones.length) {
      if (!this.zones[i].isInHiddenArea) {
        total = total + this.zones[i].heightInPx;
      }
      i = i + 1;
    }
    return total;
  }

  int verticalOffsetForLine(int lineNumber) {
    int offset = (lineNumber - 1) * this.lineHeight;
    int i = 0;
    while (i < this.zones.length) {
      ViewZone zone = this.zones[i];
      if (!zone.isInHiddenArea && zone.afterLineNumber < lineNumber) {
        offset = offset + zone.heightInPx;
      }
      i = i + 1;
    }
    return offset;
  }

  ZoneLayout[] layout(int scrollTop, int viewportHeight) {
    ZoneLayout[] result = [];
    int i = 0;
    while (i < this.zones.length) {
      ViewZone zone = this.zones[i];
      if (!zone.isInHiddenArea && zone.heightInPx > 0) {
        int verticalOffset = this.verticalOffsetForLine(zone.afterLineNumber + 1) - zone.heightInPx;
        if (zone.afterLineNumber == 0) {
          verticalOffset = 0;
        }
        int top = verticalOffset - scrollTop;
        if (top + zone.heightInPx > 0 && top < viewportHeight) {
          result.push(new ZoneLayout(zone.id, zone.afterLineNumber, verticalOffset, zone.heightInPx, top));
        }
      }
      i = i + 1;
    }
    return result;
  }
}

export ViewZones createViewZones(int lineHeight, int contentWidth, int contentLeft) {
  return new ViewZones(lineHeight, contentWidth, contentLeft);
}
