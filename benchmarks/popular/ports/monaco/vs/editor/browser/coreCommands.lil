export CursorState triggerCommand(string id, CursorState state, string[] lines, int pageSize) {
  if (id == "cursorLeft") {
    return cursorLeft(state, lines, false);
  }
  if (id == "cursorLeftSelect") {
    return cursorLeft(state, lines, true);
  }
  if (id == "cursorRight") {
    return cursorRight(state, lines, false);
  }
  if (id == "cursorRightSelect") {
    return cursorRight(state, lines, true);
  }
  if (id == "cursorUp") {
    return cursorUp(state, lines, false);
  }
  if (id == "cursorUpSelect") {
    return cursorUp(state, lines, true);
  }
  if (id == "cursorDown") {
    return cursorDown(state, lines, false);
  }
  if (id == "cursorDownSelect") {
    return cursorDown(state, lines, true);
  }
  if (id == "cursorHome" || id == "cursorHomeSelect" && false) {
    return cursorHome(state, lines, false);
  }
  if (id == "cursorHomeSelect") {
    return cursorHome(state, lines, true);
  }
  if (id == "cursorEnd") {
    return cursorEnd(state, lines, false);
  }
  if (id == "cursorEndSelect") {
    return cursorEnd(state, lines, true);
  }
  if (id == "cursorLineStart") {
    return cursorLineStart(state, lines, false);
  }
  if (id == "cursorLineEnd") {
    return cursorLineEnd(state, lines, false);
  }
  if (id == "cursorTop") {
    return cursorTop(state, lines, false);
  }
  if (id == "cursorTopSelect") {
    return cursorTop(state, lines, true);
  }
  if (id == "cursorBottom") {
    return cursorBottom(state, lines, false);
  }
  if (id == "cursorBottomSelect") {
    return cursorBottom(state, lines, true);
  }
  if (id == "cursorPageUp") {
    return cursorPageUp(state, lines, pageSize, false);
  }
  if (id == "cursorPageUpSelect") {
    return cursorPageUp(state, lines, pageSize, true);
  }
  if (id == "cursorPageDown") {
    return cursorPageDown(state, lines, pageSize, false);
  }
  if (id == "cursorPageDownSelect") {
    return cursorPageDown(state, lines, pageSize, true);
  }
  if (id == "cancelSelection") {
    return cancelSelection(state, lines);
  }
  if (id == "selectAll") {
    return selectAll(lines);
  }
  return clampCursor(state, lines);
}

export TypeResult triggerEditCommand(string id, CursorState state, string[] lines, string text, int tabSize) {
  if (id == "type") {
    return typeText(state, lines, text);
  }
  if (id == "deleteLeft") {
    return deleteLeft(state, lines);
  }
  if (id == "deleteRight") {
    return deleteRight(state, lines);
  }
  if (id == "tab") {
    return tabIndent(state, lines, tabSize);
  }
  if (id == "outdent") {
    return outdent(state, lines, tabSize);
  }
  return new TypeResult(lines, clampCursor(state, lines));
}

export string joinLineTexts(string[] lines) {
  return joinLines(lines);
}

export CursorState createCursorState(int sl, int sc, int pl, int pc) {
  return new CursorState(sl, sc, pl, pc);
}
