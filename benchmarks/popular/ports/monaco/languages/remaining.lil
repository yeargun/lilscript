import { Lexer, createLexer, addRule, wsRe } from "../editor/monarch";
import { Language, registerLanguage } from "./registry";
import { emptyBuf } from "../js-host";

Lexer keywordLexer(string id, string postfix, string[] keywords, string lineComment) {
  Lexer lex = createLexer(id, postfix, "", keywords);
  addRule(lex, "root", wsRe(), 0, "", "", false);
  if (lineComment.length > 0) {
    string escaped = emptyBuf();
    int c = 0;
    while (c < lineComment.length) {
      string ch = lineComment.charAt(c);
      if (ch == "/" || ch == "*" || ch == "-" || ch == "+" || ch == "?" || ch == "." || ch == "(" || ch == ")" || ch == "[" || ch == "]" || ch == "{" || ch == "}" || ch == "^" || ch == "$" || ch == "|" || ch == "\\") {
        escaped = escaped + "\\" + ch;
      } else {
        escaped = escaped + ch;
      }
      c++;
    }
    addRule(lex, "root", escaped + ".*", 0, "comment", "", false);
  }
  addRule(lex, "root", "/\\*", 1, "comment", "comment", false);
  addRule(lex, "root", "\"", 1, "string", "string", false);
  addRule(lex, "root", "'", 1, "string", "stringS", false);
  addRule(lex, "root", "\\d+", 0, "number", "", false);
  addRule(lex, "root", "[a-zA-Z_][\\w]*", 4, "identifier", "", false);
  addRule(lex, "root", ".", 0, "", "", false);
  addRule(lex, "comment", "\\*/", 2, "comment", "", false);
  addRule(lex, "comment", "[^*]+", 0, "comment", "", false);
  addRule(lex, "comment", "\\*", 0, "comment", "", false);
  addRule(lex, "string", "\"", 2, "string", "", false);
  addRule(lex, "string", "[^\\\\\"]+", 0, "string", "", false);
  addRule(lex, "stringS", "'", 2, "string", "", false);
  addRule(lex, "stringS", "[^']+", 0, "string", "", false);
  return lex;
}

