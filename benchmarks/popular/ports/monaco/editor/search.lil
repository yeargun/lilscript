import { PieceTreeBase } from "./piece-tree";
import { Rng, createRange } from "../base/range";
import { newRegexp, regexExec, emptyBuf, concat2 } from "../js-host";

export class FindMatch {
  Rng range;
  string[] matches;

  init(Rng range, string[] matches) {
    this.range = range;
    this.matches = matches;
  }
}

export class Searcher {
  Regex re;

  init(string source, string flags) {
    this.re = newRegexp(source, flags);
  }

  JsValue next(string text) {
    return regexExec(this.re, text);
  }
}

export string escapeRegExpCharacters(string searchString) {
  string source = emptyBuf();
  int i = 0;
  while (i < searchString.length) {
    string ch = searchString.charAt(i);
    if (
      ch == "\\" || ch == "^" || ch == "$" || ch == "." || ch == "|" || ch == "?"
      || ch == "*" || ch == "+" || ch == "(" || ch == ")" || ch == "[" || ch == "]"
      || ch == "{" || ch == "}"
    ) {
      source = concat2(concat2(source, "\\"), ch);
    } else {
      source = concat2(source, ch);
    }
    i++;
  }
  return source;
}

export Searcher createSearcher(string searchString, bool isRegex, bool matchCase, bool wholeWord) {
  string flags = "g";
  if (!matchCase) {
    flags = "gi";
  }
  string source = searchString;
  if (!isRegex) {
    source = escapeRegExpCharacters(searchString);
  }
  if (wholeWord) {
    source = concat2(concat2("\\b(?:", source), ")\\b");
  }
  return new Searcher(source, flags);
}

export FindMatch[] findMatches(
  PieceTreeBase tree,
  string searchString,
  bool isRegex,
  bool matchCase,
  bool wholeWord,
  int limit
) {
  FindMatch[] result = [];
  int[] packed = tree.findMatchesLineByLine(searchString, isRegex, matchCase, wholeWord, limit);
  int i = 0;
  while (i + 2 < packed.length) {
    result.push(new FindMatch(createRange(packed[i], packed[i + 1], packed[i], packed[i + 2]), []));
    i = i + 3;
  }
  return result;
}
