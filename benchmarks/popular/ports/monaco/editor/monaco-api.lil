  DiffEditor,
  TextModel
} from "./standalone";
import { liftPosition, Pos } from "../base/position";
import { liftRange } from "../base/range";
import { liftSelection } from "../base/selection";
import { parseUri, fileUri, Uri } from "../base/uri";
import { WordRange } from "./word";
import { Marker, MarkerSeverityHint, MarkerSeverityInfo, MarkerSeverityWarning, MarkerSeverityError } from "./markers";
import { Emitter } from "../base/lifecycle";
