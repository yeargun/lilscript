  languagesRegisterCodeAction,
  languagesRegisterCodeLens,
  languagesRegisterColor,
  languagesRegisterHighlight,
  languagesRegisterInlayHints,
  languagesRegisterInlineCompletions,
  languagesRegisterKind,
  editorGetValue,
