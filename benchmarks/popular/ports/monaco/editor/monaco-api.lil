  editorGetModel,
  editorSetModel,
  editorGetPosition,
  editorSetPosition,
  editorGetSelection,
  editorSetSelection,
  editorTrigger,
  editorLayout,
  editorLayoutSize,
  editorDispose,
  editorFocus,
  editorExecuteEdits,
  editorDeltaDecorations,
  editorRevealLine,
  editorAddAction,
  editorSetModelFacade,
  editorOnDidChangeModelContent,
  editorOnDidChangeCursorPosition,
  onDidCreateEditor,
  onDidCreateDiffEditor,
  registerLanguageId,
  setLanguageConfigurationJs,
  setTokensProviderJs,
  modelGetValue,
  modelSetValue,
  modelGetLineCount,
  modelGetLineContent,
  modelGetOffsetAt,
  modelGetPositionAt,
  modelGetLanguageId,
  modelGetVersionId,
  modelUriString,
  modelFindMatches,
  modelApplyEdits,
