enum NodeColor {
  Black,
  Red
}

struct BufferCursor {
  int line;
  int column;
}

struct Piece {
  int bufferIndex;
  BufferCursor start;
  BufferCursor end;
  int lineFeedCnt;
  int length;
}

Piece emptyPiece = Piece{0, BufferCursor{0, 0}, BufferCursor{0, 0}, 0, 0};

class TreeNode {
  TreeNode parent;
  TreeNode left;
  TreeNode right;
  NodeColor color;
  Piece piece;
  int size_left;
  int lf_left;
  bool alive;

  init(Piece piece, NodeColor color) {
    this.piece = piece;
    this.color = color;
    this.size_left = 0;
    this.lf_left = 0;
    this.alive = true;
    this.parent = this;
    this.left = this;
    this.right = this;
  }

  void detach() {
    this.alive = false;
    this.parent = this;
    this.left = this;
    this.right = this;
  }
}

TreeNode SENTINEL = new TreeNode(emptyPiece, NodeColor.Black);

TreeNode leftest(TreeNode node) {
  TreeNode cur = node;
  while (cur.left != SENTINEL) {
    cur = cur.left;
  }
  return cur;
}

TreeNode righttest(TreeNode node) {
  TreeNode cur = node;
  while (cur.right != SENTINEL) {
    cur = cur.right;
  }
  return cur;
}

TreeNode nodeNext(TreeNode node) {
  if (node.right != SENTINEL) {
    return leftest(node.right);
  }
  TreeNode cur = node;
  int guard = 0;
  while (cur.parent != SENTINEL && guard < 100000) {
    guard++;
    if (cur.parent.left == cur) {
      break;
    }
    cur = cur.parent;
  }
  if (cur.parent == SENTINEL || guard >= 100000) {
    return SENTINEL;
  }
  return cur.parent;
}

TreeNode nodePrev(TreeNode node) {
  if (node.left != SENTINEL) {
    return righttest(node.left);
  }
  TreeNode cur = node;
  while (cur.parent != SENTINEL) {
    if (cur.parent.right == cur) {
      break;
    }
    cur = cur.parent;
  }
  if (cur.parent == SENTINEL) {
    return SENTINEL;
  }
  return cur.parent;
}

int calculateSize(TreeNode node) {
  if (node == SENTINEL) {
    return 0;
  }
  return node.size_left + node.piece.length + calculateSize(node.right);
}

int calculateLF(TreeNode node) {
  if (node == SENTINEL) {
    return 0;
  }
  return node.lf_left + node.piece.lineFeedCnt + calculateLF(node.right);
}

export {
  NodeColor,
  BufferCursor,
  Piece,
  emptyPiece,
  TreeNode,
  SENTINEL,
  leftest,
  righttest,
  nodeNext,
  nodePrev,
  calculateSize,
  calculateLF
};
