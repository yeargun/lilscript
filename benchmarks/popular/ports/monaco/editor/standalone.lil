}

export void editorSetModel(CodeEditor editor, TextModel model) {
  editor.setModel(model);
}

export int editorLineCount(CodeEditor editor) {
  return editor.getModel().getLineCount();
}

export Pos editorGetPosition(CodeEditor editor) {
  return editor.getPosition();
}

export void editorSetPosition(CodeEditor editor, Pos pos) {
  editor.setPosition(pos);
}

export Sel editorGetSelection(CodeEditor editor) {
  return editor.getSelection();
