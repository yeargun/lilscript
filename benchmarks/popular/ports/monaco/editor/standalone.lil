}

export func()->void onDidCreateEditor(func()->void listener) {
  return createEmitter.event(listener);
}

export void registerLanguageId(string id) {
  registerPopularLanguages();
  Language? existing = getLanguage(id);
  if (existing != null) {
    return;
  }
  Language? plain = getLanguage("plaintext");
  if (plain != null) {
    registerLanguage(new Language(id, plain.lexer, "", "", ""));
  }
}

export void setLanguageConfigurationJs(string id, JsValue config) {
  Language? lang = getLanguage(id);
  if (lang == null || !config.truthy()) {
    return;
  }
  JsValue comments = config["comments"];
  if (comments.truthy()) {
    if (comments["lineComment"].truthy()) {
      lang.lineComment = JS.string(comments["lineComment"]);
    }
    if (comments["blockComment"].truthy()) {
      JsValue block = comments["blockComment"];
      if (block[0].truthy()) {
        lang.blockCommentStart = JS.string(block[0]);
      }
      if (block[1].truthy()) {
        lang.blockCommentEnd = JS.string(block[1]);
      }
    }
  }
}

export void setTokensProviderJs(string id, JsValue provider) {
  registerLanguageId(id);
  Language? lang = getLanguage(id);
  if (lang != null) {
    lang.tokensProvider = provider;
  }
}

