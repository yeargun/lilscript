import {
  addEventListener,
  domCreateElement,
  appendChild,
  setStyle,
  setClassName,
  setInnerHTML,
  focusElement,
  preventDefault,
  eventKey,
  eventCtrlKey,
  eventShiftKey,
  eventClientX,
  eventClientY,
  eventButton,
  eventDetail,
  hostCall,
  jsUndefined,
  eventAltKey,
  eventIsComposing,
  inputSetValue
} from "../js-host";
import { TextModel, createModel, createModelWithUri, getModels, editOp, deco } from "./text-model";
import { IdentifiedEdit } from "./edit-stack";
import { EditorView, createView } from "./view";
import { triggerCommand, handleKeydown, handlePasteEvent, handleCopyEvent, handleCutEvent, typeText, setPosition, setSel, selectedText } from "./commands";
import { runEditorAction, acceptSuggest, moveSuggest, hideSuggest, hideHover, showHover, acceptGoto, acceptRename, hideContext, showContext, openFind, findNext, closeFind, replaceOne, replaceAll } from "../contrib/runtime";
import { Emitter } from "../base/lifecycle";
import { Pos } from "../base/position";
import { Rng, createRange } from "../base/range";
import { Sel, createSelection } from "../base/selection";
import { Uri } from "../base/uri";
import { registerPopularLanguages, getLanguage, getLexer, languageIds, registerLanguage, Language } from "../languages/registry";
import { DiffChange, computeLineDiff } from "./myers";
import { Decoration } from "./interval-tree";
import { FindMatch } from "./search";
import { WordRange } from "./word";
import { Marker, setModelMarkers as storeMarkers, getModelMarkers as loadMarkers, removeAllMarkers as clearMarkers, markerFromJs } from "./markers";
import { registerProvider } from "../languages/providers";

string currentTheme = "vs";

class EditorAction {
  string id;
  string label;
  JsValue run;

  init(string id, string label, JsValue run) {
    this.id = id;
    this.label = label;
    this.run = run;
  }
}

string optString(JsValue options, string key, string fallback) {
  if (!options.truthy()) {
    return fallback;
  }
  JsValue v = options[key];
  if (!v.truthy()) {
    return fallback;
  }
  return JS.string(v);
}

bool optBool(JsValue options, string key, bool fallback) {
  if (!options.truthy()) {
    return fallback;
  }
  JsValue v = options[key];
  if (!v.truthy()) {
    return fallback;
  }
  if (JS.string(v) == "false") {
    return false;
  }
  if (JS.string(v) == "off") {
    return false;
  }
  return true;
}

int optInt(JsValue options, string key, int fallback) {
  if (!options.truthy()) {
    return fallback;
  }
  JsValue v = options[key];
  if (!v.truthy()) {
    return fallback;
  }
  return JS.number(v).toInt();
}

export class CodeEditor {
  EditorView view;
  Emitter contentEmitter;
  Emitter cursorEmitter;
  bool disposed;
  EditorAction[] actions;
  JsValue modelFacade;

  init(EditorView view) {
    this.view = view;
    this.contentEmitter = new Emitter();
    this.cursorEmitter = new Emitter();
    this.disposed = false;
    this.actions = [];
    this.modelFacade = jsUndefined();
    TextModel model = view.model;
    model.onDidChangeContent.event(() => {
      this.contentEmitter.fire();
    });
    this.bindInput();
  }

  void bindInput() {
    EditorView view = this.view;
    addEventListener(view.textarea, "keydown", (JsValue ev) => {
      if (view.suggestOpen) {
        string key = eventKey(ev);
        if (key == "ArrowDown") {
          preventDefault(ev);
          moveSuggest(view, 1);
          return;
        }
        if (key == "ArrowUp") {
          preventDefault(ev);
          moveSuggest(view, -1);
          return;
        }
        if (key == "Enter" || key == "Tab") {
          preventDefault(ev);
          acceptSuggest(view);
          return;
        }
        if (key == "Escape") {
          preventDefault(ev);
          hideSuggest(view);
          return;
        }
      }
      if (eventCtrlKey(ev) && eventKey(ev) == "f") {
        preventDefault(ev);
        openFind(view, false);
        return;
      }
      if (eventCtrlKey(ev) && eventKey(ev) == "h") {
        preventDefault(ev);
        openFind(view, true);
        return;
      }
      if (eventCtrlKey(ev) && eventKey(ev) == "g") {
        preventDefault(ev);
        this.trigger("keyboard", "editor.action.gotoLine", jsUndefined());
        return;
      }
      if (eventCtrlKey(ev) && eventKey(ev) == " ") {
        preventDefault(ev);
        this.trigger("keyboard", "editor.action.triggerSuggest", jsUndefined());
        return;
      }
      if (eventCtrlKey(ev) && eventKey(ev) == "/") {
        preventDefault(ev);
        this.trigger("keyboard", "editor.action.commentLine", jsUndefined());
        return;
      }
      if (eventCtrlKey(ev) && (eventKey(ev) == "d" || eventKey(ev) == "D")) {
        preventDefault(ev);
        this.trigger("keyboard", "editor.action.addSelectionToNextFindMatch", jsUndefined());
        return;
      }
      if (eventKey(ev) == "F2") {
        preventDefault(ev);
        this.trigger("keyboard", "editor.action.rename", jsUndefined());
        return;
      }
      if (eventKey(ev) == "F12") {
        preventDefault(ev);
        if (eventShiftKey(ev)) {
          this.trigger("keyboard", "editor.action.goToReferences", jsUndefined());
        } else {
          this.trigger("keyboard", "editor.action.goToDefinition", jsUndefined());
        }
        return;
      }
      if (eventKey(ev) == "F8") {
        preventDefault(ev);
        this.trigger("keyboard", "editor.action.marker.next", jsUndefined());
        return;
      }
      if (eventAltKey(ev) && eventShiftKey(ev) && (eventKey(ev) == "f" || eventKey(ev) == "F")) {
        preventDefault(ev);
        this.trigger("keyboard", "editor.action.formatDocument", jsUndefined());
        return;
      }
      if (eventKey(ev) == "Escape") {
        hideSuggest(view);
        hideHover(view);
        hideContext(view);
        closeFind(view);
      }
      handleKeydown(view, ev);
      this.cursorEmitter.fire();
    }, false);
    addEventListener(view.textarea, "compositionend", (JsValue ev) => {
      string composed = JS.string(ev["data"]);
      if (composed.length > 0) {
        typeText(view, composed);
      }
    }, false);
    addEventListener(view.textarea, "input", (JsValue ev) => {
      if (eventIsComposing(ev)) {
        return;
      }
      string value = JS.string(ev["target"]["value"]);
      if (value.length > 0) {
        typeText(view, value);
        inputSetValue(view.textarea, "");
      }
    }, false);
    addEventListener(view.textarea, "paste", (JsValue ev) => {
      handlePasteEvent(view, ev);
    }, false);
    addEventListener(view.textarea, "copy", (JsValue ev) => {
      handleCopyEvent(view, ev);
    }, false);
    addEventListener(view.textarea, "cut", (JsValue ev) => {
      handleCutEvent(view, ev);
    }, false);
    addEventListener(view.scrollable, "scroll", (JsValue ev) => {
      view.scrollTop = JS.number(view.scrollable["scrollTop"]).toInt();
      view.render();
    }, false);
    addEventListener(view.scrollable, "mousedown", (JsValue ev) => {
      hideContext(view);
      hideHover(view);
      Pos pos = view.coordsToPosition(eventClientX(ev), eventClientY(ev));
      int clickLine = pos.lineNumber;
      int clickCol = pos.column;
      int detail = eventDetail(ev);
      view.mouseSelecting = true;
      view.mouseAnchorLine = clickLine;
      view.mouseAnchorColumn = clickCol;
      if (detail >= 3) {
        int lineLen = view.model.getLineLength(clickLine) + 1;
        setSel(view, clickLine, 1, clickLine, lineLen);
      } else if (detail == 2) {
        setPosition(view, clickLine, clickCol);
        this.trigger("keyboard", "cursorWordSelect", jsUndefined());
      } else if (eventAltKey(ev)) {
        view.extraCursors.push(createSelection(clickLine, clickCol, clickLine, clickCol));
      } else if (eventShiftKey(ev)) {
        int sl = view.selection.selectionStartLineNumber;
        int sc = view.selection.selectionStartColumn;
        setSel(view, sl, sc, clickLine, clickCol);
      } else {
        view.extraCursors = [];
        setPosition(view, clickLine, clickCol);
      }
      focusElement(view.textarea);
      view.render();
      this.cursorEmitter.fire();
    }, false);
    addEventListener(view.margin, "mousedown", (JsValue ev) => {
      Pos pos = view.coordsToPosition(eventClientX(ev), eventClientY(ev));
      view.toggleFoldAt(pos.lineNumber);
    }, false);
    addEventListener(view.root, "contextmenu", (JsValue ev) => {
      preventDefault(ev);
      showContext(view, eventClientX(ev), eventClientY(ev));
    }, false);
    addEventListener(view.contextWidget, "mousedown", (JsValue ev) => {
      JsValue t = ev["target"];
      string cmd = JS.string(hostCall(t, "getAttribute", "data-cmd", jsUndefined(), jsUndefined()));
      if (cmd.length > 0 && cmd != "undefined") {
        this.trigger("menu", cmd, jsUndefined());
      }
      hideContext(view);
    }, false);
    addEventListener(view.findWidget, "mousedown", (JsValue ev) => {
      JsValue t = ev["target"];
      string act = JS.string(hostCall(t, "getAttribute", "data-find", jsUndefined(), jsUndefined()));
      if (act == "next") {
        findNext(view, false);
      }
      if (act == "prev") {
        findNext(view, true);
      }
      if (act == "replace") {
        replaceOne(view);
      }
      if (act == "all") {
        replaceAll(view);
      }
    }, false);
    addEventListener(view.findInput, "keydown", (JsValue ev) => {
      if (eventKey(ev) == "Enter") {
        preventDefault(ev);
        findNext(view, eventCtrlKey(ev));
      }
      if (eventKey(ev) == "Escape") {
        preventDefault(ev);
        closeFind(view);
      }
    }, false);
    addEventListener(view.gotoInput, "keydown", (JsValue ev) => {
      if (eventKey(ev) == "Enter") {
        preventDefault(ev);
        acceptGoto(view);
      }
    }, false);
    addEventListener(view.renameInput, "keydown", (JsValue ev) => {
      if (eventKey(ev) == "Enter") {
        preventDefault(ev);
        acceptRename(view);
      }
    }, false);
    addEventListener(view.scrollable, "mousemove", (JsValue ev) => {
      if (view.mouseSelecting) {
        Pos pos = view.coordsToPosition(eventClientX(ev), eventClientY(ev));
        int anchorLine = view.mouseAnchorLine;
        int anchorCol = view.mouseAnchorColumn;
        setSel(view, anchorLine, anchorCol, pos.lineNumber, pos.column);
        view.render();
        this.cursorEmitter.fire();
        return;
      }
      if (eventCtrlKey(ev)) {
        Pos pos = view.coordsToPosition(eventClientX(ev), eventClientY(ev));
        setPosition(view, pos.lineNumber, pos.column);
        showHover(view);
      }
    }, false);
    addEventListener(view.scrollable, "mouseup", (JsValue ev) => {
      view.mouseSelecting = false;
    }, false);
    addEventListener(view.root, "mouseleave", (JsValue ev) => {
      view.mouseSelecting = false;
    }, false);
  }

  string getValue() {
    return this.view.model.getValue();
  }

  void setValue(string value) {
    this.view.model.setValue(value);
    setPosition(this.view, 1, 1);
    this.view.render();
  }

  TextModel getModel() {
    return this.view.model;
  }

  void setModel(TextModel model) {
    this.view.model = model;
    this.view.languageId = model.languageId;
    setPosition(this.view, 1, 1);
    this.view.render();
  }

  Pos getPosition() {
    return new Pos(this.view.selection.positionLineNumber, this.view.selection.positionColumn);
  }

  Sel getSelection() {
    return this.view.selection;
  }

  void setPosition(Pos pos) {
    setPosition(this.view, pos.lineNumber, pos.column);
    this.view.render();
  }

  void setSelection(Sel sel) {
    setSel(this.view, sel.selectionStartLineNumber, sel.selectionStartColumn, sel.positionLineNumber, sel.positionColumn);
    this.view.render();
  }

  void focus() {
    focusElement(this.view.textarea);
  }

  bool hasTextFocus() {
    return true;
  }

  void layout() {
    int w = JS.number(this.view.root["clientWidth"]).toInt();
    int h = JS.number(this.view.root["clientHeight"]).toInt();
    if (w < 1) {
      w = this.view.width;
    }
    if (h < 1) {
      h = this.view.height;
    }
    this.view.layout(w, h);
  }

  void trigger(string source, string handlerId, JsValue payload) {
    string text = "";
    if (payload.truthy() && payload["text"].truthy()) {
      text = JS.string(payload["text"]);
    }
    if (payload.truthy() && payload["lineNumber"].truthy()) {
      int line = JS.number(payload["lineNumber"]).toInt();
      int col = 1;
      if (payload["column"].truthy()) {
        col = JS.number(payload["column"]).toInt();
      }
      setPosition(this.view, line, col);
      this.view.render();
    }
    if (triggerCommand(this.view, handlerId, text)) {
      this.cursorEmitter.fire();
      return;
    }
    if (runEditorAction(this.view, handlerId, text)) {
      this.cursorEmitter.fire();
      return;
    }
    int a = 0;
    while (a < this.actions.length) {
      if (this.actions[a].id == handlerId) {
        this.actions[a].run(this);
        return;
      }
      a++;
    }
  }

  func()->void onDidChangeModelContent(func()->void listener) {
    return this.contentEmitter.event(listener);
  }

  func()->void onDidChangeCursorPosition(func()->void listener) {
    return this.cursorEmitter.event(listener);
  }

  void updateOptions(JsValue options) {
    string theme = optString(options, "theme", this.view.theme);
    this.view.showLineNumbers = optBool(options, "lineNumbers", this.view.showLineNumbers);
    this.view.readOnly = optBool(options, "readOnly", this.view.readOnly);
    this.view.tabSize = optInt(options, "tabSize", this.view.tabSize);
    this.view.insertSpaces = optBool(options, "insertSpaces", this.view.insertSpaces);
    this.view.fontSize = optInt(options, "fontSize", this.view.fontSize);
    this.view.wordWrap = optBool(options, "wordWrap", this.view.wordWrap);
    if (options.truthy() && options["minimap"].truthy()) {
      JsValue mini = options["minimap"];
      this.view.showMinimap = optBool(mini, "enabled", this.view.showMinimap);
    }
    if (theme != this.view.theme) {
      this.view.setTheme(theme);
    } else {
      this.view.render();
    }
  }

  int[] deltaDecorations(int[] oldIds, Decoration[] next) {
    int[] ids = this.view.model.deltaDecorations(oldIds, next);
    this.view.render();
    return ids;
  }

  FindMatch[] findMatches(string searchString, bool isRegex, bool matchCase, bool wholeWord, int limit) {
    return this.view.model.findMatches(searchString, isRegex, matchCase, wholeWord, limit);
  }

  IdentifiedEdit[] executeEdits(IdentifiedEdit[] edits) {
    IdentifiedEdit[] inv = this.view.model.applyEdits(edits, true);
    this.view.render();
    return inv;
  }

  void revealLine(int lineNumber) {
    this.view.revealLine(lineNumber);
    this.view.render();
  }

  void revealPosition(Pos pos) {
    setPosition(this.view, pos.lineNumber, pos.column);
    this.view.render();
  }

  void addAction(string id, string label, JsValue run) {
    this.actions.push(new EditorAction(id, label, run));
  }

  EditorAction? getAction(string id) {
    int i = 0;
    while (i < this.actions.length) {
      if (this.actions[i].id == id) {
        return this.actions[i];
      }
      i++;
    }
    return null;
  }

  void dispose() {
    if (this.disposed) {
      return;
    }
    this.disposed = true;
    this.contentEmitter.dispose();
    this.cursorEmitter.dispose();
  }
}

export class DiffEditor {
  JsValue root;
  CodeEditor original;
  CodeEditor modified;
  DiffChange[] changes;

  init(JsValue root, CodeEditor original, CodeEditor modified) {
    this.root = root;
    this.original = original;
    this.modified = modified;
    this.changes = [];
    this.refresh();
  }

  void refresh() {
  }

  CodeEditor getOriginalEditor() {
    return this.original;
  }

  CodeEditor getModifiedEditor() {
    return this.modified;
  }

  DiffChange[] getLineChanges() {
    return computeLineDiff(this.original.getValue(), this.modified.getValue());
  }

  void layout() {
    this.original.layout();
    this.modified.layout();
  }

  void dispose() {
    this.original.dispose();
    this.modified.dispose();
  }
}

CodeEditor[] editors = [];
DiffEditor[] diffEditors = [];
Emitter createEmitter = new Emitter();
Emitter createDiffEmitter = new Emitter();

export CodeEditor createConfigured(JsValue dom, string value, string language, string theme) {
  registerPopularLanguages();
  TextModel model = createModel(value, language);
  EditorView view = createView(dom, model);
  view.theme = theme;
  view.languageId = language;
  view.applyTheme();
  view.render();
  CodeEditor editor = new CodeEditor(view);
  editors.push(editor);
  createEmitter.fire();
  return editor;
}

export CodeEditor create(JsValue dom, JsValue options) {
  string value = optString(options, "value", "");
  string language = optString(options, "language", "plaintext");
  string theme = optString(options, "theme", currentTheme);
  CodeEditor editor = createConfigured(dom, value, language, theme);
  editor.updateOptions(options);
  if (options.truthy() && options["model"].truthy()) {
  }
  editor.view.render();
  return editor;
}

export DiffEditor createDiffEditor(JsValue dom, JsValue options) {
  JsValue left = domCreateElement("div");
  JsValue right = domCreateElement("div");
  setStyle(dom, "display", "flex");
  setStyle(left, "flex", "1 1 50%");
  setStyle(right, "flex", "1 1 50%");
  appendChild(dom, left);
  appendChild(dom, right);
  string original = optString(options, "original", "");
  string modified = optString(options, "modified", "");
  string language = optString(options, "language", "plaintext");
  CodeEditor origEd = createConfigured(left, original, language, currentTheme);
  CodeEditor modEd = createConfigured(right, modified, language, currentTheme);
  DiffEditor diff = new DiffEditor(dom, origEd, modEd);
  diffEditors.push(diff);
  createDiffEmitter.fire();
  return diff;
}

export CodeEditor[] getEditors() {
  return editors;
}

export DiffEditor[] getDiffEditors() {
  return diffEditors;
}

export void defineTheme(string name, JsValue data) {
  currentTheme = name;
}

export void setTheme(string name) {
  currentTheme = name;
  int i = 0;
  while (i < editors.length) {
    editors[i].view.setTheme(name);
    i++;
  }
}

export void setModelLanguage(TextModel model, string languageId) {
  model.setLanguage(languageId);
}

export void setModelMarkers(TextModel model, string owner, JsValue markers) {
  Marker[] next = [];
  if (markers.truthy()) {
    int i = 0;
    while (markers[i].truthy()) {
      next.push(markerFromJs(markers[i], owner, model.uri.toString()));
      i++;
    }
  }
  storeMarkers(model, owner, next);
}

export Marker[] getModelMarkers(string owner, string resource, int take) {
  return loadMarkers(owner, resource, take);
}

export void removeAllMarkers(string owner) {
  clearMarkers(owner);
}

