export int[] editorGetVisibleRangePacked(CodeEditor editor) {
  int start = editor.view.visibleStartLine();
  int endLine = editor.view.visibleEndLine();
  int endCol = editor.view.model.getLineLength(endLine) + 1;
  int[] out = [];
  out.push(start);
  out.push(1);
  out.push(endLine);
  out.push(endCol);
  return out;
}

export int[] editorGetSelectionsPacked(CodeEditor editor) {
  int[] out = [];
  Sel sel = editor.view.selection;
  out.push(sel.selectionStartLineNumber);
  out.push(sel.selectionStartColumn);
  out.push(sel.positionLineNumber);
  out.push(sel.positionColumn);
  int i = 0;
  while (i < editor.view.extraCursors.length) {
    Sel extra = editor.view.extraCursors[i];
    out.push(extra.selectionStartLineNumber);
    out.push(extra.selectionStartColumn);
    out.push(extra.positionLineNumber);
    out.push(extra.positionColumn);
    i = i + 1;
  }
  return out;
}

export void editorSetSelectionsPacked(CodeEditor editor, int[] packed) {
  if (packed.length < 4) {
    return;
  }
  editor.setSelection(createSelection(packed[0], packed[1], packed[2], packed[3]));
  Sel[] extra = [];
  int i = 4;
  while (i + 3 < packed.length) {
    extra.push(createSelection(packed[i], packed[i + 1], packed[i + 2], packed[i + 3]));
    i = i + 4;
  }
  editor.view.extraCursors = extra;
}

export string[] modelGetLinesContent(TextModel model) {
  string[] lines = [];
  int i = 1;
  int n = model.getLineCount();
  while (i <= n) {
    lines.push(model.getLineContent(i));
    i = i + 1;
  }
  return lines;
}

export int modelGetValueLength(TextModel model) {
  return model.getValueLength();
}

export void modelPushStackElement(TextModel model) {
}

export int[] modelFindNextMatchPacked(TextModel model, string query, int line, int column, bool isRegex, bool matchCase, bool wholeWord) {
  FindMatch[] all = model.findMatches(query, isRegex, matchCase, wholeWord, 1000);
  int[] out = [];
  int i = 0;
  while (i < all.length) {
    FindMatch hit = all[i];
    if (hit.range.startLineNumber > line || (hit.range.startLineNumber == line && hit.range.startColumn >= column)) {
      out.push(hit.range.startLineNumber);
      out.push(hit.range.startColumn);
      out.push(hit.range.endLineNumber);
      out.push(hit.range.endColumn);
      return out;
    }
    i = i + 1;
  }
  if (all.length > 0) {
    FindMatch first = all[0];
    out.push(first.range.startLineNumber);
    out.push(first.range.startColumn);
    out.push(first.range.endLineNumber);
    out.push(first.range.endColumn);
  }
  return out;
}
