import { cubicBezier } from "./cubic-bezier";
import { mirrorEasing } from "./modifiers/mirror";
import { reverseEasing } from "./modifiers/reverse";

export func(float)->float backOut = cubicBezier(0.33, 1.53, 0.69, 0.99);
export func(float)->float backIn = reverseEasing(backOut);
export func(float)->float backInOut = mirrorEasing(backIn);
