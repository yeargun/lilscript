import { addEventListener, removeEventListener } from "../dom-host";

export func()->void addDomEvent(
  JsValue target,
  string eventName,
  JsValue handler,
  JsValue? options = null
) {
  JsValue opts = options;
  if (opts == null) {
    opts = record{passive: true};
  }
  addEventListener(target, eventName, handler, opts);
  return () => {
    removeEventListener(target, eventName, handler, opts);
  };
}
