import { isObject } from "../../motion-utils/is-object";
import { hasOwn } from "../dom-host";

export bool isHTMLElement(JsValue? element = null) {
  if (element == null) {
    return false;
  }
  return isObject(element) && hasOwn(element, "offsetHeight") && !hasOwn(element, "ownerSVGElement");
}
