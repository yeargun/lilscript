import {
  Axis,
  BoundingBox,
  Box,
  Point
} from "../../../motion-utils/types/geometry";

export Box convertBoundingBoxToBox(BoundingBox bb) {
  return Box{Axis{bb.left, bb.right}, Axis{bb.top, bb.bottom}};
}

export BoundingBox convertBoxToBoundingBox(Box box) {
  return BoundingBox{box.y.min, box.x.max, box.y.max, box.x.min};
}

export BoundingBox transformBoxPoints(
  BoundingBox point,
  (func(Point)->Point)? transformPoint = null
) {
  if (transformPoint == null) {
    return point;
  }
  Point topLeft = transformPoint(Point{point.left, point.top});
  Point bottomRight = transformPoint(Point{point.right, point.bottom});
  return BoundingBox{topLeft.y, bottomRight.x, bottomRight.y, topLeft.x};
}
