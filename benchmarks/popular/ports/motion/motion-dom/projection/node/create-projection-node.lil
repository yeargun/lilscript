ProjectionNode? projectionNodeFromRef(JsValue? value) {
  if (value == null) {
    return null;
  }
  if (!(value.truthy())) {
    return null;
  }
  JsValue idValue = value["id"];
  if (idValue is float) {
    return projectionNodeRegistry.get(idValue.toInt());
  }
  return null;
}

float metricGet(string key) {
  float? v = metrics[key];
  if (v != null) {
    return v;
  }
  return 0.0;
}

void resetDistortingTransform(string key, JsValue visualElement, Record<JsValue> values, Record<JsValue>? sharedAnimationValues = null) {
  JsValue latestValues = visualElement["latestValues"];
  if (latestValues[key].truthy()) {
