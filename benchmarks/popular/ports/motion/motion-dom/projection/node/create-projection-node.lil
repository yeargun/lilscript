export void mixAxis(Axis output, Axis from, Axis to, float p) {
  output.min = mixNumber(from.min, to.min, p);
  output.max = mixNumber(from.max, to.max, p);
}

export void mixBox(Box output, Box from, Box to, float p) {
  mixAxis(output.x, from.x, to.x, p);
  mixAxis(output.y, from.y, to.y, p);
}

void mixAxisDeltaLinear(AxisDelta output, AxisDelta delta, float p) {
  output.translate = mixNumber(delta.translate, 0.0, p);
  output.scale = mixNumber(delta.scale, 1.0, p);
  output.origin = delta.origin;
  output.originPoint = delta.originPoint;
}

bool hasOpacityCrossfade(ProjectionNode node) {
  JsValue? animValues = node.animationValues;
  if (animValues == null) {
    return false;
  }
  return animValues["opacityExit"] != null;
}

JsValue defaultLayoutTransition = record{duration: 0.45, ease: [0.4, 0.0, 0.1, 1.0]};

bool userAgentContains(string needle) {
  JsValue nav = windowGet("navigator");
  JsValue uaValue = nav["userAgent"];
  string ua = "";
  if (uaValue is string) {
    ua = uaValue.toLowerCase();
  }
  return ua.includes(needle);
}

bool roundPointEnabled = userAgentContains("applewebkit/") && !userAgentContains("chrome/");

void roundAxis(Axis axis) {
  if (roundPointEnabled) {
    axis.min = axis.min.round();
    axis.max = axis.max.round();
  }
}

void roundBox(Box box) {
  roundAxis(box.x);
  roundAxis(box.y);
}

bool shouldAnimatePositionOnly(string? name, Box oldBox, Box newBox) {
  if (name == null) {
    return false;
  }
  if (name == "position") {
    return true;
  }
  if (name == "preserve-aspect") {
    return !isNear(aspectRatio(oldBox), aspectRatio(newBox), 0.2);
  }
  return false;
}

bool checkNodeWasScrollRoot(ProjectionNode node) {
  if (node.root == node) {
    return false;
  }
  JsValue? scroll = node.scroll;
  if (scroll == null) {
    return false;
  }
  JsValue scrollVal = scroll;
  return scrollVal["wasRoot"].truthy();
}

ProjectionNode? resolveProjectionParent(JsValue parentValue) {
  if (!(parentValue.truthy())) {
    return null;
  }
  ProjectionNode? fromNode = projectionNodeFromRef(parentValue["node"]);
  if (fromNode != null) {
    return fromNode;
  }
  return projectionNodeFromRef(parentValue);
}

void sortProjectionNodes(ProjectionNode[] nodes) {
  int n = nodes.length;
  for (int i = 1; i < n; i++) {
    ProjectionNode key = nodes[i];
    WithDepth keyDepth = key;
    int j = i - 1;
    while (j >= 0) {
      WithDepth current = nodes[j];
      if (compareByDepth(current, keyDepth) <= 0) {
        break;
      }
      nodes[j + 1] = nodes[j];
      j = j - 1;
    }
    nodes[j + 1] = key;
  }
}

void eachProjectionNode(ProjectionNode[]? nodes, func(ProjectionNode)->void callback) {
  if (nodes == null) {
    return;
  }
  sortProjectionNodes(nodes);
  for (int i = 0; i < nodes.length; i++) {
    callback(nodes[i]);
  }
}

class RelativeTargetCell {
  Box? value;
  init() {
    this.value = null;
  }
}

class ResizeWidthCell {
  float value;
  JsValue? cancelDelay;
  init() {
    this.value = 0.0;
    this.cancelDelay = null;
  }
}

Point? parseLayoutAnchor(JsValue value) {
  if (value == null || value == false) {
    return null;
  }
  if (value.isObject()) {
    return Point{parseFloatValue(value["x"]), parseFloatValue(value["y"])};
  }
  return null;
}

export class Measurements {
  int animationId;
  Box measuredBox;
  Box layoutBox;
  Record<JsValue> latestValues;
  int source;

  init(int animationId, Box measuredBox, Box layoutBox, Record<JsValue> latestValues, int source) {
    this.animationId = animationId;
    this.measuredBox = measuredBox;
    this.layoutBox = layoutBox;
    this.latestValues = latestValues;
    this.source = source;
  }
}

