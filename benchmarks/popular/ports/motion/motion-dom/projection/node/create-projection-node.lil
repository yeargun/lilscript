  if (node.isAnimationBlocked && node.layout != null && !node.isLayoutDirty) {
    node.snapshot = node.layout;
    node.isLayoutDirty = true;
  }
}

void resetTransformStyle(ProjectionNode node) {
  JsValue visualElement = node.options["visualElement"];
  if (visualElement.truthy()) {
    JsValue props = visualElement["props"];
    if (props.truthy() && isFunction(props["onBeforeLayoutMeasure"])) {
      callMethod1(visualElement, "notify", "BeforeLayoutMeasure");
    }
  }
  node.resetTransform();
}

void finishAnimationNode(ProjectionNode node) {
  node.finishAnimation();
  node.targetDelta = null;
  node.relativeTarget = null;
  node.target = null;
  node.isProjectionDirty = true;
}

void resolveTargetDeltaNode(ProjectionNode node) {
  node.resolveTargetDelta();
}

void calcProjectionNode(ProjectionNode node) {
  node.calcProjection();
}

export void propagateDirtyNodes(ProjectionNode node) {
  if (statsBuffer.value != null) {
    metrics["nodes"] = metricGet("nodes") + 1.0;
  }
  ProjectionNode? parent = node.parent;
  if (parent == null) {
    return;
  }
  if (!node.isProjecting()) {
    node.isProjectionDirty = parent.isProjectionDirty;
  }
  if (node.isProjectionDirty || parent.isProjectionDirty || parent.isSharedProjectionDirty) {
    node.isSharedProjectionDirty = true;
  }
  if (parent.isTransformDirty) {
    node.isTransformDirty = true;
  }
}

export void cleanDirtyNodes(ProjectionNode node) {
  node.isProjectionDirty = false;
  node.isSharedProjectionDirty = false;
  node.isTransformDirty = false;
}

export func(JsValue)->ProjectionNode createProjectionNode(JsValue config) {
  return (JsValue options) => {
    return new ProjectionNode(options, config);
  };
}
