    callMethod2(visualElement, "setStaticValue", key, 0.0);
    if (sharedAnimationValues != null) {
      sharedAnimationValues[key] = 0.0;
    }
  }
}

void cancelTreeOptimisedTransformAnimations(ProjectionNode projectionNode) {
  projectionNode.hasCheckedOptimisedAppear = true;
  if (projectionNode.root == projectionNode) {
    return;
  }
  JsValue visualElement = projectionNode.options["visualElement"];
  if (!visualElement.truthy()) {
