    SubscriptionManager? existing = this.events.get(eventName);
    SubscriptionManager manager = new SubscriptionManager();
    if (existing != null) {
      manager = existing;
    } else {
      this.events.set(eventName, manager);
    }
    return manager.add(callback);
  }

  void notify(string eventName, JsValue? arg = null) {
    SubscriptionManager? manager = this.events.get(eventName);
    if (manager != null) {
      manager.notify(arg);
    }
  }

  void scheduleRenderMicrotask() {
    VisualElement self = this;
    microtask.render((FrameData _d) => {
      self.render();
    }, false, false);
  }
}
