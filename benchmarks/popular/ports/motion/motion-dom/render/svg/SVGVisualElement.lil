import { DOMVisualElement } from "../dom/DOMVisualElement";
import { scrapeMotionValuesFromProps } from "./utils/scrape-motion-values";
import { buildSVGAttrs } from "./utils/build-attrs";
import { renderSVG } from "./utils/render";
import { createBox } from "../../projection/geometry/models";
import { transformProps } from "../utils/keys-transform";
import { getDefaultValueType } from "../../value/types/maps/defaults";
import { camelToDash } from "../dom/utils/camel-to-dash";
import { camelCaseAttributes } from "./utils/camel-case-attrs";
import { isSVGTag } from "./utils/is-svg-tag";
import { cssStyleProperties } from "./utils/build-attrs";
import { VisualElement } from "../VisualElement";
import { callMethod1 } from "../../dom-host";
import { stringTrim } from "../../string-host";
import { getComputedStyle } from "../html/HTMLVisualElement";

export class SVGVisualElement extends DOMVisualElement {
  bool isSVGTagFlag;

  init(JsValue? options = null, JsValue? parent = null) {
    super();
    JsValue resolvedOptions = record{};
    if (options != null) {
      resolvedOptions = options;
    }
    this.type = "svg";
    this.options = resolvedOptions;
    if (parent != null) {
      this.options["parent"] = parent;
    }
    this.isSVGTagFlag = false;
    SVGVisualElement self = this;
    this.scrapeMotionValuesFromPropsHook = (JsValue props, JsValue prevProps, VisualElement element) => {
      return scrapeMotionValuesFromProps(props, prevProps, element);
    };
    this.buildHook = () => {
      buildSVGAttrs(
        self.renderState,
        self.latestValues,
        self.isSVGTagFlag,
        self.props["transformTemplate"],
        self.props["style"]
      );
    };
    this.renderInstanceHook = (JsValue instance, JsValue renderState, JsValue? styleProp, JsValue? projection) => {
      renderSVG(instance, renderState, styleProp, projection);
    };
    this.measureViewportBoxHook = () => {
      return createBox();
    };
    this.getBaseTargetFromPropsHook = (JsValue props, string key) => {
      return props[key];
    };
    this.readValueFromInstanceHook = (JsValue instance, string key) => {
      if (transformProps.has(key)) {
        JsValue? defaultType = getDefaultValueType(key);
        if (defaultType != null) {
          JsValue def = defaultType["default"];
          if (def != null) {
            return def;
          }
        }
        return 0.0;
      }
      if (cssStyleProperties.indexOf(key) != -1) {
        JsValue computedStyle = getComputedStyle(instance);
        JsValue value = computedStyle[key];
        if ((value is string) && value.truthy()) {
          return stringTrim(value);
        }
      }
      string attrKey = key;
      if (!camelCaseAttributes.has(key)) {
        attrKey = camelToDash(key);
      }
      return callMethod1(instance, "getAttribute", attrKey);
    };
    this.preMountHook = (JsValue instance) => {
      self.isSVGTagFlag = isSVGTag(`${instance["tagName"]}`);
    };
  }
}
