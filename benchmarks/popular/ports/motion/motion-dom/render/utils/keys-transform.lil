export string[] transformPropOrder = [
  "transformPerspective",
  "x",
  "y",
  "z",
  "translateX",
  "translateY",
  "translateZ",
  "scale",
  "scaleX",
  "scaleY",
  "rotate",
  "rotateX",
  "rotateY",
  "rotateZ",
  "skew",
  "skewX",
  "skewY"
];

export Set<string> transformProps = new Set<string>();

void initTransformProps() {
  for (int i = 0; i < transformPropOrder.length; i++) {
    transformProps.add(transformPropOrder[i]);
  }
  transformProps.add("pathRotation");
}

initTransformProps();
