export bool shallowCompare(JsValue next, JsValue? prev = null) {
  if (prev == null) {
    return false;
  }
  if (!next.isArray() || !prev.isArray()) {
    return next == prev;
  }
  if (next.length != prev.length) {
    return false;
  }
  int len = next.length.toInt();
  for (int i = 0; i < len; i++) {
    if (next[i] != prev[i]) {
      return false;
    }
  }
  return true;
}
