import { parseValueFromTransform } from "../../../render/dom/parse-transform";
import { transformPropOrder } from "../../../render/utils/keys-transform";
import { numberType } from "../../../value/types/numbers/index";
import { px } from "../../../value/types/numbers/units";
import { ValueType } from "../../../value/types/types";
import { VisualElement } from "../../../render/VisualElement";
import { MotionValue } from "../../../value/index";
import { visualElementOf, motionValueOf } from "../../../cast";

extern float parseFloat(string v);

export bool isNumOrPxType(ValueType? v = null) {
  if (v == null) {
    return false;
  }
  return v == numberType || v == px;
}

Set<string> transformKeys = new Set<string>();
transformKeys.add("x");
transformKeys.add("y");
transformKeys.add("z");

string[] nonTranslationalTransformKeys = [];
void initNonTranslational() {
  for (int i = 0; i < transformPropOrder.length; i++) {
    string key = transformPropOrder[i];
    if (!transformKeys.has(key)) {
      nonTranslationalTransformKeys.push(key);
    }
  }
}
initNonTranslational();

export JsValue[] removeNonTranslationalTransform(JsValue visualElement) {
  JsValue[] removedTransforms = [];
  VisualElement typed = visualElementOf(visualElement);
  for (int i = 0; i < nonTranslationalTransformKeys.length; i++) {
    string key = nonTranslationalTransformKeys[i];
    JsValue? value = typed.getValue(key);
    if (value == null) {
      continue;
    }
    MotionValue mv = motionValueOf(value);
    JsValue current = mv.get();
    bool defined =
      (current is float) ||
      (current is string) ||
      (current is bool) ||
      current.isArray() ||
      (current.isObject() && current.truthy());
    if (defined) {
      removedTransforms.push([key, current]);
      float reset = 0.0;
      if (key.startsWith("scale")) {
        reset = 1.0;
      }
      mv.set(reset);
    }
  }
  return removedTransforms;
}

float measureWidth(JsValue bbox, JsValue computedStyle) {
  JsValue x = bbox["x"];
  JsValue xmax = x["max"];
  JsValue xmin = x["min"];
  float width = 0.0;
  if (xmax is float) {
    float xmaxF = xmax;
    if (xmin is float) {
      float xminF = xmin;
      width = xmaxF - xminF;
    }
  }
  JsValue boxSizing = computedStyle["boxSizing"];
  if (boxSizing is string) {
    string boxSizingStr = boxSizing;
    if (boxSizingStr == "border-box") {
      return width;
    }
  }
  string paddingLeft = "0";
  string paddingRight = "0";
  JsValue paddingLeftVal = computedStyle["paddingLeft"];
  if (paddingLeftVal is string) {
    paddingLeft = paddingLeftVal;
  }
  JsValue paddingRightVal = computedStyle["paddingRight"];
  if (paddingRightVal is string) {
    paddingRight = paddingRightVal;
  }
  return width - parseFloat(paddingLeft) - parseFloat(paddingRight);
}

float measureHeight(JsValue bbox, JsValue computedStyle) {
  JsValue y = bbox["y"];
  JsValue ymax = y["max"];
  JsValue ymin = y["min"];
  float height = 0.0;
  if (ymax is float) {
    float ymaxF = ymax;
    if (ymin is float) {
      float yminF = ymin;
      height = ymaxF - yminF;
    }
  }
  JsValue boxSizing = computedStyle["boxSizing"];
  if (boxSizing is string) {
    string boxSizingStr = boxSizing;
    if (boxSizingStr == "border-box") {
      return height;
    }
  }
  string paddingTop = "0";
  string paddingBottom = "0";
  JsValue paddingTopVal = computedStyle["paddingTop"];
  if (paddingTopVal is string) {
    paddingTop = paddingTopVal;
  }
  JsValue paddingBottomVal = computedStyle["paddingBottom"];
  if (paddingBottomVal is string) {
    paddingBottom = paddingBottomVal;
  }
  return height - parseFloat(paddingTop) - parseFloat(paddingBottom);
}

float measureTop(JsValue bbox, JsValue computedStyle) {
  JsValue top = computedStyle["top"];
  return parseFloat(`${top}`);
}

float measureLeft(JsValue bbox, JsValue computedStyle) {
  JsValue left = computedStyle["left"];
  return parseFloat(`${left}`);
}

float axisSize(JsValue axis) {
  JsValue maxVal = axis["max"];
  JsValue minVal = axis["min"];
  float size = 0.0;
  if (maxVal is float) {
    float maxF = maxVal;
    if (minVal is float) {
      float minF = minVal;
      size = maxF - minF;
    }
  }
  return size;
}

float measureBottom(JsValue bbox, JsValue computedStyle) {
  JsValue y = bbox["y"];
  JsValue top = computedStyle["top"];
  return parseFloat(`${top}`) + axisSize(y);
}

float measureRight(JsValue bbox, JsValue computedStyle) {
  JsValue x = bbox["x"];
  JsValue left = computedStyle["left"];
  return parseFloat(`${left}`) + axisSize(x);
}

float measureX(JsValue bbox, JsValue computedStyle) {
  JsValue transform = computedStyle["transform"];
  string transformStr = "none";
  if (transform is string) {
    transformStr = transform;
  }
  return parseValueFromTransform(transformStr, "x");
}

float measureY(JsValue bbox, JsValue computedStyle) {
  JsValue transform = computedStyle["transform"];
  string transformStr = "none";
  if (transform is string) {
    transformStr = transform;
  }
  return parseValueFromTransform(transformStr, "y");
}

export Map<string, func(JsValue, JsValue)->float> positionalValues = new Map<string, func(JsValue, JsValue)->float>();
positionalValues.set("width", measureWidth);
positionalValues.set("height", measureHeight);
positionalValues.set("top", measureTop);
positionalValues.set("left", measureLeft);
positionalValues.set("bottom", measureBottom);
positionalValues.set("right", measureRight);
positionalValues.set("x", measureX);
positionalValues.set("y", measureY);
positionalValues.set("translateX", measureX);
positionalValues.set("translateY", measureY);
