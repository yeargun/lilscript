import { invariant } from "../../../motion-utils/errors";
import { isNumericalString } from "../../../motion-utils/is-numerical-string";
import { isCSSVariableToken } from "./is-css-variable";
import { stringMatch, stringTrim } from "../../string-host";
import { getComputedStyleProperty } from "../../dom-host";

extern float parseFloat(string v);

Regex splitCSSVariableRegex = new Regex(
  "^var\\(--(?:([\\w-]+)|([\\w-]+), ?([a-zA-Z\\d ()%#.,-]+))\\)",
  "u"
);

export JsValue[] parseCSSVariable(string current) {
  JsValue matched = stringMatch(current, splitCSSVariableRegex);
  if (!matched.isArray()) {
    return [null, null];
  }
  JsValue token1 = matched[1];
  JsValue token2 = matched[2];
  JsValue fallback = matched[3];
  string tokenName = "";
  if (token1 is string) {
    if (token1 != "") {
      tokenName = token1;
    }
  }
  if (tokenName == "") {
    if (token2 is string) {
      tokenName = token2;
    }
  }
  return [`--${tokenName}`, fallback];
}

float maxDepth = 4.0;

export JsValue? getVariableValue(string current, JsValue element, float depth = 1.0) {
  invariant(
    depth <= maxDepth,
    `Max CSS variable fallback depth detected in property "${current}". This may indicate a circular fallback dependency.`,
    "max-css-var-depth"
  );
  JsValue[] parsed = parseCSSVariable(current);
  JsValue token = parsed[0];
  JsValue fallback = parsed[1];
  if (!(token is string)) {
    return null;
  }
  if (token == "") {
    return null;
  }
  string resolved = getComputedStyleProperty(element, token);
  if (resolved != "") {
    string trimmed = stringTrim(resolved);
    if (isNumericalString(trimmed)) {
      return parseFloat(trimmed);
    }
    return trimmed;
  }
  if (fallback is string) {
    if (isCSSVariableToken(fallback)) {
      return getVariableValue(fallback, element, depth + 1.0);
    }
  }
  return fallback;
}
