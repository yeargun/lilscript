import { isCSSVar } from "../../render/dom/is-css-var";
import { transformProps } from "../../render/utils/keys-transform";
import { isHTMLElement } from "../../utils/is-html-element";
import { MotionValue } from "../../value/index";
import { MotionValueState } from "../MotionValueState";
import { createSelectorEffect } from "../utils/create-dom-effect";
import { createEffect } from "../utils/create-effect";
import { buildTransform } from "./transform";

Set<string> originProps = new Set<string>();
originProps.add("originX");
originProps.add("originY");
originProps.add("originZ");

export func()->void addStyleValue(
  JsValue element,
  MotionValueState state,
  string key,
  MotionValue value
) {
  (func()->void)? render = null;
  MotionValue? computed = null;

  if (transformProps.has(key)) {
    if (state.get("transform") == null) {
      if (!isHTMLElement(element) && state.get("transformBox") == null) {
        addStyleValue(element, state, "transformBox", new MotionValue("fill-box"));
      }
      state.set("transform", new MotionValue("none"), () => {
        element["style"]["transform"] = buildTransform(state);
      });
    }
    computed = state.get("transform");
  } else if (originProps.has(key)) {
    if (state.get("transformOrigin") == null) {
      state.set("transformOrigin", new MotionValue(""), () => {
        JsValue originX = state.latest["originX"];
        JsValue originY = state.latest["originY"];
        JsValue originZ = state.latest["originZ"];
        if (!(originX is float) && !(originX is string)) {
          originX = "50%";
        }
        if (!(originY is float) && !(originY is string)) {
          originY = "50%";
        }
        if (!(originZ is float) && !(originZ is string)) {
          originZ = 0.0;
        }
        element["style"]["transformOrigin"] = `${originX} ${originY} ${originZ}`;
      });
    }
    computed = state.get("transformOrigin");
  } else if (isCSSVar(key)) {
    render = () => {
      JsValue latest = state.latest[key];
      callMethod2(element["style"], "setProperty", key, `${latest}`);
    };
  } else {
    render = () => {
      element["style"][key] = state.latest[key];
    };
  }

  return state.set(key, value, render, computed);
}

import { callMethod2 } from "../../dom-host";

export func(JsValue, Record<MotionValue>)->func()->void styleEffect =
  createSelectorEffect(createEffect(addStyleValue));
