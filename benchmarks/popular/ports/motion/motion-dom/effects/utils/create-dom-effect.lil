import { resolveElements } from "../../utils/resolve-elements";
import { MotionValue } from "../../value/index";

export func(JsValue, Record<MotionValue>)->func()->void createSelectorEffect(
  func(JsValue, Record<MotionValue>)->func()->void subjectEffect
) {
  return (JsValue subject, Record<MotionValue> values) => {
    JsValue[] elements = resolveElements(subject);
    (func()->void)[] subscriptions = [];
    for (int i = 0; i < elements.length; i++) {
      func()->void remove = subjectEffect(elements[i], values);
      subscriptions.push(remove);
    }
    return () => {
      for (int j = 0; j < subscriptions.length; j++) {
        subscriptions[j]();
      }
    };
  };
}
