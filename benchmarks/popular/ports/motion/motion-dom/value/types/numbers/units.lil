import { ValueType } from "../types";

extern float parseFloat(string v);

ValueType createUnitType(string unit) {
  return new ValueType(
    (JsValue v) => {
      if (!(v is string)) {
        return false;
      }
      if (!v.endsWith(unit)) {
        return false;
      }
      string[] parts = [];
      // split on space manually
      string cur = "";
      int i = 0;
      int spaces = 0;
      while (i < v.length) {
        string ch = v.charAt(i);
        if (ch == " ") {
          spaces = spaces + 1;
        }
        i = i + 1;
      }
      return spaces == 0;
    },
    (JsValue v) => {
      if (v is string) {
        return parseFloat(v);
      }
      if (v is float) {
        return v;
      }
      return 0.0;
    },
    (JsValue v) => {
      return `${v}${unit}`;
    }
  );
}

export ValueType degrees = createUnitType("deg");
export ValueType percent = createUnitType("%");
export ValueType px = createUnitType("px");
export ValueType vh = createUnitType("vh");
export ValueType vw = createUnitType("vw");

export ValueType progressPercentage = new ValueType(
  percent.test,
  (JsValue v) => {
    JsValue parsed = percent.parse(v);
    if (parsed is float) {
      return parsed / 100.0;
    }
    return 0.0;
  },
  (JsValue v) => {
    float n = 0.0;
    if (v is float) {
      n = v;
    }
    (func(JsValue)->JsValue)? transform = percent.transform;
    if (transform != null) {
      return transform(n * 100.0);
    }
    return `${n * 100.0}%`;
  }
);
