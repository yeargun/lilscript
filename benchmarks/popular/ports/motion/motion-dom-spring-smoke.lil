import {
  SpringGenerator,
  SpringInput,
  spring
} from "./motion-dom/animation/generators/spring";

SpringInput springOptions = new SpringInput([0.0, 100.0], 170.0, 26.0, 1.0);
SpringGenerator springGen = spring(springOptions);
float springDigest = 0.0;
for (int time = 0; time <= 1024; time = time + 16) {
  springDigest = springDigest + (springGen.next(time).value * 1000.0).round();
}
print(`${springDigest}`);
