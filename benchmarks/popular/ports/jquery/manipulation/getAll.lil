import { emptyArray } from "../alloc.lil";
import { merge } from "../core";
import { nodeName } from "../core/nodeName";
import {
  hasProp,
  call1,
  isNullish
} from "../js-host.lil";

export JsValue getAll(JsValue context, JsValue tagArg = null) {
  JsValue tag = JS.or(tagArg, "*");

  JsValue ret = emptyArray();
  if (context["getElementsByTagName"].truthy()) {
    ret = JS.invoke(context, "getElementsByTagName", tag);
  } else if (context["querySelectorAll"].truthy()) {
    ret = JS.invoke(context, "querySelectorAll", tag);
  }

  if (JS.isNullish(tagArg) || (tagArg.truthy() && nodeName(context, JS.assume(tagArg)))) {
    JsValue[] single = [];
    single.push(context);
    return merge(single, ret);
  }

  return ret;
}
