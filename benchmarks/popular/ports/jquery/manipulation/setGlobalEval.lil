import { get as dataPrivGet, set as dataPrivSet } from "../data/var/dataPriv";

export void setGlobalEval(JsValue elems, JsValue refElements = null) {
  float i = 0.0;
  float l = elems.length;

  for (; i < l; i++) {
    JsValue value = true;
    if (refElements.truthy()) {
      value = dataPrivGet(refElements[i], "globalEval");
    }
    dataPrivSet(elems[i], "globalEval", value);
  }
}
