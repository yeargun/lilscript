  JsValue doAnimation = JS.method0((JsValue self2) => {
    JsValue propCopy = mergeObject(JS.object(), prop, false);

    JsValue anim = AnimationWithOpts(self2, propCopy, optall);

    if (empty || dataPrivGet(self2, "finish").truthy()) {
      JS.invoke(anim, "stop", true);
