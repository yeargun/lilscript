void stopQueue(JsValue hooks, JsValue gotoEnd) {
  JsValue stop = hooks["stop"];
  JS.delete(hooks, "stop");
  stop(gotoEnd);
}

JsValue fnStop(JsValue type, JsValue clearQueue, JsValue gotoEnd) {
  JsValue self = this;

  if (!(type is string)) {
    gotoEnd = clearQueue;
    clearQueue = type;
    type = JS.undefined();
  }

  if (clearQueue.truthy()) {
    JS.invoke(self, "queue", JS.or(type, "fx"), emptyArray());
  }

  return each(self, JS.method0((JsValue el) => {
    bool dequeue = true;
    string indexKey = "";
    bool hasIndex = false;
    if (!JS.isNullish(type)) {
      indexKey = JS.string(type) + "queueHooks";
      hasIndex = true;
    }

    JsValue data = dataPrivGet(el);

    if (hasIndex) {
      if (data[indexKey].truthy() && data[indexKey]["stop"].truthy()) {
        stopQueue(data[indexKey], gotoEnd);
