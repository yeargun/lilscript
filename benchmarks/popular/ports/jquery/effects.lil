struct OpacityAnim {
  JsValue opacity;
}

struct AnimOptsSeed {
  JsValue specialEasing;
  JsValue easing;
}

struct AnimationFacade {
  JsValue elem;
  JsValue props;
  JsValue opts;
  JsValue originalProperties;
  JsValue originalOptions;
  float startTime;
