    float tIndex = 0.0 + fxTimers.length;
    while (tIndex > 0.0) {
      tIndex = tIndex - 1.0;
      JsValue timer = fxTimers[tIndex.toInt()];
      bool sameElem = timer["elem"] == el;
      bool sameType = JS.isNullish(type) || JS.strictEqual(timer["queue"], type);
      if (sameElem && sameType) {
        JsValue stopped = timer["anim"];
