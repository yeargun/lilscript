import { emptyArray } from "./alloc.lil";
import { jQuery, merge, isXMLDoc } from "./core";
import { document } from "./var/document";
import { containsImpl } from "./selector/contains";
import "./selector/escapeSelector";
import {
  createEmptyObject,
  arraySlice,
  arrayIndexOf,
  arraySort,
  arraySplice,
  arrayPush,
  arrayJoin,
  stringSplit,
  isNullish,
  call1,
  call2,
  call3,
  objectHasOwn
} from "./js-host.lil";

/*
 * Optional limited selector module standing in for the full Sizzle-derived
 * engine in "./selector". Only native querySelectorAll / matchesSelector
 * are used, so positional pseudos, custom pseudos, :has(), leading
 * combinators and disconnected-node sorting fidelity are unsupported, as
 * documented in upstream src/selector-native.js. Importing this module
 * overwrites jQuery.find / uniqueSort / expr installed by "./selector".
 */

export Regex boolAttrPatternNative = new Regex(
  "^(?:checked|selected|async|autofocus|autoplay|controls|defer|disabled|hidden|ismap|loop|multiple|open|readonly|required|scoped)$",
  "i"
);

export Regex needsContextPatternNative = new Regex("^[\\x20\\t\\r\\n\\f]*[>+~]");

bool hasDuplicate = false;
JsValue sortInput = null;

JsValue expandoRaw = jQuery["expando"];
string expandoValue = JS.string(expandoRaw);

float sortOrder(JsValue a, JsValue b) {
  if (a == b) {
    hasDuplicate = true;
    return 0.0;
  }

  JsValue aCDP = a["compareDocumentPosition"];
  JsValue bCDP = b["compareDocumentPosition"];
  float aMissing = 1.0;
  if (aCDP.truthy()) {
    aMissing = 0.0;
  }
  float bMissing = 1.0;
  if (bCDP.truthy()) {
    bMissing = 0.0;
  }
  float compare = aMissing - bMissing;
  if (compare != 0.0) {
    return compare;
  }

  JsValue aOwner = a["ownerDocument"];
  JsValue aDoc = a;
  if (!JS.isNullish(aOwner)) {
    aDoc = aOwner;
  }
  JsValue bOwner = b["ownerDocument"];
  JsValue bDoc = b;
  if (!JS.isNullish(bOwner)) {
    bDoc = bOwner;
  }

  if (aDoc == bDoc) {
    compare = JS.number(JS.call(aCDP, a, b));
  } else {
    compare = 1.0;
  }

  int bits = compare.toInt();
  if ((bits & 1) != 0) {
    if (a == document || (aOwner == document && containsImpl(document, a))) {
      return -1.0;
    }
    if (b == document || (bOwner == document && containsImpl(document, b))) {
      return 1.0;
    }
    if (!JS.isNullish(sortInput)) {
      return JS.indexOf(sortInput, a) - JS.indexOf(sortInput, b);
    }
    return 0.0;
  }

  if ((bits & 4) != 0) {
    return -1.0;
  }
  return 1.0;
}

bool sortStable = JS.join(JS.sort(JS.stringSplit(expandoValue, ""), sortOrder), "") == expandoValue;

JsValue uniqueSortNative(JsValue results) {
  hasDuplicate = false;
  sortInput = null;
  if (!sortStable) {
    sortInput = JS.slice(results);
  }
  JS.sort(results, sortOrder);

  if (hasDuplicate) {
    JsValue duplicates = emptyArray();
    float j = 0.0;
    float i = 0.0;
    JsValue elem = results[i];
    i = i + 1.0;
    while (elem.truthy()) {
      if (elem == results[i]) {
        JS.push(duplicates, i);
        j = duplicates.length;
      }
      elem = results[i];
      i = i + 1.0;
    }
    while (j > 0.0) {
      j = j - 1.0;
      float dupIndex = JS.number(duplicates[j]);
      JS.splice(results, dupIndex, 1.0);
    }
  }

  sortInput = null;
  return results;
}

JsValue findNative(JsValue selector, JsValue context = null, JsValue results = null, JsValue seed = null) {
  JsValue out = results;
  if (JS.isNullish(out)) {
    out = emptyArray();
  }
  JsValue ctx = context;
  if (JS.isNullish(ctx)) {
    ctx = document;
  }

  if (!selector.truthy() || !(selector is string)) {
    return out;
  }
  string selectorText = selector;

  JsValue nodeTypeValue = ctx["nodeType"];
  if (nodeTypeValue != 1.0 && nodeTypeValue != 9.0 && nodeTypeValue != 11.0) {
    return emptyArray();
  }

  if (seed.truthy()) {
    float i = 0.0;
    float len = seed.length;
    for (; i < len; i++) {
      JsValue elem = seed[i];
      if (JS.invoke(jQuery["find"], "matchesSelector", elem, selectorText).truthy()) {
        JS.push(out, elem);
      }
    }
  } else {
    merge(out, JS.invoke(ctx, "querySelectorAll", selectorText));
  }

  return out;
}

bool matchesSelectorNative(JsValue elem, string selectorText) {
  try {
    JsValue matcher = elem["matches"];
    if (!matcher.truthy()) {
      matcher = elem["webkitMatchesSelector"];
    }
    if (!matcher.truthy()) {
      matcher = elem["msMatchesSelector"];
    }
    return matcher.truthy() && JS.call(matcher, elem, selectorText).truthy();
  } catch {
    return false;
  }
}

JsValue findMatchesNative(JsValue expression, JsValue elements) {
  return findNative(expression, null, null, elements);
}

JsValue findAttrNative(JsValue elem, string name) {
  string lowered = name.toLowerCase();
  JsValue attrHandle = jQuery["expr"]["attrHandle"];
  JsValue handle = attrHandle[lowered];
  JsValue value = null;
  if (handle.truthy() && objectHasOwn(attrHandle, lowered)) {
    value = handle(elem, name, isXMLDoc(elem));
  }
  if (!JS.isNullish(value)) {
    return value;
  }
  return JS.invoke(elem, "getAttribute", name);
}

JsValue fnUniqueSortNative(JsValue self) {
  return JS.invoke(self, "pushStack", uniqueSortNative(JS.slice(self)));
}

JsValue exprNative = JS.object();
JsValue attrHandleNative = JS.object();
JsValue matchDescriptorNative = JS.object();
matchDescriptorNative["bool"] = boolAttrPatternNative;
matchDescriptorNative["needsContext"] = needsContextPatternNative;
exprNative["attrHandle"] = attrHandleNative;
exprNative["match"] = matchDescriptorNative;

jQuery["uniqueSort"] = uniqueSortNative;
jQuery["unique"] = uniqueSortNative;
jQuery["find"] = findNative;
jQuery["expr"] = exprNative;
jQuery["fn"]["uniqueSort"] = JS.method0(fnUniqueSortNative);

findNative["matches"] = findMatchesNative;
findNative["matchesSelector"] = (JsValue elem, JsValue selectorExpr) => {
  return matchesSelectorNative(elem, JS.string(selectorExpr));
};
findNative["attr"] = findAttrNative;

export { jQuery };
