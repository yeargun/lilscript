import { jQuery, grep } from "../core";
import { expr } from "../selector";
import {
  call2
} from "../js-host.lil";

expr["pseudos"]["animated"] = (JsValue elem) => {
  JsValue matched = grep(jQuery["timers"], (JsValue fn, JsValue _index) => {
    return elem == fn["elem"];
  });
  return matched.length;
};

export { jQuery };
