import { emptyArray } from "./alloc.lil";
import { arr } from "./var/arr";
import { ObjectFunctionString } from "./var/ObjectFunctionString";
import { support } from "./var/support";
import { class2type } from "./var/class2type";
import { isFunction } from "./var/isFunction";
import { isWindow } from "./var/isWindow";
import { toType } from "./core/toType";
import { DOMEval } from "./core/DOMEval";
import {
  createEmptyObject,
  typeOf,
  isNullish,
  isUndefined,
  isFalse,
  arrayIsArray,
  arrayPush,
  arraySlice,
  arrayIndexOf,
  arrayFlat,
  call0,
  call2,
  call3,
  hasProp,
  objectBox,
  defineIterator,
  getArrayIterator,
  mathRandom,
  stringReplace,
  stringSplit,
  regexTest,
  throwError,
  noop,
  setLength,
  stringify,
  jsUndefined,
  objectHasOwn,
  objectToStringTag,
  functionToString,
  getPrototypeOf
} from "./js-host.lil";

string version = "3.7.1";
Regex rhtmlSuffix = new Regex("HTML$", "i");
Regex nonDigits = new Regex("\\D", "g");

JsValue defaultInit(JsValue self, JsValue _selector, JsValue _context) {
  return self;
}

export void setJQueryInit(JsValue jq, func(JsValue, JsValue, JsValue)->JsValue initImpl) {
  JsValue proto = jq["fn"];
  proto["init"] = JS.methodRest((JsValue self, JsValue args) => {
    return initImpl(self, args[0], args[1]);
  });
  proto["init"]["prototype"] = proto;
}

struct JQueryFnCore {
  string jquery;
  JsValue constructor;
  float length;
  JsValue toArray;
  JsValue get;
  JsValue pushStack;
  JsValue each;
  JsValue map;
  JsValue slice;
  JsValue first;
  JsValue last;
  JsValue even;
  JsValue odd;
  JsValue eq;
  JsValue end;
  JsValue push;
  JsValue sort;
  JsValue splice;
  JsValue extend;
}

export JsValue jQuery = JS.undefined();
jQuery = (JsValue selector, JsValue context) => {
  return JS.construct(jQuery["fn"]["init"], selector, context);
};

bool isArrayLike(JsValue obj) {
  if (isFunction(obj) || isWindow(obj)) {
    return false;
  }
  string type = toType(obj);
  if (!obj.truthy() || !JS.in("length", obj)) {
    return type == "array";
  }
  JsValue lengthValue = obj["length"];
  return type == "array" || JS.strictEqual(lengthValue, 0.0) || (JS.typeOf(lengthValue) == "number" && JS.number(lengthValue) > 0.0 && JS.in(JS.number(lengthValue) - 1.0, obj));
}

export bool isPlainObject(JsValue obj) {
  if (!obj.truthy() || objectToStringTag(obj) != "[object Object]") {
    return false;
  }

  JsValue proto = getPrototypeOf(obj);
  if (JS.isNullish(proto)) {
    return true;
  }

  JsValue Ctor = null;
  if (objectHasOwn(proto, "constructor")) {
    Ctor = proto["constructor"];
  }
  return JS.typeOf(Ctor) == "function" && functionToString(Ctor) == ObjectFunctionString;
}

export bool isEmptyObject(JsValue obj) {
  bool empty = true;
  for (string name in obj) {
    empty = false;
  }
  return empty;
}

export JsValue each(JsValue obj, JsValue callback) {
  float i = 0.0;

  if (isArrayLike(obj)) {
    float length = obj.length;
    for (; i < length; i++) {
      if (JS.isFalse(JS.call(callback, obj[i], i, obj[i]))) {
        break;
      }
    }
  } else {
    for (string key in obj) {
      if (JS.isFalse(JS.call(callback, obj[key], key, obj[key]))) {
        break;
      }
    }
  }

  return obj;
}

export JsValue text(JsValue elem) {
  string ret = "";
  float i = 0.0;
  JsValue nodeTypeValue = JS.and(elem, elem["nodeType"]);

  if (!nodeTypeValue.truthy()) {
    while (true) {
      JsValue node = elem[i];
      i = i + 1.0;
      if (JS.isNullish(node)) {
        break;
      }
      JsValue part = text(node);
      ret = ret + JS.string(part);
    }
    return ret;
  }

  if (nodeTypeValue == 1.0 || nodeTypeValue == 11.0 || nodeTypeValue == 9.0) {
    if (nodeTypeValue == 9.0) {
      return elem["documentElement"]["textContent"];
    }
    return elem["textContent"];
  }
  if (nodeTypeValue == 3.0 || nodeTypeValue == 4.0) {
    return elem["nodeValue"];
  }

  return ret;
}

export JsValue merge(JsValue first, JsValue second) {
  int len = second.length.toInt();
  int j = 0;
  int i = first.length.toInt();

  for (; j < len; j++) {
    first[i] = second[j];
    i = i + 1;
  }

  setLength(first, i);
  return first;
}

export JsValue makeArray(JsValue arrValue, JsValue results = null) {
  JsValue ret = results;
  if (JS.isNullish(ret)) {
    ret = emptyArray();
  }

  if (!JS.isNullish(arrValue)) {
    if (isArrayLike(JS.box(arrValue))) {
      if (arrValue is string) {
        JS.push(ret, arrValue);
      } else {
        merge(ret, arrValue);
      }
    } else {
      JS.push(ret, arrValue);
    }
  }

  return ret;
}

export float inArray(JsValue elem, JsValue arrValue, float i = 0.0) {
  if (JS.isNullish(arrValue)) {
    return -1.0;
  }
  return JS.indexOf(arrValue, elem, i);
}

export bool isXMLDoc(JsValue elem) {
  JsValue namespace = JS.and(elem, elem["namespaceURI"]);
  JsValue owner = JS.or(JS.and(elem, elem["ownerDocument"]), elem);
  JsValue docElem = JS.and(owner, owner["documentElement"]);
  JsValue probe = JS.or(namespace, JS.or(JS.and(docElem, docElem["nodeName"]), "HTML"));
  return !JS.regexTest(rhtmlSuffix, JS.string(probe));
}

export JsValue grep(JsValue elems, JsValue callback, bool invert = false) {
  JsValue matches = emptyArray();
  float i = 0.0;
  float length = elems.length;
  bool callbackExpect = !invert;

  for (; i < length; i++) {
    bool callbackInverse = !callback(elems[i], i).truthy();
    if (callbackInverse != callbackExpect) {
      JS.push(matches, elems[i]);
    }
  }

  return matches;
}

export JsValue map(JsValue elems, JsValue callback, JsValue arg = null) {
  float i = 0.0;
  JsValue ret = emptyArray();

  if (isArrayLike(elems)) {
    float length = elems.length;
    for (; i < length; i++) {
      JsValue value = callback(elems[i], i, arg);
      if (!JS.isNullish(value)) {
        JS.push(ret, value);
      }
    }
  } else {
    for (string key in elems) {
      JsValue value = callback(elems[key], key, arg);
      if (!JS.isNullish(value)) {
        JS.push(ret, value);
      }
    }
  }

  return arrayFlat(ret);
}

extern JsValue this;
extern JsValue arguments;

export JsValue mergeObject(JsValue target, JsValue options, bool deep) {
  if (JS.isNullish(options)) {
    return target;
  }

  for (string name in options) {
    JsValue copy = options[name];

    if (name == "__proto__" || target == copy) {
      continue;
    }

    bool copyIsArray = JS.isArray(copy);
    if (deep && copy.truthy() && (isPlainObject(copy) || copyIsArray)) {
      JsValue src = target[name];
      JsValue clone = src;
      if (copyIsArray && !JS.isArray(src)) {
        clone = emptyArray();
      } else if (!copyIsArray && !isPlainObject(src)) {
        clone = JS.object();
      }
      target[name] = mergeObject(clone, copy, true);
    } else if (!JS.isUndefined(copy)) {
      target[name] = copy;
    }
  }

  return target;
}

export JsValue extend() {
  JsValue target = arguments[0];
  if (JS.isNullish(target)) {
    target = JS.object();
  }
  float i = 1.0;
  float length = arguments.length;
  bool deep = false;

  if (target is bool) {
    deep = target;
    target = arguments[1];
    if (JS.isNullish(target)) {
      target = JS.object();
    }
    i = 2.0;
  }

  if (JS.typeOf(target) != "object" && !isFunction(target)) {
    target = JS.object();
  }

  if (i == length) {
    target = this;
    i = i - 1.0;
  }

  for (; i < length; i++) {
    JsValue options = arguments[i];
    if (!JS.isNullish(options)) {
      mergeObject(target, options, deep);
    }
  }

  return target;
}

export JsValue fnToArray() {
  return JS.slice(this);
}

export JsValue wrap(JsValue elem) {
  return jQuery(elem);
}

export JsValue wrap2(JsValue selector, JsValue context) {
  return jQuery(selector, context);
}

export JsValue fnGet(JsValue num) {
  if (JS.isNullish(num)) {
    return JS.slice(this);
  }
  float n = JS.number(num);
  if (n < 0.0) {
    return this[n + this.length];
  }
  return this[n];
}

export JsValue fnPushStack(JsValue elems) {
  JsValue ret = merge(this["constructor"](), elems);
  ret["prevObject"] = this;
  return ret;
}

export JsValue fnMap(JsValue callback) {
  JsValue mapped = emptyArray();
  float i = 0.0;
  float length = this.length;
  for (; i < length; i++) {
    JsValue value = JS.call(callback, this[i], i, this[i]);
    if (!JS.isNullish(value)) {
      JS.push(mapped, value);
    }
  }
  return JS.invoke(this, "pushStack", arrayFlat(mapped));
}

JsValue sliceApply(JsValue self, JsValue args) {
  float argc = args.length;
  if (argc == 0.0) {
    return JS.slice(self);
  }
  float start = JS.number(args[0]);
  if (argc == 1.0) {
    return JS.slice(self, start);
  }
  return JS.slice(self, start, JS.number(args[1]));
}

JsValue fnSliceArgs() {
  return JS.invoke(this, "pushStack", sliceApply(this, arguments));
}

export JsValue fnEq(JsValue iValue) {
  float len = this.length;
  float i = JS.number(iValue);
  float j = i;
  if (i < 0.0) {
    j = i + len;
  }
  JsValue elems = emptyArray();
  if (j >= 0.0 && j < len) {
    JS.push(elems, this[j]);
  }
  return JS.invoke(this, "pushStack", elems);
}

JsValue fnFirst() {
  return JS.invoke(this, "eq", 0.0);
}

JsValue fnEach(JsValue callback) {
  return each(this, callback);
}

JsValue fnLast() {
  return JS.invoke(this, "eq", -1.0);
}

JsValue filterParity(JsValue self, int rem) {
  JsValue matches = emptyArray();
  float i = 0.0;
  float length = self.length;
  for (; i < length; i++) {
    if ((i.toInt() % 2) == rem) {
      JS.push(matches, self[i]);
    }
  }
  return JS.invoke(self, "pushStack", matches);
}

JsValue fnEven() {
  return filterParity(this, 0);
}

JsValue fnOdd() {
  return filterParity(this, 1);
}

JsValue fnEnd() {
  JsValue prev = this["prevObject"];
  if (!JS.isNullish(prev)) {
    return prev;
  }
  return this["constructor"]();
}

struct NonceHost {
  JsValue nonce;
}

export void globalEval(string code, JsValue options = null, JsValue doc = null) {
  JsValue nonceValue = JS.undefined();
  if (options.truthy()) {
    nonceValue = options["nonce"];
  }
  DOMEval(code, NonceHost{nonceValue}, doc);
}

void install() {
  JsValue jQueryFn = JQueryFnCore{
    version,
    jQuery,
    0.0,
    fnToArray,
    fnGet,
    fnPushStack,
    fnEach,
    fnMap,
    fnSliceArgs,
    fnFirst,
    fnLast,
    fnEven,
    fnOdd,
    fnEq,
    fnEnd,
    arr["push"],
    arr["sort"],
    arr["splice"],
    extend
  };
  jQuery["fn"] = jQueryFn;
  jQuery["prototype"] = jQueryFn;
  setJQueryInit(jQuery, defaultInit);

  JsValue jq = jQuery;
  jq["extend"] = extend;
  jq["expando"] = "jQuery" + JS.stringReplace(version + JS.string(mathRandom()), nonDigits, "");
  jq["isReady"] = true;
  jq["error"] = (JsValue msg) => {
    throwError(JS.string(msg));
    return JS.undefined();
  };
  jq["noop"] = noop;
  jq["isPlainObject"] = isPlainObject;
  jq["isEmptyObject"] = isEmptyObject;
  jq["globalEval"] = JS.staticRest((JsValue args) => {
    globalEval(JS.string(args[0]), args[1], args[2]);
    return JS.undefined();
  });
  jq["each"] = each;
  jq["text"] = text;
  jq["makeArray"] = makeArray;
  jq["inArray"] = inArray;
  jq["isXMLDoc"] = isXMLDoc;
  jq["merge"] = merge;
  jq["grep"] = grep;
  jq["map"] = map;
  jq["guid"] = 1.0;
  jq["support"] = support;

  defineIterator(jQueryFn, getArrayIterator());

  each(JS.stringSplit("Boolean Number String Function Array Date RegExp Object Error Symbol", " "), (JsValue _i, JsValue name) => {
    string n = JS.string(name);
    class2type["[object " + n + "]"] = n.toLowerCase();
    return JS.undefined();
  });
}

install();
