import { emptyArray } from "./alloc.lil";
import { arr } from "./var/arr";
import { ObjectFunctionString } from "./var/ObjectFunctionString";
import { support } from "./var/support";
import { class2type } from "./var/class2type";
import { isFunction } from "./var/isFunction";
import { DOMEval } from "./core/DOMEval";
import {
  createEmptyObject,
  typeOf,
  isNullish,
  isUndefined,
  isFalse,
  arrayIsArray,
  arrayPush,
  arraySlice,
  arrayIndexOf,
  arrayFlat,
  call0,
  call2,
  call3,
  hasProp,
  objectBox,
  defineIterator,
  getArrayIterator,
  mathRandom,
  stringReplace,
  stringSplit,
  regexTest,
  throwError,
  noop,
  setLength,
  stringify,
  jsUndefined,
  objectHasOwn,
  objectToStringTag,
  functionToString,
  getPrototypeOf
} from "./js-host.lil";

string version = "3.7.1";
Regex rhtmlSuffix = new Regex("HTML$", "i");
Regex nonDigits = new Regex("\\D", "g");
JsValue slice = arr["slice"];
JsValue push = arr["push"];
JsValue indexOf = arr["indexOf"];
JsValue flat = arr["flat"];
JsValue toString = class2type["toString"];
JsValue hasOwn = class2type["hasOwnProperty"];
JsValue fnToString = hasOwn["toString"];

JsValue defaultInit(JsValue self, JsValue _selector, JsValue _context) {
  return self;
}

export void setJQueryInit(JsValue jq, func(JsValue, JsValue, JsValue)->JsValue initImpl) {
  JsValue proto = jq["fn"];
  proto["init"] = JS.methodRest((JsValue self, JsValue args) => {
    return initImpl(self, args[0], args[1]);
  });
  proto["init"]["prototype"] = proto;
}

struct JQueryFnCore {
  string jquery;
  JsValue constructor;
  float length;
  JsValue toArray;
  JsValue get;
  JsValue pushStack;
  JsValue each;
  JsValue map;
  JsValue slice;
  JsValue first;
  JsValue last;
  JsValue even;
  JsValue odd;
  JsValue eq;
  JsValue end;
  JsValue push;
  JsValue sort;
  JsValue splice;
  JsValue extend;
}

export JsValue jQuery = JS.undefined();
jQuery = (JsValue selector, JsValue context) => {
  return JS.construct(jQuery["fn"]["init"], selector, context);
};

bool isArrayLike(JsValue obj) {
  if (isFunction(obj) || (!JS.isNullish(obj) && JS.strictEqual(obj, obj["window"]))) {
    return false;
  }
  if (!obj.truthy() || !JS.in("length", obj)) {
    return JS.isArray(obj);
  }
  JsValue lengthValue = obj["length"];
  return JS.isArray(obj) || JS.strictEqual(lengthValue, 0.0) || (JS.typeOf(lengthValue) == "number" && JS.number(lengthValue) > 0.0 && JS.in(JS.number(lengthValue) - 1.0, obj));
}

export bool isPlainObject(JsValue obj) {
  if (!obj.truthy() || JS.invoke(toString, "call", obj) != "[object Object]") {
    return false;
  }

  JsValue proto = getPrototypeOf(obj);
  if (JS.isNullish(proto)) {
    return true;
  }

  JsValue Ctor = JS.and(JS.invoke(hasOwn, "call", proto, "constructor"), proto["constructor"]);
  return JS.typeOf(Ctor) == "function" && JS.invoke(fnToString, "call", Ctor) == ObjectFunctionString;
}

export bool isEmptyObject(JsValue obj) {
  for (string name in obj) {
    return false;
  }
  return true;
}

export JsValue each(JsValue obj, JsValue callback) {
  float i = 0.0;

  if (isArrayLike(obj)) {
    float length = obj.length;
    for (; i < length; i++) {
      if (JS.isFalse(JS.call(callback, obj[i], i, obj[i]))) {
        break;
      }
    }
  } else {
    for (string key in obj) {
      if (JS.isFalse(JS.call(callback, obj[key], key, obj[key]))) {
        break;
      }
    }
  }

  return obj;
}

export JsValue text(JsValue elem) {
  JsValue ret = "";
  float i = 0.0;
  JsValue nodeTypeValue = elem["nodeType"];

  if (!nodeTypeValue.truthy()) {
    while (true) {
      JsValue node = elem[i++];
      if (!node.truthy()) {
        break;
      }
      ret = JS.add(ret, JS.invoke(jQuery, "text", node));
    }
    return ret;
  }

  if (nodeTypeValue == 1.0 || nodeTypeValue == 11.0) {
    return elem["textContent"];
  }
  if (nodeTypeValue == 9.0) {
    return elem["documentElement"]["textContent"];
  }
  if (nodeTypeValue == 3.0 || nodeTypeValue == 4.0) {
    return elem["nodeValue"];
  }

  return ret;
}

export JsValue merge(JsValue first, JsValue second) {
  float start = first.length;
  float len = JS.number(second["length"]);
  first["length"] = start + len;
  float j = 0.0;
  for (; j < len; j++) {
    first[start + j] = second[j];
  }
  return first;
}

export JsValue makeArray(JsValue arrValue, JsValue results = JS.undefined()) {
  JsValue ret = JS.or(results, emptyArray());

  if (!JS.isNullish(arrValue)) {
    if (isArrayLike(JS.box(arrValue))) {
      if (arrValue is string) {
        JS.invoke(push, "call", ret, arrValue);
      } else {
        merge(ret, arrValue);
      }
    } else {
      JS.invoke(push, "call", ret, arrValue);
    }
  }

  return ret;
}

export float inArray(JsValue elem, JsValue arrValue, JsValue i = JS.undefined()) {
  if (JS.isNullish(arrValue)) {
    return -1.0;
  }
  return JS.number(JS.invoke(indexOf, "call", arrValue, elem, i));
}

export bool isXMLDoc(JsValue elem) {
  JsValue namespace = JS.and(elem, elem["namespaceURI"]);
  JsValue docElem = JS.and(elem, JS.or(elem["ownerDocument"], elem)["documentElement"]);
  return !JS.invoke(rhtmlSuffix, "test", JS.or(namespace, JS.or(JS.and(docElem, docElem["nodeName"]), "HTML"))).truthy();
}

export JsValue grep(JsValue elems, JsValue callback, bool invert = false) {
  JsValue matches = emptyArray();
  float i = 0.0;
  float length = elems.length;
  bool callbackExpect = !invert;

  for (; i < length; i++) {
    bool callbackInverse = !callback(elems[i], i).truthy();
    if (callbackInverse != callbackExpect) {
      JS.invoke(matches, "push", elems[i]);
    }
  }

  return matches;
}

export JsValue map(JsValue elems, JsValue callback, JsValue arg = null) {
  float i = 0.0;
  JsValue ret = emptyArray();

  if (isArrayLike(elems)) {
    float length = elems.length;
    for (; i < length; i++) {
      JsValue value = callback(elems[i], i, arg);
      if (!JS.isNullish(value)) {
        JS.invoke(ret, "push", value);
      }
    }
  } else {
    for (string key in elems) {
      JsValue value = callback(elems[key], key, arg);
      if (!JS.isNullish(value)) {
        JS.invoke(ret, "push", value);
      }
    }
  }

  return JS.invoke(flat, "call", ret);
}

extern JsValue this;
extern JsValue arguments;

export JsValue extend() {
  JsValue first = arguments[0];
  float i = 1.0;
  float length = arguments.length;
  bool deep = false;
  JsValue target = JS.undefined();

  if (first is bool) {
    deep = first;
    target = JS.or(arguments[1], JS.object());
    i = 2.0;
  } else {
    target = JS.or(first, JS.object());
  }

  if (JS.typeOf(target) != "object" && !isFunction(target)) {
    target = JS.object();
  }

  if (i == length) {
    target = this;
    i = i - 1.0;
  }

  for (; i < length; i++) {
    JsValue options = arguments[i];
    if (JS.isNullish(options)) {
      continue;
    }
    for (string name in options) {
      JsValue copy = options[name];
      if (name == "__proto__" || target == copy) {
        continue;
      }
      bool copyIsArray = JS.isArray(copy);
      if (deep && copy.truthy() && (isPlainObject(copy) || copyIsArray)) {
        JsValue src = target[name];
        JsValue clone = src;
        if (copyIsArray && !JS.isArray(src)) {
          clone = emptyArray();
        } else if (!copyIsArray && !isPlainObject(src)) {
          clone = JS.object();
        }
        target[name] = JS.invoke(jQuery, "extend", true, clone, copy);
      } else if (!JS.isUndefined(copy)) {
        target[name] = copy;
      }
    }
  }

  return target;
}

export JsValue mergeObject(JsValue target, JsValue options, bool deep) {
  return JS.invoke(jQuery, "extend", deep, target, options);
}

export JsValue fnToArray() {
  return JS.invoke(slice, "call", this);
}

export JsValue wrap(JsValue elem) {
  return jQuery(elem);
}

export JsValue wrap2(JsValue selector, JsValue context) {
  return jQuery(selector, context);
}

export JsValue fnGet(JsValue num) {
  if (JS.isNullish(num)) {
    return JS.invoke(slice, "call", this);
  }
  if (JS.lessThan(num, 0)) {
    return this[JS.add(num, this["length"])];
  }
  return this[num];
}

export JsValue fnPushStack(JsValue elems) {
  JsValue ret = merge(this["constructor"](), elems);
  ret["prevObject"] = this;
  return ret;
}

export JsValue fnMap(JsValue callback) {
  return JS.invoke(this, "pushStack", map(this, (JsValue elem, JsValue i) => {
    return JS.call(callback, elem, i, elem);
  }, null));
}

JsValue fnSliceArgs() {
  return JS.invoke(this, "pushStack", JS.invoke(slice, "apply", this, arguments));
}

export JsValue fnEq(JsValue iValue) {
  JsValue len = this["length"];
  JsValue i = JS.add(iValue, JS.and(JS.lessThan(iValue, 0), len));
  JsValue elems = emptyArray();
  if (JS.greaterThanOrEqual(i, 0) && JS.lessThan(i, len)) {
    JS.invoke(elems, "push", this[i]);
  }
  return JS.invoke(this, "pushStack", elems);
}

JsValue fnFirst() {
  return JS.invoke(this, "eq", 0.0);
}

JsValue fnEach(JsValue callback) {
  return each(this, callback);
}

JsValue fnLast() {
  return JS.invoke(this, "eq", -1.0);
}

JsValue fnEven() {
  return JS.invoke(this, "pushStack", grep(this, (JsValue _elem, JsValue i) => {
    return JS.mod(JS.add(i, 1), 2);
  }, false));
}

JsValue fnOdd() {
  return JS.invoke(this, "pushStack", grep(this, (JsValue _elem, JsValue i) => {
    return JS.mod(i, 2);
  }, false));
}

JsValue fnEnd() {
  return JS.or(this["prevObject"], this["constructor"]());
}

JsValue runGlobalEval(JsValue code, JsValue options, JsValue doc) {
  JsValue nonce = JS.object();
  nonce["nonce"] = JS.and(options, options["nonce"]);
  DOMEval(code, nonce, doc);
  return JS.undefined();
}

export void globalEval(string code, JsValue options = null, JsValue doc = null) {
  runGlobalEval(code, options, doc);
}

JsValue jqError(JsValue msg) {
  throwError(msg);
  return JS.undefined();
}

struct JQueryStatics {
  string expando;
  bool isReady;
  JsValue error;
  JsValue noop;
  JsValue isPlainObject;
  JsValue isEmptyObject;
  JsValue globalEval;
  JsValue each;
  JsValue text;
  JsValue makeArray;
  JsValue inArray;
  JsValue isXMLDoc;
  JsValue merge;
  JsValue grep;
  JsValue map;
  float guid;
  JsValue support;
}

JsValue jQueryFn = JQueryFnCore{
  version,
  jQuery,
  0.0,
  fnToArray,
  fnGet,
  fnPushStack,
  fnEach,
  fnMap,
  fnSliceArgs,
  fnFirst,
  fnLast,
  fnEven,
  fnOdd,
  fnEq,
  fnEnd,
  push,
  arr["sort"],
  arr["splice"],
  extend
};
jQuery["fn"] = jQueryFn;
jQuery["prototype"] = jQueryFn;
jQuery["extend"] = extend;

JS.invoke(jQuery, "extend", JQueryStatics{
  "jQuery" + JS.stringReplace(version + JS.string(mathRandom()), nonDigits, ""),
  true,
  jqError,
  noop,
  isPlainObject,
  isEmptyObject,
  runGlobalEval,
  each,
  text,
  makeArray,
  inArray,
  isXMLDoc,
  merge,
  grep,
  map,
  1.0,
  support
});

defineIterator(jQueryFn, getArrayIterator());

each(JS.stringSplit("Boolean Number String Function Array Date RegExp Object Error Symbol", " "), (JsValue _i, JsValue name) => {
  class2type[JS.add("[object ", JS.add(name, "]"))] = JS.invoke(name, "toLowerCase");
  return JS.undefined();
});
