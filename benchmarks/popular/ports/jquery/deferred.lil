import { jQuery, mergeObject } from "./core";
import { isFunction } from "./var/isFunction";
import { newCallbacksMemory, newCallbacksOnceMemory } from "./callbacks";
import {
  createEmptyObject,
  typeOf,
  isNullish,
  arraySlice,
  setLength,
  call0,
  call1,
  call2,
  call3,
  apply,
  jsUndefined,
  scheduleTimeout,
  throwTypeError
} from "./js-host.lil";

enum DeferredState {
  Pending,
  Resolved,
  Rejected
}

struct DeferredTuple {
  string action;
  string listener;
  JsValue list;
  JsValue memory;
  float argIndex;
}

struct PromiseApi {
  JsValue state;
  JsValue always;
  JsValue catch;
  JsValue pipe;
  JsValue then;
  JsValue promise;
}

JsValue Identity = (JsValue v) => {
  return v;
};

JsValue Thrower = (JsValue ex) => {
  throw ex;
};

void adoptValue(JsValue value, JsValue resolve, JsValue reject, bool noValue) {
  try {
    if (value.truthy()) {
      JsValue promiseMethod = value["promise"];
      if (isFunction(promiseMethod)) {
        JsValue promised = JS.call(promiseMethod, value);
        JS.invoke(promised, "done", resolve);
        JS.invoke(promised, "fail", reject);
        return;
      }
      JsValue thenMethodValue = value["then"];
      if (isFunction(thenMethodValue)) {
        JS.call(thenMethodValue, value, resolve, reject);
        return;
      }
    }

    if (noValue) {
      JS.call(resolve, JS.undefined());
    } else {
      JS.call(resolve, JS.undefined(), value);
    }
  } catch (JsValue error) {
    JS.call(reject, JS.undefined(), error);
  }
}

export JsValue Deferred(JsValue fn = null) {
  DeferredTuple[] tuples = [];
  tuples.push(DeferredTuple{
    "notify",
    "progress",
    newCallbacksMemory(),
    newCallbacksMemory(),
    2.0
  });
  tuples.push(DeferredTuple{
    "resolve",
    "done",
    newCallbacksOnceMemory(),
    newCallbacksOnceMemory(),
    0.0
  });
  tuples.push(DeferredTuple{
    "reject",
    "fail",
    newCallbacksOnceMemory(),
    newCallbacksOnceMemory(),
    1.0
  });

  DeferredState state = DeferredState.Pending;

  JsValue deferred = JS.object();
  JsValue promise = JS.undefined();

  func(JsValue)->JsValue stateMethod = (JsValue _self) => {
    return match(state) {
      DeferredState.Pending => "pending",
      DeferredState.Resolved => "resolved",
      DeferredState.Rejected => "rejected"
    };
  };

  func(JsValue, JsValue)->JsValue alwaysMethod = (JsValue thisArg, JsValue args) => {
    JS.invoke(deferred, "done", args);
    JS.invoke(deferred, "fail", args);
    return thisArg;
  };

  func(JsValue, JsValue)->JsValue catchMethod = (JsValue _self, JsValue catchFn) => {
    return JS.invoke(promise, "then", null, catchFn);
  };

  func(JsValue, JsValue)->JsValue pipeMethod = (JsValue _self, JsValue fnsArgs) => {
    JsValue pipeFns = fnsArgs;

    JsValue newDeferred = Deferred((JsValue newDefer) => {
      int ti = 0;
      while (ti < tuples.length) {
        DeferredTuple tuple = tuples[ti];
        JsValue fns = pipeFns;
        JsValue fn = null;
        if (fns.truthy()) {
          JsValue candidate = fns[tuple.argIndex];
          if (isFunction(candidate)) {
            fn = candidate;
          }
        }

        string listener = tuple.listener;
        string withName = tuple.action + "With";

        JsValue pipeFn = fn;
        JS.call(
          deferred[listener],
          deferred,
          JS.methodRest((JsValue thisArg, JsValue args) => {
            JsValue returned = null;
            if (pipeFn.truthy()) {
              returned = JS.apply(pipeFn, thisArg, args);
            }

            if (returned.truthy() && isFunction(returned["promise"])) {
              JsValue returnedPromise = JS.invoke(returned, "promise");
              JS.invoke(returnedPromise, "progress", newDefer["notify"]);
              JS.invoke(returnedPromise, "done", newDefer["resolve"]);
              JS.invoke(returnedPromise, "fail", newDefer["reject"]);
            } else {
              JsValue passArgs = args;
              if (pipeFn.truthy()) {
                JsValue[] single = [];
                single.push(returned);
                passArgs = single;
              }
              JS.invoke(newDefer, withName, thisArg, passArgs);
            }
            return JS.undefined();
          })
        );
        ti = ti + 1;
      }
      pipeFns = null;
      return JS.undefined();
    });
    return JS.invoke(newDeferred, "promise");
  };

  func(JsValue, JsValue, JsValue, JsValue)->JsValue thenMethod = (
    JsValue _self,
    JsValue onFulfilled,
    JsValue onRejected,
    JsValue onProgress
  ) => {
    float maxDepth = 0.0;

    func(float, JsValue, JsValue, JsValue)->JsValue makeResolve = (
      float _depth,
      JsValue _defer,
      JsValue _handler,
      JsValue _special
    ) => {
      return JS.undefined();
    };

    makeResolve = (
      float depth,
      JsValue newDefer,
      JsValue handler,
      JsValue special
    ) => {

      func(JsValue, JsValue)->JsValue resolveHandler = (JsValue thatArg, JsValue argsArg) => {
        JsValue that = thatArg;
        JsValue args = argsArg;

        func()->void mightThrow = () => {
          if (depth < maxDepth) {
            return;
          }
          JsValue returned = JS.apply(handler, that, args);

          JsValue promiseValue = JS.invoke(newDefer, "promise");
          if (returned == promiseValue) {
            throwTypeError("Thenable self-resolution");
          }

          JsValue thenable = null;
          if (returned.truthy()) {
            string returnedType = JS.typeOf(returned);
            if (returnedType == "object" || returnedType == "function") {
              thenable = returned["then"];
            }
          }

          if (isFunction(thenable)) {
            if (special.truthy()) {
              JS.call(
                thenable,
                returned,
                makeResolve(maxDepth, newDefer, Identity, special),
                makeResolve(maxDepth, newDefer, Thrower, special)
              );
            } else {
              float nextDepth = maxDepth + 1.0;
              maxDepth = nextDepth;

              JS.call(
                thenable,
                returned,
                makeResolve(nextDepth, newDefer, Identity, special),
                makeResolve(nextDepth, newDefer, Thrower, special),
                makeResolve(nextDepth, newDefer, Identity, newDefer["notifyWith"])
              );
            }
          } else {
            if (!(handler == Identity)) {
              that = JS.undefined();
              JsValue[] single = [];
              single.push(returned);
              args = single;
            }

            JsValue processor = special;
            if (!processor.truthy()) {
              processor = newDefer["resolveWith"];
            }
            JS.call(processor, JS.undefined(), that, args);
          }
        };

        JsValue process = null;
        if (special.truthy()) {
          process = () => {
            mightThrow();
            return JS.undefined();
          };
        } else {
          process = () => {
            try {
              mightThrow();
            } catch (JsValue e) {
              JsValue exceptionHook = jQuery["Deferred"]["exceptionHook"];
              if (exceptionHook.truthy()) {
                JS.invoke(jQuery["Deferred"], "exceptionHook", e, process["error"]);
              }

              if (depth + 1.0 >= maxDepth) {
                if (!(handler == Thrower)) {
                  that = JS.undefined();
                  JsValue[] single = [];
                  single.push(e);
                  args = single;
                }
                JS.call(
                  newDefer["rejectWith"],
                  JS.undefined(),
                  that,
                  args
                );
              }
            }
            return JS.undefined();
          };
        }

        if (depth > 0.0) {
          process();
        } else {
          JsValue getErrorHook = jQuery["Deferred"]["getErrorHook"];
          if (getErrorHook.truthy()) {
            process["error"] = JS.invoke(jQuery["Deferred"], "getErrorHook");
          } else {
            JsValue getStackHook = jQuery["Deferred"]["getStackHook"];
            if (getStackHook.truthy()) {
              process["error"] = JS.invoke(jQuery["Deferred"], "getStackHook");
            }
          }
          scheduleTimeout(process);
        }
        return JS.undefined();
      };

      return JS.methodRest(resolveHandler);
    };

    JsValue newDeferred = Deferred((JsValue newDefer) => {
      JsValue progressHandler = Identity;
      if (isFunction(onProgress)) {
        progressHandler = onProgress;
      }
      JS.invoke(tuples[0].memory, "add", makeResolve(0.0, newDefer, progressHandler, newDefer["notifyWith"]));

      JsValue fulfilledHandler = Identity;
      if (isFunction(onFulfilled)) {
        fulfilledHandler = onFulfilled;
      }
      JS.invoke(tuples[1].memory, "add", makeResolve(0.0, newDefer, fulfilledHandler, null));

      JsValue rejectedHandler = Thrower;
      if (isFunction(onRejected)) {
        rejectedHandler = onRejected;
      }
      JS.invoke(tuples[2].memory, "add", makeResolve(0.0, newDefer, rejectedHandler, null));

      return JS.undefined();
    });
    return JS.invoke(newDeferred, "promise");
  };

  func(JsValue, JsValue)->JsValue promiseMethod = (JsValue _self, JsValue obj) => {
    if (!JS.isNullish(obj)) {
      return mergeObject(obj, promise, false);
    }
    return promise;
  };

  promise = PromiseApi{
    JS.method0(stateMethod),
    JS.methodRest(alwaysMethod),
    JS.method1(catchMethod),
    JS.methodRest(pipeMethod),
    JS.methodRest((JsValue thisArg, JsValue args) => {
      return thenMethod(thisArg, args[0], args[1], args[2]);
    }),
    JS.method1(promiseMethod)
  };

  int i = 0;
  while (i < tuples.length) {
    DeferredTuple tuple = tuples[i];
    string actionName = tuple.action;
    string listener = tuple.listener;
    JsValue list = tuple.list;
    JsValue memory = tuple.memory;
    promise[listener] = list["add"];

    if (i != 0) {
      if (i == 1) {
        JS.invoke(list, "add", () => {
          state = DeferredState.Resolved;
          return JS.undefined();
        });
      } else {
        JS.invoke(list, "add", () => {
          state = DeferredState.Rejected;
          return JS.undefined();
        });
      }

      int otherIndex = 3 - i;
      JS.invoke(list, "add", tuples[otherIndex].list["disable"]);
      JS.invoke(list, "add", tuples[otherIndex].memory["disable"]);
      JS.invoke(list, "add", tuples[0].list["lock"]);
      JS.invoke(list, "add", tuples[0].memory["lock"]);
    }

    JS.invoke(list, "add", memory["fire"]);

    JsValue actionList = list;
    deferred[actionName] = JS.methodRest((JsValue thisArg, JsValue args) => {
      JsValue context = thisArg;
      if (thisArg == deferred) {
        context = JS.undefined();
      }
      JS.invoke(actionList, "fireWith", context, args);
      return thisArg;
    });
    deferred[actionName + "With"] = list["fireWith"];
    i = i + 1;
  }

  mergeObject(deferred, promise, false);

  if (fn.truthy()) {
    JS.call(fn, deferred, deferred);
  }

  return deferred;
}

JsValue when() {
  float remaining = arguments.length;
  float i = remaining;
  JsValue singleValue = null;
  if (remaining > 0.0) {
    singleValue = arguments[0];
  }

  JsValue[] resolveContexts = [];
  setLength(resolveContexts, i);
  JsValue resolveValues = JS.slice(arguments);

  JsValue primary = Deferred();

  func(JsValue)->JsValue updateFunc = (JsValue indexValue) => {
    return JS.methodRest((JsValue thisArg, JsValue args) => {
      int index = JS.number(indexValue).toInt();
      resolveContexts[index] = thisArg;
      if (args.length > 1.0) {
        resolveValues[index] = JS.slice(args);
      } else {
        resolveValues[index] = args[0];
      }

      float left = remaining - 1.0;
      remaining = left;
      if (!(left > 0.0)) {
        JS.invoke(primary, "resolveWith", resolveContexts, resolveValues);
      }
      return JS.undefined();
    });
  };

  if (remaining <= 1.0) {
    JsValue doneTarget = JS.invoke(primary, "done", updateFunc(i));
    bool noValue = !(remaining > 0.0);
    adoptValue(singleValue, doneTarget["resolve"], primary["reject"], noValue);

    string primaryState = JS.string(JS.invoke(primary, "state"));

    bool unwrap = primaryState == "pending";
    if (!unwrap) {
      JsValue maybe = resolveValues[i];
      if (maybe.truthy() && isFunction(maybe["then"])) {
        unwrap = true;
      }
    }
    if (unwrap) {
      return JS.invoke(primary, "then");
    }
  }

  while (true) {
    i = i - 1.0;
    if (i < 0.0) {
      break;
    }
    adoptValue(resolveValues[i], updateFunc(i), primary["reject"], false);
  }

  return JS.invoke(primary, "promise");
}

jQuery["Deferred"] = Deferred;
jQuery["when"] = when;

export { jQuery, when };
