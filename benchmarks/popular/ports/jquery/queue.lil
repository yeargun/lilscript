import { jQuery, each, makeArray } from "./core";
import {
  get as dataPrivGet,
  access as dataPrivAccess,
  remove as dataPrivRemove
} from "./data/var/dataPriv";
import { Deferred } from "./deferred";

struct QueueHooks {
  JsValue empty;
}

export JsValue queueStatic(JsValue elem, JsValue typeValue, JsValue data) {
  if (!elem.truthy()) {
    return JS.undefined();
  }

  string type = "fx";
  if (typeValue is string) {
    type = typeValue;
  }
  type = type + "queue";
  JsValue queue = dataPrivGet(elem, type);

  if (data.truthy()) {
    if (!queue.truthy() || JS.isArray(data)) {
      queue = dataPrivAccess(elem, type, makeArray(data));
    } else {
      JS.invoke(queue, "push", data);
    }
  }

  if (queue.truthy()) {
    return queue;
  }
  return JS.array();
}

export JsValue dequeueStatic(JsValue elem, JsValue typeValue) {
  string type = "fx";
  if (typeValue is string) {
    type = typeValue;
  }
  JsValue queue = queueStatic(elem, type, JS.undefined());
  float startLength = queue.length;
  JsValue fn = JS.invoke(queue, "shift");
  JsValue hooks = queueHooks(elem, type);

  JsValue next = () => {
    dequeueStatic(elem, type);
    return JS.undefined();
  };

  if (fn == "inprogress") {
    fn = JS.invoke(queue, "shift");
    startLength = startLength - 1.0;
  }

  if (fn.truthy()) {
    if (type == "fx") {
      JS.invoke(queue, "unshift", "inprogress");
    }
    JS.delete(hooks, "stop");
    JS.call(fn, elem, next, hooks);
  }

  if (!(startLength > 0.0) && hooks.truthy()) {
    JS.invoke(hooks["empty"], "fire");
  }
  return JS.undefined();
}

export JsValue queueHooks(JsValue elem, JsValue typeValue) {
  string type = "fx";
  if (typeValue is string) {
    type = typeValue;
  }
  string key = type + "queueHooks";
  JsValue existing = dataPrivGet(elem, key);
  if (existing.truthy()) {
    return existing;
  }

  JsValue empty = JS.call(jQuery["Callbacks"], JS.undefined(), "once memory");
  JS.invoke(empty, "add", () => {
    dataPrivRemove(elem, [type + "queue", key]);
    return JS.undefined();
  });

  return dataPrivAccess(elem, key, QueueHooks{empty});
}

export JsValue fnQueue(JsValue self, JsValue args) {
  string type = "fx";
  JsValue data = JS.undefined();
  float setter = 2.0;

  if (args.length > 0.0) {
    JsValue first = args[0];
    if (first is string) {
      type = first;
      if (args.length > 1.0) {
        data = args[1];
      }
    } else {
      data = first;
      setter = 1.0;
    }
  }

  if (args.length < setter) {
    return queueStatic(self[0], type, JS.undefined());
  }

  if (JS.isUndefined(data)) {
    return self;
  }

  return each(self, (JsValue _i, JsValue el) => {
    JsValue queue = queueStatic(el, type, data);
    queueHooks(el, type);
    if (type == "fx" && queue[0] != "inprogress") {
      dequeueStatic(el, type);
    }
    return JS.undefined();
  });
}

JsValue fnDequeue(JsValue self, JsValue type) {
  return each(self, (JsValue _i, JsValue el) => {
    dequeueStatic(el, type);
    return JS.undefined();
  });
}

JsValue fnClearQueue(JsValue self, JsValue type) {
  string kind = "fx";
  if (type is string) {
    kind = type;
  }
  return JS.invoke(self, "queue", kind, JS.array());
}

JsValue fnPromise(JsValue self, JsValue args) {
  JsValue typeValue = JS.undefined();
  JsValue obj = JS.undefined();
  if (args.length > 0.0) {
    JsValue first = args[0];
    if (first is string) {
      typeValue = first;
      if (args.length > 1.0) {
        obj = args[1];
      }
    } else {
      obj = first;
    }
  }

  string type = "fx";
  if (typeValue is string) {
    type = typeValue;
  }
  JsValue defer = Deferred();
  float count = 1.0;
  JsValue elements = self;

  JsValue resolve = () => {
    count = count - 1.0;
    if (!(count > 0.0)) {
      JS.invoke(defer, "resolveWith", elements, [elements]);
    }
    return JS.undefined();
  };

  float i = self.length;
  while (i > 0.0) {
    i = i - 1.0;
    JsValue hooks = dataPrivGet(self[i], type + "queueHooks");
    JsValue empty = JS.and(hooks, hooks["empty"]);
    if (empty.truthy()) {
      count = count + 1.0;
      JS.invoke(empty, "add", resolve);
    }
  }
  resolve();
  return JS.invoke(defer, "promise", obj);
}

jQuery["queue"] = queueStatic;
jQuery["dequeue"] = dequeueStatic;

jQuery["_queueHooks"] = queueHooks;

jQuery["fn"]["queue"] = JS.methodRest(fnQueue);
jQuery["fn"]["dequeue"] = JS.method1(fnDequeue);
jQuery["fn"]["clearQueue"] = JS.method1(fnClearQueue);
jQuery["fn"]["promise"] = JS.methodRest(fnPromise);

export { jQuery };
