import { jQuery, each, wrap } from "../core";
import { ajax } from "../ajax";
import { stripAndCollapse } from "../core/stripAndCollapse";
import { isFunction } from "../var/isFunction";
import { parseHTML } from "../core/parseHTML";

struct LoadAjaxOptions {
  string url;
  string type;
  string dataType;
  JsValue data;
}

JsValue fnLoad(JsValue urlArg, JsValue paramsArg, JsValue callbackArg) {
  JsValue self = this;

  string url = JS.string(urlArg);
  string selector = "";
  bool hasSelector = false;

  float off = JS.stringIndexOf(url, " ");
  if (off > -1.0) {
    selector = stripAndCollapse(JS.stringSlice(url, off));
    hasSelector = true;
    url = JS.stringSlice(url, 0.0, off);
  }

  JsValue params = paramsArg;
  JsValue callback = callbackArg;
  string type = "GET";

  if (isFunction(params)) {
    callback = params;
    params = JS.undefined();
  } else if (params.truthy() && JS.typeOf(params) == "object") {
    type = "POST";
  }

  if (JS.greaterThan(self["length"], 0.0)) {
    JsValue response = null;

    LoadAjaxOptions ajaxOptions = LoadAjaxOptions{url, type, "html", params};

    JsValue request = ajax(ajaxOptions, JS.undefined());

    JsValue afterRequest = JS.invoke(request, "done", (JsValue responseText, JsValue textStatus, JsValue jqXHRDone) => {
      JsValue[] doneArgs = [responseText, textStatus, jqXHRDone];
      response = doneArgs;

      if (hasSelector) {
        JsValue container = wrap("<div>");
        JsValue parsed = parseHTML(responseText, null, null);
        JS.invoke(container, "append", parsed);
        JsValue found = JS.invoke(container, "find", selector);
        JS.invoke(self, "html", found);
      } else {
        JS.invoke(self, "html", responseText);
      }
      return JS.undefined();
    });

    if (callback.truthy()) {
      JS.invoke(afterRequest, "always", (JsValue jqXHR, JsValue status) => {
        each(self, JS.method0((JsValue el) => {
          JsValue applyArgs = response;
          if (!applyArgs.truthy()) {
            JsValue[] fallback = [];
            fallback.push(jqXHR["responseText"]);
            fallback.push(status);
            fallback.push(jqXHR);
            applyArgs = fallback;
          }
          JS.invoke(callback, "apply", el, applyArgs);
          return JS.undefined();
        }));
        return JS.undefined();
      });
    }
  }

  return self;
}

jQuery["fn"]["load"] = fnLoad;

export { jQuery };
