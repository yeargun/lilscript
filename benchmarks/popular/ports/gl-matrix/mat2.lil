import {createArray, equalsN, exactEqualsN, hypotN} from "./common";

export (float[]|Float32Array) create() {
  (float[]|Float32Array) out = createArray(4);
  out[0] = 1.0;
  out[3] = 1.0;
  return out;
}

export (float[]|Float32Array) clone(float[]|Float32Array a) {
  (float[]|Float32Array) out = createArray(4);
  out[0] = a[0];
  out[1] = a[1];
  out[2] = a[2];
  out[3] = a[3];
  return out;
}

export (float[]|Float32Array) copy(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  out[0] = a[0];
  out[1] = a[1];
  out[2] = a[2];
  out[3] = a[3];
  return out;
}

export (float[]|Float32Array) identity(float[]|Float32Array out) {
  out[0] = 1.0;
  out[1] = 0.0;
  out[2] = 0.0;
  out[3] = 1.0;
  return out;
}

export (float[]|Float32Array) fromValues(
  float m00,
  float m01,
  float m10,
  float m11
) {
  (float[]|Float32Array) out = createArray(4);
  out[0] = m00;
  out[1] = m01;
  out[2] = m10;
  out[3] = m11;
  return out;
}

export (float[]|Float32Array) set(
  float[]|Float32Array out,
  float m00,
  float m01,
  float m10,
  float m11
) {
  out[0] = m00;
  out[1] = m01;
  out[2] = m10;
  out[3] = m11;
  return out;
}

export (float[]|Float32Array) transpose(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  if (out == a) {
    float a1 = a[1];
    out[1] = a[2];
    out[2] = a1;
  } else {
    out[0] = a[0];
    out[1] = a[2];
    out[2] = a[1];
    out[3] = a[3];
  }
  return out;
}

export (float[]|Float32Array)? invert(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  float a0 = a[0];
  float a1 = a[1];
  float a2 = a[2];
  float a3 = a[3];
  float determinant = a0 * a3 - a2 * a1;
  if (determinant == 0.0) {
    return null;
  }
  determinant = 1.0 / determinant;
  out[0] = a3 * determinant;
  out[1] = -a1 * determinant;
  out[2] = -a2 * determinant;
  out[3] = a0 * determinant;
  return out;
}

export (float[]|Float32Array) adjoint(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  float a0 = a[0];
  out[0] = a[3];
  out[1] = -a[1];
  out[2] = -a[2];
  out[3] = a0;
  return out;
}

export float determinant(float[]|Float32Array a) {
  return a[0] * a[3] - a[2] * a[1];
}

export (float[]|Float32Array) multiply(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array b
) {
  float a0 = a[0];
  float a1 = a[1];
  float a2 = a[2];
  float a3 = a[3];
  float b0 = b[0];
  float b1 = b[1];
  float b2 = b[2];
  float b3 = b[3];
  out[0] = a0 * b0 + a2 * b1;
  out[1] = a1 * b0 + a3 * b1;
  out[2] = a0 * b2 + a2 * b3;
  out[3] = a1 * b2 + a3 * b3;
  return out;
}

export (float[]|Float32Array) rotate(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float radians
) {
  float a0 = a[0];
  float a1 = a[1];
  float a2 = a[2];
  float a3 = a[3];
  float sine = radians.sin();
  float cosine = radians.cos();
  out[0] = a0 * cosine + a2 * sine;
  out[1] = a1 * cosine + a3 * sine;
  out[2] = a0 * -sine + a2 * cosine;
  out[3] = a1 * -sine + a3 * cosine;
  return out;
}

export (float[]|Float32Array) scale(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array vector
) {
  float x = vector[0];
  float y = vector[1];
  out[0] = a[0] * x;
  out[1] = a[1] * x;
  out[2] = a[2] * y;
  out[3] = a[3] * y;
  return out;
}

export (float[]|Float32Array) fromRotation(
  float[]|Float32Array out,
  float radians
) {
  float sine = radians.sin();
  float cosine = radians.cos();
  out[0] = cosine;
  out[1] = sine;
  out[2] = -sine;
  out[3] = cosine;
  return out;
}

export (float[]|Float32Array) fromScaling(
  float[]|Float32Array out,
  float[]|Float32Array vector
) {
  out[0] = vector[0];
  out[1] = 0.0;
  out[2] = 0.0;
  out[3] = vector[1];
  return out;
}

export string str(float[]|Float32Array a) {
  return "mat2(" + a[0] + ", " + a[1] + ", " + a[2] + ", " + a[3] + ")";
}

export float frob(float[]|Float32Array a) {
  return hypotN(a, 4);
}

export (float[]|Float32Array)[] LDU(
  float[]|Float32Array lower,
  float[]|Float32Array diagonal,
  float[]|Float32Array upper,
  float[]|Float32Array a
) {
  lower[2] = a[2] / a[0];
  upper[0] = a[0];
  upper[1] = a[1];
  upper[3] = a[3] - lower[2] * upper[1];
  return [lower, diagonal, upper];
}

export (float[]|Float32Array) add(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array b
) {
  out[0] = a[0] + b[0];
  out[1] = a[1] + b[1];
  out[2] = a[2] + b[2];
  out[3] = a[3] + b[3];
  return out;
}

export (float[]|Float32Array) subtract(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array b
) {
  out[0] = a[0] - b[0];
  out[1] = a[1] - b[1];
  out[2] = a[2] - b[2];
  out[3] = a[3] - b[3];
  return out;
}

export bool exactEquals(float[]|Float32Array a, float[]|Float32Array b) {
  return exactEqualsN(a, b, 4);
}

export bool equals(float[]|Float32Array a, float[]|Float32Array b) {
  return equalsN(a, b, 4);
}

export (float[]|Float32Array) multiplyScalar(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float amount
) {
  out[0] = a[0] * amount;
  out[1] = a[1] * amount;
  out[2] = a[2] * amount;
  out[3] = a[3] * amount;
  return out;
}

export (float[]|Float32Array) multiplyScalarAndAdd(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array b,
  float amount
) {
  out[0] = a[0] + b[0] * amount;
  out[1] = a[1] + b[1] * amount;
  out[2] = a[2] + b[2] * amount;
  out[3] = a[3] + b[3] * amount;
  return out;
}

export {multiply as mul, subtract as sub};
