import {
  createArray,
  equalsN,
  exactEqualsN,
  hypot3,
  hypot4
} from "./common";
import {
  rotateX as rotateQuatX,
  rotateY as rotateQuatY,
  rotateZ as rotateQuatZ
} from "./quat";

export (float[]|Float32Array) create() {
  (float[]|Float32Array) out = createArray(8);
  out[3] = 1.0;
  return out;
}

export (float[]|Float32Array) clone(float[]|Float32Array a) {
  (float[]|Float32Array) out = createArray(8);
  out[0] = a[0];
  out[1] = a[1];
  out[2] = a[2];
  out[3] = a[3];
  out[4] = a[4];
  out[5] = a[5];
  out[6] = a[6];
  out[7] = a[7];
  return out;
}

export (float[]|Float32Array) fromValues(
  float x1,
  float y1,
  float z1,
  float w1,
  float x2,
  float y2,
  float z2,
  float w2
) {
  (float[]|Float32Array) out = createArray(8);
  out[0] = x1;
  out[1] = y1;
  out[2] = z1;
  out[3] = w1;
  out[4] = x2;
  out[5] = y2;
  out[6] = z2;
  out[7] = w2;
  return out;
}

export (float[]|Float32Array) fromRotationTranslationValues(
  float x1,
  float y1,
  float z1,
  float w1,
  float x2,
  float y2,
  float z2
) {
  (float[]|Float32Array) out = createArray(8);
  out[0] = x1;
  out[1] = y1;
  out[2] = z1;
  out[3] = w1;
  float ax = x2 * 0.5;
  float ay = y2 * 0.5;
  float az = z2 * 0.5;
  out[4] = ax * w1 + ay * z1 - az * y1;
  out[5] = ay * w1 + az * x1 - ax * z1;
  out[6] = az * w1 + ax * y1 - ay * x1;
  out[7] = -ax * x1 - ay * y1 - az * z1;
  return out;
}

export (float[]|Float32Array) fromRotationTranslation(
  float[]|Float32Array out,
  float[]|Float32Array quaternion,
  float[]|Float32Array translation
) {
  float ax = translation[0] * 0.5;
  float ay = translation[1] * 0.5;
  float az = translation[2] * 0.5;
  float bx = quaternion[0];
  float by = quaternion[1];
  float bz = quaternion[2];
  float bw = quaternion[3];
  out[0] = bx;
  out[1] = by;
  out[2] = bz;
  out[3] = bw;
  out[4] = ax * bw + ay * bz - az * by;
  out[5] = ay * bw + az * bx - ax * bz;
  out[6] = az * bw + ax * by - ay * bx;
  out[7] = -ax * bx - ay * by - az * bz;
  return out;
}

export (float[]|Float32Array) fromTranslation(
  float[]|Float32Array out,
  float[]|Float32Array translation
) {
  out[0] = 0.0;
  out[1] = 0.0;
  out[2] = 0.0;
  out[3] = 1.0;
  out[4] = translation[0] * 0.5;
  out[5] = translation[1] * 0.5;
  out[6] = translation[2] * 0.5;
  out[7] = 0.0;
  return out;
}

export (float[]|Float32Array) fromRotation(
  float[]|Float32Array out,
  float[]|Float32Array quaternion
) {
  out[0] = quaternion[0];
  out[1] = quaternion[1];
  out[2] = quaternion[2];
  out[3] = quaternion[3];
  out[4] = 0.0;
  out[5] = 0.0;
  out[6] = 0.0;
  out[7] = 0.0;
  return out;
}

export (float[]|Float32Array) fromMat4(
  float[]|Float32Array out,
  float[]|Float32Array matrix
) {
  (float[]|Float32Array) scaling = createArray(3);
  scaling[0] = hypot3(matrix[0], matrix[1], matrix[2]);
  scaling[1] = hypot3(matrix[4], matrix[5], matrix[6]);
  scaling[2] = hypot3(matrix[8], matrix[9], matrix[10]);
  float inverse1 = 1.0 / scaling[0];
  float inverse2 = 1.0 / scaling[1];
  float inverse3 = 1.0 / scaling[2];
  float sm11 = matrix[0] * inverse1;
  float sm12 = matrix[1] * inverse2;
  float sm13 = matrix[2] * inverse3;
  float sm21 = matrix[4] * inverse1;
  float sm22 = matrix[5] * inverse2;
  float sm23 = matrix[6] * inverse3;
  float sm31 = matrix[8] * inverse1;
  float sm32 = matrix[9] * inverse2;
  float sm33 = matrix[10] * inverse3;
  float trace = sm11 + sm22 + sm33;
  float scale = 0.0;
  (float[]|Float32Array) rotation = createArray(4);
  if (trace > 0.0) {
    scale = (trace + 1.0).sqrt() * 2.0;
    rotation[3] = 0.25 * scale;
    rotation[0] = (sm23 - sm32) / scale;
    rotation[1] = (sm31 - sm13) / scale;
    rotation[2] = (sm12 - sm21) / scale;
  } else if (sm11 > sm22 && sm11 > sm33) {
    scale = (1.0 + sm11 - sm22 - sm33).sqrt() * 2.0;
    rotation[3] = (sm23 - sm32) / scale;
    rotation[0] = 0.25 * scale;
    rotation[1] = (sm12 + sm21) / scale;
    rotation[2] = (sm31 + sm13) / scale;
  } else if (sm22 > sm33) {
    scale = (1.0 + sm22 - sm11 - sm33).sqrt() * 2.0;
    rotation[3] = (sm31 - sm13) / scale;
    rotation[0] = (sm12 + sm21) / scale;
    rotation[1] = 0.25 * scale;
    rotation[2] = (sm23 + sm32) / scale;
  } else {
    scale = (1.0 + sm33 - sm11 - sm22).sqrt() * 2.0;
    rotation[3] = (sm12 - sm21) / scale;
    rotation[0] = (sm31 + sm13) / scale;
    rotation[1] = (sm23 + sm32) / scale;
    rotation[2] = 0.25 * scale;
  }
  (float[]|Float32Array) translation = createArray(3);
  translation[0] = matrix[12];
  translation[1] = matrix[13];
  translation[2] = matrix[14];
  return fromRotationTranslation(out, rotation, translation);
}

export (float[]|Float32Array) copy(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  out[0] = a[0];
  out[1] = a[1];
  out[2] = a[2];
  out[3] = a[3];
  out[4] = a[4];
  out[5] = a[5];
  out[6] = a[6];
  out[7] = a[7];
  return out;
}

export (float[]|Float32Array) identity(float[]|Float32Array out) {
  out[0] = 0.0;
  out[1] = 0.0;
  out[2] = 0.0;
  out[3] = 1.0;
  out[4] = 0.0;
  out[5] = 0.0;
  out[6] = 0.0;
  out[7] = 0.0;
  return out;
}

export (float[]|Float32Array) set(
  float[]|Float32Array out,
  float x1,
  float y1,
  float z1,
  float w1,
  float x2,
  float y2,
  float z2,
  float w2
) {
  out[0] = x1;
  out[1] = y1;
  out[2] = z1;
  out[3] = w1;
  out[4] = x2;
  out[5] = y2;
  out[6] = z2;
  out[7] = w2;
  return out;
}

export (float[]|Float32Array) getReal(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  out[0] = a[0];
  out[1] = a[1];
  out[2] = a[2];
  out[3] = a[3];
  return out;
}

export (float[]|Float32Array) getDual(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  out[0] = a[4];
  out[1] = a[5];
  out[2] = a[6];
  out[3] = a[7];
  return out;
}

export (float[]|Float32Array) setReal(
  float[]|Float32Array out,
  float[]|Float32Array quaternion
) {
  out[0] = quaternion[0];
  out[1] = quaternion[1];
  out[2] = quaternion[2];
  out[3] = quaternion[3];
  return out;
}

export (float[]|Float32Array) setDual(
  float[]|Float32Array out,
  float[]|Float32Array quaternion
) {
  out[4] = quaternion[0];
  out[5] = quaternion[1];
  out[6] = quaternion[2];
  out[7] = quaternion[3];
  return out;
}

export (float[]|Float32Array) getTranslation(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  float ax = a[4];
  float ay = a[5];
  float az = a[6];
  float aw = a[7];
  float bx = -a[0];
  float by = -a[1];
  float bz = -a[2];
  float bw = a[3];
  out[0] = (ax * bw + aw * bx + ay * bz - az * by) * 2.0;
  out[1] = (ay * bw + aw * by + az * bx - ax * bz) * 2.0;
  out[2] = (az * bw + aw * bz + ax * by - ay * bx) * 2.0;
  return out;
}

export (float[]|Float32Array) translate(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array vector
) {
  float ax1 = a[0];
  float ay1 = a[1];
  float az1 = a[2];
  float aw1 = a[3];
  float bx1 = vector[0] * 0.5;
  float by1 = vector[1] * 0.5;
  float bz1 = vector[2] * 0.5;
  float ax2 = a[4];
  float ay2 = a[5];
  float az2 = a[6];
  float aw2 = a[7];
  out[0] = ax1;
  out[1] = ay1;
  out[2] = az1;
  out[3] = aw1;
  out[4] = aw1 * bx1 + ay1 * bz1 - az1 * by1 + ax2;
  out[5] = aw1 * by1 + az1 * bx1 - ax1 * bz1 + ay2;
  out[6] = aw1 * bz1 + ax1 * by1 - ay1 * bx1 + az2;
  out[7] = -ax1 * bx1 - ay1 * by1 - az1 * bz1 + aw2;
  return out;
}

export (float[]|Float32Array) rotateX(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float radians
) {
  float bx = -a[0];
  float by = -a[1];
  float bz = -a[2];
  float bw = a[3];
  float ax = a[4];
  float ay = a[5];
  float az = a[6];
  float aw = a[7];
  float ax1 = ax * bw + aw * bx + ay * bz - az * by;
  float ay1 = ay * bw + aw * by + az * bx - ax * bz;
  float az1 = az * bw + aw * bz + ax * by - ay * bx;
  float aw1 = aw * bw - ax * bx - ay * by - az * bz;
  rotateQuatX(out, a, radians);
  bx = out[0];
  by = out[1];
  bz = out[2];
  bw = out[3];
  out[4] = ax1 * bw + aw1 * bx + ay1 * bz - az1 * by;
  out[5] = ay1 * bw + aw1 * by + az1 * bx - ax1 * bz;
  out[6] = az1 * bw + aw1 * bz + ax1 * by - ay1 * bx;
  out[7] = aw1 * bw - ax1 * bx - ay1 * by - az1 * bz;
  return out;
}

export (float[]|Float32Array) rotateY(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float radians
) {
  float bx = -a[0];
  float by = -a[1];
  float bz = -a[2];
  float bw = a[3];
  float ax = a[4];
  float ay = a[5];
  float az = a[6];
  float aw = a[7];
  float ax1 = ax * bw + aw * bx + ay * bz - az * by;
  float ay1 = ay * bw + aw * by + az * bx - ax * bz;
  float az1 = az * bw + aw * bz + ax * by - ay * bx;
  float aw1 = aw * bw - ax * bx - ay * by - az * bz;
  rotateQuatY(out, a, radians);
  bx = out[0];
  by = out[1];
  bz = out[2];
  bw = out[3];
  out[4] = ax1 * bw + aw1 * bx + ay1 * bz - az1 * by;
  out[5] = ay1 * bw + aw1 * by + az1 * bx - ax1 * bz;
  out[6] = az1 * bw + aw1 * bz + ax1 * by - ay1 * bx;
  out[7] = aw1 * bw - ax1 * bx - ay1 * by - az1 * bz;
  return out;
}

export (float[]|Float32Array) rotateZ(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float radians
) {
  float bx = -a[0];
  float by = -a[1];
  float bz = -a[2];
  float bw = a[3];
  float ax = a[4];
  float ay = a[5];
  float az = a[6];
  float aw = a[7];
  float ax1 = ax * bw + aw * bx + ay * bz - az * by;
  float ay1 = ay * bw + aw * by + az * bx - ax * bz;
  float az1 = az * bw + aw * bz + ax * by - ay * bx;
  float aw1 = aw * bw - ax * bx - ay * by - az * bz;
  rotateQuatZ(out, a, radians);
  bx = out[0];
  by = out[1];
  bz = out[2];
  bw = out[3];
  out[4] = ax1 * bw + aw1 * bx + ay1 * bz - az1 * by;
  out[5] = ay1 * bw + aw1 * by + az1 * bx - ax1 * bz;
  out[6] = az1 * bw + aw1 * bz + ax1 * by - ay1 * bx;
  out[7] = aw1 * bw - ax1 * bx - ay1 * by - az1 * bz;
  return out;
}

export (float[]|Float32Array) rotateByQuatAppend(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array quaternion
) {
  float qx = quaternion[0];
  float qy = quaternion[1];
  float qz = quaternion[2];
  float qw = quaternion[3];
  float ax = a[0];
  float ay = a[1];
  float az = a[2];
  float aw = a[3];
  out[0] = ax * qw + aw * qx + ay * qz - az * qy;
  out[1] = ay * qw + aw * qy + az * qx - ax * qz;
  out[2] = az * qw + aw * qz + ax * qy - ay * qx;
  out[3] = aw * qw - ax * qx - ay * qy - az * qz;
  ax = a[4];
  ay = a[5];
  az = a[6];
  aw = a[7];
  out[4] = ax * qw + aw * qx + ay * qz - az * qy;
  out[5] = ay * qw + aw * qy + az * qx - ax * qz;
  out[6] = az * qw + aw * qz + ax * qy - ay * qx;
  out[7] = aw * qw - ax * qx - ay * qy - az * qz;
  return out;
}

export (float[]|Float32Array) rotateByQuatPrepend(
  float[]|Float32Array out,
  float[]|Float32Array quaternion,
  float[]|Float32Array a
) {
  float qx = quaternion[0];
  float qy = quaternion[1];
  float qz = quaternion[2];
  float qw = quaternion[3];
  float bx = a[0];
  float by = a[1];
  float bz = a[2];
  float bw = a[3];
  out[0] = qx * bw + qw * bx + qy * bz - qz * by;
  out[1] = qy * bw + qw * by + qz * bx - qx * bz;
  out[2] = qz * bw + qw * bz + qx * by - qy * bx;
  out[3] = qw * bw - qx * bx - qy * by - qz * bz;
  bx = a[4];
  by = a[5];
  bz = a[6];
  bw = a[7];
  out[4] = qx * bw + qw * bx + qy * bz - qz * by;
  out[5] = qy * bw + qw * by + qz * bx - qx * bz;
  out[6] = qz * bw + qw * bz + qx * by - qy * bx;
  out[7] = qw * bw - qx * bx - qy * by - qz * bz;
  return out;
}

export (float[]|Float32Array) rotateAroundAxis(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array axis,
  float radians
) {
  if (radians.abs() < 0.000001) {
    return copy(out, a);
  }
  float axisLength = hypot3(axis[0], axis[1], axis[2]);
  float halfRadians = radians * 0.5;
  float sine = halfRadians.sin();
  float bx = sine * axis[0] / axisLength;
  float by = sine * axis[1] / axisLength;
  float bz = sine * axis[2] / axisLength;
  float bw = halfRadians.cos();
  float ax1 = a[0];
  float ay1 = a[1];
  float az1 = a[2];
  float aw1 = a[3];
  out[0] = ax1 * bw + aw1 * bx + ay1 * bz - az1 * by;
  out[1] = ay1 * bw + aw1 * by + az1 * bx - ax1 * bz;
  out[2] = az1 * bw + aw1 * bz + ax1 * by - ay1 * bx;
  out[3] = aw1 * bw - ax1 * bx - ay1 * by - az1 * bz;
  float ax = a[4];
  float ay = a[5];
  float az = a[6];
  float aw = a[7];
  out[4] = ax * bw + aw * bx + ay * bz - az * by;
  out[5] = ay * bw + aw * by + az * bx - ax * bz;
  out[6] = az * bw + aw * bz + ax * by - ay * bx;
  out[7] = aw * bw - ax * bx - ay * by - az * bz;
  return out;
}

export (float[]|Float32Array) add(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array b
) {
  out[0] = a[0] + b[0];
  out[1] = a[1] + b[1];
  out[2] = a[2] + b[2];
  out[3] = a[3] + b[3];
  out[4] = a[4] + b[4];
  out[5] = a[5] + b[5];
  out[6] = a[6] + b[6];
  out[7] = a[7] + b[7];
  return out;
}

export (float[]|Float32Array) multiply(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array b
) {
  float ax0 = a[0];
  float ay0 = a[1];
  float az0 = a[2];
  float aw0 = a[3];
  float bx1 = b[4];
  float by1 = b[5];
  float bz1 = b[6];
  float bw1 = b[7];
  float ax1 = a[4];
  float ay1 = a[5];
  float az1 = a[6];
  float aw1 = a[7];
  float bx0 = b[0];
  float by0 = b[1];
  float bz0 = b[2];
  float bw0 = b[3];
  out[0] = ax0 * bw0 + aw0 * bx0 + ay0 * bz0 - az0 * by0;
  out[1] = ay0 * bw0 + aw0 * by0 + az0 * bx0 - ax0 * bz0;
  out[2] = az0 * bw0 + aw0 * bz0 + ax0 * by0 - ay0 * bx0;
  out[3] = aw0 * bw0 - ax0 * bx0 - ay0 * by0 - az0 * bz0;
  out[4] =
    ax0 * bw1 +
    aw0 * bx1 +
    ay0 * bz1 -
    az0 * by1 +
    ax1 * bw0 +
    aw1 * bx0 +
    ay1 * bz0 -
    az1 * by0;
  out[5] =
    ay0 * bw1 +
    aw0 * by1 +
    az0 * bx1 -
    ax0 * bz1 +
    ay1 * bw0 +
    aw1 * by0 +
    az1 * bx0 -
    ax1 * bz0;
  out[6] =
    az0 * bw1 +
    aw0 * bz1 +
    ax0 * by1 -
    ay0 * bx1 +
    az1 * bw0 +
    aw1 * bz0 +
    ax1 * by0 -
    ay1 * bx0;
  out[7] =
    aw0 * bw1 -
    ax0 * bx1 -
    ay0 * by1 -
    az0 * bz1 +
    aw1 * bw0 -
    ax1 * bx0 -
    ay1 * by0 -
    az1 * bz0;
  return out;
}

export (float[]|Float32Array) scale(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float amount
) {
  out[0] = a[0] * amount;
  out[1] = a[1] * amount;
  out[2] = a[2] * amount;
  out[3] = a[3] * amount;
  out[4] = a[4] * amount;
  out[5] = a[5] * amount;
  out[6] = a[6] * amount;
  out[7] = a[7] * amount;
  return out;
}

export float dot(
  float[]|Float32Array a,
  float[]|Float32Array b
) {
  return a[0] * b[0] + a[1] * b[1] + a[2] * b[2] + a[3] * b[3];
}

export (float[]|Float32Array) lerp(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array b,
  float amount
) {
  float inverseAmount = 1.0 - amount;
  if (dot(a, b) < 0.0) {
    amount = -amount;
  }
  out[0] = a[0] * inverseAmount + b[0] * amount;
  out[1] = a[1] * inverseAmount + b[1] * amount;
  out[2] = a[2] * inverseAmount + b[2] * amount;
  out[3] = a[3] * inverseAmount + b[3] * amount;
  out[4] = a[4] * inverseAmount + b[4] * amount;
  out[5] = a[5] * inverseAmount + b[5] * amount;
  out[6] = a[6] * inverseAmount + b[6] * amount;
  out[7] = a[7] * inverseAmount + b[7] * amount;
  return out;
}

export (float[]|Float32Array) invert(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  float squared = squaredLength(a);
  out[0] = -a[0] / squared;
  out[1] = -a[1] / squared;
  out[2] = -a[2] / squared;
  out[3] = a[3] / squared;
  out[4] = -a[4] / squared;
  out[5] = -a[5] / squared;
  out[6] = -a[6] / squared;
  out[7] = a[7] / squared;
  return out;
}

export (float[]|Float32Array) conjugate(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  out[0] = -a[0];
  out[1] = -a[1];
  out[2] = -a[2];
  out[3] = a[3];
  out[4] = -a[4];
  out[5] = -a[5];
  out[6] = -a[6];
  out[7] = a[7];
  return out;
}

export float length(float[]|Float32Array a) {
  return hypot4(a[0], a[1], a[2], a[3]);
}

export float squaredLength(float[]|Float32Array a) {
  float x = a[0];
  float y = a[1];
  float z = a[2];
  float w = a[3];
  return x * x + y * y + z * z + w * w;
}

export (float[]|Float32Array) normalize(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  float magnitude = squaredLength(a);
  if (magnitude > 0.0) {
    magnitude = magnitude.sqrt();
    float a0 = a[0] / magnitude;
    float a1 = a[1] / magnitude;
    float a2 = a[2] / magnitude;
    float a3 = a[3] / magnitude;
    float b0 = a[4];
    float b1 = a[5];
    float b2 = a[6];
    float b3 = a[7];
    float product = a0 * b0 + a1 * b1 + a2 * b2 + a3 * b3;
    out[0] = a0;
    out[1] = a1;
    out[2] = a2;
    out[3] = a3;
    out[4] = (b0 - a0 * product) / magnitude;
    out[5] = (b1 - a1 * product) / magnitude;
    out[6] = (b2 - a2 * product) / magnitude;
    out[7] = (b3 - a3 * product) / magnitude;
  }
  return out;
}

export string str(float[]|Float32Array a) {
  return
    "quat2(" +
    a[0] +
    ", " +
    a[1] +
    ", " +
    a[2] +
    ", " +
    a[3] +
    ", " +
    a[4] +
    ", " +
    a[5] +
    ", " +
    a[6] +
    ", " +
    a[7] +
    ")";
}

export bool exactEquals(
  float[]|Float32Array a,
  float[]|Float32Array b
) {
  return exactEqualsN(a, b, 8);
}

export bool equals(
  float[]|Float32Array a,
  float[]|Float32Array b
) {
  return equalsN(a, b, 8);
}

export {
  multiply as mul,
  length as len,
  squaredLength as sqrLen
};
