import {createArray, equalsN, exactEqualsN, hypotN} from "./common";

export (float[]|Float32Array) create() {
  (float[]|Float32Array) out = createArray(9);
  out[0] = 1.0;
  out[4] = 1.0;
  out[8] = 1.0;
  return out;
}

export (float[]|Float32Array) fromMat4(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  out[0] = a[0];
  out[1] = a[1];
  out[2] = a[2];
  out[3] = a[4];
  out[4] = a[5];
  out[5] = a[6];
  out[6] = a[8];
  out[7] = a[9];
  out[8] = a[10];
  return out;
}

export (float[]|Float32Array) clone(float[]|Float32Array a) {
  (float[]|Float32Array) out = createArray(9);
  out[0] = a[0];
  out[1] = a[1];
  out[2] = a[2];
  out[3] = a[3];
  out[4] = a[4];
  out[5] = a[5];
  out[6] = a[6];
  out[7] = a[7];
  out[8] = a[8];
  return out;
}

export (float[]|Float32Array) copy(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  out[0] = a[0];
  out[1] = a[1];
  out[2] = a[2];
  out[3] = a[3];
  out[4] = a[4];
  out[5] = a[5];
  out[6] = a[6];
  out[7] = a[7];
  out[8] = a[8];
  return out;
}

export (float[]|Float32Array) fromValues(
  float m00,
  float m01,
  float m02,
  float m10,
  float m11,
  float m12,
  float m20,
  float m21,
  float m22
) {
  (float[]|Float32Array) out = createArray(9);
  out[0] = m00;
  out[1] = m01;
  out[2] = m02;
  out[3] = m10;
  out[4] = m11;
  out[5] = m12;
  out[6] = m20;
  out[7] = m21;
  out[8] = m22;
  return out;
}

export (float[]|Float32Array) set(
  float[]|Float32Array out,
  float m00,
  float m01,
  float m02,
  float m10,
  float m11,
  float m12,
  float m20,
  float m21,
  float m22
) {
  out[0] = m00;
  out[1] = m01;
  out[2] = m02;
  out[3] = m10;
  out[4] = m11;
  out[5] = m12;
  out[6] = m20;
  out[7] = m21;
  out[8] = m22;
  return out;
}

export (float[]|Float32Array) identity(float[]|Float32Array out) {
  out[0] = 1.0;
  out[1] = 0.0;
  out[2] = 0.0;
  out[3] = 0.0;
  out[4] = 1.0;
  out[5] = 0.0;
  out[6] = 0.0;
  out[7] = 0.0;
  out[8] = 1.0;
  return out;
}

export (float[]|Float32Array) transpose(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  if (out == a) {
    float a01 = a[1];
    float a02 = a[2];
    float a12 = a[5];
    out[1] = a[3];
    out[2] = a[6];
    out[3] = a01;
    out[5] = a[7];
    out[6] = a02;
    out[7] = a12;
  } else {
    out[0] = a[0];
    out[1] = a[3];
    out[2] = a[6];
    out[3] = a[1];
    out[4] = a[4];
    out[5] = a[7];
    out[6] = a[2];
    out[7] = a[5];
    out[8] = a[8];
  }
  return out;
}

export (float[]|Float32Array)? invert(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  float a00 = a[0];
  float a01 = a[1];
  float a02 = a[2];
  float a10 = a[3];
  float a11 = a[4];
  float a12 = a[5];
  float a20 = a[6];
  float a21 = a[7];
  float a22 = a[8];
  float b01 = a22 * a11 - a12 * a21;
  float b11 = -a22 * a10 + a12 * a20;
  float b21 = a21 * a10 - a11 * a20;
  float determinant = a00 * b01 + a01 * b11 + a02 * b21;
  if (determinant == 0.0 || determinant != determinant) {
    return null;
  }
  determinant = 1.0 / determinant;
  out[0] = b01 * determinant;
  out[1] = (-a22 * a01 + a02 * a21) * determinant;
  out[2] = (a12 * a01 - a02 * a11) * determinant;
  out[3] = b11 * determinant;
  out[4] = (a22 * a00 - a02 * a20) * determinant;
  out[5] = (-a12 * a00 + a02 * a10) * determinant;
  out[6] = b21 * determinant;
  out[7] = (-a21 * a00 + a01 * a20) * determinant;
  out[8] = (a11 * a00 - a01 * a10) * determinant;
  return out;
}

export (float[]|Float32Array) adjoint(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  float a00 = a[0];
  float a01 = a[1];
  float a02 = a[2];
  float a10 = a[3];
  float a11 = a[4];
  float a12 = a[5];
  float a20 = a[6];
  float a21 = a[7];
  float a22 = a[8];
  out[0] = a11 * a22 - a12 * a21;
  out[1] = a02 * a21 - a01 * a22;
  out[2] = a01 * a12 - a02 * a11;
  out[3] = a12 * a20 - a10 * a22;
  out[4] = a00 * a22 - a02 * a20;
  out[5] = a02 * a10 - a00 * a12;
  out[6] = a10 * a21 - a11 * a20;
  out[7] = a01 * a20 - a00 * a21;
  out[8] = a00 * a11 - a01 * a10;
  return out;
}

export float determinant(float[]|Float32Array a) {
  float a00 = a[0];
  float a01 = a[1];
  float a02 = a[2];
  float a10 = a[3];
  float a11 = a[4];
  float a12 = a[5];
  float a20 = a[6];
  float a21 = a[7];
  float a22 = a[8];
  return
    a00 * (a22 * a11 - a12 * a21) +
    a01 * (-a22 * a10 + a12 * a20) +
    a02 * (a21 * a10 - a11 * a20);
}

export (float[]|Float32Array) multiply(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array b
) {
  float a00 = a[0];
  float a01 = a[1];
  float a02 = a[2];
  float a10 = a[3];
  float a11 = a[4];
  float a12 = a[5];
  float a20 = a[6];
  float a21 = a[7];
  float a22 = a[8];
  float b00 = b[0];
  float b01 = b[1];
  float b02 = b[2];
  float b10 = b[3];
  float b11 = b[4];
  float b12 = b[5];
  float b20 = b[6];
  float b21 = b[7];
  float b22 = b[8];
  out[0] = b00 * a00 + b01 * a10 + b02 * a20;
  out[1] = b00 * a01 + b01 * a11 + b02 * a21;
  out[2] = b00 * a02 + b01 * a12 + b02 * a22;
  out[3] = b10 * a00 + b11 * a10 + b12 * a20;
  out[4] = b10 * a01 + b11 * a11 + b12 * a21;
  out[5] = b10 * a02 + b11 * a12 + b12 * a22;
  out[6] = b20 * a00 + b21 * a10 + b22 * a20;
  out[7] = b20 * a01 + b21 * a11 + b22 * a21;
  out[8] = b20 * a02 + b21 * a12 + b22 * a22;
  return out;
}

export (float[]|Float32Array) translate(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array vector
) {
  float a00 = a[0];
  float a01 = a[1];
  float a02 = a[2];
  float a10 = a[3];
  float a11 = a[4];
  float a12 = a[5];
  float a20 = a[6];
  float a21 = a[7];
  float a22 = a[8];
  float x = vector[0];
  float y = vector[1];
  out[0] = a00;
  out[1] = a01;
  out[2] = a02;
  out[3] = a10;
  out[4] = a11;
  out[5] = a12;
  out[6] = x * a00 + y * a10 + a20;
  out[7] = x * a01 + y * a11 + a21;
  out[8] = x * a02 + y * a12 + a22;
  return out;
}

export (float[]|Float32Array) rotate(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float radians
) {
  float a00 = a[0];
  float a01 = a[1];
  float a02 = a[2];
  float a10 = a[3];
  float a11 = a[4];
  float a12 = a[5];
  float a20 = a[6];
  float a21 = a[7];
  float a22 = a[8];
  float sine = radians.sin();
  float cosine = radians.cos();
  out[0] = cosine * a00 + sine * a10;
  out[1] = cosine * a01 + sine * a11;
  out[2] = cosine * a02 + sine * a12;
  out[3] = cosine * a10 - sine * a00;
  out[4] = cosine * a11 - sine * a01;
  out[5] = cosine * a12 - sine * a02;
  out[6] = a20;
  out[7] = a21;
  out[8] = a22;
  return out;
}

export (float[]|Float32Array) scale(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array vector
) {
  float x = vector[0];
  float y = vector[1];
  out[0] = x * a[0];
  out[1] = x * a[1];
  out[2] = x * a[2];
  out[3] = y * a[3];
  out[4] = y * a[4];
  out[5] = y * a[5];
  out[6] = a[6];
  out[7] = a[7];
  out[8] = a[8];
  return out;
}

export (float[]|Float32Array) fromTranslation(
  float[]|Float32Array out,
  float[]|Float32Array vector
) {
  out[0] = 1.0;
  out[1] = 0.0;
  out[2] = 0.0;
  out[3] = 0.0;
  out[4] = 1.0;
  out[5] = 0.0;
  out[6] = vector[0];
  out[7] = vector[1];
  out[8] = 1.0;
  return out;
}

export (float[]|Float32Array) fromRotation(
  float[]|Float32Array out,
  float radians
) {
  float sine = radians.sin();
  float cosine = radians.cos();
  out[0] = cosine;
  out[1] = sine;
  out[2] = 0.0;
  out[3] = -sine;
  out[4] = cosine;
  out[5] = 0.0;
  out[6] = 0.0;
  out[7] = 0.0;
  out[8] = 1.0;
  return out;
}

export (float[]|Float32Array) fromScaling(
  float[]|Float32Array out,
  float[]|Float32Array vector
) {
  out[0] = vector[0];
  out[1] = 0.0;
  out[2] = 0.0;
  out[3] = 0.0;
  out[4] = vector[1];
  out[5] = 0.0;
  out[6] = 0.0;
  out[7] = 0.0;
  out[8] = 1.0;
  return out;
}

export (float[]|Float32Array) fromMat2d(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  out[0] = a[0];
  out[1] = a[1];
  out[2] = 0.0;
  out[3] = a[2];
  out[4] = a[3];
  out[5] = 0.0;
  out[6] = a[4];
  out[7] = a[5];
  out[8] = 1.0;
  return out;
}

export (float[]|Float32Array) fromQuat(
  float[]|Float32Array out,
  float[]|Float32Array quaternion
) {
  float x = quaternion[0];
  float y = quaternion[1];
  float z = quaternion[2];
  float w = quaternion[3];
  float x2 = x + x;
  float y2 = y + y;
  float z2 = z + z;
  float xx = x * x2;
  float yx = y * x2;
  float yy = y * y2;
  float zx = z * x2;
  float zy = z * y2;
  float zz = z * z2;
  float wx = w * x2;
  float wy = w * y2;
  float wz = w * z2;
  out[0] = 1.0 - yy - zz;
  out[3] = yx - wz;
  out[6] = zx + wy;
  out[1] = yx + wz;
  out[4] = 1.0 - xx - zz;
  out[7] = zy - wx;
  out[2] = zx - wy;
  out[5] = zy + wx;
  out[8] = 1.0 - xx - yy;
  return out;
}

export (float[]|Float32Array)? normalFromMat4(
  float[]|Float32Array out,
  float[]|Float32Array a
) {
  float a00 = a[0];
  float a01 = a[1];
  float a02 = a[2];
  float a03 = a[3];
  float a10 = a[4];
  float a11 = a[5];
  float a12 = a[6];
  float a13 = a[7];
  float a20 = a[8];
  float a21 = a[9];
  float a22 = a[10];
  float a23 = a[11];
  float a30 = a[12];
  float a31 = a[13];
  float a32 = a[14];
  float a33 = a[15];
  float b00 = a00 * a11 - a01 * a10;
  float b01 = a00 * a12 - a02 * a10;
  float b02 = a00 * a13 - a03 * a10;
  float b03 = a01 * a12 - a02 * a11;
  float b04 = a01 * a13 - a03 * a11;
  float b05 = a02 * a13 - a03 * a12;
  float b06 = a20 * a31 - a21 * a30;
  float b07 = a20 * a32 - a22 * a30;
  float b08 = a20 * a33 - a23 * a30;
  float b09 = a21 * a32 - a22 * a31;
  float b10 = a21 * a33 - a23 * a31;
  float b11 = a22 * a33 - a23 * a32;
  float determinant =
    b00 * b11 -
    b01 * b10 +
    b02 * b09 +
    b03 * b08 -
    b04 * b07 +
    b05 * b06;
  if (determinant == 0.0 || determinant != determinant) {
    return null;
  }
  determinant = 1.0 / determinant;
  out[0] = (a11 * b11 - a12 * b10 + a13 * b09) * determinant;
  out[1] = (a12 * b08 - a10 * b11 - a13 * b07) * determinant;
  out[2] = (a10 * b10 - a11 * b08 + a13 * b06) * determinant;
  out[3] = (a02 * b10 - a01 * b11 - a03 * b09) * determinant;
  out[4] = (a00 * b11 - a02 * b08 + a03 * b07) * determinant;
  out[5] = (a01 * b08 - a00 * b10 - a03 * b06) * determinant;
  out[6] = (a31 * b05 - a32 * b04 + a33 * b03) * determinant;
  out[7] = (a32 * b02 - a30 * b05 - a33 * b01) * determinant;
  out[8] = (a30 * b04 - a31 * b02 + a33 * b00) * determinant;
  return out;
}

export (float[]|Float32Array) projection(
  float[]|Float32Array out,
  float width,
  float height
) {
  out[0] = 2.0 / width;
  out[1] = 0.0;
  out[2] = 0.0;
  out[3] = 0.0;
  out[4] = -2.0 / height;
  out[5] = 0.0;
  out[6] = -1.0;
  out[7] = 1.0;
  out[8] = 1.0;
  return out;
}

export string str(float[]|Float32Array a) {
  return
    "mat3(" +
    a[0] +
    ", " +
    a[1] +
    ", " +
    a[2] +
    ", " +
    a[3] +
    ", " +
    a[4] +
    ", " +
    a[5] +
    ", " +
    a[6] +
    ", " +
    a[7] +
    ", " +
    a[8] +
    ")";
}

export float frob(float[]|Float32Array a) {
  return hypotN(a, 9);
}

export (float[]|Float32Array) add(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array b
) {
  out[0] = a[0] + b[0];
  out[1] = a[1] + b[1];
  out[2] = a[2] + b[2];
  out[3] = a[3] + b[3];
  out[4] = a[4] + b[4];
  out[5] = a[5] + b[5];
  out[6] = a[6] + b[6];
  out[7] = a[7] + b[7];
  out[8] = a[8] + b[8];
  return out;
}

export (float[]|Float32Array) subtract(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array b
) {
  out[0] = a[0] - b[0];
  out[1] = a[1] - b[1];
  out[2] = a[2] - b[2];
  out[3] = a[3] - b[3];
  out[4] = a[4] - b[4];
  out[5] = a[5] - b[5];
  out[6] = a[6] - b[6];
  out[7] = a[7] - b[7];
  out[8] = a[8] - b[8];
  return out;
}

export (float[]|Float32Array) multiplyScalar(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float amount
) {
  out[0] = a[0] * amount;
  out[1] = a[1] * amount;
  out[2] = a[2] * amount;
  out[3] = a[3] * amount;
  out[4] = a[4] * amount;
  out[5] = a[5] * amount;
  out[6] = a[6] * amount;
  out[7] = a[7] * amount;
  out[8] = a[8] * amount;
  return out;
}

export (float[]|Float32Array) multiplyScalarAndAdd(
  float[]|Float32Array out,
  float[]|Float32Array a,
  float[]|Float32Array b,
  float amount
) {
  out[0] = a[0] + b[0] * amount;
  out[1] = a[1] + b[1] * amount;
  out[2] = a[2] + b[2] * amount;
  out[3] = a[3] + b[3] * amount;
  out[4] = a[4] + b[4] * amount;
  out[5] = a[5] + b[5] * amount;
  out[6] = a[6] + b[6] * amount;
  out[7] = a[7] + b[7] * amount;
  out[8] = a[8] + b[8] * amount;
  return out;
}

export bool exactEquals(float[]|Float32Array a, float[]|Float32Array b) {
  return exactEqualsN(a, b, 9);
}

export bool equals(float[]|Float32Array a, float[]|Float32Array b) {
  return equalsN(a, b, 9);
}

export {multiply as mul, subtract as sub};
