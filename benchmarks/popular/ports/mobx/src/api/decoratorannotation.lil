import { DEV } from "../dev-flag.lil";
import { assign, isStr, undef, toStr } from "../host.lil";
import { die } from "../errors.lil";

export JsValue createDecoratorAnnotation(JsValue annotation, JsValue decorate) {
  return assign(JS.method2((JsValue _self, JsValue value, JsValue context) => {
    if (context.truthy() && isStr(context["kind"])) {
      return JS.call(decorate, undef(), annotation, value, context);
    }
    if (DEV) {
      die("Invalid arguments for `" + toStr(annotation["annotationType_"]) + "`");
    }
    return undef();
  }), annotation);
}
