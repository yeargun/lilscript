export JsValue configure = JS.method1((JsValue _s, JsValue options) => {
  if (JS.strictEqual(options["isolateGlobalState"], true)) {
    call0(isolateGlobalState, undef());
  }
  if (!isUndef(options["enforceActions"])) {
    JsValue ea = options["enforceActions"];
    if (JS.strictEqual(ea, "always")) {
      globalState["enforceActions"] = "always";
      globalState["allowStateChanges"] = false;
    } else if (JS.strictEqual(ea, "observed")) {
      globalState["enforceActions"] = true;
      globalState["allowStateChanges"] = false;
    } else {
      globalState["enforceActions"] = false;
      globalState["allowStateChanges"] = true;
    }
  }
  if (inOp("computedRequiresReaction", options)) {
    globalState["computedRequiresReaction"] = options["computedRequiresReaction"].truthy();
