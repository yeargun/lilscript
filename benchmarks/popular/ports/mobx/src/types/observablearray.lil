export JsValue ObservableArrayAdministration = JS.methodRest((JsValue self, JsValue args) => {
  string name = "ObservableArray";
  if (len(args) > 0 && !isUndef(args[0])) {
    name = toStr(args[0]);
  } else if (DEV) {
    name = "ObservableArray@" + getNextId();
  }
  JsValue enhancer = args[1];
  self["owned_"] = false;
