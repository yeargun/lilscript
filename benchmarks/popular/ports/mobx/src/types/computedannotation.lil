import { DEV } from "../dev-flag.lil";
import {
  apply,
  assign,
  stringifyKey
} from "../host.lil";
import { die } from "../errors.lil";
import { annotationOwnMake } from "./observableannotation.lil";

JsValue computedAnnotationExtend = JS.methodRest((JsValue self, JsValue args) => {
  JsValue adm = args[0];
  JsValue key = args[1];
  JsValue descriptor = args[2];
  JsValue proxyTrap = args[3];
  if (DEV && !descriptor["get"].truthy()) {
    die("Cannot apply '" + self["annotationType_"] + "' to '" + adm["name_"] + "." + stringifyKey(key) + "':\n'" + self["annotationType_"] + "' can only be used on getter(+setter) properties.");
  }
  JsValue opts = assign(JS.object(), self["options_"]);
  opts["get"] = descriptor["get"];
  opts["set"] = descriptor["set"];
  return JS.call(adm["defineComputedProperty_"], adm, key, opts, proxyTrap);
});

export JsValue createComputedAnnotation(string name, JsValue options) {
  JsValue annotation = JS.object();
  annotation["annotationType_"] = name;
  annotation["options_"] = options;
  annotation["make_"] = annotationOwnMake;
  annotation["extend_"] = computedAnnotationExtend;
  return annotation;
}
