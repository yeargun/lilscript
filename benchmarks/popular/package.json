{
  "name": "lilscript-popular-library-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "benchmark": "node audit-surfaces.mjs && node run.mjs && BENCH_ROUNDS=9 node benchmark-exact.mjs && node publish-web.mjs && node --test test/*.test.mjs",
    "audit:surfaces": "node audit-surfaces.mjs && node --test test/surface-audit.test.mjs",
    "audit:configs": "node audit-configs.mjs",
    "performance": "node benchmark-exact.mjs",
    "publish:web": "node publish-web.mjs",
    "publish:motion-lab": "node publish-motion-lab.mjs",
    "verify:exact": "node verify-nanoid.mjs && node verify-mitt.mjs && node verify-clsx.mjs && node verify-gl-matrix.mjs && node verify-motion.mjs"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.8.2",
    "acorn": "8.15.0",
    "clsx": "2.1.1",
    "gl-matrix": "3.4.3",
    "immer": "10.1.1",
    "jquery": "3.7.1",
    "jsdom": "26.1.0",
    "mitt": "3.0.1",
    "motion": "^13.0.0",
    "nanoid": "5.1.5",
    "preact": "10.26.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "google-closure-compiler": "20260804.0.0",
    "rolldown": "1.2.3",
    "terser": "5.43.1",
    "vite": "8.2.1"
  }
}
