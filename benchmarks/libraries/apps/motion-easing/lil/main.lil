import { cubicBezier, steps } from "../../../ports/motion-easing/index";

pure bool close(float actual, float expected, float tolerance = 0.0) {
  return (actual - expected).abs() <= tolerance;
}

float passed = 0.0;
void check(bool condition) {
  if (condition) {
    passed += 1;
  }
}

func(float)->float linear = cubicBezier(0.0, 0.0, 1.0, 1.0);
check(linear(0.0) == 0.0);
check(linear(1.0) == 1.0);
check(linear(0.5) == 0.5);

func(float)->float curve = cubicBezier(0.5, 0.1, 0.31, 0.96);
check(curve(0.0) == 0.0);
check(close(curve(0.01), 0.002, 0.005));
check(close(curve(0.25), 0.164, 0.005));
check(close(curve(0.75), 0.935, 0.005));
check(close(curve(0.99), 0.999, 0.005));
check(curve(1.0) == 1.0);

func(float)->float stepEnd = steps(4);
float[] endValues = [0.0, 0.2, 0.249, 0.25, 0.49, 0.5, 0.99, 1.0];
float[] endExpected = [0.0, 0.0, 0.0, 0.25, 0.25, 0.5, 0.75, 0.75];
for (int index = 0; index < endValues.length; index++) {
  check(stepEnd(endValues[index]) == endExpected[index]);
}

func(float)->float stepStart = steps(4, "start");
float[] startValues = [0.0, 0.2, 0.249, 0.25, 0.49, 0.5, 0.51, 0.99, 1.0, 2.0];
float[] startExpected = [0.25, 0.25, 0.25, 0.25, 0.5, 0.5, 0.75, 1.0, 1.0, 1.0];
for (int index = 0; index < startValues.length; index++) {
  check(stepStart(startValues[index]) == startExpected[index]);
}

float curveDigest = 0.0;
float stepDigest = 0.0;
for (int index = 0; index < 120000; index++) {
  float progress = (index % 101) / 100.0;
  if (curve(progress) > 0.5) { curveDigest += index % 17; }
  if (stepEnd(progress) >= 0.5) { stepDigest += index % 13; }
  if (stepStart(progress) > 0.5) { stepDigest += index % 7; }
}
print(`motion-easing:${passed}:${curveDigest}:${stepDigest}`);
