import { clamp } from "../../../ports/micro-math/clamp";
import { lerp } from "../../../ports/micro-math/lerp";

int passed = 0;
if (clamp(0.0, -100.0, 100.0) == 0.0) { passed += 1; }
if (clamp(0.0, 100.0, 100.0) == 100.0) { passed += 1; }
if (clamp(0.0, 100.0, -100.0) == 0.0) { passed += 1; }
if (clamp(100.0, 0.0, 50.0) == 50.0) { passed += 1; }
if (clamp(50.0, 100.0, 150.0) == 100.0) { passed += 1; }
if (lerp(0.0, 1.0, 0.0) == 0.0) { passed += 1; }
if (lerp(-25.0, 50.0, 1.0) == 50.0) { passed += 1; }
if (lerp(-25.0, 50.0, 0.0) == -25.0) { passed += 1; }
if (lerp(100.0, 10.0, 0.0) == 100.0) { passed += 1; }
if (lerp(0.0, 100.0, 0.5) == 50.0) { passed += 1; }

float position = 0.0;
float limited = 0.0;
for (int index = 0; index < 180000; index++) {
  position += lerp(-40.0, 80.0, (index % 6) / 6.0);
  limited += clamp((index % 23) - 11, -5.0, 7.0);
}
print(`micro-math:${passed}:${position}:${limited}`);
