import { levenshtein } from "../../../ports/js-levenshtein/index";

string[] left = [
  "a", "ab", "ac", "abc", "kitten", "xabxcdxxefxgx", "cat",
  "xabxcdxxefxgx", "javawasneat", "example", "sturgeon",
  "levenshtein", "distance", "因為我是中國人所以我會說中文"
];
string[] right = [
  "b", "ac", "bc", "axc", "sitting", "1ab2cd34ef5g6", "cow",
  "abcdefg", "scalaisgreat", "samples", "urgently", "frankenstein",
  "difference", "因為我是英國人所以我會說英文"
];
int[] expected = [1, 1, 1, 1, 3, 6, 2, 6, 7, 3, 6, 6, 5, 2];

int passed = 0;
for (int index = 0; index < left.length; index++) {
  if (levenshtein(left[index], right[index]) == expected[index]) {
    passed += 1;
  }
}

int digest = 0;
for (int iteration = 0; iteration < 50000; iteration++) {
  int first = iteration % left.length;
  int second = (iteration * 5 + 3) % right.length;
  digest += levenshtein(left[first], right[second]) * ((iteration % 7) + 1);
}
print(`js-levenshtein:${passed}:${digest}`);
