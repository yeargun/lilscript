import { emotionHash } from "../../../ports/emotion-hash/index";

string[] values = ["something", "", "a", "color: hotpink;", "display:grid", "A😀Z", "café", "中文网页"];
string[] expected = ["crsxd7", "0", "acqbnw", "1bh9win", "vetbs0", "13a52ga", "1sy5lhz", "1gn5who"];
int passed = 0;
for (int index = 0; index < values.length; index++) {
  if (emotionHash(values[index]) == expected[index]) {
    passed += 1;
  }
}

int digest = 0;
for (int iteration = 0; iteration < 100000; iteration++) {
  string hash = emotionHash(values[iteration % values.length]);
  digest += hash.length * 37 + hash.charCodeAt(iteration % hash.length);
}
print(`emotion-hash:${passed}:${digest}`);
