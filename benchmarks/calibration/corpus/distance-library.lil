export int distance(string a,string b){int[] row=[];for(int j=0;j<=b.length;j++){row.push(j);}for(int i=1;i<=a.length;i++){int diagonal=row[0];row[0]=i;for(int j=1;j<=b.length;j++){int prior=row[j];int replace=diagonal;if(a.codeUnitAt(i-1)!=b.codeUnitAt(j-1)){replace++;}int insert=row[j-1]+1;int erase=prior+1;int best=replace;if(insert<best){best=insert;}if(erase<best){best=erase;}row[j]=best;diagonal=prior;}}return row[b.length];}
export int probe(int input){string a="compiler😀";if((input&1)!=0){a="compressλ";}string b="compression😀";if((input&2)!=0){b="compilationλ";}return distance(a,b);}
