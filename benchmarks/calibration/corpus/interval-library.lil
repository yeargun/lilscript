export int locate(int point){int lo=0;int hi=starts.length;while(lo<hi){int mid=(lo+hi)>>>1;if(starts[mid]<=point){lo=mid+1;}else{hi=mid;}}int index=lo-1;if(index>=0&&point<=ends[index]){return index;}return -1;}
export int probe(int input){int total=0;for(int i=0;i<97;i++){total+=locate(((input+i*17)&16383)-8192);}return total;}
