int digest = 0;
Uint8Array retained = new Uint8Array(256);
for (int round = 0; round < 20000; round++) {
  Uint8Array target = new Uint8Array(256);
  Uint8Array source = new Uint8Array(64);
  for (int index = 0; index < target.length; index++) {
    target[index] = round;
  }
  for (int index = 0; index < source.length; index++) {
    source[index] = round + 3;
  }
  for (int index = 0; index < source.length; index++) {
    target[index + 32] = source[index];
  }
  for (int index = 0; index < 96; index++) {
    target[index + 128] = target[index];
  }
  digest = digest * 31 + target[0] + target[32] + target[128] + target[191];
  if (round == 19999) {
    retained = target;
  }
}

int[] values = [3, 1, 4, 1, 5, 9];
bool contains = false;
for (int index = values.length - 2; index < values.length; index++) {
  if (values[index] == 1) {
    contains = true;
  }
}
bool any = false;
bool all = true;
int found = -1;
for (int index = 0; index < values.length; index++) {
  int value = values[index];
  if (value > 8) {
    any = true;
  }
  if (value <= 0) {
    all = false;
  }
  if (found == -1 && value == 4) {
    found = index;
  }
}
string joined = "";
for (int index = 0; index < values.length; index++) {
  if (index > 0) {
    joined += "|";
  }
  joined += values[index];
}
int firstFour = -1;
int lastOne = -1;
for (int index = 1; index < joined.length; index++) {
  string character = joined.charAt(index);
  if (firstFour == -1 && character == "4") {
    firstFour = index;
  }
  if (character == "1") {
    lastOne = index;
  }
}
string repeated = "";
for (int index = 0; index < found; index++) {
  repeated += joined;
}
print(`${digest}:${retained[32]}:${contains}:${any}:${all}:${found}:${firstFour}:${lastOne}:${repeated.length}:${joined}`);
