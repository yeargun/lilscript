int measure(int seed) {
    int[] prefix = [seed, seed + 1];
    int[] values = [...prefix, seed + 2, seed + 3];
    auto [first, second, ...tail] = values;
    int total = (first ?? 0) + (second ?? 0);
    for (int value of tail) {
        total += value;
    }

    Record<int> base = record{a: seed, b: seed + 1, c: seed + 2, d: seed + 3};
    Record<int> merged = record{...base, b: seed + 4, e: seed + 5};
    auto {a, b, ...remaining} = merged;
    return total + (a ?? 0) + (b ?? 0) + (remaining.c ?? 0) +
        (remaining.d ?? 0) + (remaining.e ?? 0);
}

int total = 0;
for (int i = 0; i < 4000; i++) {
    total += measure(i % 97);
}
print(total);
