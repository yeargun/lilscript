 1 | class Holder<T> {
  T value;
  func(T,T)->bool equals;

  init(T value, func(T,T)->bool equals) {
    this.value = value;
    this.equals = equals;
  }

  bool same(T next) {
    func(T,T)->bool compare = this.equals;
    return compare(this.value, next);
  }
