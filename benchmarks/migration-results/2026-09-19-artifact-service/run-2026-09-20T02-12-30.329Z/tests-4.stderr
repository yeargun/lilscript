native-closure-artifact {"case":"reentry","source":"extern void keep(int slot,func(int)->int callback);\nextern int invoke(int slot,int delta);\nextern void clear(int slot);\nextern void clearAll();\nextern func(int)->int take(int slot);\nextern void expectLive(int count);\nextern void assertEmpty();\n\nstruct Pair {int left;int right;}\nvoid overlap(ref Pair whole,ref int leaf) {whole=Pair{10,20};leaf+=1;}\nvoid attach(int slot) {\n    Pair state=Pair{1,2};\n    keep(slot,(int value)=>{state.left=invoke(slot+1,value);return state.left+state.right;});\n    keep(slot+1,(int value)=>{state=Pair{100+value,200+value};return 5+value;});\n    keep(slot+2,(int value)=>{overlap(ref state,ref state.left);return state.left+state.right;});\n}\nvoid selfClearing(int slot,int seed) {\n    int state=seed;\n    keep(slot,(int delta)=>{int before=state;clear(slot);state+=delta;print(before);return state;});\n}\nvoid exercise() {\n    attach(0);\n    print(invoke(0,3));print(invoke(2,0));print(invoke(0,1));\n    clearAll();assertEmpty();\n    selfClearing(4,30);print(invoke(4,7));assertEmpty();\n}\nexercise();assertEmpty();\n","source_sha256":"01e8ed69cbe6796e1e1f6054acf9374d0b0ead04acd20b099210d0f75dd5b9b3","expected":"211\n31\n207\n30\n37\n","expected_sha256":"16ac76e70c59d906cf3ee8c150ca24ce9b8e90dc95b7476a984a713ad7e80fd6","c":"#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n#include <inttypes.h>\n#include <limits.h>\n#include <float.h>\n#include <fenv.h>\n#include <math.h>\n#include <stdio.h>\n#include <string.h>\n#if !defined(__STDC_VERSION__) || __STDC_VERSION__ < 201112L\n#error \"LilScript native requires C11\"\n#endif\n#if defined(__FAST_MATH__) || (defined(__FINITE_MATH_ONLY__) && __FINITE_MATH_ONLY__ != 0)\n#error \"LilScript native forbids fast-math and finite-only arithmetic\"\n#endif\n#if FLT_EVAL_METHOD != 0\n#error \"LilScript native requires evaluation in the declared floating type\"\n#endif\n#pragma STDC FP_CONTRACT OFF\n_Static_assert(CHAR_BIT == 