ode callback oracle"}
native-closure-artifact {"case":"iterations","source":"extern void keep(int slot,func(int)->int callback);\nextern int invoke(int slot,int delta);\nextern void clear(int slot);\nextern void clearAll();\nextern func(int)->int take(int slot);\nextern void expectLive(int count);\nextern void assertEmpty();\n\nfunc(int)->int counter(int seed){return (int delta)=>{seed+=delta;return seed;};}\nvoid fill() {\n    int index=0;\n    while(index<4) {\n        expectLive(index*2);\n        int state=index*10;\n        keep(index,(int delta)=>{state+=delta;return state;});\n        auto scratch=counter(100+index);print(scratch(1));\n        index+=1;\n        if(index==2){continue;}\n        if(index==4){break;}\n    }\n}\nvoid churn() {\n    int index=0;\n    while(index<128) {\n        assertEmpty();\n        auto scratch=counter(index);\n        auto copy=scratch;\n        scratch=counter(index+1);\n        index+=1;\n        if(index==128){break;}\n        if(index%2==0){continue;}\n    }\n}\nfill();expectLive(8);\nprint(invoke(0,1));print(invoke(1,2));print(invoke(2,3));print(invoke(3,4));\nprint(invoke(0,5));print(invoke(1,5));\nclearAll();assertEmpty();churn();assertEmpty();\n","source_sha256":"1193e1af77f50cee24bf857f2c097984803cf3270309eb303c770ec95b2683a2","expected":"101\n102\n103\n104\n1\n12\n23\n34\n6\n17\n","expected_sha256":"570e775c7fb4185c5bba22d1b9813a251682cf5c93c6b6b919bb6dadbd40b628","c":"#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n#include <inttypes.h>\n#include <limits.h>\n#include <float.h>\n#include <fenv.h>\n#include <math.h>\n#include <stdio.h>\n#include <string.h>\n#if !defined(__STDC_VERSION__) || __STDC_VERSION__ < 201112L\n#error \"LilScript native requires C11\"\n#endif\n#if defined(__FAST_MATH__) || (defined(__FINITE_MATH_ONLY__) && __FINITE_MATH_ONLY__ != 0)\n#error \"LilScript native forbids fast-math and finite-only arithmetic\"\n#endif\n#if FLT_EVAL_METHOD != 0\n#error \"LilScript native requires evaluation in the declare