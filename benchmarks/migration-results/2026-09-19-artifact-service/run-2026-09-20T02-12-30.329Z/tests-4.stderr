earAll();assertEmpty();\n","sha256":"5a7feb20f4a30b6f8acf98b637c99516292f6a09bf26f596e5bbfedd186c8e10","bytes":373,"origin":"authored-portable-companion"},{"file":"native-closures/portable-factory.lil","source":"// Authored portable callback consumer of the unchanged integrated value/ref module.\nimport {productScore} from \"../integrated-architecture/products.lil\";\nextern void keep(int slot,func(int)->int callback);\nstruct Counter {int count;string label;}\nexport void installCounter(int seed,int slot) {\n    Counter state=Counter{seed,\"counter/ready\"};\n    keep(slot,(int delta)=>{\n        state.count+=delta;\n        return productScore(state.count,state.label.length);\n    });\n}\n","sha256":"9aff2e50956b68ab0470c4636590dca0c2415492e3c36ec668a1b7cb25cd254e","bytes":473,"origin":"authored-portable-companion"},{"file":"integrated-architecture/products.lil","source":"// Authored value/reference consumer, also compiled unchanged as a native module.\nstruct Pair { int x; int y; }\n\nint productStep(Pair productLocal,int delta) {\n    productLocal.x+=delta;\n    return productLocal.x+productLocal.y;\n}\n\nvoid updateReference(ref Pair whole,ref int leaf,int delta) {\n    whole=Pair{whole.x+delta,whole.y+1};\n    leaf+=2;\n}\n\nexport int productScore(int count,int width) {\n    Pair valueState=Pair{count,width};\n    Pair valueSaved=valueState;\n    int score=productStep(valueState,3);\n    // A separate constructor keeps this reference-exposed component packed.\n    Pair referenceState=Pair{count,width};\n    Pair referenceSaved=referenceState;\n    updateReference(ref referenceState,ref referenceState.x,4);\n    print(score);\n    print(valueSaved.x);\n    print(valueSaved.y);\n    print(referenceState.x);\n    print(referenceState.y);\n    print(referenceSaved.x);\n    print(referenceSaved.y);\n    return score+referenceState.x;\n}\n","sha256":"58cc646f62bb19b9ff4a4f9931221a32eeb24d87edbf23357842d0a635f3d778","bytes":955,"origin":"unchanged-integrated-source"}]}
