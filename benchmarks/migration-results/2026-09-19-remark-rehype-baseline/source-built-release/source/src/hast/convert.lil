JsValue oneImpl(JsValue self, JsValue node, JsValue parent) {
  if (JS.isUndefined(node) || JS.isNullish(node) || JS.typeOf(node) != "object") {
    throw JS.construct(Error, "Cannot compile `" + jsString(node) + "`");
  }
  JsValue typeVal = JS.get(node, "type");
  if (!(typeVal is string)) {
    throw JS.construct(Error, "Cannot compile unknown node");
  }
  string type = typeVal;
  JsValue handlers = JS.get(self, "handlers");
  if (hasOwn(handlers, type)) {
    JsValue handle = JS.get(handlers, type);
    if (!(JS.isUndefined(handle) || JS.isNullish(handle) || !handle.truthy())) {
      return JS.call(handle, handlers, self, node, parent);
    }
  }
  JsValue pass = JS.get(JS.get(self, "options"), "passThrough");
  if (JS.isArray(pass) && arrayIncludes(pass, type)) {
    if (hasOwn(node, "children")) {
      JsValue copied = JS.object();
      for (string key in node) {
        if (key != "children" && hasOwn(node, key)) {
          copied[key] = cloneValue(JS.get(node, key));
        }
      }
      copied["children"] = stateAll(self, node);
      return copied;
    }
    return cloneValue(node);
  }
  JsValue unknown = JS.get(JS.get(self, "options"), "unknownHandler");
  if (JS.typeOf(unknown) == "function") {
    return JS.call(unknown, JS.undefined(), self, node, parent);
  }
  return unknownDefault(self, node);
}

JsValue allImpl(JsValue self, JsValue parent) {
  JsValue values = emptyChildren();
  if (JS.isUndefined(parent) || JS.isNullish(parent) || !hasOwn(parent, "children")) {
    return values;
  }
  JsValue nodes = JS.get(parent, "children");
  if (!JS.isArray(nodes)) {
    return values;
  }
  int n = JS.number(JS.get(nodes, "length")).toInt();
  int index = 0;
  while (index < n) {
    JsValue result = JS.call(JS.get(self, "one"), self, nodes[index], parent);
    if (!(JS.isUndefined(result) || JS.isNullish(result) || !result.truthy())) {
      if (index > 0 && JS.get(nodes[index - 1], "type") is string && JS.get(nodes[index - 1], "type") == "break" && !JS.isArray(result)) {
        if (JS.get(result, "type") is string && JS.get(result, "type") == "text") {
          result["value"] = trimMarkdownSpaceStart(stringField(result, "value"));
        } else if (JS.get(result, "type") is string && JS.get(result, "type") == "element") {
          JsValue kids = JS.get(result, "children");
          if (JS.isArray(kids) && JS.number(JS.get(kids, "length")) > 0.0 && JS.get(kids[0], "type") is string && JS.get(kids[0], "type") == "text") {
            kids[0]["value"] = trimMarkdownSpaceStart(stringField(kids[0], "value"));
          }
        }
      }
      if (JS.isArray(result)) {
        int r = 0;
        int rn = JS.number(JS.get(result, "length")).toInt();
        while (r < rn) {
          JS.push(values, result[r]);
          r = r + 1;
        }
      } else {
        JS.push(values, result);
      }
    }
    index = index + 1;
  }
  return values;
}

export JsValue makeDefaultHandlers() {
  JsValue handlers = JS.object();
  handlers["paragraph"] = JS.method3(handleParagraph);
  handlers["root"] = JS.method3(handleRoot);
  handlers["text"] = JS.method3(handleText);
  handlers["blockquote"] = JS.method3(handleBlockquote);
