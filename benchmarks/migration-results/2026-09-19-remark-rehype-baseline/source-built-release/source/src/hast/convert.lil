    tag = "ol";
  }
  return finish(state, node, element(tag, props, JS.call(JS.get(state, "wrap"), state, results, true)));
}

int jsLen(JsValue value) {
  if (!JS.isArray(value)) {
    return 0;
  }
  return JS.number(JS.get(value, "length")).toInt();
}

JsValue oneTableCell(JsValue state, string tagName, JsValue align, JsValue cells, int cellIndex) {
  JsValue props = JS.object();
  if (JS.isArray(align) && cellIndex < jsLen(align)) {
    JsValue alignValue = align[cellIndex];
    if (!(JS.isUndefined(alignValue) || JS.isNullish(alignValue)) && alignValue.truthy()) {
      props["align"] = alignValue;
    }
  }
  JsValue result = element(tagName, props, emptyChildren());
  if (JS.isArray(cells) && cellIndex < jsLen(cells)) {
    JsValue cell = cells[cellIndex];
    if (!(JS.isUndefined(cell) || JS.isNullish(cell))) {
      result["children"] = stateAll(state, cell);
      JS.call(JS.get(state, "patch"), state, cell, result);
      result = JS.call(JS.get(state, "applyData"), state, cell, result);
    }
  }
  return result;
}

JsValue handleTableRow(JsValue _s, JsValue state, JsValue node, JsValue parent) {
  JsValue siblings = JS.undefined();
  JsValue align = JS.undefined();
  if (!(JS.isUndefined(parent) || JS.isNullish(parent))) {
    siblings = JS.get(parent, "children");
    if (JS.get(parent, "type") is string && JS.get(parent, "type") == "table") {
      align = JS.get(parent, "align");
    }
  }
  string tagName = "td";
  if (JS.isArray(siblings) && arrayIndexOf(siblings, node) == 0) {
    tagName = "th";
  }
  JsValue cells = JS.get(node, "children");
  int cellCount = jsLen(cells);
  if (JS.isArray(align)) {
    cellCount = jsLen(align);
  }
  JsValue out = emptyChildren();
  int cellIndex = 0;
  while (cellIndex < cellCount) {
    JS.push(out, oneTableCell(state, tagName, align, cells, cellIndex));
    cellIndex = cellIndex + 1;
  }
  return finish(state, node, element("tr", JS.object(), JS.call(JS.get(state, "wrap"), state, out, true)));
}

JsValue handleTable(JsValue _s, JsValue state, JsValue node, JsValue _p) {
  JsValue rows = stateAll(state, node);
  JsValue tableContent = emptyChildren();
  if (JS.number(JS.get(rows, "length")) > 0.0) {
