bool itemIsLoose(JsValue node) {
  JsValue spread = JS.get(node, "spread");
  if (JS.isUndefined(spread) || JS.isNullish(spread)) {
    JsValue children = JS.get(node, "children");
    return JS.isArray(children) && JS.number(JS.get(children, "length")) > 1.0;
  }
  return spread.truthy();
}

bool listIsLoose(JsValue node) {
  if (JS.get(node, "type") is string && JS.get(node, "type") == "list" && JS.get(node, "spread").truthy()) {
    return true;
  }
  if (!(JS.get(node, "type") is string) || JS.get(node, "type") != "list") {
    return false;
  }
  JsValue children = JS.get(node, "children");
  if (!JS.isArray(children)) {
    return false;
  }
  int n = JS.number(JS.get(children, "length")).toInt();
  int i = 0;
  while (i < n) {
    if (itemIsLoose(children[i])) {
      return true;
    }
    i = i + 1;
  }
  return false;
}

JsValue handleListItem(JsValue _s, JsValue state, JsValue node, JsValue parent) {
  JsValue results = stateAll(state, node);
  bool loose = itemIsLoose(node);
  if (!(JS.isUndefined(parent) || JS.isNullish(parent))) {
    loose = listIsLoose(parent);
  }
  JsValue props = JS.object();
  JsValue checkedVal = JS.get(node, "checked");
  if (checkedVal is bool) {
    JsValue paragraph = JS.undefined();
    if (JS.number(JS.get(results, "length")) > 0.0) {
      JsValue head = results[0];
      if (JS.get(head, "type") is string && JS.get(head, "type") == "element" && JS.get(head, "tagName") is string && JS.get(head, "tagName") == "p") {
        paragraph = head;
      }
    }
    if (JS.isUndefined(paragraph) || JS.isNullish(paragraph)) {
      paragraph = element("p", JS.object(), emptyChildren());
      JsValue next = arr1(paragraph);
      int i = 0;
      int n = JS.number(JS.get(results, "length")).toInt();
      while (i < n) {
        JS.push(next, results[i]);
        i = i + 1;
      }
      results = next;
    }
    JsValue pKids = JS.get(paragraph, "children");
    if (!JS.isArray(pKids)) {
      pKids = emptyChildren();
    }
    JsValue withBox = arr1(element("input", JS.object("type", "checkbox", "checked", checkedVal, "disabled", true), emptyChildren()));
    if (JS.number(JS.get(pKids, "length")) > 0.0) {
      JS.push(withBox, textNode(" "));
    }
    int q = 0;
    int qn = JS.number(JS.get(pKids, "length")).toInt();
    while (q < qn) {
      JS.push(withBox, pKids[q]);
      q = q + 1;
    }
    paragraph["children"] = withBox;
    props["className"] = arr1("task-list-item");
  }
  JsValue children = emptyChildren();
  int index = 0;
  int rn = JS.number(JS.get(results, "length")).toInt();
  while (index < rn) {
    JsValue child = results[index];
    bool isP = JS.get(child, "type") is string && JS.get(child, "type") == "element" && JS.get(child, "tagName") is string && JS.get(child, "tagName") == "p";
    if (loose || index != 0 || !isP) {
      JS.push(children, textNode("\n"));
    }
    if (isP && !loose) {
      JsValue inner = JS.get(child, "children");
      int k = 0;
      int kn = 0;
      if (JS.isArray(inner)) {
        kn = JS.number(JS.get(inner, "length")).toInt();
      }
      while (k < kn) {
        JS.push(children, inner[k]);
        k = k + 1;
      }
    } else {
      JS.push(children, child);
    }
    index = index + 1;
  }
  if (rn > 0) {
    JsValue tail = results[rn - 1];
    bool tailP = JS.get(tail, "type") is string && JS.get(tail, "type") == "element" && JS.get(tail, "tagName") is string && JS.get(tail, "tagName") == "p";
    if (loose || !tailP) {
      JS.push(children, textNode("\n"));
    }
  }
  return finish(state, node, element("li", props, children));
}

JsValue handleList(JsValue _s, JsValue state, JsValue node, JsValue _p) {
