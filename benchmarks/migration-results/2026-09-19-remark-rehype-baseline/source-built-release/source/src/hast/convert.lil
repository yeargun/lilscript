void collectDefs(JsValue node, JsValue definitionById, JsValue footnoteById) {
  if (JS.isUndefined(node) || JS.isNullish(node) || JS.typeOf(node) != "object") {
    return;
  }
  JsValue typeVal = JS.get(node, "type");
  if (typeVal is string && (typeVal == "definition" || typeVal == "footnoteDefinition")) {
    string id = definitionId(node);
    JsValue map = definitionById;
    if (typeVal == "footnoteDefinition") {
