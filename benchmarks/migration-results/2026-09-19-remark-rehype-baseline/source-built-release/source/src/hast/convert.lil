  handlers["delete"] = JS.method3(handleDelete);
  handlers["emphasis"] = JS.method3(handleEmphasis);
  handlers["strong"] = JS.method3(handleStrong);
  handlers["thematicBreak"] = JS.method3(handleThematicBreak);
  handlers["footnoteReference"] = JS.method3(handleFootnoteReference);
  handlers["heading"] = JS.method3(handleHeading);
  handlers["html"] = JS.method3(handleHtml);
  handlers["image"] = JS.method3(handleImage);
  handlers["link"] = JS.method3(handleLink);
  handlers["linkReference"] = JS.method3(handleLinkReference);
  handlers["imageReference"] = JS.method3(handleImageReference);
  handlers["list"] = JS.method3(handleList);
  handlers["listItem"] = JS.method3(handleListItem);
  handlers["inlineCode"] = JS.method3(handleInlineCode);
  handlers["code"] = JS.method3(handleCode);
  handlers["table"] = JS.method3(handleTable);
  handlers["tableRow"] = JS.method3(handleTableRow);
  handlers["tableCell"] = JS.method3(handleTableCell);
  handlers["definition"] = JS.method3(handleIgnore);
  handlers["yaml"] = JS.method3(handleIgnore);
  handlers["toml"] = JS.method3(handleIgnore);
  handlers["footnoteDefinition"] = JS.method3(handleIgnore);
  return handlers;
}

