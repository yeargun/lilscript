string revertSuffix(JsValue node) {
  string subtype = stringField(node, "referenceType");
  if (subtype == "collapsed") {
    return "][]";
  }
  if (subtype == "full") {
    JsValue labelVal = JS.get(node, "label");
    if (JS.isUndefined(labelVal) || JS.isNullish(labelVal)) {
      return "][" + jsString(JS.get(node, "identifier")) + "]";
    }
    return "][" + jsString(labelVal) + "]";
  }
  return "]";
}

JsValue revertReference(JsValue state, JsValue node) {
  string suffix = revertSuffix(node);
  if (JS.get(node, "type") is string && JS.get(node, "type") == "imageReference") {
    return arr1(textNode("![" + stringField(node, "alt") + suffix));
  }
  JsValue contents = stateAll(state, node);
  if (JS.number(JS.get(contents, "length")) > 0.0 && JS.get(contents[0], "type") is string && JS.get(contents[0], "type") == "text") {
    contents[0]["value"] = "[" + stringField(contents[0], "value");
  } else {
    JsValue next = arr1(textNode("["));
    int i = 0;
    int n = JS.number(JS.get(contents, "length")).toInt();
    while (i < n) {
      JS.push(next, contents[i]);
      i = i + 1;
    }
    contents = next;
  }
  int cn = JS.number(JS.get(contents, "length")).toInt();
  if (cn > 0 && JS.get(contents[cn - 1], "type") is string && JS.get(contents[cn - 1], "type") == "text") {
    contents[cn - 1]["value"] = stringField(contents[cn - 1], "value") + suffix;
  } else {
    JS.push(contents, textNode(suffix));
  }
  return contents;
}

