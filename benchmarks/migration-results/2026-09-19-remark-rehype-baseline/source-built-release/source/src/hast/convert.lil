JsValue unknownDefault(JsValue state, JsValue node) {
  JsValue data = JS.get(node, "data");
  if (JS.isUndefined(data) || JS.isNullish(data)) {
    data = JS.object();
  }
  JsValue result = JS.undefined();
  if (hasOwn(node, "value") && !(hasOwn(data, "hProperties") || hasOwn(data, "hChildren"))) {
    result = textNode(jsString(JS.get(node, "value")));
  } else {
    result = element("div", JS.object(), stateAll(state, node));
  }
  JS.call(JS.get(state, "patch"), state, node, result);
  return JS.call(JS.get(state, "applyData"), state, node, result);
