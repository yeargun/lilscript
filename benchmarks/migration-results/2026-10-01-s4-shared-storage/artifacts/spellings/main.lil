extern void observe(int n);export int select0(bool flag,int n){if(flag){return n+1;}else{return n-1;}}export int select1(bool flag,int n){if(flag){return n+2;}else{return n-2;}}export int select2(bool flag,int n){if(flag){return n+3;}else{return n-3;}}export int select3(bool flag,int n){if(flag){return n+4;}else{return n-4;}}export int select4(bool flag,int n){if(flag){return n+5;}else{return n-5;}}export int select5(bool flag,int n){if(flag){return n+6;}else{return n-6;}}export int loops(int n){int total=0;for(int i=0;i<n;i+=1){total+=i;}if(n>0){observe(total);}if(n==0){observe(99);}return total;}export string quotes(){return "\"quoted\" \"again\"";}
