extern bool next();export JsValue read(JsValue obj){if(JS.strictEqual(obj,null)||JS.isUndefined(obj)){return JS.undefined();}return obj["item"];}export JsValue call(JsValue obj){JsValue callback;if(JS.strictEqual(obj,null)||JS.isUndefined(obj)){callback=JS.undefined();}else{callback=obj["method"];}return callback();}export bool ensure(bool flag){if(!flag){flag=next();}return flag;}
