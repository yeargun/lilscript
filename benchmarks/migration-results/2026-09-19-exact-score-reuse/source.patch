+                        view("abcd", None),
+                    ] {
+                        assert_eq!(package.sizes.raw, different.sizes.raw);
+                        assert!(!same_streams(package, different, budget).unwrap());
+                    }
+                    assert!(!same_streams(
+                        view("ab", None),
+                        view("ab", Some(("./data.mjs", ""))),
+                        budget,
+                    )
+                    .unwrap());
+                });
+            })
+            .unwrap();
+    });
