+fn equal_bytes(
+    left: &str,
+    right: &str,
+    budget: &mut AllocationBudget<'_>,
+) -> Result<bool, CandidateError> {
+    if left.len() != right.len() {
+        return Ok(false);
+    }
+    budget.work(
+        WorkKind::Analysis,
+        u64::try_from(left.len()).map_err(|_| AllocationError::Capacity)?,
+    )?;
+    Ok(left == right)
