struct Point {
  int x;
  int y;
}

struct Rect {
  Point origin;
  int width;
  int height;
}

int area(Rect rect) {
  return rect.width * rect.height + rect.origin.x + rect.origin.y;
}

int[] values = [3, 1, 4, 1, 5, 9];
int total = 0;
for (int i = 0; i + 3 < values.length; i += 4) {
  int w = values[i + 2];
  int h = values[i + 3];
  if (w == 0) {
    w = 1;
  }
  if (h == 0) {
    h = 1;
  }
  total += area(Rect{Point{values[i], values[i + 1]}, w, h});
}
print(total);
