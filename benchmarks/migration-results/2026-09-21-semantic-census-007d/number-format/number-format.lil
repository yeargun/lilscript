float x = 1.0;
for (int i = 0; i < 1100; i++) {
  print(x);
  print(-x / 3.0);
  x = x * 2.0;
}
float y = 1.0;
for (int i = 0; i < 1080; i++) {
  print(y);
  print(y * 7.0 / 11.0);
  y = y / 2.0;
}
float z = 0.1;
for (int i = 0; i < 400; i++) {
  print(z);
  print(`${z}|${i}|${z > 1.0}`);
  z = z * 1.37 + 0.001;
}
float w = 123456789.0;
for (int i = 0; i < 60; i++) {
  print(w);
  w = w * 10.0 + 0.5;
}
print(0.0 / 0.0);
print(1.0 / 0.0);
print(-1.0 / 0.0);
print(-0.0);
print(`${-0.0}`);
print(.0);
print(9007199254740993.0);
print(0.000001);
print(0.0000001);
print(1000000000000000000000.0);
print(100000000000000000000.0);
print(0.00000000000000000123);
