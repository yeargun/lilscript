class Text{string text;init(string x){this.text=x;}}class Count{int count;init(int x){this.count=x;}}sealed class Base{virtual int read(int n=3){return n+1;}}class Child extends Base{override int read(int n=4){return n*2;}}Text|Count choose(bool text){if(text){return new Text("hello");}return new Count(9);}export int payload(bool text){auto f=match(choose(text)){Text(item)=>(()=>item.text.length),Count(item)=>(()=>item.count)};return f();}export int dispatch(bool child){Base b=new Base();if(child){b=new Child();}return b.read();}