+/// Empty global plans can be reused only while the edit owner's complete
+/// source revision is unchanged. The revision advances for every touched body
+/// or table, even when a rule forgot to report a semantic change.
+#[derive(Clone, Copy)]
+struct GlobalStable {
+    revision: RevisionId,
+    admission: crate::admission_replay::Receipt,
+    work: GlobalWork,
+}
+
+#[derive(Clone, Copy)]
+struct GlobalWork {
+    frequency: u64,
+    aggregates: u64,
+    limits: u32,
+    evaluated: u32,
+    refused: [u32; 6],
+}
+impl GlobalWork {
+    fn between(before: &RuleReceipt, after: &RuleReceipt) -> Self {
+        Self {
+            frequency: after.call_frequency_work - before.call_frequency_work,
+            aggregates: after.aggregate_analysis_work - before.aggregate_analysis_work,
+            limits: after.aggregate_limits - before.aggregate_limits,
+            evaluated: after.evaluated_calls - before.evaluated_calls,
+            refused: std::array::from_fn(|index| {
+                after.evaluation_refusals[index] - before.evaluation_refusals[index]
+            }),
+        }
+    }
+    fn replay(self, receipt: &mut RuleReceipt) {
+        receipt.call_frequency_work += self.frequency;
+        receipt.aggregate_analysis_work += self.aggregates;
+        receipt.aggregate_limits += self.limits;
+        receipt.evaluated_calls = receipt.evaluated_calls.saturating_add(self.evaluated);
+        for (total, count) in receipt.evaluation_refusals.iter_mut().zip(self.refused) {
+            *total = total.saturating_add(count);
+        }
+    }
+}
+
+pub(super) struct DirtyGlobals {
+    seen: [Option<GlobalStable>; 9],
+    enabled: bool,
+}
+impl DirtyGlobals {
+    pub(super) fn new(enabled: bool) -> Self {
+        Self {
+            seen: [None; 9],
+            enabled,
+        }
+    }
+    pub(super) fn apply<'src>(
+        &mut self,
+        editor: &mut edit::Editor<'src>,
+        rule: ProgramRule,
+        receipt: &mut RuleReceipt,
+        budget: &mut AllocationBudget<'_>,
+        build: impl FnOnce(
+            &mut edit::Editor<'src>,
+            &mut RuleReceipt,
+            &mut AllocationBudget<'_>,
+        ) -> Result<bool, RuleError>,
+    ) -> Result<bool, RuleError> {
+        let revision = editor.revision();
+        let slot = &mut self.seen[rule as usize];
+        if let Some(stable) = slot.filter(|stable| stable.revision == revision) {
+            return budget.replay(&stable.admission, || {
+                if self.enabled {
+                    receipt.global_rules_reused += 1;
+                    stable.work.replay(receipt);
+                    Ok(false)
+                } else {
+                    receipt.global_rules_visited += 1;
+                    build(editor, receipt, &mut AllocationBudget::new(None))
+                }
+            });
+        }
+        receipt.global_rules_visited += 1;
+        let before = *receipt;
+        let (changed, admission) = budget.record(|budget| build(editor, receipt, budget))?;
+        *slot = admission
+            .filter(|stage| !changed && stage.live_bytes() == 0 && editor.revision() == revision)
+            .map(|admission| GlobalStable {
+                revision,
+                admission,
+                work: GlobalWork::between(&before, receipt),
+            });
+        Ok(changed)
+    }
+}
