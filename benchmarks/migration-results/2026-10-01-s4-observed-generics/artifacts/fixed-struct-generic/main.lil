struct Point{int x;}export Point copy<T>(Point p,T value){p.x+=1;return p;}class Box<T>{T value;init(T v){this.value=v;}Point change(Point p){p.x+=2;return p;}}export constructor Box;class Constructed{int value;init(Point p){this.value=p.x;}}export JsValue constructorValue(){return Constructed;}export int run(){Point p=Point{4};Box<int> b=new Box<int>(3);Point q=b.change(p);Point r=copy(p,true);return p.x*100+q.x*10+r.x;}