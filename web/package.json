{
  "name": "lilscript-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "catalog": "node scripts/generate-benchmark-catalog.mjs",
    "dev": "vite --port 5173",
    "build": "npm run catalog && vite build",
    "build:pages": "LILSCRIPT_PAGES_BASE=/lilscript/ vite build && node scripts/prepare-pages.mjs",
    "preview": "vite preview --port 4174",
    "test": "node --test test/*.test.mjs",
    "test:pages": "node --test test/product-pages.test.mjs test/delivery.test.mjs test/demos.test.mjs",
    "publish:motion-lab": "node ../benchmarks/popular/publish-motion-lab.mjs"
  },
  "dependencies": {
    "lucide": "^1.28.0"
  },
  "devDependencies": {
    "vite": "8.2.1"
  }
}
