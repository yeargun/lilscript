struct Point {
  int x;
  int y;
}
int manhattan(Point point) {
  int x = point.x;
  if (x < 0) {
    x = -x;
  }
  int y = point.y;
  if (y < 0) {
    y = -y;
  }
  return x + y;
}
int[] values = [3, -4, 5, 6, -7, 8, 1, -2];
int total = 0;
for (int i = 0; i + 1 < values.length; i += 2) {
  total += manhattan(Point{values[i], values[i + 1]});
}
print(total);
