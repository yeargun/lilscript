{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lilscript.dev/schema/large-library-observations-v1.json",
  "title": "LilScript large-library observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "format",
    "matrixSha256",
    "regressionPolicy",
    "codec",
    "observations",
    "comparisons",
    "evidenceFingerprint"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "lilscript-large-library-observations" },
    "matrixSha256": { "$ref": "#/$defs/sha256" },
    "regressionPolicy": { "$ref": "#/$defs/regressionPolicy" },
    "codec": { "$ref": "#/$defs/codec" },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    },
    "comparisons": {
      "type": "array",
      "items": { "$ref": "#/$defs/comparison" }
    },
    "evidenceFingerprint": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitObject": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "nullableSha256": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "nullableGitObject": {
      "anyOf": [{ "$ref": "#/$defs/gitObject" }, { "type": "null" }]
    },
    "sizes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "gzip9", "brotli11"],
      "properties": {
        "raw": { "type": "integer", "minimum": 0 },
        "gzip9": { "type": "integer", "minimum": 0 },
        "brotli11": { "type": "integer", "minimum": 0 }
      }
    },
    "regressionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semanticStatusRequired", "maxRegressionBytes"],
      "properties": {
        "semanticStatusRequired": { "const": "passed" },
        "maxRegressionBytes": { "$ref": "#/$defs/sizes" }
      }
    },
    "gzipCodec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoder",
        "libraryVersion",
        "cargoPackage",
        "cargoPackageVersion",
        "level",
        "mtime"
      ],
      "properties": {
        "encoder": { "const": "upstream-stock-zlib-c" },
        "libraryVersion": { "const": "1.3.1" },
        "cargoPackage": { "const": "libz-sys" },
        "cargoPackageVersion": { "type": "string", "minLength": 1 },
        "level": { "const": 9 },
        "mtime": { "const": 0 }
      }
    },
    "brotliCodec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoder",
        "libraryVersion",
        "cargoPackage",
        "cargoPackageVersion",
        "quality",
        "lgwin",
        "mode"
      ],
      "properties": {
        "encoder": { "const": "official-google-brotli-c" },
        "libraryVersion": { "const": "1.1.0" },
        "cargoPackage": { "const": "compu-brotli-sys" },
        "cargoPackageVersion": { "type": "string", "minLength": 1 },
        "quality": { "const": 11 },
        "lgwin": { "const": 22 },
        "mode": { "const": "generic" }
      }
    },
    "codec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binarySha256",
        "sourceSha256",
        "builtFromRevision",
        "schemaVersion",
        "gzip9",
        "brotli11"
      ],
      "properties": {
        "binarySha256": { "$ref": "#/$defs/nullableSha256" },
        "sourceSha256": { "$ref": "#/$defs/sha256" },
        "builtFromRevision": { "$ref": "#/$defs/nullableGitObject" },
        "schemaVersion": { "const": 1 },
        "gzip9": { "$ref": "#/$defs/gzipCodec" },
        "brotli11": { "$ref": "#/$defs/brotliCodec" }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from"],
      "properties": {
        "kind": { "enum": ["identity", "prepend-first-line"] },
        "from": { "type": ["string", "null"] }
      }
    },
    "artifactSemantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidenceClass", "command", "summary"],
      "properties": {
        "status": {
          "enum": ["passed", "failed", "not-run", "reported-passed"]
        },
        "evidenceClass": { "enum": ["fresh", "published", "none"] },
        "command": { "type": ["string", "null"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "aggregateSemantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidenceClass", "command", "summary"],
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not-run",
            "reported-passed"
          ]
        },
        "evidenceClass": { "enum": ["fresh", "published", "none"] },
        "command": { "type": ["string", "null"] },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "objective",
        "gateMetrics",
        "relativePath",
        "configSha256",
        "sha256",
        "sizes",
        "derivation",
        "semantic"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["gate", "diagnostic"] },
        "objective": { "enum": ["raw", "gzip9", "brotli11", null] },
        "gateMetrics": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["raw", "gzip9", "brotli11"] }
        },
        "relativePath": { "type": "string", "minLength": 1 },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizes": { "$ref": "#/$defs/sizes" },
        "derivation": { "$ref": "#/$defs/derivation" },
        "semantic": { "$ref": "#/$defs/artifactSemantic" }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "revision",
        "tree",
        "binarySha256",
        "primarySourceSha256",
        "sourceIdentity"
      ],
      "properties": {
        "role": {
          "enum": ["published-unknown", "baseline", "checkpoint"]
        },
        "revision": { "$ref": "#/$defs/nullableGitObject" },
        "tree": { "$ref": "#/$defs/nullableGitObject" },
        "binarySha256": { "$ref": "#/$defs/nullableSha256" },
        "primarySourceSha256": { "$ref": "#/$defs/nullableSha256" },
        "sourceIdentity": { "type": ["string", "null"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "tree",
        "packageLockSha256",
        "entrySha256",
        "configSha256",
        "configDerivation"
      ],
      "properties": {
        "revision": { "$ref": "#/$defs/gitObject" },
        "tree": { "$ref": "#/$defs/gitObject" },
        "packageLockSha256": { "$ref": "#/$defs/sha256" },
        "entrySha256": { "$ref": "#/$defs/sha256" },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "configDerivation": { "type": ["string", "null"] }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "wallMs",
        "userCpuMs",
        "systemCpuMs",
        "contention",
        "diagnosticOnly",
        "unavailableReason"
      ],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "wallMs": { "type": ["number", "null"], "minimum": 0 },
        "userCpuMs": { "type": ["number", "null"], "minimum": 0 },
        "systemCpuMs": { "type": ["number", "null"], "minimum": 0 },
        "contention": { "enum": ["isolated", "contended", "unknown"] },
        "diagnosticOnly": { "const": true },
        "unavailableReason": { "type": ["string", "null"] }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "kind", "diagnostic", "artifactEmitted"],
      "properties": {
        "phase": { "enum": ["prepare", "compile", "measure"] },
        "kind": {
          "enum": [
            "timeout",
            "compile-error",
            "crash",
            "aborted",
            "not-run"
          ]
        },
        "diagnostic": { "type": "string" },
        "artifactEmitted": { "type": "boolean" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "library",
        "purpose",
        "evidenceClass",
        "recordedAt",
        "compiler",
        "source",
        "status",
        "artifacts",
        "semantic",
        "timing",
        "failure",
        "notes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
        "library": {
          "enum": ["solidlil", "motionlil", "markedlil", "mobxlil", "mobxlil-production-min", "jquerylil"]
        },
        "purpose": { "enum": ["comparison", "published", "diagnostic"] },
        "evidenceClass": { "enum": ["published", "fresh"] },
        "recordedAt": { "type": "string", "format": "date-time" },
        "compiler": { "$ref": "#/$defs/compiler" },
        "source": { "$ref": "#/$defs/source" },
        "status": {
          "enum": ["passed", "compile-error", "timeout", "aborted", "not-run"]
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "semantic": { "$ref": "#/$defs/aggregateSemantic" },
        "timing": { "$ref": "#/$defs/timing" },
        "failure": {
          "anyOf": [{ "$ref": "#/$defs/failure" }, { "type": "null" }]
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library",
        "metric",
        "beforeObservation",
        "afterObservation",
        "maxRegressionBytes",
        "outcome",
        "gatePassed",
        "reason"
      ],
      "properties": {
        "library": {
          "enum": ["solidlil", "motionlil", "markedlil", "mobxlil", "mobxlil-production-min", "jquerylil"]
        },
        "metric": { "enum": ["raw", "gzip9", "brotli11"] },
        "beforeObservation": { "type": ["string", "null"] },
        "afterObservation": { "type": ["string", "null"] },
        "maxRegressionBytes": { "type": "integer", "minimum": 0 },
        "outcome": { "enum": ["win", "tie", "regression", "ineligible"] },
        "gatePassed": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    }
  }
}
