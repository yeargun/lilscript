int factor = 6;

int increment(int value) {
  return value + 1;
}

int threeSteps(int value) {
  return increment(increment(increment(value)));
}

int repeated(int value) {
  int first = value * 7;
  int second = 7 * value;
  return first + second;
}

int unused(int value) {
  return value * 1000;
}

class Box {
  int value;

  init(int value) {
    this.value = value;
  }

  int plus(int amount) {
    return this.value + amount;
  }
}

Box box = new Box(40);
print(threeSteps(1));
print(repeated(factor));
print(box.plus(2));
print("application-build-identifier");
print("application-build-identifier");
print("application-build-identifier");

if (false) {
  print(unused(9));
}
