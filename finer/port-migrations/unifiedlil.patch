+// Two printings of the same compiled program are candidates for each published ESM: the compiler's
+// own artifact, and esbuild's minified reprint of it. The smaller one under this port's `cost_model`
+// ships (the build log says which). Measured on this port: under `brotli` the compiler's printing is
+// ~90 Brotli smaller than the reprint (esbuild's renaming and statement folding break repetition the
+// compiler chose); under `raw` the reprint is ~500 bytes smaller. Picking per objective keeps each
+// build on the better side, and the choice cannot regress when the compiler moves.
+const configText = readFileSync(resolve(root, "lilscript.toml"), "utf8")
+const costModel = /^\s*cost_model\s*=\s*"([a-z]+)"/m.exec(configText)?.[1] ?? "brotli"
+function cost(bytes) {
+  if (costModel === "raw") return bytes.length
+  if (costModel === "gzip") return gzipSync(bytes, { level: 9 }).length
+  return brotliCompressSync(bytes, {
+    params: {
+      [zlib.BROTLI_PARAM_QUALITY]: 11,
+      [zlib.BROTLI_PARAM_LGWIN]: 22,
+      [zlib.BROTLI_PARAM_SIZE_HINT]: bytes.length,
+    },
+  }).length
+}
+async function publish(name, source, publicBanner, keep) {
+  const direct = Buffer.from(filterExports(`${publicBanner}${source.trimEnd()}\n`, keep))
+  const printed = await transform(direct.toString("utf8"), {
+    format: "esm",
+    legalComments: "inline",
+    minify: true,
+    target: "es2022",
+  })
+  const reprint = Buffer.from(printed.code)
+  const directCost = cost(direct)
+  const reprintCost = cost(reprint)
+  writeFileSync(resolve(dist, name), directCost <= reprintCost ? direct : reprint)
+  console.log(`dist/${name}: ${directCost <= reprintCost ? "compiler" : "esbuild reprint"} (${costModel} ${directCost} vs ${reprintCost})`)
+}
+
