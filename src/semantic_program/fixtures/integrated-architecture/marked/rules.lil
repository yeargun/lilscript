export Regex otherTableAlignChars = new Regex("^\\||\\| *$", "g");
export Regex otherTableRowBlankLine = new Regex("\\n[ \\t]*$");
export Regex otherTableAlignRight = new Regex("^ *-+: *$");
export Regex otherTableAlignCenter = new Regex("^ *:-+: *$");
export Regex otherTableAlignLeft = new Regex("^ *:-+ *$");
export Regex otherStartATag = new Regex("^<a ", "i");
export Regex otherEndATag = new Regex("^<\\/a>", "i");
export Regex otherStartPreScriptTag = new Regex("^<(pre|code|kbd|script)(\\s|>)", "i");
export Regex otherEndPreScriptTag = new Regex("^<\\/(pre|code|kbd|script)(\\s|>)", "i");
export Regex otherStartAngleBracket = new Regex("^<");
export Regex otherEndAngleBracket = new Regex(">$");
export Regex otherPedanticHrefTitle = new Regex("^([^'\"]*[^\\s])\\s+(['\"])(.*)\\2");
export Regex otherUnicodeAlphaNumeric = new Regex("[\\p{L}\\p{N}]", "u");
export Regex otherEscapeTest = new Regex("[&<>\"']");
export Regex otherEscapeTestNoEncode = new Regex("[<>\"']|&(?!(#\\d{1,7}|#[Xx][a-fA-F0-9]{1,6}|\\w+);)");
export Regex otherPercentDecode = new Regex("%25", "g");
export Regex otherSlashPipe = new Regex("\\\\\\|", "g");
export Regex otherCarriageReturn = new Regex("\\r\\n|\\r", "g");
export Regex otherSpaceLine = new Regex("^ +$", "gm");
export Regex otherNotSpaceStart = new Regex("^\\S*");
export Regex nextBullet0 = new Regex("^ {0,0}(?:[*+-]|\\d{1,9}[.)])((?:[ \\t][^\\n]*)?(?:\\n|$))");
export Regex nextBullet1 = new Regex("^ {0,1}(?:[*+-]|\\d{1,9}[.)])((?:[ \\t][^\\n]*)?(?:\\n|$))");
export Regex nextBullet2 = new Regex("^ {0,2}(?:[*+-]|\\d{1,9}[.)])((?:[ \\t][^\\n]*)?(?:\\n|$))");
export Regex nextBullet3 = new Regex("^ {0,3}(?:[*+-]|\\d{1,9}[.)])((?:[ \\t][^\\n]*)?(?:\\n|$))");
export Regex hrIndent0 = new Regex("^ {0,0}((?:- *){3,}|(?:_ *){3,}|(?:\\* *){3,})(?:\\n+|$)");
export Regex hrIndent1 = new Regex("^ {0,1}((?:- *){3,}|(?:_ *){3,}|(?:\\* *){3,})(?:\\n+|$)");
export Regex hrIndent2 = new Regex("^ {0,2}((?:- *){3,}|(?:_ *){3,}|(?:\\* *){3,})(?:\\n+|$)");
export Regex hrIndent3 = new Regex("^ {0,3}((?:- *){3,}|(?:_ *){3,}|(?:\\* *){3,})(?:\\n+|$)");
export Regex fencesBegin0 = new Regex("^ {0,0}(?:```|~~~)");
export Regex fencesBegin1 = new Regex("^ {0,1}(?:```|~~~)");
export Regex fencesBegin2 = new Regex("^ {0,2}(?:```|~~~)");
export Regex fencesBegin3 = new Regex("^ {0,3}(?:```|~~~)");
export Regex headingBegin0 = new Regex("^ {0,0}#");
export Regex headingBegin1 = new Regex("^ {0,1}#");
export Regex headingBegin2 = new Regex("^ {0,2}#");
export Regex headingBegin3 = new Regex("^ {0,3}#");
export Regex htmlBegin0 = new Regex("^ {0,0}<(?:[a-z].*>|!--)", "i");
export Regex htmlBegin1 = new Regex("^ {0,1}<(?:[a-z].*>|!--)", "i");
export Regex htmlBegin2 = new Regex("^ {0,2}<(?:[a-z].*>|!--)", "i");
export Regex htmlBegin3 = new Regex("^ {0,3}<(?:[a-z].*>|!--)", "i");
export Regex blockquoteBegin0 = new Regex("^ {0,0}>");
export Regex blockquoteBegin1 = new Regex("^ {0,1}>");
export Regex blockquoteBegin2 = new Regex("^ {0,2}>");
export Regex blockquoteBegin3 = new Regex("^ {0,3}>");

export Regex nextBulletRegex(int indent) {
  int i = indent - 1;
  if (i < 0) { i = 0; }
  if (i > 3) { i = 3; }
  if (i == 0) { return nextBullet0; }
  if (i == 1) { return nextBullet1; }
  if (i == 2) { return nextBullet2; }
  return nextBullet3;
}

