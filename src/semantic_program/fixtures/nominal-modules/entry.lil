import { Interval, Frame } from "./left-types";
import { SpanAxis, OtherFrame } from "./right-types";
import { translateFrame, snapshot, replaceFrame } from "./helpers";
import { makeLeft, leftNumber, setLeft } from "./private-left";
import { makeRight, rightNumber } from "./private-right";
export { Interval as GeometryAxis, OtherFrame as GeometryBox };

Frame box = Frame{Interval{1.0, 3.0}, Interval{5.0, 8.0}};
OtherFrame original = box;
translateFrame(ref box, 2.0, 4.0);
print(box.x.min == 3.0);
print(box.x.max == 5.0);
print(box.y.min == 9.0);
print(box.y.max == 12.0);
print(original.x.min == 1.0);
print(original.y.max == 8.0);
OtherFrame saved = snapshot(ref box);
print(saved.x.min == 3.0);
print(box.x.min == 13.0);
replaceFrame(ref box, ref box.x.min);
print(box.x.min == 12.0);
print(box.x.max == 20.0);
print(box.y.min == 30.0);
print(box.y.max == 45.0);
print(saved.x.min == 3.0);
print(saved.y.max == 12.0);
SpanAxis fromOtherBranch = Interval{6.0, 9.0};
print(fromOtherBranch.max == 9.0);
auto left = makeLeft(2);
auto right = makeRight(5);
auto leftCopy = left;
setLeft(ref left, 7);
print(leftNumber(left));
print(leftNumber(leftCopy));
print(rightNumber(right));
print(right.marker);
