extern JsValue event(string label);
export void run(bool which){
    string truth="truth-only-payload";
    string empty="";
    string? present="nullish-only-payload";
    string? missing=null;
    string choice=if(which){"yes-literal-payload"}else{"no-literal-payload"};
    JS.and(truth,event("truth-effect"));
    JS.or(empty,event("empty-effect"));
    auto unused_present=present??event("unreachable-nullish");
    auto unused_missing=missing??event("missing-effect");
    JS.and(choice,event("branch-effect"));
}
