// Build-time feature constants. Production builds copy the source graph and
// select false values before compilation.
export bool DEV = true;
export bool TEST = true;

export JsValue TrackOpTypes = JS.object(
  "GET", "get",
  "HAS", "has",
  "ITERATE", "iterate"
);

export JsValue TriggerOpTypes = JS.object(
  "SET", "set",
  "ADD", "add",
  "DELETE", "delete",
  "CLEAR", "clear"
);

export JsValue ReactiveFlags = JS.object(
  "SKIP", "__v_skip",
  "IS_REACTIVE", "__v_isReactive",
  "IS_READONLY", "__v_isReadonly",
  "IS_SHALLOW", "__v_isShallow",
  "RAW", "__v_raw",
  "IS_REF", "__v_isRef"
);
