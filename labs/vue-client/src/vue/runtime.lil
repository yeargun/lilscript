import {read_DEV as vue_read_DEV, read_ESM_BUNDLER as vue_read_ESM_BUNDLER, read_ESM_BROWSER as vue_read_ESM_BROWSER, read_GLOBAL as vue_read_GLOBAL} from "../package/build-flags.lil";
