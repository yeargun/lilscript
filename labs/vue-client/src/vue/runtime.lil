  withScopeId
} from "../package/runtime-dom.lil";

extern JsValue Object;

if (vue_read_DEV().truthy()) initDev();

export void compile() {
  if (vue_read_DEV().truthy()) {
    string message = "Runtime compilation is not supported in this build of Vue.";
    if (vue_read_ESM_BUNDLER().truthy()) {
      message += " Configure your bundler to alias \"vue\" to \"vue/dist/vue.esm-bundler.js\".";
    } else if (vue_read_ESM_BROWSER().truthy()) {
      message += " Use \"vue.esm-browser.js\" instead.";
    } else if (vue_read_GLOBAL().truthy()) {
      message += " Use \"vue.global.js\" instead.";
    }
    JS.call(runtimeWarn, JS.undefined(), message);
  }
}

JS.invoke(
  Object,
  "defineProperty",
  compile,
  "name",
  JS.object("configurable", true, "value", "compile")
);

