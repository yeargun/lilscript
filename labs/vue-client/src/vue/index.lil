JsValue compileErrorHandler(string template) {
  return JS.method2((JsValue _self, JsValue error, JsValue asWarningValue) => {
    bool asWarning = !JS.isUndefined(asWarningValue) && asWarningValue.truthy();
    string message = JS.string(error["message"]);
    if (!asWarning) message = "Template compilation error: " + message;

    string codeFrame = "";
    JsValue location = error["loc"];
    if (location.truthy()) {
      codeFrame = JS.string(JS.call(
        sharedGenerateCodeFrame,
        JS.undefined(),
        template,
        location["start"]["offset"],
        location["end"]["offset"]
      ));
    }
    if (codeFrame != "") message += "\n" + codeFrame;
    JS.call(runtimeWarn, JS.undefined(), message);
    return JS.undefined();
  });
}

JsValue compileToFunction(JsValue template) {
  JsValue options = JS.undefined();
  if (JS.number(arguments["length"]).toInt() > 1) options = arguments[1];

  if (!sharedIsString(template)) {
    if (template["nodeType"].truthy()) {
      template = template["innerHTML"];
    } else {
      if (__DEV__) {
        JS.call(runtimeWarn, JS.undefined(), "invalid template option: ", template);
      }
      return sharedNoop;
    }
  }

  string source = JS.string(template);
  string key = sharedGenCacheKey(source, options);
  JsValue cached = compileCache[key];
  if (cached.truthy()) return cached;

  if (source.startsWith("#")) {
    JsValue element = JS.invoke(document, "querySelector", source);
    if (__DEV__ && !element.truthy()) {
      JS.call(
        runtimeWarn,
        JS.undefined(),
        "Template element not found or is empty: " + source
      );
    }
    source = "";
    if (element.truthy()) source = JS.string(element["innerHTML"]);
  }

  JsValue onError = compileErrorHandler(source);
  JsValue onWarn = sharedNoop;
  if (__DEV__) {
    onWarn = JS.method1((JsValue _self, JsValue error) => {
      JS.call(onError, JS.undefined(), error, true);
      return JS.undefined();
    });
  }
  JsValue defaultOnError = JS.undefined();
  if (__DEV__) defaultOnError = onError;
  JsValue defaultOptions = JS.object(
    "hoistStatic", true,
    "onError", defaultOnError,
    "onWarn", onWarn
  );
  JsValue resolvedOptions = JS.call(
    sharedExtend,
    JS.undefined(),
    defaultOptions,
    options
  );

  if (
    !resolvedOptions["isCustomElement"].truthy() &&
    JS.typeOf(customElements) != "undefined"
  ) {
    resolvedOptions["isCustomElement"] = JS.method1(
      (JsValue _self, JsValue tag) => JS.invoke(customElements, "get", tag).truthy()
    );
  }

  JsValue result = JS.call(
    compilerCompile,
    JS.undefined(),
    source,
    resolvedOptions
  );
  string code = JS.string(result["code"]);
  JsValue render = JS.undefined();
  if (__GLOBAL__) {
    JsValue evaluateGlobal = JS.construct(Function, code);
    render = JS.call(evaluateGlobal, JS.undefined());
  } else {
    JsValue evaluateModule = JS.construct(Function, "Vue", code);
    render = JS.call(evaluateModule, JS.undefined(), runtimeDom);
  }

  render["_rc"] = true;
  compileCache[key] = render;
  return render;
}

JS.invoke(
  Object,
  "defineProperty",
  compileToFunction,
  "name",
  JS.object("configurable", true, "value", "compileToFunction")
);

runtimeRegisterRuntimeCompiler(compileToFunction);

