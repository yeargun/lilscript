import extern {
  escapeHtml as interpolateEscapeHtml,
  toDisplayString as interpolateToDisplayString
} from "../../../packages/vuelil/shared.js";

extern string interpolateEscapeHtml(JsValue value);
extern string interpolateToDisplayString(JsValue value);

export string ssrInterpolate(JsValue value) {
  return interpolateEscapeHtml(interpolateToDisplayString(value));
}
