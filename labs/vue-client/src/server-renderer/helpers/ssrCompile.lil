import {
  NO as compileNO,
  extend as compileExtend,
  generateCodeFrame as compileGenerateCodeFrame,
  isFunction as compileIsFunction
} from "../../package/shared.lil";
import {
  BaseTransition as compileVueBaseTransition,
  Fragment as compileVueFragment,
