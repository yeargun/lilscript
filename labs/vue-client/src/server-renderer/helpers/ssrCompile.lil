  ssrRenderSlotInner,
  ssrRenderStyle,
  ssrRenderSuspense,
  ssrRenderTeleport,
  ssrRenderVNode
} from "../internal";

extern JsValue Error;
extern JsValue Function;
extern JsValue JSON;
extern JsValue Object;

JsValue compileCache = JS.invoke(Object, "create", null);

export JsValue ssrCompile(string template, JsValue instance) {
  if (!vue_read_CJS().truthy()) {
    throw JS.construct(
      Error,
      "On-the-fly template compilation is not supported in the ESM build of " +
      "@vue/server-renderer. All templates must be pre-compiled into " +
      "render functions."
    );
  }
  JsValue component = instance["type"];
  JsValue config = instance["appContext"]["config"];
  JsValue finalCompilerOptions = JS.call(
    compileExtend,
    JS.undefined(),
    JS.call(
      compileExtend,
      JS.undefined(),
      JS.object(
        "isCustomElement", config["isCustomElement"],
        "delimiters", component["delimiters"]
      ),
      config["compilerOptions"]
    ),
    component["compilerOptions"]
  );
  if (!finalCompilerOptions["isCustomElement"].truthy()) {
    finalCompilerOptions["isCustomElement"] = compileNO;
  }
  if (!finalCompilerOptions["isNativeTag"].truthy()) {
    finalCompilerOptions["isNativeTag"] = compileNO;
  }
  JsValue cacheDescriptor = JS.object(
    "template", template,
    "compilerOptions", finalCompilerOptions
  );
  JsValue replacer = JS.method2((JsValue _self, JsValue _key, JsValue value) => {
    if (compileIsFunction(value)) return JS.invoke(value, "toString");
    return value;
  });
  string cacheKey = JS.string(
    JS.invoke(JSON, "stringify", cacheDescriptor, replacer)
  );
  JsValue cached = compileCache[cacheKey];
  if (cached.truthy()) return cached;
  finalCompilerOptions["onError"] = JS.method1((JsValue _self, JsValue error) => {
    if (vue_read_DEV().truthy()) {
      string message = "[@vue/server-renderer] Template compilation error: " +
        JS.string(error["message"]);
      string codeFrame = "";
      if (error["loc"].truthy()) {
        codeFrame = JS.string(compileGenerateCodeFrame(
          template,
          JS.number(error["loc"]["start"]["offset"]).toInt(),
          JS.number(error["loc"]["end"]["offset"]).toInt()
        ));
      }
      if (codeFrame != "") compileWarn(message + "\n" + codeFrame);
      else compileWarn(message);
    } else {
      throw error;
    }
    return JS.undefined();
  });
  JsValue compiled = JS.call(
    compileSsrTemplate,
    JS.undefined(),
    template,
    finalCompilerOptions
  );
  JsValue vue = JS.object(
    "BaseTransition", compileVueBaseTransition,
    "Fragment", compileVueFragment,
    "KeepAlive", compileVueKeepAlive,
    "Suspense", compileVueSuspense,
    "Teleport", compileVueTeleport,
    "Transition", compileVueTransition,
    "TransitionGroup", compileVueTransitionGroup,
    "camelize", compileVueCamelize,
    "capitalize", compileVueCapitalize,
    "createBlock", compileVueCreateBlock,
    "createCommentVNode", compileVueCreateCommentVNode,
    "createElementBlock", compileVueCreateElementBlock,
    "createElementVNode", compileVueCreateElementVNode,
    "createSlots", compileVueCreateSlots,
    "createStaticVNode", compileVueCreateStaticVNode,
    "createTextVNode", compileVueCreateTextVNode,
    "createVNode", compileVueCreateVNode,
    "guardReactiveProps", compileVueGuardReactiveProps,
    "isMemoSame", compileVueIsMemoSame,
    "isRef", compileVueIsRef,
    "mergeProps", compileVueMergeProps,
    "normalizeClass", compileVueNormalizeClass,
    "normalizeProps", compileVueNormalizeProps,
    "normalizeStyle", compileVueNormalizeStyle,
    "openBlock", compileVueOpenBlock,
    "popScopeId", compileVuePopScopeId,
    "pushScopeId", compileVuePushScopeId,
    "renderList", compileVueRenderList,
    "renderSlot", compileVueRenderSlot,
    "resolveComponent", compileVueResolveComponent,
    "resolveDirective", compileVueResolveDirective,
    "resolveDynamicComponent", compileVueResolveDynamicComponent,
    "resolveFilter", compileVueResolveFilter,
    "setBlockTracking", compileVueSetBlockTracking,
    "toDisplayString", compileVueToDisplayString,
    "toHandlerKey", compileVueToHandlerKey,
    "toHandlers", compileVueToHandlers,
    "unref", compileVueUnref,
    "vModelCheckbox", compileVueVModelCheckbox,
    "vModelDynamic", compileVueVModelDynamic,
    "vModelRadio", compileVueVModelRadio,
    "vModelSelect", compileVueVModelSelect,
    "vModelText", compileVueVModelText,
    "vShow", compileVueVShow,
    "withCtx", compileVueWithCtx,
    "withDirectives", compileVueWithDirectives,
    "withKeys", compileVueWithKeys,
    "withModifiers", compileVueWithModifiers,
    "withMemo", compileVueWithMemo
  );
  JsValue helpers = JS.object(
    "ssrGetDirectiveProps", ssrGetDirectiveProps,
    "ssrGetDynamicModelProps", ssrGetDynamicModelProps,
    "ssrIncludeBooleanAttr", ssrIncludeBooleanAttr,
    "ssrInterpolate", ssrInterpolate,
    "ssrLooseContain", ssrLooseContain,
    "ssrLooseEqual", ssrLooseEqual,
    "ssrRenderAttr", ssrRenderAttr,
    "ssrRenderAttrs", ssrRenderAttrs,
    "ssrRenderClass", ssrRenderClass,
    "ssrRenderComponent", ssrRenderComponent,
    "ssrRenderDynamicAttr", ssrRenderDynamicAttr,
    "ssrRenderDynamicModel", ssrRenderDynamicModel,
    "ssrRenderList", ssrRenderList,
    "ssrRenderSlot", ssrRenderSlot,
    "ssrRenderSlotInner", ssrRenderSlotInner,
    "ssrRenderStyle", ssrRenderStyle,
    "ssrRenderSuspense", ssrRenderSuspense,
    "ssrRenderTeleport", ssrRenderTeleport,
    "ssrRenderVNode", ssrRenderVNode
  );
  JsValue requireMap = JS.object(
    "vue", vue,
    "vue/server-renderer", helpers
  );
  JsValue fakeRequire = JS.method1((JsValue _self, JsValue id) => {
    return requireMap[id];
  });
  JsValue factory = JS.call(
    Function,
    JS.undefined(),
    "require",
    compiled["code"]
  );
  JsValue render = JS.call(factory, JS.undefined(), fakeRequire);
  compileCache[cacheKey] = render;
  return render;
}
