import { createVNode as componentCreateVNode } from "../../package/runtime-dom.lil";
import { renderComponentVNode } from "../render";

export JsValue ssrRenderComponent(
  JsValue component,
  JsValue props = JS.undefined(),
  JsValue children = JS.undefined(),
  JsValue parentComponent = JS.undefined(),
  JsValue slotScopeId = JS.undefined()
) {
  if (JS.isUndefined(props)) props = null;
  if (JS.isUndefined(children)) children = null;
  if (JS.isUndefined(parentComponent)) parentComponent = null;
  return renderComponentVNode(
    JS.call(componentCreateVNode, JS.undefined(), component, props, children),
    parentComponent,
    slotScopeId
  );
}
