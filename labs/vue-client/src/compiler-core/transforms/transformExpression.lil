import {
  createCompoundExpression,
  createSimpleExpression
} from "../ast";
import {
  isReferencedIdentifier,
  isStaticProperty,
  isStaticPropertyKey,
  walkIdentifiers
} from "../babelUtils";
import { createCompilerError } from "../errors";
import { IS_REF, Object, UNREF } from "../runtimeHelpers";
import {
  advancePositionWithClone,
  findDir,
  isSimpleIdentifier
} from "../utils";
import {
  COMPILER_BROWSER,
  COMPILER_DEV,
  validateBrowserExpression
} from "../validateExpression";

extern JsValue hostParseExpression(string source, JsValue plugins, int mode);

JsValue expressionUndefined() {
  return JS.undefined();
}

int expressionLength(JsValue value) {
  return JS.number(value["length"]).toInt();
}

void expressionPush(JsValue values, JsValue value) {
  values[expressionLength(values)] = value;
}

bool expressionSame(JsValue left, JsValue right) {
  return JS.strictEqual(left, right);
}

bool globallyAllowed(string name) {
  string values = ",Infinity,undefined,NaN,isFinite,isNaN,parseFloat,parseInt,decodeURI," +
    "decodeURIComponent,encodeURI,encodeURIComponent,Math,Number,Date,Array," +
    "Object,Boolean,String,RegExp,Map,Set,JSON,Intl,BigInt,console,Error,Symbol,";
  return values.includes("," + name + ",");
}

bool literalAllowed(string name) {
  return name == "true" || name == "false" || name == "null" || name == "this";
}

bool bindingIsConst(JsValue type) {
  return expressionSame(type, "setup-const") || expressionSame(type, "literal-const");
}

string rewriteIdentifierBasic(string raw, JsValue context) {
  JsValue bindings = context["bindingMetadata"];
  JsValue binding = bindings[raw];
  if (context["inline"].truthy()) {
    if (bindingIsConst(binding) || expressionSame(binding, "setup-reactive-const") || context["identifiers"][raw].truthy()) return raw;
    if (expressionSame(binding, "setup-ref")) return raw + ".value";
    if (expressionSame(binding, "setup-maybe-ref") || expressionSame(binding, "setup-let")) {
      return JS.string(JS.call(context["helperString"], expressionUndefined(), UNREF)) + "(" + raw + ")";
    }
    if (expressionSame(binding, "props")) return "__props." + raw;
    if (expressionSame(binding, "props-aliased")) return "__props." + JS.string(bindings["__propsAliases"][raw]);
  } else {
    if (!JS.isUndefined(binding) && (JS.string(binding).startsWith("setup") || expressionSame(binding, "literal-const"))) {
      return "$setup." + raw;
    }
    if (expressionSame(binding, "props-aliased")) return "$props['" + JS.string(bindings["__propsAliases"][raw]) + "']";
    if (!JS.isUndefined(binding)) return "$" + JS.string(binding) + "." + raw;
  }
  return "_ctx." + raw;
}

export string stringifyExpression(JsValue expression) {
  if (JS.typeOf(expression) == "string") return JS.string(expression);
  if (JS.number(expression["type"]).toInt() == 4) return JS.string(expression["content"]);
  string result = "";
  JsValue children = expression["children"];
  for (int index = 0; index < expressionLength(children); index++) {
    result += stringifyExpression(children[index]);
  }
  return result;
}

export JsValue processExpression(
  JsValue node,
  JsValue context,
  bool asParams = false,
  bool asRawStatements = false,
  JsValue localVars = JS.undefined()
) {
  if (COMPILER_BROWSER) {
    if (COMPILER_DEV) validateBrowserExpression(node, context, asParams, asRawStatements);
    return node;
  }
  string raw = JS.string(node["content"]);
  if (!context["prefixIdentifiers"].truthy() || raw.trim() == "") return node;
  JsValue known = localVars;
  if (JS.isUndefined(known)) known = JS.invoke(Object, "create", context["identifiers"]);
  JsValue ast = node["ast"];
  if (expressionSame(ast, false)) return node;
  if (JS.isNullish(ast) && isSimpleIdentifier(raw)) {
    bool scope = context["identifiers"][raw].truthy();
    JsValue binding = context["bindingMetadata"][raw];
    if (!asParams && !scope && !literalAllowed(raw) && (!globallyAllowed(raw) || !JS.isUndefined(binding))) {
      if (bindingIsConst(binding)) node["constType"] = 1;
      node["content"] = rewriteIdentifierBasic(raw, context);
    } else if (!scope) {
      if (literalAllowed(raw)) node["constType"] = 3;
      else node["constType"] = 2;
    }
    return node;
  }
  if (JS.isNullish(ast)) {
    int mode = 0;
    if (asRawStatements) mode = 1;
    else if (asParams) mode = 2;
    try {
      ast = hostParseExpression(raw, context["expressionPlugins"], mode);
    } catch (JsValue error) {
      JS.call(
        context["onError"],
        expressionUndefined(),
        createCompilerError(46, node["loc"], expressionUndefined(), JS.string(error["message"]))
      );
      return node;
    }
  }
  JsValue identifiers = JS.array();
  JsValue parentStack = JS.array();
  JsValue visitor = JS.method3((
    JsValue _self,
    JsValue identifier,
    JsValue parent,
    JsValue stack
  ) => {
    if (isStaticPropertyKey(identifier, parent)) return expressionUndefined();
    string name = JS.string(identifier["name"]);
    if (name.startsWith("_filter_")) return expressionUndefined();
    bool referenced = isReferencedIdentifier(identifier, parent, stack);
    bool local = known[name].truthy();
    bool prefix = referenced && !globallyAllowed(name) && name != "require";
    if (prefix && !local) {
      if (isStaticProperty(parent) && parent["shorthand"].truthy()) {
        identifier["prefix"] = name + ": ";
      }
      JsValue binding = context["bindingMetadata"][name];
      if (context["inline"].truthy() && expressionSame(binding, "setup-let") &&
        !JS.isNullish(parent) && JS.string(parent["type"]) == "AssignmentExpression" &&
        expressionSame(parent["left"], identifier)) {
        JsValue right = parent["right"];
        int rightStart = JS.number(right["start"]).toInt() - 1;
        int rightEnd = JS.number(right["end"]).toInt() - 1;
        string rightExpression = raw.slice(rightStart, rightEnd);
        identifier["name"] = JS.string(JS.call(context["helperString"], expressionUndefined(), IS_REF)) +
          "(" + name + ") ? " + name + ".value " + JS.string(parent["operator"]) +
          " " + rightExpression + " : " + name;
      } else {
        identifier["name"] = rewriteIdentifierBasic(name, context);
      }
    } else if (!(prefix && local)) {
      if (JS.isNullish(parent)) identifier["isConstant"] = true;
      else {
        string parentType = JS.string(parent["type"]);
        if (parentType != "CallExpression" && parentType != "NewExpression" && parentType != "MemberExpression") {
          identifier["isConstant"] = true;
        }
      }
    }
    expressionPush(identifiers, identifier);
    return expressionUndefined();
  });
  walkIdentifiers(ast, visitor, true, parentStack, known);
  JS.invoke(identifiers, "sort", JS.method2((
    JsValue _self,
    JsValue left,
    JsValue right
  ) => {
    return JS.number(left["start"]) - JS.number(right["start"]);
  }));
  JsValue children = JS.array();
  int previousEnd = 0;
  for (int index = 0; index < expressionLength(identifiers); index++) {
    JsValue identifier = identifiers[index];
    int start = JS.number(identifier["start"]).toInt() - 1;
    int end = JS.number(identifier["end"]).toInt() - 1;
    string leading = raw.slice(previousEnd, start);
    if (!JS.isUndefined(identifier["prefix"])) leading += JS.string(identifier["prefix"]);
    if (leading.length > 0) expressionPush(children, leading);
    string source = raw.slice(start, end);
    JsValue startPosition = advancePositionWithClone(node["loc"]["start"], source, start);
    JsValue endPosition = advancePositionWithClone(node["loc"]["start"], source, end);
    int constantType = 0;
    if (identifier["isConstant"].truthy()) constantType = 3;
    expressionPush(children, createSimpleExpression(
      JS.string(identifier["name"]),
      false,
      JS.object("start", startPosition, "end", endPosition, "source", source),
      constantType
    ));
    previousEnd = end;
    if (index == expressionLength(identifiers) - 1 && end < raw.length) {
      expressionPush(children, raw.slice(end));
    }
  }
  JsValue result = node;
  if (expressionLength(children) > 0) {
    result = createCompoundExpression(children, node["loc"]);
    result["ast"] = ast;
  } else {
    result["constType"] = 3;
  }
  result["identifiers"] = JS.invoke(Object, "keys", known);
  return result;
}

export JsValue transformExpression(JsValue node, JsValue context) {
  int type = JS.number(node["type"]).toInt();
  if (type == 5) {
    node["content"] = processExpression(node["content"], context);
  } else if (type == 1) {
    JsValue memo = findDir(node, "memo");
    JsValue props = node["props"];
    for (int index = 0; index < expressionLength(props); index++) {
      JsValue directive = props[index];
      if (JS.number(directive["type"]).toInt() == 7 && JS.string(directive["name"]) != "for") {
        JsValue expression = directive["exp"];
        JsValue argument = directive["arg"];
        bool skipEvent = JS.string(directive["name"]) == "on" && argument.truthy();
        bool skipMemoKey = memo.truthy() &&
          JS.invoke(context["vForMemoKeyedNodes"], "has", node).truthy() &&
          argument.truthy() && JS.number(argument["type"]).toInt() == 4 &&
          JS.string(argument["content"]) == "key";
        if (expression.truthy() && JS.number(expression["type"]).toInt() == 4 &&
          !skipEvent && !skipMemoKey) {
          directive["exp"] = processExpression(
            expression,
            context,
            JS.string(directive["name"]) == "slot"
          );
        }
        if (argument.truthy() && JS.number(argument["type"]).toInt() == 4 &&
          !argument["isStatic"].truthy()) {
          directive["arg"] = processExpression(argument, context);
        }
      }
    }
  }
  return expressionUndefined();
}
