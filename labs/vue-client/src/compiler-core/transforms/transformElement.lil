    JsValue children = node["children"];
    if (elementLength(children) > 0) {
      if (elementSame(vnodeTag, KEEP_ALIVE)) {
        block = true;
        patchFlag = patchFlag | 1024;
        vnodeChildren = children;
      } else if (component && !elementSame(vnodeTag, TELEPORT)) {
        JsValue slotsResult = buildSlots(node, context);
        vnodeChildren = slotsResult["slots"];
