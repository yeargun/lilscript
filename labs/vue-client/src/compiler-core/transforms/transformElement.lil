  else existing["value"] = createArrayExpression(JS.array(value, incoming["value"]), existing["loc"]);
}

JsValue dedupeProperties(JsValue properties) {
  JsValue known = JS.construct(Map);
  JsValue deduped = JS.array();
  for (int index = 0; index < elementLength(properties); index++) {
    JsValue property = properties[index];
    JsValue key = property["key"];
    if (JS.number(key["type"]).toInt() == 8 || !key["isStatic"].truthy()) {
      elementPush(deduped, property);
    } else {
      string name = JS.string(key["content"]);
      JsValue existing = JS.invoke(known, "get", name);
      if (existing.truthy()) {
        if (name == "style" || name == "class" || eventName(name)) mergePropertyAsArray(existing, property);
      } else {
        JS.invoke(known, "set", name, property);
        elementPush(deduped, property);
      }
    }
  }
  return deduped;
}

string stringifyDynamicProps(JsValue names) {
  string result = "[";
  for (int index = 0; index < elementLength(names); index++) {
    result += JS.string(JS.invoke(JSON, "stringify", names[index]));
    if (index + 1 < elementLength(names)) result += ", ";
  }
  return result + "]";
}

export JsValue buildDirectiveArgs(JsValue directive, JsValue context) {
  JsValue args = JS.array();
  JsValue runtime = JS.invoke(directiveImportMap, "get", directive);
  if (runtime.truthy()) {
