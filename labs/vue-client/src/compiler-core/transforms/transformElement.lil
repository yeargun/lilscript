    } else {
      JS.call(context["helper"], elementUndefined(), RESOLVE_DIRECTIVE);
      JS.invoke(context["directives"], "add", directive["name"]);
      elementPush(args, toValidAssetId(JS.string(directive["name"]), "directive"));
    }
  }
  if (directive["exp"].truthy()) elementPush(args, directive["exp"]);
  if (directive["arg"].truthy()) {
    if (!directive["exp"].truthy()) elementPush(args, "void 0");
    elementPush(args, directive["arg"]);
  }
  JsValue modifiers = directive["modifiers"];
  if (elementLength(modifiers) > 0) {
    if (!directive["arg"].truthy()) {
      if (!directive["exp"].truthy()) elementPush(args, "void 0");
      elementPush(args, "void 0");
    }
    JsValue properties = JS.array();
    JsValue trueExpression = createSimpleExpression("true", false, directive["loc"]);
    for (int index = 0; index < elementLength(modifiers); index++) {
      elementPush(properties, createObjectProperty(modifiers[index], trueExpression));
    }
    elementPush(args, createObjectExpression(properties, directive["loc"]));
  }
  return createArrayExpression(args, directive["loc"]);
}

bool componentTag(string tag) {
  return tag == "component" || tag == "Component";
}

string setupReference(string name, JsValue context) {
  JsValue bindings = context["bindingMetadata"];
  if (JS.isNullish(bindings) || elementSame(bindings["__isScriptSetup"], false)) return "";
  string camel = camelizeText(name);
  string pascal = capitalizeText(camel);
  string[] names = [name, camel, pascal];
  for (int pass = 0; pass < 2; pass++) {
    for (int index = 0; index < names.length; index++) {
      string candidate = names[index];
      string kind = "";
      if (!JS.isUndefined(bindings[candidate])) kind = JS.string(bindings[candidate]);
      bool matches = kind == "setup-let" || kind == "setup-ref" || kind == "setup-maybe-ref";
      if (pass == 0) matches = kind == "setup-const" || kind == "setup-reactive-const" || kind == "literal-const";
      if (matches) {
        if (context["inline"].truthy()) {
          if (pass == 0) return candidate;
          return JS.string(JS.call(context["helperString"], elementUndefined(), UNREF)) + "(" + candidate + ")";
        }
        return "$setup[" + JS.string(JS.invoke(JSON, "stringify", candidate)) + "]";
      }
    }
  }
  for (int index = 0; index < names.length; index++) {
    string candidate = names[index];
    if (elementSame(bindings[candidate], "props")) {
      string target = "$props";
      if (context["inline"].truthy()) target = "__props";
      return JS.string(JS.call(context["helperString"], elementUndefined(), UNREF)) + "(" + target + "[" +
        JS.string(JS.invoke(JSON, "stringify", candidate)) + "])";
    }
  }
  return "";
}

export JsValue resolveComponentType(JsValue node, JsValue context, bool ssr = false) {
  string tag = JS.string(node["tag"]);
  JsValue isProp = findProp(node, "is", false, true);
  if (isProp.truthy()) {
    if (componentTag(tag)) {
      JsValue expression = elementUndefined();
      if (JS.number(isProp["type"]).toInt() == 6 && isProp["value"].truthy()) {
        expression = createSimpleExpression(JS.string(isProp["value"]["content"]), true);
      } else {
        expression = isProp["exp"];
        if (!expression.truthy() && isProp["arg"].truthy()) {
          expression = createSimpleExpression("is", false, isProp["arg"]["loc"]);
          expression = processExpression(expression, context);
          isProp["exp"] = expression;
        }
      }
      if (expression.truthy()) return createCallExpression(
        JS.call(context["helper"], elementUndefined(), RESOLVE_DYNAMIC_COMPONENT),
        JS.array(expression)
      );
    } else if (JS.number(isProp["type"]).toInt() == 6 && isProp["value"].truthy() &&
      JS.string(isProp["value"]["content"]).startsWith("vue:")) {
      tag = JS.string(isProp["value"]["content"]).slice(4);
    }
  }
  JsValue builtIn = isCoreComponent(tag);
  if (JS.isUndefined(builtIn)) builtIn = JS.call(context["isBuiltInComponent"], elementUndefined(), tag);
  if (builtIn.truthy()) {
    if (!ssr) JS.call(context["helper"], elementUndefined(), builtIn);
    return builtIn;
  }
  string setup = setupReference(tag, context);
  if (setup != "") return setup;
  int dot = JS.number(JS.invoke(tag, "indexOf", ".")).toInt();
  if (dot > 0) {
    setup = setupReference(tag.slice(0, dot), context);
    if (setup != "") return setup + tag.slice(dot);
  }
  if (context["selfName"].truthy() && capitalizeText(camelizeText(tag)) == JS.string(context["selfName"])) {
    JS.call(context["helper"], elementUndefined(), RESOLVE_COMPONENT);
    JS.invoke(context["components"], "add", tag + "__self");
    return toValidAssetId(tag, "component");
  }
  JS.call(context["helper"], elementUndefined(), RESOLVE_COMPONENT);
  JS.invoke(context["components"], "add", tag);
  return toValidAssetId(tag, "component");
}

