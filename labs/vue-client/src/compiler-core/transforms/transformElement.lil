}

bool elementSame(JsValue left, JsValue right) {
  return JS.strictEqual(left, right);
}

string camelizeText(string value) {
  string result = "";
  bool upper = false;
  for (int index = 0; index < value.length; index++) {
    string character = value.charAt(index);
    if (character == "-") {
      upper = true;
    } else if (upper) {
      result += character.toUpperCase();
      upper = false;
    } else {
      result += character;
    }
  }
  return result;
}

string capitalizeText(string value) {
  if (value.length == 0) return value;
  return value.charAt(0).toUpperCase() + value.slice(1);
}

bool hasModifier(JsValue directive, string name) {
  JsValue modifiers = directive["modifiers"];
  for (int index = 0; index < elementLength(modifiers); index++) {
    if (JS.string(modifiers[index]["content"]) == name) return true;
  }
  return false;
}

JsValue directiveImportMap = JS.construct(WeakMap);

bool builtInDirective(string name) {
  string names = ",bind,cloak,else-if,else,for,html,if,model,on,once,pre,show,slot,text,memo,";
  return names.includes("," + name + ",");
}

bool eventName(string name) {
  if (name.length < 3 || name.charAt(0) != "o" || name.charAt(1) != "n") return false;
  int third = name.charCodeAt(2);
  return third < 97 || third > 122;
}

bool reservedPropName(string name) {
  string names = ",key,ref,ref_for,ref_key,onVnodeBeforeMount,onVnodeMounted,onVnodeBeforeUpdate,onVnodeUpdated,onVnodeBeforeUnmount,onVnodeUnmounted,";
  return names.includes("," + name + ",");
}

void mergePropertyAsArray(JsValue existing, JsValue incoming) {
