      JsValue built = buildProps(node, context, elementUndefined(), component, dynamicComponent, false);
      vnodeProps = built["props"];
      patchFlag = JS.number(built["patchFlag"]).toInt();
      needsPatch = built["needsPatch"].truthy();
      blockRequired = built["isBlockRequired"].truthy();
      if (built["shouldUseBlock"].truthy()) block = true;
      JsValue names = built["dynamicPropNames"];
      if (elementLength(names) > 0) dynamicProps = stringifyDynamicProps(names);
      JsValue directives = built["directives"];
