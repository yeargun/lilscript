// LilScript has no structural optional-property interfaces or string-valued
// enums, so compiler option contracts cross the existing JsValue boundary.
export JsValue BindingTypes = JS.object(
  "DATA", "data",
  "PROPS", "props",
  "PROPS_ALIASED", "props-aliased",
  "SETUP_LET", "setup-let",
  "SETUP_CONST", "setup-const",
  "SETUP_REACTIVE_CONST", "setup-reactive-const",
  "SETUP_MAYBE_REF", "setup-maybe-ref",
  "SETUP_REF", "setup-ref",
  "OPTIONS", "options",
  "LITERAL_CONST", "literal-const"
);
