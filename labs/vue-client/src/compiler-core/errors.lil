export JsValue createCompilerError(
  int code,
  JsValue loc = JS.undefined(),
  JsValue messages = JS.undefined(),
  string additionalMessage = ""
) {
  JsValue table = messages;
  if (JS.isNullish(table)) table = errorMessages;
  string message = errorString(table[errorString(code)]) + additionalMessage;
  JsValue error = JS.construct(SyntaxError, message);
  error["code"] = code;
  error["loc"] = loc;
  return error;
}

export void defaultOnError(JsValue error) {
  throw error;
}

export void defaultOnWarn(JsValue warning) {
  JS.invoke(console, "warn", "[Vue warn] " + errorString(warning["message"]));
}
