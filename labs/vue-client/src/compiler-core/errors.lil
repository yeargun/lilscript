export extern JsValue String;
export extern JsValue SyntaxError;
export extern JsValue console;

JsValue errorsUndefined() {
  return JS.undefined();
}

int errorsLength(JsValue value) {
  return JS.number(value["length"]).toInt();
}

string errorString(JsValue value) {
  return JS.string(JS.call(String, errorsUndefined(), value));
}

JsValue errorNumericEnum(JsValue names) {
  JsValue result = JS.object();
  for (int index = 0; index < errorsLength(names); index++) {
    string name = JS.string(names[index]);
    result[name] = index;
    result[errorString(index)] = name;
  }
  return result;
}

