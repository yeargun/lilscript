import {
  NodeOpTypes,
  TestNodeTypes,
  dumpOps,
  logNodeOp,
  nodeOps,
  resetOps
} from "./nodeOps";
import { patchProp } from "./patchProp";
import { serialize, serializeInner } from "./serialize";
import { triggerEvent } from "./triggerEvent";

JsValue renderer = createRenderer(
  JS.call(extend, JS.undefined(), JS.object("patchProp", patchProp), nodeOps)
);

export JsValue render = renderer["render"];
export JsValue createApp = renderer["createApp"];

export string renderToString(JsValue vnode) {
  JsValue root = JS.call(nodeOps["createElement"], JS.undefined(), "div");
  JS.call(render, JS.undefined(), vnode, root);
  return serializeInner(root);
}

