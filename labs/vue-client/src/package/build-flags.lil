// TOML-owned build flags. The test profile may read injected flags live.
define bool VUE_HOST_FLAGS = false;
extern JsValue globalThis;
define bool VUE_DEV = true;
export JsValue read_DEV(){
  if(VUE_HOST_FLAGS && !JS.isUndefined(globalThis["__DEV__"])) return globalThis["__DEV__"];
  return VUE_DEV;
}
define bool VUE_GLOBAL = false;
export JsValue read_GLOBAL(){
  if(VUE_HOST_FLAGS && !JS.isUndefined(globalThis["__GLOBAL__"])) return globalThis["__GLOBAL__"];
  return VUE_GLOBAL;
}
define bool VUE_ESM_BUNDLER = true;
export JsValue read_ESM_BUNDLER(){
  if(VUE_HOST_FLAGS && !JS.isUndefined(globalThis["__ESM_BUNDLER__"])) return globalThis["__ESM_BUNDLER__"];
  return VUE_ESM_BUNDLER;
}
