  float timeout = 0.0;
  int propCount = 0;
  if (JS.strictEqual(expectedType, transitionType)) {
    if (transitionTimeout > 0.0) {
      type = transitionType;
      timeout = transitionTimeout;
      propCount = valueLength(transitionDurations);
    }
  } else if (JS.strictEqual(expectedType, animationType)) {
    if (animationTimeout > 0.0) {
      type = animationType;
      timeout = animationTimeout;
      propCount = valueLength(animationDurations);
    }
  } else {
    timeout = hostMathMax(transitionTimeout, animationTimeout);
    if (timeout > 0.0) {
      if (transitionTimeout > animationTimeout) {
        type = transitionType;
        propCount = valueLength(transitionDurations);
      } else {
