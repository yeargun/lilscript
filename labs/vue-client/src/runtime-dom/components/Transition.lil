  if (transitionIsArray(hook)) {
    int count = valueLength(hook);
    for (int index = 0; index < count; index++) {
      if (JS.number(hostRead(hostRead(hook, index), "length")).toInt() > 1) return true;
    }
    return false;
  }
  return JS.number(hostRead(hook, "length")).toInt() > 1;
}

float numberOf(JsValue value) {
  JsValue result = transitionToNumber(value);
  if (TRANSITION_DEV) {
    JS.call(dependencyAssertNumber, JS.undefined(), result, "<transition> explicit duration");
