  if (JS.isNullish(transitionClasses) || !transitionClasses.truthy()) {
    transitionClasses = hostCreateSet(JS.undefined());
    hostWrite(element, vtcKey, transitionClasses);
  }
  hostSetAdd(transitionClasses, classes);
}

