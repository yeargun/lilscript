  if (transitionIsObject(duration)) {
    return JS.array(numberOf(hostRead(duration, "enter")), numberOf(hostRead(duration, "leave")));
  }
  float value = numberOf(duration);
  return JS.array(value, value);
}

void nextFrame(JsValue callback) {
