void updateCustomElement(JsValue self) {
  JsValue vnode = createCustomElementVNode(self);
  JsValue app = hostRead(self, "_app");
  if (!JS.isNullish(app) && app.truthy()) hostWrite(vnode, "appContext", hostRead(app, "_context"));
