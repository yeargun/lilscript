  JsValue props = hostRead(definition, "props");
  JsValue declaredPropKeys = JS.undefined();
  if (customElementIsArray(props)) declaredPropKeys = props;
  else {
    if (JS.isNullish(props)) props = JS.object();
    declaredPropKeys = hostObjectKeys(props);
