  JsValue ownKeys = hostObjectKeys(self);
  int ownCount = valueLength(ownKeys);
  for (int index = 0; index < ownCount; index++) {
    string key = hostString(hostRead(ownKeys, index));
    if (!key.startsWith("_") && JS.invoke(declaredPropKeys, "includes", key).truthy()) {
      JS.call(hostRead(self, "_setProp"), self, key, hostRead(self, key));
    }
  }
  int count = valueLength(declaredPropKeys);
  for (int index = 0; index < count; index++) {
    string key = customElementCamelizeString(hostString(hostRead(declaredPropKeys, index)));
    if (CUSTOM_ELEMENT_DEV && hostHasProperty(hostGetPrototypeOf(self), key)) {
      customWarn(
        "Custom element prop \"" + key + "\" conflicts with an existing property " +
          "on the element and will overwrite it."
