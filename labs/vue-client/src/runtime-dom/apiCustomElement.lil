    hostDefineAccessor(
      self,
      propKey,
      JS.method0((JsValue element) => JS.call(hostRead(element, "_getProp"), element, propKey)),
      JS.method1((JsValue element, JsValue value) => {
        JS.call(hostRead(element, "_setProp"), element, propKey, value, true, !hostRead(element, "_patching").truthy());
        return JS.undefined();
