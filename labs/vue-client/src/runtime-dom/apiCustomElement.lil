  }
  JsValue slots = hostCreateSet(JS.undefined());
  int rootCount = valueLength(roots);
  for (int rootIndex = 0; rootIndex < rootCount; rootIndex++) {
    JsValue found = JS.invoke(hostRead(roots, rootIndex), "querySelectorAll", "slot");
    int foundCount = valueLength(found);
    for (int index = 0; index < foundCount; index++) JS.invoke(slots, "add", hostRead(found, index));
  }
  return hostArrayFrom(slots);
}

void renderSlots(JsValue self) {
  JsValue outlets = getSlots(self);
  JsValue scopeId = hostRead(hostRead(hostRead(self, "_instance"), "type"), "__scopeId");
  int count = valueLength(outlets);
  for (int index = 0; index < count; index++) {
    JsValue outlet = hostRead(outlets, index);
    string slotName = "default";
    JsValue name = JS.invoke(outlet, "getAttribute", "name");
    if (!JS.isNullish(name) && name.truthy()) slotName = hostString(name);
    JsValue content = hostRead(hostRead(self, "_slots"), slotName);
    JsValue parent = hostRead(outlet, "parentNode");
    if (!JS.isNullish(content) && content.truthy()) {
      int nodeCount = valueLength(content);
      for (int nodeIndex = 0; nodeIndex < nodeCount; nodeIndex++) {
        JsValue node = hostRead(content, nodeIndex);
        if (!JS.isNullish(scopeId) && scopeId.truthy() && JS.number(hostRead(node, "nodeType")).toInt() == 1) {
          string id = hostString(scopeId) + "-s";
