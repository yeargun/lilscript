void parseSlots(JsValue self) {
  JsValue slots = hostCreateObject();
  hostWrite(self, "_slots", slots);
  while (!JS.isNullish(hostRead(self, "firstChild")) && hostRead(self, "firstChild").truthy()) {
    JsValue node = hostRead(self, "firstChild");
    string slotName = "default";
    if (JS.number(hostRead(node, "nodeType")).toInt() == 1) {
      JsValue attribute = JS.invoke(node, "getAttribute", "slot");
      if (!JS.isNullish(attribute) && attribute.truthy()) slotName = hostString(attribute);
    }
    JsValue slot = hostRead(slots, slotName);
    if (JS.isNullish(slot)) {
      slot = JS.array();
      hostWrite(slots, slotName, slot);
    }
