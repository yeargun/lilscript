  while (!JS.isNullish(parent) && parent.truthy()) {
    JsValue next = hostRead(parent, "assignedSlot");
    if (JS.isNullish(next) || !next.truthy()) next = hostRead(parent, "parentNode");
    if (JS.isNullish(next) || !next.truthy()) next = hostRead(parent, "host");
    parent = next;
    if (JS.isNullish(parent) || !parent.truthy()) break;
    if (hostInstanceOf(parent, VueElement)) {
      hostWrite(self, "_parent", parent);
