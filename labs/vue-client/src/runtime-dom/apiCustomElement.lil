  if (JS.isUndefined(createAppFunction)) createAppFunction = createApp;
  hostWrite(self, "_def", definition);
  hostWrite(self, "_props", initialProps);
  hostWrite(self, "_createApp", createAppFunction);
  hostWrite(self, "_isVueCE", true);
  hostWrite(self, "_instance", null);
  hostWrite(self, "_app", null);
  hostWrite(self, "_nonce", hostRead(definition, "nonce"));
  hostWrite(self, "_connected", false);
  hostWrite(self, "_resolved", false);
  hostWrite(self, "_patching", false);
  hostWrite(self, "_dirty", false);
  hostWrite(self, "_numberProps", null);
  hostWrite(self, "_styleChildren", hostCreateWeakSet());
  hostWrite(self, "_pendingResolve", JS.undefined());
  hostWrite(self, "_parent", JS.undefined());
  hostWrite(self, "_styleAnchors", hostCreateWeakMap());
  hostWrite(self, "_styles", JS.undefined());
  hostWrite(self, "_childStyles", JS.undefined());
