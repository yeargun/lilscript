JsValue getRootStyleInsertionAnchor(JsValue root) {
  JsValue children = hostRead(root, "childNodes");
  int count = valueLength(children);
  for (int index = 0; index < count; index++) {
    JsValue node = hostRead(children, index);
    if (!hostIsStyleElement(node)) return node;
  }
  return null;
