void mountCustomElement(JsValue self, JsValue definition) {
  if ((CUSTOM_ELEMENT_DEV || CUSTOM_ELEMENT_FEATURE_PROD_DEVTOOLS) &&
      (JS.isNullish(hostRead(definition, "name")) || !hostRead(definition, "name").truthy())) {
    hostWrite(definition, "name", "VueElement");
