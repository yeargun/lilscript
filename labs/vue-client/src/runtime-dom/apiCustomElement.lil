    if (!JS.isNullish(last) && last.truthy()) anchor = last;
    JS.invoke(root, "insertBefore", style, anchor);
    last = style;
    if (index == 0) {
      if (JS.isUndefined(parentComponent) || JS.isNullish(parentComponent) || !parentComponent.truthy()) {
        JS.invoke(hostRead(self, "_styleAnchors"), "set", hostRead(self, "_def"), style);
      }
      if (!JS.isUndefined(owner) && !JS.isNullish(owner) && owner.truthy()) {
        JS.invoke(hostRead(self, "_styleAnchors"), "set", owner, style);
      }
