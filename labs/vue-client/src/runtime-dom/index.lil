  "parentNode", JS.method1((JsValue _self, JsValue node) => hostParentNode(node)),
  "nextSibling", JS.method1((JsValue _self, JsValue node) => hostNextSibling(node)),
  "querySelector", JS.method1((JsValue _self, JsValue selector) => hostQuerySelector(hostString(selector))),
  "setScopeId", JS.method2((JsValue _self, JsValue element, JsValue id) => {
    hostSetAttribute(element, hostString(id), "");
    return JS.undefined();
  }),
  "insertStaticContent", insertStaticContent
);

export void patchClass(JsValue element, JsValue value, bool isSVG) {
  JsValue transitionClasses = hostRead(element, vtcKey);
  if (!JS.isNullish(transitionClasses)) {
    JsValue classes = hostArrayFrom(transitionClasses);
    if (!JS.isNullish(value) && hostString(value) != "") {
      JsValue combined = JS.array(value);
      int classCount = valueLength(classes);
      for (int index = 0; index < classCount; index++) {
        hostWrite(combined, valueLength(combined), hostRead(classes, index));
      }
      value = JS.invoke(combined, "join", " ");
    } else {
      value = JS.invoke(classes, "join", " ");
    }
  }
  if (JS.isNullish(value)) {
    hostRemoveAttribute(element, "class");
  } else if (isSVG) {
    hostSetAttribute(element, "class", value);
  } else {
    hostWrite(element, "className", value);
  }
}

Regex displayPattern = new Regex("(?:^|;)\\s*display\\s*:");
Regex semicolonPattern = new Regex("[^\\\\];\\s*$");
Regex importantPattern = new Regex("\\s*!important$");
string[] stylePrefixes = ["Webkit", "Moz", "ms"];
JsValue stylePrefixCache = JS.object();

string callStringTransform(JsValue transform, string value) {
  return hostString(hostCall1(transform, value));
}

string autoPrefix(JsValue style, string rawName) {
  JsValue cached = hostRead(stylePrefixCache, rawName);
  if (!JS.isNullish(cached) && hostString(cached) != "") return hostString(cached);
  string name = callStringTransform(dependencyCamelize, rawName);
  if (name != "filter" && hostHasProperty(style, name)) {
    hostWrite(stylePrefixCache, rawName, name);
    return name;
  }
  name = callStringTransform(dependencyCapitalize, name);
  for (int index = 0; index < stylePrefixes.length; index++) {
    string prefixed = stylePrefixes[index] + name;
    if (hostHasProperty(style, prefixed)) {
      hostWrite(stylePrefixCache, rawName, prefixed);
      return prefixed;
    }
  }
  return rawName;
}

void setStyle(JsValue style, string name, JsValue value) {
  if (dependencyIsArray(value)) {
    int length = valueLength(value);
    for (int index = 0; index < length; index++) setStyle(style, name, hostRead(value, index));
    return;
  }
  if (JS.isNullish(value)) value = "";
  string text = hostString(value);
  if (semicolonPattern.test(text)) {
    hostWarn("Unexpected semicolon at the end of '" + name + "' style value: '" + text + "'", JS.undefined());
  }
  bool important = importantPattern.test(text);
  if (important) text = hostString(JS.invoke(text, "replace", importantPattern, ""));
  if (name.startsWith("--")) {
    if (important) hostCallMethod3(style, "setProperty", name, text, "important");
    else hostCallMethod2(style, "setProperty", name, text);
  } else {
    string prefixed = autoPrefix(style, name);
    if (important) {
      string hyphenated = callStringTransform(dependencyHyphenate, prefixed);
      hostCallMethod3(style, "setProperty", hyphenated, text, "important");
    } else {
      hostWrite(style, prefixed, value);
    }
  }
}

bool preserveTextareaResize(JsValue element, string key, JsValue previous, JsValue next) {
  string tag = hostString(hostRead(element, "tagName"));
  return tag == "TEXTAREA" && (key == "width" || key == "height") &&
    dependencyIsString(next) && same(previous, next);
}

export void patchStyle(JsValue element, JsValue previous, JsValue next) {
  JsValue style = hostRead(element, "style");
  bool cssString = dependencyIsString(next);
  bool controlledDisplay = false;
  if (!JS.isNullish(next) && next.truthy() && !cssString) {
    if (!JS.isNullish(previous) && previous.truthy()) {
      if (!dependencyIsString(previous)) {
        for (string key in previous) {
          if (JS.isNullish(hostRead(next, key))) setStyle(style, key, "");
        }
      } else {
        string[] oldStyles = hostString(previous).split(";");
        for (int index = 0; index < oldStyles.length; index++) {
          string oldStyle = oldStyles[index];
          int colon = oldStyle.indexOf(":");
          string key = oldStyle.slice(0, colon).trim();
          if (JS.isNullish(hostRead(next, key))) setStyle(style, key, "");
        }
      }
    }
    for (string key in next) {
      if (key == "display") controlledDisplay = true;
      JsValue value = hostRead(next, key);
      if (!JS.isNullish(value)) {
        JsValue oldValue = JS.undefined();
        if (!dependencyIsString(previous) && !JS.isNullish(previous) && previous.truthy()) {
          oldValue = hostRead(previous, key);
        }
        if (!preserveTextareaResize(element, key, oldValue, value)) setStyle(style, key, value);
      } else {
        setStyle(style, key, "");
      }
    }
  } else if (cssString) {
    if (!same(previous, next)) {
      string text = hostString(next);
      JsValue cssVars = hostRead(style, CSS_VAR_TEXT);
      if (!JS.isNullish(cssVars) && cssVars.truthy()) text += ";" + hostString(cssVars);
      hostWrite(style, "cssText", text);
      controlledDisplay = displayPattern.test(text);
    }
  } else if (!JS.isNullish(previous) && previous.truthy()) {
    hostRemoveAttribute(element, "style");
  }
  if (hostHasProperty(element, vShowOriginalDisplay)) {
    JsValue originalDisplay = "";
    if (controlledDisplay) originalDisplay = hostRead(style, "display");
    hostWrite(element, vShowOriginalDisplay, originalDisplay);
    JsValue hidden = hostRead(element, vShowHidden);
    if (!JS.isNullish(hidden) && hidden.truthy()) hostWrite(style, "display", "none");
  }
}

export void patchAttr(
  JsValue element,
  string key,
  JsValue value,
  bool isSVG,
  JsValue instance,
  JsValue booleanValue
) {
  bool isBoolean = booleanValue.truthy();
  if (JS.isUndefined(booleanValue)) {
    isBoolean = hostCall1(dependencyIsSpecialBooleanAttr, key).truthy();
  }
  if (isSVG && key.startsWith("xlink:")) {
    if (JS.isNullish(value)) hostRemoveAttributeNS(element, xlinkNS, key.slice(6));
    else hostSetAttributeNS(element, xlinkNS, key, value);
    return;
  }
  if (JS.isNullish(value) || (isBoolean && !dependencyIncludeBooleanAttr(value))) {
    hostRemoveAttribute(element, key);
  } else {
    JsValue attributeValue = value;
    if (isBoolean) attributeValue = "";
    else if (dependencyIsSymbol(value)) attributeValue = hostString(value);
    hostSetAttribute(element, key, attributeValue);
  }
}

export void patchDOMProp(
  JsValue element,
  string key,
  JsValue value,
  JsValue parentComponent,
  JsValue attrName
) {
  if (key == "innerHTML" || key == "textContent") {
    if (!JS.isNullish(value)) {
      JsValue content = value;
      if (key == "innerHTML") content = hostUnsafeToTrustedHTML(value);
      hostWrite(element, key, content);
    }
    return;
  }
  string tag = hostString(hostRead(element, "tagName"));
  if (key == "value" && tag != "PROGRESS" && !tag.includes("-")) {
    JsValue oldValue = hostRead(element, "value");
    if (tag == "OPTION") oldValue = hostGetAttribute(element, "value");
    if (tag == "OPTION" && (JS.isNullish(oldValue) || !oldValue.truthy())) oldValue = "";
    JsValue newValue = value;
    if (JS.isNullish(value)) {
      newValue = "";
      if (same(hostRead(element, "type"), "checkbox")) newValue = "on";
    } else {
      newValue = hostString(value);
    }
    if (!same(oldValue, newValue) || !hostHasProperty(element, "_value")) hostWrite(element, "value", newValue);
    if (JS.isNullish(value)) hostRemoveAttribute(element, key);
    hostWrite(element, "_value", value);
    return;
  }
  bool needRemove = false;
  if (same(value, "") || JS.isNullish(value)) {
    string kind = JS.typeOf(hostRead(element, key));
    if (kind == "boolean") {
      value = dependencyIncludeBooleanAttr(value);
    } else if (JS.isNullish(value) && kind == "string") {
      value = "";
      needRemove = true;
    } else if (kind == "number") {
      value = 0;
      needRemove = true;
    }
  }
  try {
    hostWrite(element, key, value);
  } catch (JsValue error) {
    if (!needRemove) {
      hostWarn(
        "Failed setting prop \"" + key + "\" on <" + tag.toLowerCase() + ">: value " +
          hostString(value) + " is invalid.",
        error
      );
    }
  }
  if (needRemove) {
    string removeName = key;
    if (!JS.isNullish(attrName)) removeName = hostString(attrName);
    hostRemoveAttribute(element, removeName);
  }
}

Regex optionModifierPattern = new Regex("(Once|Passive|Capture)$");
Regex optionModifierEventPattern = new Regex("^on:?(?:Once|Passive|Capture)$");
JsValue invokerKey = hostCreateSymbol("_vei");
float cachedNow = 0.0;
JsValue resolvedPromise = hostResolvedPromise();

float getNow() {
  if (cachedNow != 0.0) return cachedNow;
  cachedNow = hostDateNow();
  hostPromiseThen(resolvedPromise, JS.method0((JsValue _self) => {
    cachedNow = 0.0;
    return JS.undefined();
  }));
  return cachedNow;
}

JsValue parseEventName(string rawName) {
  string name = rawName;
  JsValue options = JS.undefined();
  while (true) {
    JsValue matched = optionModifierPattern.exec(name);
    if (JS.isNullish(matched) || optionModifierEventPattern.test(name)) break;
    if (JS.isUndefined(options)) options = JS.object();
    string modifier = hostString(hostRead(matched, 1));
    string option = modifier.toLowerCase();
    hostWrite(options, option, true);
    name = name.slice(0, name.length - modifier.length);
  }
  string event = callStringTransform(dependencyHyphenate, name.slice(2));
  if (name.charCodeAt(2) == 58) event = name.slice(3);
  return JS.array(event, options);
}

JsValue sanitizeEventValue(JsValue value, string propName) {
  if (dependencyIsFunction(value) || dependencyIsArray(value)) return value;
  hostWarn(
    "Wrong type passed as event handler to " + propName + " - did you forget @ or : " +
      "in front of your prop?\nExpected function or array of functions, received type " +
      JS.typeOf(value) + ".",
    JS.undefined()
  );
  return JS.method0((JsValue _self) => JS.undefined());
}

JsValue createInvoker(JsValue initialValue, JsValue instance) {
  JsValue invoker = JS.undefined();
  invoker = JS.method1((JsValue _self, JsValue event) => {
    JsValue timestamp = hostRead(event, "_vts");
    if (JS.isNullish(timestamp) || !timestamp.truthy()) {
      hostWrite(event, "_vts", hostDateNow());
    } else if (JS.number(timestamp) <= JS.number(hostRead(invoker, "attached"))) {
      return JS.undefined();
    }
    JsValue value = hostRead(invoker, "value");
    if (dependencyIsArray(value)) {
      JsValue originalStop = hostRead(event, "stopImmediatePropagation");
      hostWrite(event, "stopImmediatePropagation", JS.method0((JsValue _innerSelf) => {
        hostCall0(JS.invoke(originalStop, "bind", event));
        hostWrite(event, "_stopped", true);
        return JS.undefined();
      }));
      JsValue handlers = hostArraySlice(value);
      int count = valueLength(handlers);
      for (int index = 0; index < count; index++) {
        JsValue stopped = hostRead(event, "_stopped");
        if (!JS.isNullish(stopped) && stopped.truthy()) break;
        JsValue handler = hostRead(handlers, index);
        if (!JS.isNullish(handler) && handler.truthy()) hostCall1(handler, event);
      }
    } else {
      hostCall1(value, event);
    }
    return JS.undefined();
  });
  hostWrite(invoker, "value", initialValue);
  hostWrite(invoker, "attached", getNow());
  return invoker;
}

export void addEventListener(JsValue element, string event, JsValue handler, JsValue options) {
  hostAddEventListener(element, event, handler, options);
}

export void removeEventListener(JsValue element, string event, JsValue handler, JsValue options) {
  hostRemoveEventListener(element, event, handler, options);
}

export void patchEvent(
  JsValue element,
  string rawName,
  JsValue previous,
  JsValue next,
  JsValue instance
) {
  JsValue invokers = hostRead(element, invokerKey);
  if (JS.isNullish(invokers)) {
    invokers = JS.object();
    hostWrite(element, invokerKey, invokers);
  }
  JsValue existing = hostRead(invokers, rawName);
  if (!JS.isNullish(next) && next.truthy() && !JS.isNullish(existing) && existing.truthy()) {
    hostWrite(existing, "value", sanitizeEventValue(next, rawName));
    return;
  }
  JsValue parsed = parseEventName(rawName);
  string name = hostString(hostRead(parsed, 0));
  JsValue options = hostRead(parsed, 1);
  if (!JS.isNullish(next) && next.truthy()) {
    JsValue invoker = createInvoker(sanitizeEventValue(next, rawName), instance);
    hostWrite(invokers, rawName, invoker);
    hostAddEventListener(element, name, invoker, options);
  } else if (!JS.isNullish(existing) && existing.truthy()) {
    hostRemoveEventListener(element, name, existing, options);
    hostWrite(invokers, rawName, JS.undefined());
  }
}

bool nativeOn(string key) {
  if (key.length < 3) return false;
  int third = key.charCodeAt(2);
  return key.charCodeAt(0) == 111 && key.charCodeAt(1) == 110 && third > 96 && third < 123;
}

bool shouldSetAsProp(JsValue element, string key, JsValue value, bool isSVG) {
  if (isSVG) {
    if (key == "innerHTML" || key == "textContent") return true;
    if (hostHasProperty(element, key) && nativeOn(key) && dependencyIsFunction(value)) return true;
    return false;
  }
  if (key == "spellcheck" || key == "draggable" || key == "translate" || key == "autocorrect") return false;
  string tag = hostString(hostRead(element, "tagName"));
  if (key == "sandbox" && tag == "IFRAME") return false;
  if (key == "form") return false;
  if (key == "list" && tag == "INPUT") return false;
  if (key == "type" && tag == "TEXTAREA") return false;
  if ((key == "width" || key == "height") &&
      (tag == "IMG" || tag == "VIDEO" || tag == "CANVAS" || tag == "SOURCE")) return false;
  if (nativeOn(key) && dependencyIsString(value)) return false;
  return hostHasProperty(element, key);
}

Regex upperCasePattern = new Regex("[A-Z]");

bool shouldSetAsPropForVueCE(JsValue element, string key) {
  JsValue definition = hostRead(element, "_def");
  JsValue props = hostRead(definition, "props");
  if (JS.isNullish(props)) return false;
  string camelKey = callStringTransform(dependencyCamelize, key);
  if (dependencyIsArray(props)) {
    int count = valueLength(props);
    for (int index = 0; index < count; index++) {
      if (callStringTransform(dependencyCamelize, hostString(hostRead(props, index))) == camelKey) return true;
    }
    return false;
  }
  JsValue keys = hostObjectKeys(props);
  int count = valueLength(keys);
