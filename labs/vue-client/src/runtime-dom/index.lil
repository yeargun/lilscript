JsValue insertStaticContent(
  JsValue content,
  JsValue parent,
  JsValue anchor,
  JsValue namespace,
  JsValue start,
  JsValue end
) {
  JsValue before = hostLastChild(parent);
  if (!JS.isNullish(anchor)) before = hostPreviousSibling(anchor);
  if (!JS.isNullish(start) && (same(start, end) || !JS.isNullish(hostNextSibling(start)))) {
    while (true) {
      hostInsert(hostCloneNode(start), parent, anchor);
      if (same(start, end)) break;
      start = hostNextSibling(start);
      if (JS.isNullish(start)) break;
    }
  } else {
    string kind = "";
    if (!JS.isNullish(namespace)) kind = hostString(namespace);
    string source = hostString(content);
    if (kind == "svg") source = "<svg>" + source + "</svg>";
    else if (kind == "mathml") source = "<math>" + source + "</math>";
    hostSetTemplateHTML(hostUnsafeToTrustedHTML(source));
    JsValue template = hostTemplateContent();
    if (kind == "svg" || kind == "mathml") {
      JsValue wrapper = hostFirstChild(template);
      while (!JS.isNullish(hostFirstChild(wrapper))) {
        hostAppendChild(template, hostFirstChild(wrapper));
      }
      hostRemoveChild(template, wrapper);
    }
    hostInsert(template, parent, anchor);
  }
  JsValue first = hostFirstChild(parent);
  if (!JS.isNullish(before)) first = hostNextSibling(before);
  JsValue last = hostLastChild(parent);
  if (!JS.isNullish(anchor)) last = hostPreviousSibling(anchor);
  return JS.array(first, last);
}

JsValue nodeCreateElement(JsValue tagValue, JsValue namespace, JsValue isValue, JsValue props) {
  string tag = hostString(tagValue);
  JsValue element = hostCreateElement(tag, namespace, isValue);
  if (tag == "select" && !JS.isNullish(props) && !JS.isNullish(hostRead(props, "multiple"))) {
    hostSetAttribute(element, "multiple", hostRead(props, "multiple"));
  }
  return element;
}

export JsValue nodeOps = JS.object(
  "insert", JS.method3((JsValue _self, JsValue child, JsValue parent, JsValue anchor) => {
