JsValue dynamicBeforeUpdate(JsValue element, JsValue binding, JsValue vnode, JsValue previousVNode) {
  callModelHook(element, binding, vnode, previousVNode, "beforeUpdate");
  return JS.undefined();
}

JsValue dynamicUpdated(JsValue element, JsValue binding, JsValue vnode, JsValue previousVNode) {
  callModelHook(element, binding, vnode, previousVNode, "updated");
  return JS.undefined();
}

export JsValue vModelDynamic = JS.object(
  "created", dynamicCreated,
  "mounted", dynamicMounted,
  "beforeUpdate", dynamicBeforeUpdate,
  "updated", dynamicUpdated
);

export void initVShowForSSR() {
  hostWrite(vShow, "getSSRProps", JS.method1((JsValue _self, JsValue binding) => {
    if (!hostRead(binding, "value").truthy()) return JS.object("style", JS.object("display", "none"));
    return JS.undefined();
  }));
}

export void initVModelForSSR() {
  hostWrite(vModelText, "getSSRProps", JS.method1((JsValue _self, JsValue binding) =>
    JS.object("value", hostRead(binding, "value"))
  ));
  hostWrite(vModelRadio, "getSSRProps", JS.method2((JsValue _self, JsValue binding, JsValue vnode) => {
    JsValue props = hostRead(vnode, "props");
    if (!JS.isNullish(props) && dependencyLooseEqual(hostRead(props, "value"), hostRead(binding, "value"))) {
      return JS.object("checked", true);
    }
    return JS.undefined();
  }));
  hostWrite(vModelCheckbox, "getSSRProps", JS.method2((JsValue _self, JsValue binding, JsValue vnode) => {
    JsValue value = hostRead(binding, "value");
    JsValue props = hostRead(vnode, "props");
    if (dependencyIsArray(value)) {
      if (!JS.isNullish(props) && dependencyLooseIndexOf(value, hostRead(props, "value")) > -1) {
        return JS.object("checked", true);
      }
    } else if (dependencyIsSet(value)) {
      if (!JS.isNullish(props) && hostSetHas(value, hostRead(props, "value"))) {
        return JS.object("checked", true);
      }
    } else if (value.truthy()) {
      return JS.object("checked", true);
    }
    return JS.undefined();
  }));
  hostWrite(vModelDynamic, "getSSRProps", JS.method2((JsValue _self, JsValue binding, JsValue vnode) => {
    JsValue vnodeType = hostRead(vnode, "type");
    if (JS.typeOf(vnodeType) != "string") return JS.undefined();
    JsValue props = hostRead(vnode, "props");
    JsValue model = resolveDynamicModel(hostString(vnodeType).toUpperCase(), hostRead(props, "type"));
    JsValue callback = hostRead(model, "getSSRProps");
    if (!JS.isNullish(callback) && callback.truthy()) return hostCall2(callback, binding, vnode);
    return JS.undefined();
  }));
}

bool ssrDirectivesInitialized = false;

export void initDirectivesForSSR() {
  if (ssrDirectivesInitialized) return;
  ssrDirectivesInitialized = true;
  initVModelForSSR();
  initVShowForSSR();
}
