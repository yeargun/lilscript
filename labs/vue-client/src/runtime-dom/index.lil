extern void runtimeDomWrite(JsValue value, JsValue key, JsValue next);

bool RUNTIME_DOM_DEV = true;
bool RUNTIME_DOM_COMPAT = false;
bool RUNTIME_DOM_SSR = true;

void domWarn(string message) {
  JS.call(runtimeDomWarn, JS.undefined(), message);
}

JsValue rendererOptions = JS.call(
  runtimeDomExtend,
  JS.undefined(),
  JS.object("patchProp", patchProp),
  nodeOps
);
JsValue renderer = JS.undefined();
bool enabledHydration = false;

JsValue ensureRenderer() {
  if (JS.isUndefined(renderer) || JS.isNullish(renderer) || !renderer.truthy()) {
    renderer = JS.call(runtimeDomCreateRenderer, JS.undefined(), rendererOptions);
  }
  return renderer;
}

JsValue ensureHydrationRenderer() {
  if (!enabledHydration) renderer = JS.call(runtimeDomCreateHydrationRenderer, JS.undefined(), rendererOptions);
  enabledHydration = true;
  return renderer;
}

export JsValue render = JS.methodRest((JsValue _self, JsValue args) => {
  JsValue current = ensureRenderer();
  return runtimeDomApply(runtimeDomRead(current, "render"), current, args);
});

export JsValue hydrate = JS.methodRest((JsValue _self, JsValue args) => {
  JsValue current = ensureHydrationRenderer();
  return runtimeDomApply(runtimeDomRead(current, "hydrate"), current, args);
});

JsValue resolveRootNamespace(JsValue container) {
  return runtimeDomResolveRootNamespace(container);
}

void injectNativeTagCheck(JsValue app) {
  runtimeDomDefineValue(
    runtimeDomRead(app, "config"),
    "isNativeTag",
    JS.method1((JsValue _self, JsValue tag) => {
      return JS.call(runtimeDomIsHTMLTag, JS.undefined(), tag).truthy() ||
        JS.call(runtimeDomIsSVGTag, JS.undefined(), tag).truthy() ||
        JS.call(runtimeDomIsMathMLTag, JS.undefined(), tag).truthy();
    }),
    false
  );
}

void injectCompilerOptionsCheck(JsValue app) {
  if (!JS.call(runtimeDomIsRuntimeOnly, JS.undefined()).truthy()) return;
  JsValue config = runtimeDomRead(app, "config");
  JsValue customElement = runtimeDomRead(config, "isCustomElement");
  runtimeDomDefineAccessor(
    config,
    "isCustomElement",
    JS.method0((JsValue _self) => customElement),
    JS.method1((JsValue _self, JsValue _value) => {
      domWarn("The `isCustomElement` config option is deprecated. Use `compilerOptions.isCustomElement` instead.");
      return JS.undefined();
    })
  );
  JsValue compilerOptions = runtimeDomRead(config, "compilerOptions");
  string message =
    "The `compilerOptions` config option is only respected when using " +
    "a build of Vue.js that includes the runtime compiler (aka \"full build\"). " +
    "Since you are using the runtime-only build, `compilerOptions` " +
    "must be passed to `@vue/compiler-dom` in the build setup instead.\n" +
    "- For vue-loader: pass it via vue-loader's `compilerOptions` loader option.\n" +
    "- For vue-cli: see https://cli.vuejs.org/guide/webpack.html#modifying-options-of-a-loader\n" +
    "- For vite: pass it via @vitejs/plugin-vue options. See https://github.com/vitejs/vite-plugin-vue/tree/main/packages/plugin-vue#example-for-passing-options-to-vuecompiler-sfc";
  runtimeDomDefineAccessor(
    config,
    "compilerOptions",
    JS.method0((JsValue _self) => {
      domWarn(message);
      return compilerOptions;
    }),
    JS.method1((JsValue _self, JsValue _value) => {
      domWarn(message);
      return JS.undefined();
    })
  );
}

JsValue normalizeContainer(JsValue container) {
  if (runtimeDomIsString(container)) {
    string selector = runtimeDomString(container);
    JsValue result = runtimeDomQuerySelector(selector);
    if (RUNTIME_DOM_DEV && (JS.isNullish(result) || !result.truthy())) {
      domWarn("Failed to mount app: mount target selector \"" + selector + "\" returned null.");
    }
    return result;
  }
  if (RUNTIME_DOM_DEV && runtimeDomIsClosedShadowRoot(container)) {
    domWarn("mounting on a ShadowRoot with `{mode: \"closed\"}` may lead to unpredictable bugs");
  }
  return container;
}

export JsValue createApp = JS.methodRest((JsValue _self, JsValue args) => {
  JsValue current = ensureRenderer();
  JsValue app = runtimeDomApply(runtimeDomRead(current, "createApp"), current, args);
  if (RUNTIME_DOM_DEV) {
    injectNativeTagCheck(app);
    injectCompilerOptionsCheck(app);
  }
  JsValue mount = runtimeDomRead(app, "mount");
  runtimeDomWrite(app, "mount", JS.method1((JsValue _mountSelf, JsValue target) => {
    JsValue container = normalizeContainer(target);
    if (JS.isNullish(container) || !container.truthy()) return JS.undefined();
    JsValue component = runtimeDomRead(app, "_component");
    if (!runtimeDomIsFunction(component) &&
        !runtimeDomRead(component, "render").truthy() &&
        !runtimeDomRead(component, "template").truthy()) {
      runtimeDomWrite(component, "template", runtimeDomRead(container, "innerHTML"));
      if (RUNTIME_DOM_COMPAT && RUNTIME_DOM_DEV && JS.number(runtimeDomRead(container, "nodeType")).toInt() == 1) {
        JsValue attributes = runtimeDomRead(container, "attributes");
        int count = JS.number(runtimeDomRead(attributes, "length")).toInt();
        Regex directivePattern = new Regex("^(?:v-|:|@)");
        for (int index = 0; index < count; index++) {
          string name = runtimeDomString(runtimeDomRead(runtimeDomRead(attributes, index), "name"));
          if (name != "v-cloak" && directivePattern.test(name)) {
            JS.call(
              runtimeDomRead(compatUtils, "warnDeprecation"),
              compatUtils,
              runtimeDomRead(DeprecationTypes, "GLOBAL_MOUNT_CONTAINER"),
              null
            );
            break;
          }
        }
      }
    }
    if (JS.number(runtimeDomRead(container, "nodeType")).toInt() == 1) {
      runtimeDomSetTextContent(container, "");
    }
    JsValue proxy = JS.call(mount, JS.undefined(), container, false, resolveRootNamespace(container));
    if (runtimeDomIsElement(container)) {
      runtimeDomRemoveAttribute(container, "v-cloak");
      runtimeDomSetAttribute(container, "data-v-app", "");
    }
    return proxy;
  }));
  return app;
});

export JsValue createSSRApp = JS.methodRest((JsValue _self, JsValue args) => {
  JsValue current = ensureHydrationRenderer();
  JsValue app = runtimeDomApply(runtimeDomRead(current, "createApp"), current, args);
  if (RUNTIME_DOM_DEV) {
    injectNativeTagCheck(app);
    injectCompilerOptionsCheck(app);
  }
  JsValue mount = runtimeDomRead(app, "mount");
  runtimeDomWrite(app, "mount", JS.method1((JsValue _mountSelf, JsValue target) => {
    JsValue container = normalizeContainer(target);
    if (!JS.isNullish(container) && container.truthy()) {
      return JS.call(mount, JS.undefined(), container, true, resolveRootNamespace(container));
    }
    return JS.undefined();
  }));
  return app;
});

bool ssrDirectiveInitialized = false;
export void initDirectivesForSSR() {
  if (!RUNTIME_DOM_SSR || ssrDirectiveInitialized) return;
  ssrDirectiveInitialized = true;
  initVModelForSSR();
  initVShowForSSR();
}

