import { patchClass } from "./modules/class";
import { patchStyle } from "./modules/style";
import { patchAttr } from "./modules/attrs";
import { patchDOMProp } from "./modules/props";
import { patchEvent } from "./modules/events";
import extern {
  camelize as patchPropCamelize,
  isArray as patchPropIsArray,
  isFunction as patchPropIsFunction,
  isModelListener as patchPropIsModelListener,
  isOn as patchPropIsOn,
  isString as patchPropIsString
} from "../../packages/vuelil/shared.js";
import extern { hostCall1, hostHasProperty, hostObjectKeys, hostRead, hostString, hostWrite } from "./host.js";

extern JsValue patchPropCamelize;
extern bool patchPropIsArray(JsValue value);
extern bool patchPropIsFunction(JsValue value);
extern bool patchPropIsModelListener(string value);
extern bool patchPropIsOn(string value);
extern bool patchPropIsString(JsValue value);
extern JsValue hostCall1(JsValue fn, JsValue first);
extern bool hostHasProperty(JsValue value, JsValue key);
extern JsValue hostObjectKeys(JsValue value);
extern JsValue hostRead(JsValue value, JsValue key);
extern string hostString(JsValue value);
extern void hostWrite(JsValue value, JsValue key, JsValue next);

int valueLength(JsValue value) {
  return JS.number(hostRead(value, "length")).toInt();
}

string camelize(string key) {
  return hostString(hostCall1(patchPropCamelize, key));
}

bool nativeOn(string key) {
  if (key.length < 3) return false;
  int third = key.charCodeAt(2);
  return key.charCodeAt(0) == 111 && key.charCodeAt(1) == 110 && third > 96 && third < 123;
}

bool shouldSetAsProp(JsValue element, string key, JsValue value, bool isSVG) {
  if (isSVG) {
    if (key == "innerHTML" || key == "textContent") return true;
    if (hostHasProperty(element, key) && nativeOn(key) && patchPropIsFunction(value)) return true;
    return false;
  }
  if (key == "spellcheck" || key == "draggable" || key == "translate" || key == "autocorrect") return false;
  string tag = hostString(hostRead(element, "tagName"));
  if (key == "sandbox" && tag == "IFRAME") return false;
  if (key == "form") return false;
  if (key == "list" && tag == "INPUT") return false;
  if (key == "type" && tag == "TEXTAREA") return false;
  if ((key == "width" || key == "height") &&
      (tag == "IMG" || tag == "VIDEO" || tag == "CANVAS" || tag == "SOURCE")) return false;
  if (nativeOn(key) && patchPropIsString(value)) return false;
  return hostHasProperty(element, key);
}

bool shouldSetAsPropForVueCE(JsValue element, string key) {
  JsValue props = hostRead(hostRead(element, "_def"), "props");
  if (JS.isNullish(props) || !props.truthy()) return false;
  string camelKey = camelize(key);
  if (patchPropIsArray(props)) {
    int count = valueLength(props);
    for (int index = 0; index < count; index++) {
      if (camelize(hostString(hostRead(props, index))) == camelKey) return true;
    }
    return false;
  }
  JsValue keys = hostObjectKeys(props);
  int count = valueLength(keys);
  for (int index = 0; index < count; index++) {
    if (camelize(hostString(hostRead(keys, index))) == camelKey) return true;
  }
  return false;
}

Regex upperCasePattern = new Regex("[A-Z]");

export void patchProp(
  JsValue element,
  string originalKey,
  JsValue previous,
  JsValue next,
  JsValue namespace,
  JsValue parentComponent
) {
  string key = originalKey;
  bool isSVG = JS.strictEqual(namespace, "svg");
  if (key == "class") {
    patchClass(element, next, isSVG);
  } else if (key == "style") {
    patchStyle(element, previous, next);
  } else if (patchPropIsOn(key)) {
    if (!patchPropIsModelListener(key)) patchEvent(element, key, previous, next, parentComponent);
  } else {
    bool useProp = false;
    if (key.startsWith(".")) {
      key = key.slice(1);
      useProp = true;
    } else if (key.startsWith("^")) {
      key = key.slice(1);
    } else {
      useProp = shouldSetAsProp(element, key, next, isSVG);
    }
    if (useProp) {
      patchDOMProp(element, key, next, parentComponent);
      string tag = hostString(hostRead(element, "tagName"));
      if (!tag.includes("-") && (key == "value" || key == "checked" || key == "selected")) {
        patchAttr(element, key, next, isSVG, parentComponent, key != "value");
      }
      return;
    }
    JsValue isVueCE = hostRead(element, "_isVueCE");
    JsValue definition = hostRead(element, "_def");
    JsValue asyncLoader = hostRead(definition, "__asyncLoader");
    bool forceVueCE = !JS.isNullish(isVueCE) && isVueCE.truthy() &&
      (shouldSetAsPropForVueCE(element, key) ||
        ((!JS.isNullish(asyncLoader) && asyncLoader.truthy()) &&
          (upperCasePattern.test(key) || !patchPropIsString(next))));
    if (forceVueCE) {
      patchDOMProp(element, camelize(key), next, parentComponent, key);
    } else {
      if (key == "true-value") hostWrite(element, "_trueValue", next);
      else if (key == "false-value") hostWrite(element, "_falseValue", next);
      patchAttr(element, key, next, isSVG, parentComponent);
    }
  }
}
