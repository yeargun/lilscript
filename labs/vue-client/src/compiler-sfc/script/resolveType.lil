JsValue fileToScopeCache = createCache();
JsValue fileToGlobalScopeCache = createCache();

export void invalidateTypeCache(string filename) {
  filename = normalizePath(filename);
  JS.invoke(fileToScopeCache, "delete", filename);
  JS.invoke(fileToGlobalScopeCache, "delete", filename);
  JS.invoke(tsConfigCache, "delete", filename);
  JsValue affectedConfig = JS.invoke(tsConfigRefMap, "get", filename);
  if (affectedConfig.truthy()) JS.invoke(tsConfigCache, "delete", affectedConfig);
