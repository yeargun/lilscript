import extern { parse as resolveBabelParse } from "@babel/parser";
import extern {
  capitalize as resolveCapitalize,
  hasOwn as resolveHasOwn
} from "../../../packages/vuelil/shared.js";
import extern { minimatch as resolveIsMatch } from "minimatch";
import extern { default as resolvePath } from "node:path";
import extern { default as resolveProcess } from "node:process";
import extern {
  hostArrayFrom,
  hostAssign,
  hostCreateError,
  hostCreateMap,
  hostCreateObject,
  hostCreateSet,
  hostHasProperty,
  hostJsonStringify,
  hostKeys
} from "../host.js";
import { createCache } from "../cache";
import { parse as parseSFC } from "../parse";
import { resolveParserPlugins } from "./context";
import {
  UNKNOWN_TYPE,
  createGetCanonicalFileName,
  getId,
  getImportedName,
  getStringLiteralKey,
  joinPaths,
  normalizePath
} from "./utils";

extern JsValue hostArrayFrom;
extern JsValue hostAssign;
extern JsValue hostCreateError;
extern JsValue hostCreateMap;
extern JsValue hostCreateObject;
extern JsValue hostCreateSet;
extern JsValue hostHasProperty;
extern JsValue hostJsonStringify;
extern JsValue hostKeys;
extern JsValue resolveBabelParse;
extern JsValue resolveCapitalize;
extern JsValue resolveHasOwn;
extern JsValue resolveIsMatch;
extern JsValue resolvePath;
extern JsValue resolveProcess;

int resolveLength(JsValue value) {
  return JS.number(value["length"]).toInt();
}

void resolvePush(JsValue values, JsValue value) {
  values[resolveLength(values)] = value;
}

JsValue nullObject() {
  return JS.call(hostCreateObject, JS.undefined(), null);
}

JsValue createSet(JsValue values = JS.undefined()) {
  return JS.call(hostCreateSet, JS.undefined(), values);
}

JsValue assignObjects(JsValue target, JsValue first, JsValue second = JS.undefined()) {
  if (JS.isUndefined(second)) {
    return JS.call(hostAssign, JS.undefined(), target, first);
  }
  return JS.call(hostAssign, JS.undefined(), target, first, second);
}

bool owns(JsValue value, JsValue key) {
  return JS.call(resolveHasOwn, JS.undefined(), value, key).truthy();
}

JsValue arrayFrom(JsValue value) {
  return JS.call(hostArrayFrom, JS.undefined(), value);
}

bool arrayIncludes(JsValue values, JsValue value) {
  return JS.invoke(values, "includes", value).truthy();
}

bool hasVueIgnore(JsValue node) {
  JsValue comments = node["leadingComments"];
  if (JS.isNullish(comments)) return false;
  for (int index = 0; index < resolveLength(comments); index++) {
    if (JS.string(comments[index]["value"]).includes("@vue-ignore")) return true;
  }
  return false;
}

JsValue SupportedBuiltinsSet = createSet(
  JS.array("Partial", "Required", "Readonly", "Pick", "Omit")
);

export constructor TypeScope;
class TypeScope {
  JsValue filename;
  JsValue source;
  JsValue offset;
  JsValue imports;
  JsValue types;
  JsValue declares;
  JsValue isGenericScope;
  JsValue resolvedImportSources;
  JsValue exportedTypes;
  JsValue exportedDeclares;

  init(
    string filename,
    string source,
    int offset = 0,
    JsValue imports = JS.undefined(),
    JsValue types = JS.undefined(),
    JsValue declares = JS.undefined()
  ) {
    this.filename = filename;
    this.source = source;
    this.offset = offset;
    this.imports = imports;
    this.types = types;
    this.declares = declares;
    if (JS.isUndefined(this.imports)) this.imports = nullObject();
    if (JS.isUndefined(this.types)) this.types = nullObject();
    if (JS.isUndefined(this.declares)) this.declares = nullObject();
    this.isGenericScope = false;
    this.resolvedImportSources = nullObject();
    this.exportedTypes = nullObject();
    this.exportedDeclares = nullObject();
  }
}

void recordScopeDep(JsValue ctx, JsValue scope) {
  if (!JS.isNullish(scope) &&
    !JS.strictEqual(scope["filename"], ctx["filename"])) {
    if (JS.isNullish(ctx["deps"])) ctx["deps"] = createSet();
    JS.invoke(ctx["deps"], "add", scope["filename"]);
  }
}

void recordResolvedElementDeps(JsValue ctx, JsValue resolved) {
  JsValue props = resolved["props"];
  for (string key in props) {
    recordScopeDep(ctx, props[key]["_ownerScope"]);
  }
}

export JsValue resolveTypeElements(
  JsValue ctx,
  JsValue node,
  JsValue scope = JS.undefined(),
  JsValue typeParameters = JS.undefined()
) {
  bool canCache = JS.isUndefined(typeParameters);
  if (canCache && node["_resolvedElements"].truthy()) {
    recordResolvedElementDeps(ctx, node["_resolvedElements"]);
    return node["_resolvedElements"];
  }
  JsValue selectedScope = node["_ownerScope"];
  if (!selectedScope.truthy()) selectedScope = scope;
  if (!selectedScope.truthy()) selectedScope = ctxToScope(ctx);
  JsValue resolved = innerResolveTypeElements(
    ctx,
    node,
    selectedScope,
    typeParameters
  );
  if (canCache) node["_resolvedElements"] = resolved;
  return resolved;
}

JsValue innerResolveTypeElements(
  JsValue ctx,
  JsValue node,
  JsValue scope,
  JsValue typeParameters
) {
  if (hasVueIgnore(node)) {
    string ignoredType = JS.string(node["type"]);
    if ((ignoredType == "TSIntersectionType" || ignoredType == "TSUnionType") &&
      resolveLength(node["types"]) > 1) {
      JsValue maps = JS.array(JS.object("props", JS.object()));
      JsValue types = node["types"];
      for (int index = 1; index < resolveLength(types); index++) {
        resolvePush(maps, resolveTypeElements(ctx, types[index], scope, typeParameters));
      }
      return mergeElements(maps, ignoredType);
    }
    return JS.object("props", JS.object());
  }

  string type = JS.string(node["type"]);
  if (type == "TSTypeLiteral") {
    return typeElementsToMap(ctx, node["members"], scope, typeParameters);
  }
  if (type == "TSInterfaceDeclaration") {
    return resolveInterfaceMembers(ctx, node, scope, typeParameters);
  }
  if (type == "TSTypeAliasDeclaration" || type == "TSTypeAnnotation" ||
    type == "TSParenthesizedType") {
    return resolveTypeElements(ctx, node["typeAnnotation"], scope, typeParameters);
  }
  if (type == "TSFunctionType") {
    return JS.object("props", JS.object(), "calls", JS.array(node));
  }
  if (type == "TSUnionType" || type == "TSIntersectionType") {
    JsValue maps = JS.array();
    JsValue types = node["types"];
    for (int index = 0; index < resolveLength(types); index++) {
      resolvePush(maps, resolveTypeElements(ctx, types[index], scope, typeParameters));
    }
    return mergeElements(maps, type);
  }
  if (type == "TSMappedType") {
    return resolveMappedType(ctx, node, scope, typeParameters);
  }
  if (type == "TSIndexedAccessType") {
    JsValue types = resolveIndexType(ctx, node, scope);
    JsValue maps = JS.array();
    for (int index = 0; index < resolveLength(types); index++) {
      JsValue item = types[index];
      resolvePush(maps, resolveTypeElements(ctx, item, item["_ownerScope"]));
    }
    return mergeElements(maps, "TSUnionType");
  }
  if (type == "TSExpressionWithTypeArguments" || type == "TSTypeReference") {
    JsValue typeNameValue = getReferenceName(node);
    if (JS.typeOf(typeNameValue) == "string") {
      string typeName = JS.string(typeNameValue);
      JsValue importedType = scope["imports"][typeName];
      if ((typeName == "ExtractPropTypes" || typeName == "ExtractPublicPropTypes") &&
        node["typeParameters"].truthy() &&
        importedType.truthy() && JS.string(importedType["source"]) == "vue") {
        return resolveExtractPropTypes(
          resolveTypeElements(
            ctx,
            node["typeParameters"]["params"][0],
            scope,
            typeParameters
          ),
          scope
        );
      }
    }
    JsValue resolved = resolveTypeReference(ctx, node, scope);
    if (resolved.truthy()) {
      JsValue typeParams = JS.undefined();
      string resolvedType = JS.string(resolved["type"]);
      if ((resolvedType == "TSTypeAliasDeclaration" ||
        resolvedType == "TSInterfaceDeclaration") &&
        resolved["typeParameters"].truthy() && node["typeParameters"].truthy()) {
        typeParams = nullObject();
        JsValue params = resolved["typeParameters"]["params"];
        JsValue supplied = node["typeParameters"]["params"];
        for (int index = 0; index < resolveLength(params); index++) {
          string name = JS.string(params[index]["name"]);
          JsValue param = JS.undefined();
          if (!JS.isUndefined(typeParameters)) param = typeParameters[name];
          if (!param.truthy()) param = supplied[index];
          typeParams[name] = param;
        }
      }
      return resolveTypeElements(
        ctx,
        resolved,
        resolved["_ownerScope"],
        typeParams
      );
    }
    if (JS.typeOf(typeNameValue) == "string") {
      string typeName = JS.string(typeNameValue);
      if (!JS.isUndefined(typeParameters) && typeParameters[typeName].truthy()) {
        return resolveTypeElements(
          ctx,
          typeParameters[typeName],
          scope,
          typeParameters
        );
      }
      if (JS.invoke(SupportedBuiltinsSet, "has", typeName).truthy()) {
        return resolveBuiltin(ctx, node, typeName, scope, typeParameters);
      }
      if (typeName == "ReturnType" && node["typeParameters"].truthy()) {
        JsValue returned = resolveReturnType(
          ctx,
          node["typeParameters"]["params"][0],
          scope
        );
        if (returned.truthy()) return resolveTypeElements(ctx, returned, scope);
      }
    }
    return JS.invoke(
      ctx,
      "error",
      "Unresolvable type reference or unsupported built-in utility type",
      node,
      scope
    );
  }
  if (type == "TSImportType") {
    JsValue qualifier = node["qualifier"];
    if (JS.strictEqual(getId(node["argument"]), "vue") && qualifier.truthy() &&
      JS.string(qualifier["type"]) == "Identifier" &&
      JS.string(qualifier["name"]) == "ExtractPropTypes" &&
      node["typeParameters"].truthy()) {
      return resolveExtractPropTypes(
        resolveTypeElements(ctx, node["typeParameters"]["params"][0], scope),
        scope
      );
    }
    JsValue sourceScope = importSourceToScope(
      ctx,
      node["argument"],
      scope,
      JS.string(node["argument"]["value"])
    );
    JsValue resolved = resolveTypeReference(ctx, node, sourceScope);
    if (resolved.truthy()) {
      return resolveTypeElements(ctx, resolved, resolved["_ownerScope"]);
    }
  } else if (type == "TSTypeQuery") {
    JsValue resolved = resolveTypeReference(ctx, node, scope);
    if (resolved.truthy()) {
      return resolveTypeElements(ctx, resolved, resolved["_ownerScope"]);
    }
  }
  return JS.invoke(ctx, "error", "Unresolvable type: " + type, node, scope);
}

JsValue typeElementsToMap(
  JsValue ctx,
  JsValue elements,
  JsValue scope = JS.undefined(),
  JsValue typeParameters = JS.undefined()
) {
  if (JS.isUndefined(scope)) scope = ctxToScope(ctx);
  JsValue result = JS.object("props", JS.object());
  for (int index = 0; index < resolveLength(elements); index++) {
    JsValue element = elements[index];
    string type = JS.string(element["type"]);
    if (type == "TSPropertySignature" || type == "TSMethodSignature") {
      if (!JS.isUndefined(typeParameters)) {
        scope = createChildScope(scope);
        scope["isGenericScope"] = true;
        assignObjects(scope["types"], typeParameters);
      }
      element["_ownerScope"] = scope;
      JsValue name = getStringLiteralKey(element);
      if (!JS.strictEqual(name, null)) {
        result["props"][JS.string(name)] = element;
      } else {
        JS.invoke(
          ctx,
          "error",
          "Unsupported computed key in type referenced by a macro",
          element["key"],
          scope
        );
      }
    } else if (type == "TSCallSignatureDeclaration") {
      if (JS.isNullish(result["calls"])) result["calls"] = JS.array();
      resolvePush(result["calls"], element);
    }
  }
  return result;
}

JsValue mergeElements(JsValue maps, string type) {
  if (resolveLength(maps) == 1) return maps[0];
  JsValue result = JS.object("props", JS.object());
  JsValue baseProps = result["props"];
  for (int index = 0; index < resolveLength(maps); index++) {
    JsValue props = maps[index]["props"];
    for (string key in props) {
      if (!owns(baseProps, key)) {
        baseProps[key] = props[key];
      } else {
        baseProps[key] = createProperty(
          baseProps[key]["key"],
          JS.object(
            "type", type,
            "types", JS.array(baseProps[key], props[key])
          ),
          baseProps[key]["_ownerScope"],
          baseProps[key]["optional"].truthy() || props[key]["optional"].truthy()
        );
      }
    }
    JsValue calls = maps[index]["calls"];
    if (!JS.isNullish(calls)) {
      if (JS.isNullish(result["calls"])) result["calls"] = JS.array();
      for (int callIndex = 0; callIndex < resolveLength(calls); callIndex++) {
        resolvePush(result["calls"], calls[callIndex]);
      }
    }
  }
  return result;
}

JsValue createProperty(
  JsValue key,
  JsValue typeAnnotation,
  JsValue scope,
  bool optional
) {
  return JS.object(
    "type", "TSPropertySignature",
    "key", key,
    "kind", "get",
    "optional", optional,
    "typeAnnotation", JS.object(
      "type", "TSTypeAnnotation",
      "typeAnnotation", typeAnnotation
    ),
    "_ownerScope", scope
  );
}

JsValue resolveInterfaceMembers(
  JsValue ctx,
  JsValue node,
  JsValue scope,
  JsValue typeParameters
) {
  JsValue base = typeElementsToMap(
    ctx,
    node["body"]["body"],
    node["_ownerScope"],
    typeParameters
  );
  JsValue extensions = node["extends"];
  if (!JS.isNullish(extensions)) {
    for (int index = 0; index < resolveLength(extensions); index++) {
      JsValue extension = extensions[index];
      try {
        JsValue resolved = resolveTypeElements(ctx, extension, scope);
        JsValue props = resolved["props"];
        for (string key in props) {
          if (!owns(base["props"], key)) base["props"][key] = props[key];
        }
        JsValue calls = resolved["calls"];
        if (!JS.isNullish(calls)) {
          if (JS.isNullish(base["calls"])) base["calls"] = JS.array();
          for (int callIndex = 0; callIndex < resolveLength(calls); callIndex++) {
            resolvePush(base["calls"], calls[callIndex]);
          }
        }
      } catch (JsValue _error) {
        if (!ctx["silentOnExtendsFailure"].truthy()) {
          JS.invoke(
            ctx,
            "error",
            "Failed to resolve extends base type.\nIf this previously worked in 3.2, " +
              "you can instruct the compiler to ignore this extend by adding " +
              "/* @vue-ignore */ before it, for example:\n\n" +
              "interface Props extends /* @vue-ignore */ Base {}\n\n" +
              "Note: both in 3.2 or with the ignore, the properties in the base " +
              "type are treated as fallthrough attrs at runtime.",
            extension,
            scope
          );
        }
      }
    }
  }
  return base;
}

JsValue resolveMappedType(
  JsValue ctx,
  JsValue node,
  JsValue scope,
  JsValue typeParameters
) {
  JsValue result = JS.object("props", JS.object());
  JsValue keys = JS.undefined();
  if (node["nameType"].truthy()) {
    string name = JS.string(node["typeParameter"]["name"]);
    JsValue constraint = node["typeParameter"]["constraint"];
    scope = createChildScope(scope);
    JsValue additions = JS.object();
    if (!JS.isUndefined(typeParameters)) assignObjects(additions, typeParameters);
    additions[name] = constraint;
    assignObjects(scope["types"], additions);
    keys = resolveStringType(ctx, node["nameType"], scope);
  } else {
    keys = resolveStringType(ctx, node["typeParameter"]["constraint"], scope);
  }
  for (int index = 0; index < resolveLength(keys); index++) {
    string key = JS.string(keys[index]);
    result["props"][key] = createProperty(
      JS.object("type", "Identifier", "name", key),
      node["typeAnnotation"],
      scope,
      node["optional"].truthy()
    );
  }
  return result;
}

JsValue resolveIndexType(JsValue ctx, JsValue node, JsValue scope) {
  if (JS.string(node["indexType"]["type"]) == "TSNumberKeyword") {
    return resolveArrayElementType(ctx, node["objectType"], scope);
  }
  JsValue indexType = node["indexType"];
  JsValue objectType = node["objectType"];
  JsValue types = JS.array();
  JsValue keys = JS.undefined();
  JsValue resolved = JS.undefined();
  if (JS.string(indexType["type"]) == "TSStringKeyword") {
    resolved = resolveTypeElements(ctx, objectType, scope);
    keys = JS.call(hostKeys, JS.undefined(), resolved["props"]);
  } else {
    keys = resolveStringType(ctx, indexType, scope);
    resolved = resolveTypeElements(ctx, objectType, scope);
  }
  for (int index = 0; index < resolveLength(keys); index++) {
    string key = JS.string(keys[index]);
    JsValue property = resolved["props"][key];
    JsValue targetType = JS.undefined();
    if (!JS.isNullish(property) && !JS.isNullish(property["typeAnnotation"])) {
      targetType = property["typeAnnotation"]["typeAnnotation"];
    }
    if (targetType.truthy()) {
      targetType["_ownerScope"] = property["_ownerScope"];
      resolvePush(types, targetType);
    }
  }
  return types;
}

JsValue resolveArrayElementType(JsValue ctx, JsValue node, JsValue scope) {
  string type = JS.string(node["type"]);
  if (type == "TSArrayType") return JS.array(node["elementType"]);
  if (type == "TSTupleType") {
    JsValue result = JS.array();
    JsValue elements = node["elementTypes"];
    for (int index = 0; index < resolveLength(elements); index++) {
      JsValue element = elements[index];
      if (JS.string(element["type"]) == "TSNamedTupleMember") {
        element = element["elementType"];
      }
      resolvePush(result, element);
    }
    return result;
  }
  if (type == "TSTypeReference") {
    if (JS.strictEqual(getReferenceName(node), "Array") &&
      node["typeParameters"].truthy()) {
      return node["typeParameters"]["params"];
    }
    JsValue resolved = resolveTypeReference(ctx, node, scope);
    if (resolved.truthy()) return resolveArrayElementType(ctx, resolved, scope);
  }
  return JS.invoke(
    ctx,
    "error",
    "Failed to resolve element type from target type",
    node,
    scope
  );
}

JsValue resolveStringType(
  JsValue ctx,
  JsValue node,
  JsValue scope,
  JsValue typeParameters = JS.undefined()
) {
  string type = JS.string(node["type"]);
  if (type == "StringLiteral") return JS.array(node["value"]);
  if (type == "TSLiteralType") {
    return resolveStringType(ctx, node["literal"], scope, typeParameters);
  }
  if (type == "TSUnionType") {
    JsValue result = JS.array();
    JsValue types = node["types"];
    for (int index = 0; index < resolveLength(types); index++) {
      JsValue values = resolveStringType(ctx, types[index], scope, typeParameters);
      for (int valueIndex = 0; valueIndex < resolveLength(values); valueIndex++) {
        resolvePush(result, values[valueIndex]);
      }
    }
    return result;
  }
  if (type == "TemplateLiteral") return resolveTemplateKeys(ctx, node, scope);
  if (type == "TSTypeReference") {
    JsValue resolved = resolveTypeReference(ctx, node, scope);
    if (resolved.truthy()) {
      return resolveStringType(ctx, resolved, scope, typeParameters);
    }
    if (JS.string(node["typeName"]["type"]) == "Identifier") {
      string name = JS.string(node["typeName"]["name"]);
      if (!JS.isUndefined(typeParameters) && typeParameters[name].truthy()) {
        return resolveStringType(
          ctx,
          typeParameters[name],
          scope,
          typeParameters
        );
      }
      if (name == "Extract") {
        return resolveStringType(
          ctx,
          node["typeParameters"]["params"][1],
          scope,
          typeParameters
        );
      }
      if (name == "Exclude") {
        JsValue excluded = resolveStringType(
          ctx,
          node["typeParameters"]["params"][1],
          scope,
          typeParameters
        );
        JsValue first = resolveStringType(
          ctx,
          node["typeParameters"]["params"][0],
          scope,
          typeParameters
        );
        JsValue result = JS.array();
        for (int index = 0; index < resolveLength(first); index++) {
          if (!arrayIncludes(excluded, first[index])) resolvePush(result, first[index]);
        }
        return result;
      }
      if (name == "Uppercase" || name == "Lowercase" || name == "Capitalize" ||
        name == "Uncapitalize") {
        JsValue first = resolveStringType(
          ctx,
          node["typeParameters"]["params"][0],
          scope,
          typeParameters
        );
        JsValue result = JS.array();
        for (int index = 0; index < resolveLength(first); index++) {
          string value = JS.string(first[index]);
          if (name == "Uppercase") value = value.toUpperCase();
          else if (name == "Lowercase") value = value.toLowerCase();
          else if (name == "Capitalize") {
            value = JS.string(JS.call(resolveCapitalize, JS.undefined(), value));
          } else value = value.charAt(0).toLowerCase() + value.slice(1);
          resolvePush(result, value);
        }
        return result;
      }
      JS.invoke(
        ctx,
        "error",
        "Unsupported type when resolving index type",
        node["typeName"],
        scope
      );
    }
  }
  return JS.invoke(
    ctx,
    "error",
    "Failed to resolve index type into finite keys",
    node,
    scope
  );
}

JsValue resolveTemplateKeys(JsValue ctx, JsValue node, JsValue scope) {
  if (resolveLength(node["expressions"]) == 0) {
    return JS.array(node["quasis"][0]["value"]["raw"]);
  }
  JsValue result = JS.array();
  JsValue expression = node["expressions"][0];
  JsValue quasi = node["quasis"][0];
  string leading = "";
  if (quasi.truthy()) leading = JS.string(quasi["value"]["raw"]);
  JsValue resolved = resolveStringType(ctx, expression, scope);
  JsValue remainingQuasis = node["quasis"];
  if (quasi.truthy()) remainingQuasis = JS.invoke(node["quasis"], "slice", 1);
  JsValue nextNode = assignObjects(
    JS.object(),
    node,
    JS.object(
      "expressions", JS.invoke(node["expressions"], "slice", 1),
      "quasis", remainingQuasis
    )
  );
  JsValue restResolved = resolveTemplateKeys(ctx, nextNode, scope);
  for (int index = 0; index < resolveLength(resolved); index++) {
    for (int restIndex = 0; restIndex < resolveLength(restResolved); restIndex++) {
      resolvePush(
        result,
        leading + JS.string(resolved[index]) + JS.string(restResolved[restIndex])
      );
    }
  }
  return result;
}

JsValue resolveBuiltin(
  JsValue ctx,
  JsValue node,
  string name,
  JsValue scope,
  JsValue typeParameters
) {
  JsValue value = resolveTypeElements(
    ctx,
    node["typeParameters"]["params"][0],
    scope,
    typeParameters
  );
  if (name == "Partial" || name == "Required") {
    JsValue result = JS.object("props", JS.object(), "calls", value["calls"]);
    JsValue keys = JS.call(hostKeys, JS.undefined(), value["props"]);
    for (int index = 0; index < resolveLength(keys); index++) {
      string key = JS.string(keys[index]);
      result["props"][key] = assignObjects(
        JS.object(),
        value["props"][key],
        JS.object("optional", name == "Partial")
      );
    }
    return result;
  }
  if (name == "Readonly") return value;
  if (name == "Pick") {
    JsValue picked = resolveStringType(
      ctx,
      node["typeParameters"]["params"][1],
      scope,
      typeParameters
    );
    JsValue result = JS.object("props", JS.object(), "calls", value["calls"]);
    for (int index = 0; index < resolveLength(picked); index++) {
      string key = JS.string(picked[index]);
      result["props"][key] = value["props"][key];
    }
    return result;
  }
  JsValue omitted = resolveStringType(
    ctx,
    node["typeParameters"]["params"][1],
    scope,
    typeParameters
  );
  JsValue result = JS.object("props", JS.object(), "calls", value["calls"]);
  for (string key in value["props"]) {
    if (!arrayIncludes(omitted, key)) result["props"][key] = value["props"][key];
  }
  return result;
}

JsValue resolveTypeReference(
  JsValue ctx,
  JsValue node,
  JsValue scope = JS.undefined(),
  JsValue name = JS.undefined(),
  bool onlyExported = false
) {
  bool canCache = JS.isNullish(scope) || !scope["isGenericScope"].truthy();
  if (canCache && node["_resolvedReference"].truthy()) {
    recordScopeDep(ctx, node["_resolvedReference"]["_ownerScope"]);
    return node["_resolvedReference"];
  }
  if (!scope.truthy()) scope = ctxToScope(ctx);
  if (!name.truthy()) name = getReferenceName(node);
  JsValue resolved = innerResolveTypeReference(
    ctx,
    scope,
    name,
    node,
    onlyExported
