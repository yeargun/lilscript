}

JsValue getReferenceName(JsValue node) {
  JsValue reference = JS.undefined();
  string type = JS.string(node["type"]);
  if (type == "TSTypeReference") reference = node["typeName"];
  else if (type == "TSExpressionWithTypeArguments") reference = node["expression"];
  else if (type == "TSImportType") reference = node["qualifier"];
  else reference = node["exprName"];
  if (reference.truthy()) {
    if (JS.string(reference["type"]) == "Identifier") return reference["name"];
    if (JS.string(reference["type"]) == "TSQualifiedName") {
      return qualifiedNameToPath(reference);
    }
  }
  return "default";
}

JsValue qualifiedNameToPath(JsValue node) {
  if (JS.string(node["type"]) == "Identifier") return JS.array(node["name"]);
  JsValue result = qualifiedNameToPath(node["left"]);
  resolvePush(result, node["right"]["name"]);
  return result;
}

JsValue resolveGlobalScope(JsValue ctx) {
  JsValue files = ctx["options"]["globalTypeFiles"];
  if (!files.truthy()) return JS.undefined();
  JsValue fs = resolveFS(ctx);
  if (!fs.truthy()) {
    throw JS.call(
      hostCreateError,
      JS.undefined(),
      "[vue/compiler-sfc] globalTypeFiles requires fs access."
    );
  }
  JsValue scopes = JS.array();
  for (int index = 0; index < resolveLength(files); index++) {
    resolvePush(scopes, fileToScope(ctx, normalizePath(JS.string(files[index])), true));
  }
  return scopes;
}

JsValue ts = JS.undefined();
JsValue loadTS = JS.undefined();

export void registerTS(JsValue load) {
  loadTS = JS.method0((JsValue _self) => {
    try {
      return JS.call(load, JS.undefined());
    } catch (JsValue error) {
      if (JS.typeOf(error["message"]) == "string" &&
        JS.string(error["message"]).includes("Cannot find module")) {
        throw JS.call(
          hostCreateError,
          JS.undefined(),
          "Failed to load TypeScript, which is required for resolving imported types. " +
            "Please make sure \"TypeScript\" is installed as a project dependency."
        );
      }
      throw JS.call(
        hostCreateError,
        JS.undefined(),
        "Failed to load TypeScript for resolving imported types."
      );
    }
  });
}

JsValue resolveFS(JsValue ctx) {
  if (ctx["fs"].truthy()) return ctx["fs"];
  if (!ts.truthy() && loadTS.truthy()) ts = JS.call(loadTS, JS.undefined());
  JsValue fs = ctx["options"]["fs"];
  if (!fs.truthy() && ts.truthy()) fs = ts["sys"];
  if (!fs.truthy()) return JS.undefined();

  JsValue wrapped = JS.object();
  wrapped["fileExists"] = JS.method1((JsValue _self, JsValue rawFile) => {
    string file = JS.string(rawFile);
    if (file.endsWith(".vue.ts") && !file.endsWith(".d.vue.ts")) {
      file = JS.string(JS.invoke(file, "replace", new Regex("\\.ts$"), ""));
    }
    return JS.call(fs["fileExists"], fs, file);
  });
  wrapped["readFile"] = JS.method1((JsValue _self, JsValue rawFile) => {
    string file = JS.string(rawFile);
    if (file.endsWith(".vue.ts") && !file.endsWith(".d.vue.ts")) {
      file = JS.string(JS.invoke(file, "replace", new Regex("\\.ts$"), ""));
    }
    return JS.call(fs["readFile"], fs, file);
  });
  wrapped["realpath"] = fs["realpath"];
  ctx["fs"] = wrapped;
  return wrapped;
}

JsValue resolveTypeFromImport(
  JsValue ctx,
  JsValue node,
  string name,
  JsValue scope
) {
  JsValue binding = scope["imports"][name];
  JsValue sourceScope = importSourceToScope(
    ctx,
    node,
    scope,
    JS.string(binding["source"])
  );
  return resolveTypeReference(
    ctx,
    node,
    sourceScope,
    binding["imported"],
    true
  );
}

bool cjsBuild = true;
bool typeResolveTestBuild = false;

JsValue importSourceToScope(
  JsValue ctx,
  JsValue node,
  JsValue scope,
  string source,
  bool trackDep = true
) {
  JsValue fs = JS.undefined();
  try {
    fs = resolveFS(ctx);
  } catch (JsValue error) {
    return JS.invoke(ctx, "error", error["message"], node, scope);
  }
  if (!fs.truthy()) {
    return JS.invoke(
      ctx,
      "error",
      "No fs option provided to `compileScript` in non-Node environment. " +
        "File system access is required for resolving imported types.",
      node,
      scope
    );
  }

  JsValue resolved = scope["resolvedImportSources"][source];
  if (!resolved.truthy()) {
    if (source.startsWith("..")) {
      JsValue joinFunction = joinPaths;
      if (JS.string(resolveProcess["platform"]) == "win32") {
        joinFunction = resolvePath["join"];
      }
      string filename = JS.string(JS.call(
        joinFunction,
        resolvePath,
        JS.invoke(resolvePath, "dirname", scope["filename"]),
        source
      ));
      resolved = resolveExt(filename, fs);
    } else if (source.charAt(0) == ".") {
      string filename = JS.string(JS.call(
        joinPaths,
        JS.undefined(),
        JS.invoke(resolvePath, "dirname", scope["filename"]),
        source
      ));
      resolved = resolveExt(filename, fs);
    } else {
      if (!cjsBuild) {
        return JS.invoke(
          ctx,
          "error",
          "Type import from non-relative sources is not supported in the browser build.",
          node,
          scope
        );
      }
      if (!ts.truthy()) {
        if (loadTS.truthy()) ts = JS.call(loadTS, JS.undefined());
        if (!ts.truthy()) {
          return JS.invoke(
            ctx,
            "error",
            "Failed to resolve import source " +
              JS.string(JS.call(hostJsonStringify, JS.undefined(), source)) + ". " +
              "TypeScript is required as a peer dep for vue in order " +
              "to support resolving types from module imports.",
            node,
            scope
          );
        }
      }
      resolved = resolveWithTS(
        JS.string(scope["filename"]),
        source,
        ts,
        fs
      );
    }
    if (!resolved.truthy() && source.charAt(0) == "." && cjsBuild) {
      if (!ts.truthy() && loadTS.truthy()) ts = JS.call(loadTS, JS.undefined());
      if (ts.truthy()) {
        resolved = resolveWithTS(
          JS.string(scope["filename"]),
          source,
          ts,
          fs
        );
      }
    }
    if (resolved.truthy()) {
      resolved = normalizePath(JS.string(resolved));
      scope["resolvedImportSources"][source] = resolved;
    }
  }
  if (resolved.truthy()) {
    if (trackDep) {
      if (JS.isNullish(ctx["deps"])) ctx["deps"] = createSet();
      JS.invoke(ctx["deps"], "add", resolved);
    }
    return fileToScope(ctx, JS.string(resolved));
  }
  return JS.invoke(
    ctx,
    "error",
    "Failed to resolve import source " +
      JS.string(JS.call(hostJsonStringify, JS.undefined(), source)) + ".",
    node,
    scope
  );
}

JsValue resolveExt(string filename, JsValue fs) {
  string moduleType = "u";
  if (filename.endsWith(".mjs")) moduleType = "m";
  else if (filename.endsWith(".cjs")) moduleType = "c";
  filename = JS.string(JS.invoke(
    filename,
    "replace",
    new Regex("\\.[cm]?jsx?$"),
    ""
  ));

  JsValue exact = tryResolveFile(filename, fs);
  if (exact.truthy()) return exact;
  JsValue resolved = JS.undefined();
  if (moduleType == "m") {
    resolved = resolveMts(filename, fs);
    if (!resolved.truthy()) resolved = resolveTs(filename, fs);
  } else if (moduleType == "c") {
    resolved = resolveCts(filename, fs);
    if (!resolved.truthy()) resolved = resolveTs(filename, fs);
  } else {
    resolved = resolveTs(filename, fs);
    if (!resolved.truthy()) resolved = resolveMts(filename, fs);
    if (!resolved.truthy()) resolved = resolveCts(filename, fs);
  }
  if (resolved.truthy()) return resolved;
  resolved = tryResolveFile(
    JS.string(JS.call(joinPaths, JS.undefined(), filename, "index.ts")),
    fs
  );
  if (resolved.truthy()) return resolved;
  resolved = tryResolveFile(
    JS.string(JS.call(joinPaths, JS.undefined(), filename, "index.tsx")),
    fs
  );
  if (resolved.truthy()) return resolved;
  return tryResolveFile(
    JS.string(JS.call(joinPaths, JS.undefined(), filename, "index.d.ts")),
    fs
  );
}

JsValue tryResolveFile(string filename, JsValue fs) {
  if (JS.call(fs["fileExists"], fs, filename).truthy()) return filename;
  return JS.undefined();
}

JsValue resolveTs(string filename, JsValue fs) {
  JsValue resolved = tryResolveFile(filename + ".ts", fs);
  if (resolved.truthy()) return resolved;
  resolved = tryResolveFile(filename + ".tsx", fs);
  if (resolved.truthy()) return resolved;
  return tryResolveFile(filename + ".d.ts", fs);
}

JsValue resolveMts(string filename, JsValue fs) {
  JsValue resolved = tryResolveFile(filename + ".mts", fs);
  if (resolved.truthy()) return resolved;
  return tryResolveFile(filename + ".d.mts", fs);
}

JsValue resolveCts(string filename, JsValue fs) {
  JsValue resolved = tryResolveFile(filename + ".cts", fs);
  if (resolved.truthy()) return resolved;
  return tryResolveFile(filename + ".d.cts", fs);
}

JsValue tsConfigCache = createCache();
JsValue tsConfigRefMap = JS.call(hostCreateMap, JS.undefined());

JsValue resolveWithTS(
  string containingFile,
  string source,
  JsValue typescript,
  JsValue fs
) {
  if (!cjsBuild) return JS.undefined();

  JsValue configPath = JS.invoke(
    typescript,
    "findConfigFile",
    containingFile,
    fs["fileExists"]
  );
  JsValue compilerOptions = JS.undefined();
  JsValue resolutionCache = JS.undefined();
  if (configPath.truthy()) {
    string normalizedConfigPath = normalizePath(JS.string(configPath));
    JsValue configs = JS.invoke(tsConfigCache, "get", normalizedConfigPath);
    if (!configs.truthy()) {
      JsValue loaded = loadTSConfig(
        JS.string(configPath),
        typescript,
        fs,
        JS.undefined()
      );
      configs = JS.array();
      for (int index = 0; index < resolveLength(loaded); index++) {
        resolvePush(configs, JS.object("config", loaded[index]));
      }
      JS.invoke(tsConfigCache, "set", normalizedConfigPath, configs);
    }

    JsValue matchedConfig = JS.undefined();
    if (resolveLength(configs) == 1) {
      matchedConfig = configs[0];
    } else {
      JsValue versionParts = JS.invoke(
        typescript["versionMajorMinor"],
        "split",
        "."
      );
      int major = JS.number(versionParts[0]).toInt();
      int minor = JS.number(versionParts[1]).toInt();
      for (int index = 0; index < resolveLength(configs); index++) {
        JsValue candidate = configs[index];
        JsValue options = candidate["config"]["options"];
        JsValue baseValue = options["pathsBasePath"];
        if (!baseValue.truthy()) {
          baseValue = JS.invoke(
            resolvePath,
            "dirname",
            options["configFilePath"]
          );
        }
        string base = normalizePath(JS.string(baseValue));
        JsValue raw = candidate["config"]["raw"];
        JsValue included = JS.undefined();
        JsValue excluded = JS.undefined();
        if (!JS.isNullish(raw)) {
          included = raw["include"];
          excluded = raw["exclude"];
        }
        bool includedMatch = false;
        if (JS.isNullish(included)) {
          includedMatch = base == "" || containingFile.startsWith(base);
        } else {
          for (int includeIndex = 0;
            includeIndex < resolveLength(included);
            includeIndex++) {
            string pattern = configPattern(
              base,
              JS.string(included[includeIndex]),
              major,
              minor,
              JS.string(configPath)
            );
            if (JS.call(
              resolveIsMatch,
              JS.undefined(),
              containingFile,
              pattern
            ).truthy()) {
              includedMatch = true;
              break;
            }
          }
        }
        if (!includedMatch) continue;

        bool excludedMatch = false;
        if (!JS.isNullish(excluded)) {
          for (int excludeIndex = 0;
            excludeIndex < resolveLength(excluded);
            excludeIndex++) {
            string pattern = configPattern(
              base,
              JS.string(excluded[excludeIndex]),
              major,
              minor,
              JS.string(configPath)
            );
            if (JS.call(
              resolveIsMatch,
              JS.undefined(),
              containingFile,
              pattern
            ).truthy()) {
              excludedMatch = true;
              break;
            }
          }
        }
        if (excludedMatch) continue;
        matchedConfig = candidate;
        break;
      }
      if (!matchedConfig.truthy()) matchedConfig = configs[resolveLength(configs) - 1];
    }
    compilerOptions = matchedConfig["config"]["options"];
    resolutionCache = matchedConfig["cache"];
    if (!resolutionCache.truthy()) {
      resolutionCache = JS.invoke(
        typescript,
        "createModuleResolutionCache",
        JS.invoke(resolveProcess, "cwd"),
        createGetCanonicalFileName(
          typescript["sys"]["useCaseSensitiveFileNames"].truthy()
        ),
        compilerOptions
      );
      matchedConfig["cache"] = resolutionCache;
    }
