  JS.invoke(visited, "add", configPath);
  JsValue references = config["projectReferences"];
  if (!JS.isNullish(references)) {
    for (int index = 0; index < resolveLength(references); index++) {
      string refPath = JS.string(JS.invoke(
        typescript,
        "resolveProjectReferencePath",
        references[index]
