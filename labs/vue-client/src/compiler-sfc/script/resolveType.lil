    compilerOptions = JS.object();
  }

  JsValue result = JS.invoke(
    typescript,
    "resolveModuleName",
    source,
    containingFile,
    compilerOptions,
    fs,
    resolutionCache
  );
  if (result["resolvedModule"].truthy()) {
    string filename = JS.string(result["resolvedModule"]["resolvedFileName"]);
    if (filename.endsWith(".vue.ts") && !filename.endsWith(".d.vue.ts")) {
      filename = JS.string(JS.invoke(filename, "replace", new Regex("\\.ts$"), ""));
    }
    if (fs["realpath"].truthy()) {
      return JS.call(fs["realpath"], fs, filename);
    }
    return filename;
  }
  return JS.undefined();
}

string configPattern(
  string base,
  string pattern,
  int major,
  int minor,
  string configPath
) {
  bool supportsConfigDir = major > 5 || (major == 5 && minor >= 5);
  if (pattern.startsWith("${configDir}") && supportsConfigDir) {
    string replaced = JS.string(JS.invoke(
      pattern,
      "replace",
      "${configDir}",
      JS.invoke(resolvePath, "dirname", configPath)
