    return normalizePath(replaced);
  }
  return JS.string(JS.call(joinPaths, JS.undefined(), base, pattern));
}

JsValue loadTSConfig(
  string configPath,
  JsValue typescript,
  JsValue fs,
  JsValue visited = JS.undefined()
) {
  if (JS.isUndefined(visited)) visited = createSet();
  JsValue parseConfigHost = typescript["sys"];
  if (typeResolveTestBuild) {
    parseConfigHost = assignObjects(
      JS.object(),
      fs,
      JS.object(
        "useCaseSensitiveFileNames", true,
        "readDirectory", JS.method0((JsValue _self) => JS.array())
