  if (canCache) node["_resolvedReference"] = resolved;
  return resolved;
}

JsValue innerResolveTypeReference(
  JsValue ctx,
  JsValue scope,
  JsValue name,
  JsValue node,
  bool onlyExported
) {
  if (JS.typeOf(name) == "string") {
    string stringName = JS.string(name);
    if (scope["imports"][stringName].truthy()) {
      return resolveTypeFromImport(ctx, node, stringName, scope);
    }
    JsValue lookupSource = JS.undefined();
    if (JS.string(node["type"]) == "TSTypeQuery") {
      if (onlyExported) lookupSource = scope["exportedDeclares"];
      else lookupSource = scope["declares"];
    } else {
      if (onlyExported) lookupSource = scope["exportedTypes"];
      else lookupSource = scope["types"];
    }
    if (lookupSource[stringName].truthy()) return lookupSource[stringName];
    JsValue globalScopes = resolveGlobalScope(ctx);
    if (!JS.isNullish(globalScopes)) {
      for (int index = 0; index < resolveLength(globalScopes); index++) {
        JsValue globalScope = globalScopes[index];
        JsValue source = globalScope["types"];
        if (JS.string(node["type"]) == "TSTypeQuery") {
          source = globalScope["declares"];
        }
        if (source[stringName].truthy()) {
          if (JS.isNullish(ctx["deps"])) ctx["deps"] = createSet();
          JS.invoke(ctx["deps"], "add", globalScope["filename"]);
          JsValue resolved = source[stringName];
          if (resolved["_ownerScope"].truthy() &&
            !JS.strictEqual(resolved["_ownerScope"], globalScope)) {
            JS.invoke(
              ctx["deps"],
              "add",
              resolved["_ownerScope"]["filename"]
            );
          }
          return resolved;
        }
      }
    }
    return JS.undefined();
  }

  JsValue namespace = innerResolveTypeReference(
    ctx,
    scope,
    name[0],
    node,
    onlyExported
  );
  if (namespace.truthy()) {
    if (JS.string(namespace["type"]) != "TSModuleDeclaration") {
      namespace = namespace["_ns"];
    }
    if (namespace.truthy()) {
      JsValue parentScope = namespace["_ownerScope"];
      if (!parentScope.truthy()) parentScope = scope;
      JsValue childScope = moduleDeclToScope(ctx, namespace, parentScope);
      JsValue nextName = JS.undefined();
      if (resolveLength(name) > 2) nextName = JS.invoke(name, "slice", 1);
      else nextName = name[resolveLength(name) - 1];
      return innerResolveTypeReference(
        ctx,
        childScope,
        nextName,
        node,
        !namespace["declare"].truthy()
