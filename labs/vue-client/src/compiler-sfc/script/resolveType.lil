export JsValue fileToScope(
  JsValue ctx,
  string filename,
  bool asGlobal = false
) {
  JsValue cache = fileToScopeCache;
  if (asGlobal) cache = fileToGlobalScopeCache;
  JsValue cached = JS.invoke(cache, "get", filename);
  if (cached.truthy()) return cached;
  JsValue fs = resolveFS(ctx);
  JsValue sourceValue = JS.call(fs["readFile"], fs, filename);
  string source = "";
  if (sourceValue.truthy()) source = JS.string(sourceValue);
  JsValue body = parseFile(
    filename,
    source,
    fs,
    ctx["options"]["babelParserPlugins"]
  );
  TypeScope scopeValue = new TypeScope(filename, source, 0, recordImports(body));
  JsValue scope = scopeValue;
  recordTypes(ctx, body, scope, asGlobal);
  JS.invoke(cache, "set", filename, scope);
  return scope;
}

JsValue parseFile(
  string filename,
  string content,
  JsValue fs,
  JsValue parserPlugins = JS.undefined()
) {
  string extension = JS.string(JS.invoke(resolvePath, "extname", filename));
  if (extension == ".ts" || extension == ".mts" || extension == ".tsx" ||
    extension == ".cts" || extension == ".mtsx") {
    bool declaration = new Regex("\\.d\\.[cm]?ts$").test(filename);
    JsValue parsed = JS.call(
      resolveBabelParse,
      JS.undefined(),
      content,
      JS.object(
        "plugins", resolveParserPlugins(
          extension.slice(1),
          parserPlugins,
          declaration
        ),
        "sourceType", "module"
      )
    );
    return parsed["program"]["body"];
  }

  bool unknownTypeSource = !new Regex("\\.[cm]?[tj]sx?$").test(filename);
  string arbitraryTypeSource = filename.slice(0, -extension.length) +
    ".d" + extension + ".ts";
  bool hasArbitraryTypeDeclaration = unknownTypeSource &&
    JS.call(fs["fileExists"], fs, arbitraryTypeSource).truthy();
  if (hasArbitraryTypeDeclaration) {
    JsValue parsed = JS.call(
      resolveBabelParse,
      JS.undefined(),
      JS.call(fs["readFile"], fs, arbitraryTypeSource),
      JS.object(
        "plugins", resolveParserPlugins("ts", parserPlugins, true),
        "sourceType", "module"
      )
    );
    return parsed["program"]["body"];
  }

  if (extension == ".vue") {
    JsValue descriptor = parseSFC(content)["descriptor"];
    JsValue script = descriptor["script"];
    JsValue scriptSetup = descriptor["scriptSetup"];
    if (!script.truthy() && !scriptSetup.truthy()) return JS.array();

    JsValue firstBlock = JS.undefined();
    JsValue secondBlock = JS.undefined();
    bool scriptFirst = script.truthy() && !scriptSetup.truthy();
    if (script.truthy() && scriptSetup.truthy()) {
      scriptFirst = JS.number(script["loc"]["start"]["offset"]) <
        JS.number(scriptSetup["loc"]["start"]["offset"]);
    }
    if (scriptFirst) {
      firstBlock = script;
      secondBlock = scriptSetup;
    } else {
      firstBlock = scriptSetup;
      secondBlock = script;
    }
    int firstOffset = JS.number(firstBlock["loc"]["start"]["offset"]).toInt();
    string scriptContent = " ".repeat(firstOffset) +
      JS.string(firstBlock["content"]);
    if (secondBlock.truthy()) {
      int gap = JS.number(secondBlock["loc"]["start"]["offset"]).toInt() -
        JS.number(script["loc"]["end"]["offset"]).toInt();
      scriptContent += " ".repeat(gap) + JS.string(secondBlock["content"]);
    }
    JsValue language = JS.undefined();
    if (script.truthy()) language = script["lang"];
    if (!language.truthy() && scriptSetup.truthy()) language = scriptSetup["lang"];
    JsValue parsed = JS.call(
      resolveBabelParse,
      JS.undefined(),
      scriptContent,
      JS.object(
        "plugins", resolveParserPlugins(
          JS.string(language),
          parserPlugins
        ),
        "sourceType", "module"
      )
    );
    return parsed["program"]["body"];
  }
  return JS.array();
}

JsValue ctxToScope(JsValue ctx) {
  if (ctx["scope"].truthy()) return ctx["scope"];
  JsValue body = JS.undefined();
  if (JS.call(hostHasProperty, JS.undefined(), ctx, "ast").truthy()) {
    body = ctx["ast"];
  } else if (ctx["scriptAst"].truthy()) {
    body = JS.array();
    JsValue scriptBody = ctx["scriptAst"]["body"];
    JsValue setupBody = ctx["scriptSetupAst"]["body"];
    for (int index = 0; index < resolveLength(scriptBody); index++) {
      resolvePush(body, scriptBody[index]);
    }
    for (int index = 0; index < resolveLength(setupBody); index++) {
      resolvePush(body, setupBody[index]);
    }
  } else {
    body = ctx["scriptSetupAst"]["body"];
  }
  int offset = 0;
  if (JS.call(hostHasProperty, JS.undefined(), ctx, "startOffset").truthy() &&
    !JS.isNullish(ctx["startOffset"])) {
    offset = JS.number(ctx["startOffset"]).toInt();
  }
  JsValue imports = JS.undefined();
  if (JS.call(hostHasProperty, JS.undefined(), ctx, "userImports").truthy()) {
    imports = JS.call(hostCreateObject, JS.undefined(), ctx["userImports"]);
  } else {
    imports = recordImports(body);
  }
  TypeScope scopeValue = new TypeScope(
    JS.string(ctx["filename"]),
    JS.string(ctx["source"]),
    offset,
    imports
  );
  JsValue scope = scopeValue;
  recordTypes(ctx, body, scope);
  ctx["scope"] = scope;
  return scope;
}

JsValue moduleDeclToScope(
  JsValue ctx,
  JsValue node,
  JsValue parentScope
) {
  if (node["_resolvedChildScope"].truthy()) return node["_resolvedChildScope"];
  JsValue scope = createChildScope(parentScope);
  if (JS.string(node["body"]["type"]) == "TSModuleDeclaration") {
    JsValue declaration = node["body"];
    declaration["_ownerScope"] = scope;
    string id = JS.string(getId(declaration["id"]));
    scope["types"][id] = declaration;
    scope["exportedTypes"][id] = declaration;
  } else {
    recordTypes(ctx, node["body"]["body"], scope);
  }
  node["_resolvedChildScope"] = scope;
  return scope;
}

JsValue createChildScope(JsValue parentScope) {
  TypeScope scope = new TypeScope(
    JS.string(parentScope["filename"]),
    JS.string(parentScope["source"]),
    JS.number(parentScope["offset"]).toInt(),
    JS.call(hostCreateObject, JS.undefined(), parentScope["imports"]),
    JS.call(hostCreateObject, JS.undefined(), parentScope["types"]),
    JS.call(hostCreateObject, JS.undefined(), parentScope["declares"])
  );
  return scope;
}

Regex importExportRE = new Regex("^Import|^Export");

void recordTypes(
  JsValue ctx,
  JsValue body,
  JsValue scope,
  bool asGlobal = false
) {
  JsValue types = scope["types"];
  JsValue declares = scope["declares"];
  JsValue exportedTypes = scope["exportedTypes"];
  JsValue exportedDeclares = scope["exportedDeclares"];
  JsValue imports = scope["imports"];
  bool isAmbient = false;
  if (asGlobal) {
    isAmbient = true;
    for (int index = 0; index < resolveLength(body); index++) {
      if (importExportRE.test(JS.string(body[index]["type"]))) {
        isAmbient = false;
        break;
      }
    }
  }

  for (int index = 0; index < resolveLength(body); index++) {
    JsValue statement = body[index];
    if (asGlobal) {
      if (isAmbient) {
        if (statement["declare"].truthy()) recordType(statement, types, declares);
      } else if (JS.string(statement["type"]) == "TSModuleDeclaration" &&
        statement["global"].truthy()) {
        JsValue statements = statement["body"]["body"];
        for (int childIndex = 0;
          childIndex < resolveLength(statements);
          childIndex++) {
          JsValue child = statements[childIndex];
          string childType = JS.string(child["type"]);
          if (childType == "ExportNamedDeclaration") {
            if (child["declaration"].truthy()) {
              recordType(child["declaration"], types, declares);
            } else if (child["source"].truthy()) {
              JsValue sourceScope = importSourceToScope(
                ctx,
                child["source"],
                scope,
                JS.string(child["source"]["value"]),
                false
              );
              JsValue specifiers = child["specifiers"];
              for (int specIndex = 0;
                specIndex < resolveLength(specifiers);
                specIndex++) {
                JsValue specifier = specifiers[specIndex];
                if (JS.string(specifier["type"]) == "ExportSpecifier") {
                  string exported = JS.string(getId(specifier["exported"]));
                  string local = JS.string(specifier["local"]["name"]);
                  if (sourceScope["exportedTypes"][local].truthy()) {
                    types[exported] = sourceScope["exportedTypes"][local];
                  }
                  if (sourceScope["exportedDeclares"][local].truthy()) {
                    declares[exported] = sourceScope["exportedDeclares"][local];
                  }
                }
              }
            }
          } else if (childType == "ExportAllDeclaration" &&
            child["source"].truthy()) {
            JsValue sourceScope = importSourceToScope(
              ctx,
              child["source"],
              scope,
              JS.string(child["source"]["value"]),
              false
            );
            assignObjects(types, sourceScope["exportedTypes"]);
            assignObjects(declares, sourceScope["exportedDeclares"]);
          } else {
            recordType(child, types, declares);
          }
        }
      }
    } else {
      recordType(statement, types, declares);
    }
  }

  if (!asGlobal) {
    for (int index = 0; index < resolveLength(body); index++) {
      JsValue statement = body[index];
      string type = JS.string(statement["type"]);
      if (type == "ExportNamedDeclaration") {
        if (statement["declaration"].truthy()) {
          recordType(statement["declaration"], types, declares);
          recordType(
            statement["declaration"],
            exportedTypes,
            exportedDeclares
          );
        } else {
          JsValue specifiers = statement["specifiers"];
          for (int specIndex = 0;
            specIndex < resolveLength(specifiers);
            specIndex++) {
            JsValue specifier = specifiers[specIndex];
            if (JS.string(specifier["type"]) != "ExportSpecifier") continue;
            string local = JS.string(specifier["local"]["name"]);
            string exported = JS.string(getId(specifier["exported"]));
            if (statement["source"].truthy()) {
              imports[exported] = JS.object(
                "source", statement["source"]["value"],
                "imported", local
              );
              exportedTypes[exported] = JS.object(
                "type", "TSTypeReference",
                "typeName", JS.object("type", "Identifier", "name", local),
                "_ownerScope", scope
              );
            } else if (types[local].truthy()) {
              exportedTypes[exported] = types[local];
            }
          }
        }
      } else if (type == "ExportAllDeclaration") {
        JsValue sourceScope = importSourceToScope(
          ctx,
          statement["source"],
          scope,
          JS.string(statement["source"]["value"])
        );
        assignObjects(exportedTypes, sourceScope["exportedTypes"]);
      } else if (type == "ExportDefaultDeclaration" &&
        statement["declaration"].truthy()) {
        JsValue declaration = statement["declaration"];
        if (JS.string(declaration["type"]) != "Identifier") {
          recordType(declaration, types, declares, "default");
          recordType(
            declaration,
            exportedTypes,
            exportedDeclares,
            "default"
          );
        } else if (types[JS.string(declaration["name"])].truthy()) {
          exportedTypes["default"] = types[JS.string(declaration["name"])];
        }
      }
    }
  }

  JsValue typeKeys = JS.call(hostKeys, JS.undefined(), types);
  for (int index = 0; index < resolveLength(typeKeys); index++) {
    string key = JS.string(typeKeys[index]);
    JsValue node = types[key];
    if (!node["_ownerScope"].truthy()) node["_ownerScope"] = scope;
    if (node["_ns"].truthy() && !node["_ns"]["_ownerScope"].truthy()) {
      node["_ns"]["_ownerScope"] = scope;
    }
  }
  JsValue declareKeys = JS.call(hostKeys, JS.undefined(), declares);
  for (int index = 0; index < resolveLength(declareKeys); index++) {
    string key = JS.string(declareKeys[index]);
    if (!declares[key]["_ownerScope"].truthy()) {
      declares[key]["_ownerScope"] = scope;
    }
  }
}

void recordType(
  JsValue node,
  JsValue types,
  JsValue declares,
  JsValue overwriteId = JS.undefined()
) {
  string type = JS.string(node["type"]);
  if (type == "TSInterfaceDeclaration" || type == "TSEnumDeclaration" ||
    type == "TSModuleDeclaration") {
    if (type == "TSModuleDeclaration" && node["global"].truthy()) {
      JsValue statements = node["body"]["body"];
      for (int index = 0; index < resolveLength(statements); index++) {
        JsValue statement = statements[index];
        if (JS.string(statement["type"]) == "ExportNamedDeclaration" &&
          statement["declaration"].truthy()) {
          recordType(statement["declaration"], types, declares);
        } else {
          recordType(statement, types, declares);
        }
      }
      return;
    }
    string id = JS.string(getId(node["id"]));
    if (overwriteId.truthy()) id = JS.string(overwriteId);
    JsValue existing = types[id];
    if (existing.truthy()) {
      if (type == "TSModuleDeclaration") {
        if (JS.string(existing["type"]) == "TSModuleDeclaration") {
          mergeNamespaces(existing, node);
        } else {
          attachNamespace(existing, node);
        }
        return;
      }
      if (JS.string(existing["type"]) == "TSModuleDeclaration") {
        types[id] = node;
        attachNamespace(node, existing);
        return;
      }
      if (JS.string(existing["type"]) != type) return;
      if (type == "TSInterfaceDeclaration") {
        appendArray(existing["body"]["body"], node["body"]["body"]);
      } else {
        appendArray(existing["members"], node["members"]);
      }
    } else {
      types[id] = node;
    }
    return;
  }
  if (type == "ClassDeclaration") {
    if (overwriteId.truthy() || node["id"].truthy()) {
      string id = JS.string(getId(node["id"]));
      if (overwriteId.truthy()) id = JS.string(overwriteId);
      types[id] = node;
    }
    return;
  }
  if (type == "TSTypeAliasDeclaration") {
    string name = JS.string(node["id"]["name"]);
    types[name] = node["typeAnnotation"];
    if (node["typeParameters"].truthy()) types[name] = node;
    return;
  }
  if (type == "TSDeclareFunction") {
    if (node["id"].truthy()) {
      declares[JS.string(node["id"]["name"])] = node;
    }
    return;
  }
  if (type == "VariableDeclaration" && node["declare"].truthy()) {
    JsValue declarations = node["declarations"];
    for (int index = 0; index < resolveLength(declarations); index++) {
      JsValue declaration = declarations[index];
      if (JS.string(declaration["id"]["type"]) == "Identifier" &&
        declaration["id"]["typeAnnotation"].truthy()) {
        declares[JS.string(declaration["id"]["name"])] =
          declaration["id"]["typeAnnotation"]["typeAnnotation"];
      }
    }
  }
}

void appendArray(JsValue target, JsValue source) {
  for (int index = 0; index < resolveLength(source); index++) {
    resolvePush(target, source[index]);
  }
}

void mergeNamespaces(JsValue target, JsValue source) {
  JsValue targetBody = target["body"];
  JsValue sourceBody = source["body"];
  bool targetDeclaration = JS.string(targetBody["type"]) == "TSModuleDeclaration";
  bool sourceDeclaration = JS.string(sourceBody["type"]) == "TSModuleDeclaration";
  if (targetDeclaration) {
    if (sourceDeclaration) {
      mergeNamespaces(targetBody, sourceBody);
    } else {
      resolvePush(
        sourceBody["body"],
        JS.object(
          "type", "ExportNamedDeclaration",
          "declaration", targetBody,
          "exportKind", "type",
          "specifiers", JS.array()
        )
      );
    }
  } else if (sourceDeclaration) {
    resolvePush(
      targetBody["body"],
      JS.object(
        "type", "ExportNamedDeclaration",
        "declaration", sourceBody,
        "exportKind", "type",
        "specifiers", JS.array()
      )
    );
  } else {
    appendArray(targetBody["body"], sourceBody["body"]);
  }
}

void attachNamespace(JsValue target, JsValue namespace) {
  if (!target["_ns"].truthy()) target["_ns"] = namespace;
  else mergeNamespaces(target["_ns"], namespace);
}

export JsValue recordImports(JsValue body) {
  JsValue imports = nullObject();
  for (int index = 0; index < resolveLength(body); index++) {
    recordImport(body[index], imports);
  }
  return imports;
}

void recordImport(JsValue node, JsValue imports) {
  if (JS.string(node["type"]) != "ImportDeclaration") return;
  JsValue specifiers = node["specifiers"];
  for (int index = 0; index < resolveLength(specifiers); index++) {
    JsValue specifier = specifiers[index];
    imports[JS.string(specifier["local"]["name"])] = JS.object(
      "imported", getImportedName(specifier),
      "source", node["source"]["value"]
    );
  }
}

export JsValue inferRuntimeType(
  JsValue ctx,
  JsValue node,
  JsValue scope = null,
  bool isKeyOf = false,
  JsValue typeParameters = JS.undefined()
) {
  if (hasVueIgnore(node)) return JS.array(UNKNOWN_TYPE);
  if (!scope.truthy()) {
    scope = node["_ownerScope"];
    if (!scope.truthy()) scope = ctxToScope(ctx);
  }

  JsValue previousSilent = ctx["silentOnExtendsFailure"];
  ctx["silentOnExtendsFailure"] = true;
  try {
    string type = JS.string(node["type"]);
    if (type == "TSStringKeyword") return JS.array("String");
    if (type == "TSNumberKeyword") return JS.array("Number");
    if (type == "TSBooleanKeyword") return JS.array("Boolean");
    if (type == "TSObjectKeyword") return JS.array("Object");
    if (type == "TSNullKeyword") return JS.array("null");

    if (type == "TSTypeLiteral" || type == "TSInterfaceDeclaration") {
      JsValue types = createSet();
      JsValue members = node["members"];
      if (type == "TSInterfaceDeclaration") members = node["body"]["body"];
      for (int index = 0; index < resolveLength(members); index++) {
        JsValue member = members[index];
        string memberType = JS.string(member["type"]);
        if (isKeyOf) {
          if (memberType == "TSPropertySignature" &&
            JS.string(member["key"]["type"]) == "NumericLiteral") {
            JS.invoke(types, "add", "Number");
          } else if (memberType == "TSIndexSignature") {
            JsValue annotation = member["parameters"][0]["typeAnnotation"];
            if (annotation.truthy() && JS.string(annotation["type"]) != "Noop") {
              JsValue inferred = inferRuntimeType(
                ctx,
                annotation["typeAnnotation"],
                scope
              );
              string inferredType = JS.string(inferred[0]);
              if (inferredType == UNKNOWN_TYPE) return JS.array(UNKNOWN_TYPE);
              JS.invoke(types, "add", inferredType);
            }
          } else {
            JS.invoke(types, "add", "String");
          }
        } else if (memberType == "TSCallSignatureDeclaration" ||
          memberType == "TSConstructSignatureDeclaration") {
          JS.invoke(types, "add", "Function");
        } else {
          JS.invoke(types, "add", "Object");
        }
      }
      if (JS.number(types["size"]).toInt() > 0) return arrayFrom(types);
      if (isKeyOf) return JS.array(UNKNOWN_TYPE);
      return JS.array("Object");
    }

    if (type == "TSPropertySignature") {
      if (node["typeAnnotation"].truthy()) {
        return inferRuntimeType(
          ctx,
          node["typeAnnotation"]["typeAnnotation"],
          scope
        );
      }
    } else if (type == "TSMethodSignature" || type == "TSFunctionType") {
      return JS.array("Function");
    } else if (type == "TSArrayType" || type == "TSTupleType") {
      return JS.array("Array");
    } else if (type == "TSLiteralType") {
      string literalType = JS.string(node["literal"]["type"]);
      if (literalType == "StringLiteral") return JS.array("String");
      if (literalType == "BooleanLiteral") return JS.array("Boolean");
      if (literalType == "NumericLiteral" || literalType == "BigIntLiteral") {
        return JS.array("Number");
      }
      return JS.array(UNKNOWN_TYPE);
    } else if (type == "TSTypeReference") {
      JsValue resolved = JS.undefined();
      try {
        resolved = resolveTypeReference(ctx, node, scope);
      } catch (JsValue _error) {}
      if (resolved.truthy()) {
        if (JS.string(resolved["type"]) == "TSTypeAliasDeclaration") {
          if (JS.string(resolved["typeAnnotation"]["type"]) == "TSFunctionType") {
            return JS.array("Function");
          }
          if (node["typeParameters"].truthy()) {
            JsValue typeParams = nullObject();
            if (resolved["typeParameters"].truthy()) {
              JsValue params = resolved["typeParameters"]["params"];
              for (int index = 0; index < resolveLength(params); index++) {
                typeParams[JS.string(params[index]["name"])] =
                  node["typeParameters"]["params"][index];
              }
            }
            return inferRuntimeType(
              ctx,
              resolved["typeAnnotation"],
              resolved["_ownerScope"],
              isKeyOf,
              typeParams
            );
          }
        }
        return inferRuntimeType(
          ctx,
          resolved,
          resolved["_ownerScope"],
          isKeyOf
        );
      }

      if (JS.string(node["typeName"]["type"]) == "Identifier") {
        string name = JS.string(node["typeName"]["name"]);
        if (!JS.isUndefined(typeParameters) && typeParameters[name].truthy()) {
          return inferRuntimeType(
            ctx,
            typeParameters[name],
            scope,
            isKeyOf,
            typeParameters
          );
        }
        if (isKeyOf) {
          JsValue keyResult = inferKeyOfReference(
            ctx,
            node,
            scope,
            name
          );
          if (!JS.isUndefined(keyResult)) return keyResult;
        } else {
          JsValue referenceResult = inferReferenceBuiltin(
            ctx,
            node,
            scope,
            name,
            typeParameters
          );
          if (!JS.isUndefined(referenceResult)) return referenceResult;
        }
      }
    } else if (type == "TSParenthesizedType") {
      return inferRuntimeType(ctx, node["typeAnnotation"], scope);
    } else if (type == "TSUnionType") {
      return flattenTypes(ctx, node["types"], scope, isKeyOf, typeParameters);
    } else if (type == "TSIntersectionType") {
      return JS.invoke(
        flattenTypes(ctx, node["types"], scope, isKeyOf, typeParameters),
        "filter",
        JS.method1((JsValue _self, JsValue inferred) =>
          !JS.strictEqual(inferred, UNKNOWN_TYPE))
      );
    } else if (type == "TSMappedType") {
      JsValue typeAnnotation = node["typeAnnotation"];
      JsValue typeParameter = node["typeParameter"];
      if (typeAnnotation.truthy() &&
        JS.string(typeAnnotation["type"]) == "TSIndexedAccessType" &&
        typeParameter.truthy() && typeParameter["constraint"].truthy() &&
        !JS.isUndefined(typeParameters)) {
        JsValue constraint = typeParameter["constraint"];
        if (JS.string(constraint["type"]) == "TSTypeOperator" &&
          JS.string(constraint["operator"]) == "keyof" &&
          constraint["typeAnnotation"].truthy() &&
          JS.string(constraint["typeAnnotation"]["type"]) == "TSTypeReference" &&
          JS.string(constraint["typeAnnotation"]["typeName"]["type"]) ==
            "Identifier") {
          string typeName = JS.string(
            constraint["typeAnnotation"]["typeName"]["name"]
          );
          JsValue indexType = typeAnnotation["indexType"];
          JsValue objectType = typeAnnotation["objectType"];
          if (objectType.truthy() &&
            JS.string(objectType["type"]) == "TSTypeReference" &&
            JS.string(objectType["typeName"]["type"]) == "Identifier" &&
            JS.string(objectType["typeName"]["name"]) == typeName &&
            indexType.truthy() &&
            JS.string(indexType["type"]) == "TSTypeReference" &&
            JS.string(indexType["typeName"]["type"]) == "Identifier" &&
            JS.string(indexType["typeName"]["name"]) ==
              JS.string(typeParameter["name"])) {
            JsValue targetType = typeParameters[typeName];
            if (targetType.truthy()) return inferRuntimeType(ctx, targetType, scope);
          }
        }
      }
      return JS.array(UNKNOWN_TYPE);
    } else if (type == "TSEnumDeclaration") {
      return inferEnumType(node);
    } else if (type == "TSSymbolKeyword") {
      return JS.array("Symbol");
    } else if (type == "TSIndexedAccessType") {
      return flattenTypes(
        ctx,
        resolveIndexType(ctx, node, scope),
        scope,
        isKeyOf
      );
    } else if (type == "ClassDeclaration") {
      return JS.array("Object");
    } else if (type == "TSImportType") {
      JsValue sourceScope = importSourceToScope(
        ctx,
        node["argument"],
        scope,
        JS.string(node["argument"]["value"])
      );
      JsValue resolved = resolveTypeReference(ctx, node, sourceScope);
      if (resolved.truthy()) {
        return inferRuntimeType(ctx, resolved, resolved["_ownerScope"]);
      }
    } else if (type == "TSTypeQuery") {
      JsValue id = node["exprName"];
      if (JS.string(id["type"]) == "Identifier") {
        JsValue matched = scope["declares"][JS.string(id["name"])];
        if (matched.truthy()) {
          return inferRuntimeType(
            ctx,
            matched,
            matched["_ownerScope"],
            isKeyOf
          );
        }
      }
    } else if (type == "TSTypeOperator") {
      return inferRuntimeType(
        ctx,
        node["typeAnnotation"],
        scope,
        JS.string(node["operator"]) == "keyof"
      );
    } else if (type == "TSAnyKeyword" && isKeyOf) {
      return JS.array("String", "Number", "Symbol");
    }
  } catch (JsValue _error) {
  } finally {
    ctx["silentOnExtendsFailure"] = previousSilent;
  }
  return JS.array(UNKNOWN_TYPE);
}

JsValue inferKeyOfReference(
  JsValue ctx,
  JsValue node,
  JsValue scope,
  string name
) {
  if (name == "String" || name == "Array" || name == "ArrayLike" ||
    name == "Parameters" || name == "ConstructorParameters" ||
    name == "ReadonlyArray") {
    return JS.array("String", "Number");
  }
  if (name == "Record" || name == "Partial" || name == "Required" ||
    name == "Readonly") {
    if (node["typeParameters"].truthy() &&
      node["typeParameters"]["params"][0].truthy()) {
      return inferRuntimeType(
        ctx,
        node["typeParameters"]["params"][0],
        scope,
        true
      );
    }
    return JS.undefined();
  }
  if (name == "Pick" || name == "Extract") {
    if (node["typeParameters"].truthy() &&
      node["typeParameters"]["params"][1].truthy()) {
      return inferRuntimeType(
        ctx,
        node["typeParameters"]["params"][1],
        scope
      );
    }
    return JS.undefined();
  }
  if (name == "Function" || name == "Object" || name == "Set" ||
    name == "Map" || name == "WeakSet" || name == "WeakMap" ||
    name == "Date" || name == "Promise" || name == "Error" ||
    name == "Uppercase" || name == "Lowercase" || name == "Capitalize" ||
    name == "Uncapitalize" || name == "ReadonlyMap" ||
    name == "ReadonlySet") {
    return JS.array("String");
  }
  return JS.undefined();
}

JsValue inferReferenceBuiltin(
  JsValue ctx,
  JsValue node,
  JsValue scope,
  string name,
  JsValue typeParameters
) {
  if (name == "Array" || name == "Function" || name == "Object" ||
    name == "Set" || name == "Map" || name == "WeakSet" ||
    name == "WeakMap" || name == "Date" || name == "Promise" ||
    name == "Error") {
    return JS.array(name);
  }
  if (name == "Partial" || name == "Required" || name == "Readonly" ||
    name == "Record" || name == "Pick" || name == "Omit" ||
    name == "InstanceType") {
    return JS.array("Object");
  }
  if (name == "Uppercase" || name == "Lowercase" || name == "Capitalize" ||
    name == "Uncapitalize") {
    return JS.array("String");
  }
  if (name == "Parameters" || name == "ConstructorParameters" ||
    name == "ReadonlyArray") {
    return JS.array("Array");
  }
  if (name == "ReadonlyMap") return JS.array("Map");
  if (name == "ReadonlySet") return JS.array("Set");
  if (name == "Ref" || name == "ShallowRef" || name == "ComputedRef" ||
    name == "WritableComputedRef") {
    return JS.array("Object");
  }
  if (name == "MaybeRef" || name == "MaybeRefOrGetter") {
    JsValue types = createSet(JS.array("Object"));
    if (name == "MaybeRefOrGetter") JS.invoke(types, "add", "Function");
    if (node["typeParameters"].truthy() &&
      node["typeParameters"]["params"][0].truthy()) {
      JsValue inferred = inferRuntimeType(
        ctx,
        node["typeParameters"]["params"][0],
        scope,
        false,
        typeParameters
      );
      for (int index = 0; index < resolveLength(inferred); index++) {
        JS.invoke(types, "add", inferred[index]);
      }
    }
    return arrayFrom(types);
  }
  if (name == "NonNullable") {
    if (node["typeParameters"].truthy() &&
      node["typeParameters"]["params"][0].truthy()) {
      JsValue inferred = inferRuntimeType(
        ctx,
        node["typeParameters"]["params"][0],
        scope
      );
      JsValue result = JS.array();
      for (int index = 0; index < resolveLength(inferred); index++) {
        if (JS.string(inferred[index]) != "null") resolvePush(result, inferred[index]);
      }
      return result;
    }
    return JS.undefined();
  }
  if (name == "Extract") {
    if (node["typeParameters"].truthy() &&
      node["typeParameters"]["params"][1].truthy()) {
      return inferRuntimeType(
        ctx,
        node["typeParameters"]["params"][1],
        scope
      );
    }
    return JS.undefined();
  }
  if (name == "Exclude" || name == "OmitThisParameter") {
    if (node["typeParameters"].truthy() &&
      node["typeParameters"]["params"][0].truthy()) {
      return inferRuntimeType(
        ctx,
        node["typeParameters"]["params"][0],
        scope
      );
    }
  }
  return JS.undefined();
}

JsValue flattenTypes(
  JsValue ctx,
  JsValue types,
  JsValue scope,
  bool isKeyOf = false,
  JsValue typeParameters = JS.undefined()
) {
  if (resolveLength(types) == 1) {
    JsValue selectedScope = types[0]["_ownerScope"];
    if (!selectedScope.truthy()) selectedScope = scope;
    return inferRuntimeType(
      ctx,
      types[0],
      selectedScope,
      isKeyOf,
      typeParameters
    );
  }
  JsValue unique = createSet();
  for (int index = 0; index < resolveLength(types); index++) {
    JsValue selectedScope = types[index]["_ownerScope"];
    if (!selectedScope.truthy()) selectedScope = scope;
    JsValue inferred = inferRuntimeType(
      ctx,
      types[index],
      selectedScope,
      isKeyOf,
      typeParameters
    );
    for (int inferredIndex = 0;
      inferredIndex < resolveLength(inferred);
      inferredIndex++) {
      JS.invoke(unique, "add", inferred[inferredIndex]);
    }
  }
  return arrayFrom(unique);
}

JsValue inferEnumType(JsValue node) {
  JsValue types = createSet();
  JsValue members = node["members"];
  for (int index = 0; index < resolveLength(members); index++) {
    JsValue initializer = members[index]["initializer"];
    if (!initializer.truthy()) continue;
    string type = JS.string(initializer["type"]);
    if (type == "StringLiteral") JS.invoke(types, "add", "String");
    else if (type == "NumericLiteral") JS.invoke(types, "add", "Number");
  }
  if (JS.number(types["size"]).toInt() > 0) return arrayFrom(types);
  return JS.array("Number");
}

JsValue resolveExtractPropTypes(JsValue elements, JsValue scope) {
  JsValue result = JS.object("props", JS.object());
  JsValue props = elements["props"];
  for (string key in props) {
    JsValue raw = props[key];
    result["props"][key] = reverseInferType(
      raw["key"],
      raw["typeAnnotation"]["typeAnnotation"],
      scope
    );
  }
  return result;
}

JsValue reverseInferType(
  JsValue key,
  JsValue node,
  JsValue scope,
  bool optional = true,
  bool checkObjectSyntax = true
) {
  string type = JS.string(node["type"]);
  if (checkObjectSyntax && type == "TSTypeLiteral") {
    JsValue typeType = findStaticPropertyType(node, "type");
    if (typeType.truthy()) {
      JsValue requiredType = findStaticPropertyType(node, "required");
      bool inferredOptional = true;
      if (requiredType.truthy() &&
        JS.string(requiredType["type"]) == "TSLiteralType" &&
        JS.string(requiredType["literal"]["type"]) == "BooleanLiteral") {
        inferredOptional = !requiredType["literal"]["value"].truthy();
      }
      return reverseInferType(
        key,
        typeType,
        scope,
        inferredOptional,
        false
      );
    }
  } else if (type == "TSTypeReference" &&
    JS.string(node["typeName"]["type"]) == "Identifier") {
    string name = JS.string(node["typeName"]["name"]);
    if (name.endsWith("Constructor")) {
      return createProperty(key, ctorToType(name), scope, optional);
    }
    if (name == "PropType" && node["typeParameters"].truthy()) {
      return createProperty(
        key,
        node["typeParameters"]["params"][0],
        scope,
        optional
      );
    }
  }
  if ((type == "TSTypeReference" || type == "TSImportType") &&
    node["typeParameters"].truthy()) {
    JsValue params = node["typeParameters"]["params"];
    for (int index = 0; index < resolveLength(params); index++) {
      JsValue inferred = reverseInferType(key, params[index], scope, optional);
      if (inferred.truthy()) return inferred;
    }
  }
  return createProperty(
    key,
    JS.object("type", "TSNullKeyword"),
    scope,
    optional
  );
}

JsValue ctorToType(string ctorType) {
  string ctor = ctorType.slice(0, -11);
  if (ctor == "String" || ctor == "Number" || ctor == "Boolean") {
    return JS.object("type", "TS" + ctor + "Keyword");
  }
  if (ctor == "Array" || ctor == "Function" || ctor == "Object" ||
    ctor == "Set" || ctor == "Map" || ctor == "WeakSet" ||
    ctor == "WeakMap" || ctor == "Date" || ctor == "Promise") {
    return JS.object(
      "type", "TSTypeReference",
      "typeName", JS.object("type", "Identifier", "name", ctor)
    );
  }
  return JS.object("type", "TSNullKeyword");
}

JsValue findStaticPropertyType(JsValue node, string key) {
  JsValue members = node["members"];
  for (int index = 0; index < resolveLength(members); index++) {
    JsValue member = members[index];
    if (JS.string(member["type"]) == "TSPropertySignature" &&
      JS.strictEqual(getStringLiteralKey(member), key) &&
      member["typeAnnotation"].truthy()) {
      return member["typeAnnotation"]["typeAnnotation"];
    }
  }
  return JS.undefined();
}

JsValue resolveReturnType(JsValue ctx, JsValue argument, JsValue scope) {
  JsValue resolved = argument;
  string type = JS.string(argument["type"]);
  if (type == "TSTypeReference" || type == "TSTypeQuery" ||
    type == "TSImportType") {
    resolved = resolveTypeReference(ctx, argument, scope);
  }
  if (!resolved.truthy()) return JS.undefined();
  if (JS.string(resolved["type"]) == "TSFunctionType") {
    if (resolved["typeAnnotation"].truthy()) {
      return resolved["typeAnnotation"]["typeAnnotation"];
    }
    return JS.undefined();
  }
  if (JS.string(resolved["type"]) == "TSDeclareFunction") {
    return resolved["returnType"];
  }
  return JS.undefined();
}

export JsValue resolveUnionType(
  JsValue ctx,
  JsValue node,
  JsValue scope = JS.undefined()
) {
  if (JS.string(node["type"]) == "TSTypeReference") {
    JsValue resolved = resolveTypeReference(ctx, node, scope);
    if (resolved.truthy()) node = resolved;
  }
  if (JS.string(node["type"]) != "TSUnionType") return JS.array(node);
  JsValue result = JS.array();
  JsValue types = node["types"];
  for (int index = 0; index < resolveLength(types); index++) {
    JsValue nested = resolveUnionType(ctx, types[index], scope);
    appendArray(result, nested);
  }
  return result;
}
