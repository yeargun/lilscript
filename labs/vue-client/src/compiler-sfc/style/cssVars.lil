import extern { default as cssVarsHash } from "hash-sum";
import extern {
  NodeTypes as CssVarsNodeTypes,
  createRoot as cssVarsCreateRoot,
  createSimpleExpression as cssVarsCreateSimpleExpression,
  createTransformContext as cssVarsCreateTransformContext,
  processExpression as cssVarsProcessExpression
} from "../../../packages/vuelil/compiler-dom.js";
import extern { getEscapedCssVarName as cssVarsEscapeName } from "../../../packages/vuelil/shared.js";

extern JsValue CssVarsNodeTypes;
extern JsValue cssVarsCreateRoot;
extern JsValue cssVarsCreateSimpleExpression;
extern JsValue cssVarsCreateTransformContext;
extern JsValue cssVarsEscapeName;
extern JsValue cssVarsHash;
extern JsValue cssVarsProcessExpression;
extern JsValue RegExp;

export string CSS_VARS_HELPER = "useCssVars";

int cssVarsLength(JsValue value) {
  return JS.number(value["length"]).toInt();
}

void cssVarsPush(JsValue values, JsValue value) {
  values[cssVarsLength(values)] = value;
}

string genVarName(string id, string raw, bool isProd, bool isSSR = false) {
  if (isProd) {
    string result = JS.string(JS.call(cssVarsHash, JS.undefined(), id + raw));
    Regex leadingDigit = new Regex("^\\d");
    JsValue prefixDigit = JS.method1((JsValue _self, JsValue digit) =>
      "v" + JS.string(digit)
    );
    return JS.string(JS.invoke(result, "replace", leadingDigit, prefixDigit));
  }
  return id + "-" + JS.string(JS.call(
    cssVarsEscapeName,
    JS.undefined(),
    raw,
    isSSR
  ));
}

export string genCssVarsFromList(
  JsValue vars,
  string id,
  bool isProd,
  bool isSSR = false
) {
  JsValue entries = JS.array();
  for (int index = 0; index < cssVarsLength(vars); index++) {
    string prefix = "";
    if (isSSR) prefix = ":--";
    string key = JS.string(vars[index]);
    cssVarsPush(
      entries,
      "\"" + prefix + genVarName(id, key, isProd, isSSR) + "\": (" + key + ")"
    );
  }
  return "{\n  " + JS.string(JS.invoke(entries, "join", ",\n  ")) + "\n}";
}

string normalizeExpression(string expression) {
  expression = expression.trim();
  if ((expression.charAt(0) == "'" &&
      expression.charAt(expression.length - 1) == "'") ||
    (expression.charAt(0) == "\"" &&
      expression.charAt(expression.length - 1) == "\"")) {
    return expression.slice(1, -1);
  }
  return expression;
}

JsValue vBindRE = JS.construct(RegExp, "v-bind\\s*\\(", "g");

JsValue lexBinding(string content, int start) {
  int state = 0;
  int parenDepth = 0;
  for (int index = start; index < content.length; index++) {
    string character = content.charAt(index);
    if (state == 0) {
      if (character == "'") state = 1;
      else if (character == "\"") state = 2;
      else if (character == "(") parenDepth++;
      else if (character == ")") {
        if (parenDepth > 0) parenDepth--;
        else return index;
      }
    } else if (state == 1) {
      if (character == "'") state = 0;
    } else if (character == "\"") state = 0;
  }
  return null;
}

export JsValue parseCssVars(JsValue sfc) {
  JsValue vars = JS.array();
  JsValue styles = sfc["styles"];
  Regex commentsRE = new Regex("/\\*([\\s\\S]*?)\\*/|//.*", "g");
  for (int styleIndex = 0; styleIndex < cssVarsLength(styles); styleIndex++) {
    string content = JS.string(JS.invoke(
      styles[styleIndex]["content"],
      "replace",
      commentsRE,
      ""
    ));
    vBindRE["lastIndex"] = 0;
    JsValue regexMatch = JS.invoke(vBindRE, "exec", content);
    while (!JS.isNullish(regexMatch)) {
      int start = JS.number(regexMatch["index"]).toInt() +
        JS.string(regexMatch[0]).length;
      JsValue end = lexBinding(content, start);
      if (!JS.isNullish(end)) {
        string variable = normalizeExpression(
          content.slice(start, JS.number(end).toInt())
        );
        if (!JS.invoke(vars, "includes", variable).truthy()) {
          cssVarsPush(vars, variable);
        }
      }
      regexMatch = JS.invoke(vBindRE, "exec", content);
    }
  }
  return vars;
}

export JsValue cssVarsPlugin = JS.method1((JsValue _self, JsValue opts) => {
  string id = JS.string(opts["id"]);
  bool isProd = opts["isProd"].truthy();
  JsValue declaration = JS.method1((JsValue _declSelf, JsValue decl) => {
    string value = JS.string(decl["value"]);
    if (JS.invoke(vBindRE, "test", value).truthy()) {
      vBindRE["lastIndex"] = 0;
      string transformed = "";
      int lastIndex = 0;
      JsValue regexMatch = JS.invoke(vBindRE, "exec", value);
      while (!JS.isNullish(regexMatch)) {
        int start = JS.number(regexMatch["index"]).toInt() +
          JS.string(regexMatch[0]).length;
        JsValue end = lexBinding(value, start);
        if (!JS.isNullish(end)) {
          string variable = normalizeExpression(
            value.slice(start, JS.number(end).toInt())
          );
          transformed += value.slice(lastIndex, JS.number(regexMatch["index"]).toInt()) +
            "var(--" + genVarName(id, variable, isProd) + ")";
          lastIndex = JS.number(end).toInt() + 1;
        }
        regexMatch = JS.invoke(vBindRE, "exec", value);
      }
      decl["value"] = transformed + value.slice(lastIndex);
    }
    return JS.undefined();
  });
  return JS.object("postcssPlugin", "vue-sfc-vars", "Declaration", declaration);
});
cssVarsPlugin["postcss"] = true;

export string genCssVarsCode(
  JsValue vars,
  JsValue bindings,
  string id,
  bool isProd
) {
  string varsExpression = genCssVarsFromList(vars, id, isProd);
  JsValue expression = JS.call(
    cssVarsCreateSimpleExpression,
    JS.undefined(),
    varsExpression,
    false
  );
  JsValue bindingMetadata = bindings;
  if (JS.strictEqual(bindings["__isScriptSetup"], false)) {
    bindingMetadata = JS.undefined();
  }
  JsValue root = JS.call(cssVarsCreateRoot, JS.undefined(), JS.array());
  JsValue context = JS.call(
    cssVarsCreateTransformContext,
    JS.undefined(),
    root,
    JS.object(
      "prefixIdentifiers", true,
      "inline", true,
      "bindingMetadata", bindingMetadata
    )
  );
  JsValue transformed = JS.call(
    cssVarsProcessExpression,
    JS.undefined(),
    expression,
    context
  );
  string transformedString = "";
  if (JS.strictEqual(transformed["type"], CssVarsNodeTypes["SIMPLE_EXPRESSION"])) {
    transformedString = JS.string(transformed["content"]);
  } else {
    JsValue children = transformed["children"];
    for (int index = 0; index < cssVarsLength(children); index++) {
      JsValue child = children[index];
      if (JS.typeOf(child) == "string") transformedString += JS.string(child);
      else transformedString += JS.string(child["content"]);
    }
  }
  return "_" + CSS_VARS_HELPER + "(_ctx => (" + transformedString + "))";
}

export string genNormalScriptCssVarsCode(
  JsValue cssVars,
  JsValue bindings,
  string id,
  bool isProd,
  string defaultVar
) {
  return "\nimport { " + CSS_VARS_HELPER + " as _" + CSS_VARS_HELPER +
    " } from 'vue'\n" +
    "const __injectCSSVars__ = () => {\n" +
    genCssVarsCode(cssVars, bindings, id, isProd) + "}\n" +
    "const __setup__ = " + defaultVar + ".setup\n" +
    defaultVar + ".setup = __setup__\n" +
    "  ? (props, ctx) => { __injectCSSVars__();return __setup__(props, ctx) }\n" +
    "  : __injectCSSVars__\n";
}
