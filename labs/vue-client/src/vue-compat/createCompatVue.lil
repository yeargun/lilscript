  withScopeId
} from "../package/runtime-dom.lil";
import { extend as sharedExtend } from "../package/shared.lil";

define bool CREATE_COMPAT_DEV = true;

JsValue runtimeDom = JS.object(
  "BaseTransition", BaseTransition,
  "BaseTransitionPropsValidators", BaseTransitionPropsValidators,
  "Comment", Comment,
  "DeprecationTypes", DeprecationTypes,
  "EffectScope", EffectScope,
