if (CREATE_COMPAT_DEV) initDev();

JsValue wrappedCreateApp = JS.methodRest((JsValue _self, JsValue args) => {
  JsValue app = JS.apply(runtimeCreateApp, JS.undefined(), args);
  if (JS.call(
    compatUtils["isCompatEnabled"],
    compatUtils,
    DeprecationTypes["RENDER_FUNCTION"],
    null
  ).truthy()) {
    JS.invoke(app, "component", "__compat__transition", Transition);
    JS.invoke(app, "component", "__compat__transition-group", TransitionGroup);
    JS.invoke(app, "component", "__compat__keep-alive", KeepAlive);
    app["_context"]["directives"]["show"] = vShow;
    app["_context"]["directives"]["model"] = vModelDynamic;
  }
  return app;
});

export JsValue createCompatVue() {
  JsValue Vue = JS.call(
    compatUtils["createCompatVue"],
    compatUtils,
    runtimeCreateApp,
    wrappedCreateApp
  );
  JS.call(sharedExtend, JS.undefined(), Vue, runtimeDom);
  return Vue;
}
