  if (JS.isNullish(oldObject)) oldObject = hostCreateObject();
  JsValue newObject = newProps;
  if (JS.isNullish(newObject)) newObject = hostCreateObject();
  JsValue oldKeys = hostObjectKeys(oldObject);
  JsValue newKeys = hostObjectKeys(newObject);
  if (valueLength(oldKeys) != valueLength(newKeys)) return true;
