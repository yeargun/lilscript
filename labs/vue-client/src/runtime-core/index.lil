export JsValue createRenderer(JsValue options) {
  RendererKernel renderer = new RendererKernel(options);
  return renderer.facade();
}

// Component and application context -----------------------------------------

export JsValue LifecycleHooks = JS.object(
  "BEFORE_CREATE", "bc", "CREATED", "c", "BEFORE_MOUNT", "bm",
  "MOUNTED", "m", "BEFORE_UPDATE", "bu", "UPDATED", "u",
  "BEFORE_UNMOUNT", "bum", "UNMOUNTED", "um", "DEACTIVATED", "da",
  "ACTIVATED", "a", "RENDER_TRIGGERED", "rtg", "RENDER_TRACKED", "rtc",
  "ERROR_CAPTURED", "ec", "SERVER_PREFETCH", "sp"
);

export JsValue currentInstance = null;
export JsValue currentApp = null;
export bool isInSSRComponentSetup = false;

export JsValue getCurrentInstance() {
  if (!JS.isNullish(currentInstance)) return currentInstance;
  return currentRenderingInstance;
}

export JsValue setCurrentInstance(JsValue instance) {
  JsValue previous = currentInstance;
  currentInstance = instance;
  JsValue scope = hostRead(instance, "scope");
  if (!JS.isNullish(scope) && isFunctionValue(hostRead(scope, "on"))) {
    hostCallMethod0(scope, "on");
  }
  return JS.method0((JsValue _self) => {
    JsValue currentScope = hostRead(instance, "scope");
    if (!JS.isNullish(currentScope) && isFunctionValue(hostRead(currentScope, "off"))) {
      hostCallMethod0(currentScope, "off");
    }
    currentInstance = previous;
    return JS.undefined();
  });
}

export void unsetCurrentInstance() {
  JsValue scope = hostRead(currentInstance, "scope");
  if (!JS.isNullish(scope) && isFunctionValue(hostRead(scope, "off"))) {
    hostCallMethod0(scope, "off");
  }
  currentInstance = null;
}

export void setInSSRSetupState(bool state) {
  isInSSRComponentSetup = state;
}

export JsValue setCurrentRenderingInstance(JsValue instance) {
  JsValue previous = currentRenderingInstance;
  currentRenderingInstance = instance;
  currentScopeId = null;
  if (!JS.isNullish(instance)) {
    JsValue scopeId = hostRead(hostRead(instance, "type"), "__scopeId");
    if (scopeId.truthy()) currentScopeId = scopeId;
  }
  return previous;
}

export void pushScopeId(JsValue id) {
  currentScopeId = id;
}

export void popScopeId() {
  currentScopeId = null;
}

export JsValue withCtx(
  JsValue fn,
  JsValue context = JS.undefined(),
  bool isNonScopedSlot = false
) {
  if (JS.isUndefined(context)) context = currentRenderingInstance;
  if (JS.isNullish(context) || hostRead(fn, "_n").truthy()) return fn;
  JsValue wrapper = JS.undefined();
  wrapper = JS.methodRest((JsValue _self, JsValue callArgs) => {
    bool disable = hostRead(wrapper, "_d").truthy();
    if (disable) setBlockTracking(-1, false);
    JsValue previous = setCurrentRenderingInstance(context);
    int stackSize = blockStack.length;
    JsValue result = JS.undefined();
    try {
      result = hostApply(fn, JS.undefined(), callArgs);
    } finally {
      while (blockStack.length > stackSize) closeBlock();
      setCurrentRenderingInstance(previous);
      if (disable) setBlockTracking(1, false);
    }
    return result;
  });
  hostWrite(wrapper, "_n", true);
  hostWrite(wrapper, "_c", true);
  hostWrite(wrapper, "_d", true);
  if (isNonScopedSlot) hostWrite(wrapper, "_ns", true);
  return wrapper;
}

export JsValue withScopeId(JsValue _id) {
  return withCtx;
}

export void provide(JsValue key, JsValue value) {
  if (JS.isNullish(currentInstance) || hostRead(currentInstance, "isMounted").truthy()) {
    hostWarn("provide() can only be used inside setup().");
  }
  if (!JS.isNullish(currentInstance)) {
    JsValue provides = hostRead(currentInstance, "provides");
    JsValue parent = hostRead(currentInstance, "parent");
    JsValue parentProvides = JS.undefined();
    if (!JS.isNullish(parent)) parentProvides = hostRead(parent, "provides");
    if (JS.strictEqual(parentProvides, provides)) {
      provides = hostObjectCreate(parentProvides);
      hostWrite(currentInstance, "provides", provides);
    }
    hostWrite(provides, key, value);
  }
}

export JsValue inject(
  JsValue key,
  JsValue defaultValue,
  bool treatDefaultAsFactory = false
) {
  JsValue instance = getCurrentInstance();
