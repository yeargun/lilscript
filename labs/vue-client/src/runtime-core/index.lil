bool isObjectValue(JsValue value) {
  return !JS.isNullish(value) && JS.typeOf(value) == "object";
}

bool isFunctionValue(JsValue value) {
  return JS.typeOf(value) == "function";
}

int valueLength(JsValue value) {
  return hostNumber(hostRead(value, "length")).toInt();
}

export string version = "3.5.42";

// Scheduler -----------------------------------------------------------------

export JsValue SchedulerJobFlags = JS.object(
  "1", "QUEUED", "2", "PRE", "4", "ALLOW_RECURSE", "8", "DISPOSED",
  "QUEUED", 1, "PRE", 2, "ALLOW_RECURSE", 4, "DISPOSED", 8
);

JsValue[] schedulerQueue = [];
int flushIndex = -1;
JsValue[] pendingPostFlushCbs = [];
JsValue activePostFlushCbs = null;
int postFlushIndex = 0;
JsValue resolvedPromise = hostPromiseResolve();
JsValue currentFlushPromise = null;

int schedulerFlags(JsValue job) {
  JsValue value = hostRead(job, "flags");
  if (JS.isNullish(value)) return 0;
  return hostNumber(value).toInt();
}

void setSchedulerFlags(JsValue job, int flags) {
  hostWrite(job, "flags", flags);
}

float schedulerId(JsValue job) {
  JsValue id = hostRead(job, "id");
  if (!JS.isNullish(id)) return hostNumber(id);
  if ((schedulerFlags(job) & 2) != 0) return -1.0;
  return hostInfinity();
}

int findInsertionIndex(float id) {
  int start = flushIndex + 1;
  int end = schedulerQueue.length;
  while (start < end) {
    int middle = (start + end) >> 1;
    JsValue middleJob = schedulerQueue[middle];
    float middleId = schedulerId(middleJob);
    if (middleId < id || (middleId == id && (schedulerFlags(middleJob) & 2) != 0)) {
      start = middle + 1;
    } else {
      end = middle;
    }
  }
  return start;
}

void queueFlush() {
  if (JS.isNullish(currentFlushPromise)) {
    currentFlushPromise = hostPromiseThen(resolvedPromise, JS.method0((JsValue _self) => {
      flushJobs(JS.undefined());
      return JS.undefined();
    }));
  }
}

export void queueJob(JsValue job) {
  int flags = schedulerFlags(job);
  if ((flags & 1) != 0) return;
  float id = schedulerId(job);
  int length = schedulerQueue.length;
  if (
    length == 0 ||
    ((flags & 2) == 0 && id >= schedulerId(schedulerQueue[length - 1]))
  ) {
    schedulerQueue.push(job);
  } else {
    hostArrayInsert(JS.assume(schedulerQueue), findInsertionIndex(id), job);
  }
  setSchedulerFlags(job, flags | 1);
  queueFlush();
}

JsValue nextTickCallback(JsValue self, JsValue callArgs) {
  JsValue promise = currentFlushPromise;
  if (JS.isNullish(promise)) promise = resolvedPromise;
  JsValue fn = hostRead(callArgs, 0);
  if (isFunctionValue(fn)) {
    if (self.truthy()) fn = hostBind(fn, self);
    return hostPromiseThen(promise, fn);
  }
  return promise;
}

export JsValue nextTick = hostSetFunctionName(
  hostFunction1Rest(JS.method2((JsValue _self, JsValue self, JsValue callArgs) =>
    nextTickCallback(self, callArgs)
  )),
  "nextTick"
);

export void queuePostFlushCb(JsValue callback) {
  if (!dependencyIsArray(callback)) {
    if (!JS.isNullish(activePostFlushCbs) && schedulerId(callback) == -1.0) {
      hostArrayInsert(activePostFlushCbs, postFlushIndex + 1, callback);
    } else if ((schedulerFlags(callback) & 1) == 0) {
      pendingPostFlushCbs.push(callback);
      setSchedulerFlags(callback, schedulerFlags(callback) | 1);
    }
  } else {
    int length = valueLength(callback);
    for (int index = 0; index < length; index++) {
      pendingPostFlushCbs.push(hostRead(callback, index));
    }
  }
  queueFlush();
}

bool checkRecursiveUpdates(JsValue seen, JsValue job) {
  JsValue oldCount = hostMapGet(seen, job);
  int count = 0;
  if (!JS.isNullish(oldCount)) count = hostNumber(oldCount).toInt();
  if (count > 100) {
    hostWarn(
      "Maximum recursive updates exceeded. This means you have a reactive effect that is mutating its own dependencies and thus recursively triggering itself. Possible sources include component template, render function, updated hook or watcher source function."
    );
    return true;
  }
  hostMapSet(seen, job, count + 1);
  return false;
}

export void flushPreFlushCbs(
  JsValue instance = JS.undefined(),
  JsValue seen = JS.undefined(),
  int startIndex = -2
) {
  if (JS.isUndefined(seen)) seen = hostCreateMap();
  int index = startIndex;
  if (index == -2) index = flushIndex + 1;
  while (index < schedulerQueue.length) {
    JsValue callback = schedulerQueue[index];
    if ((schedulerFlags(callback) & 2) != 0) {
      if (!JS.isNullish(instance) && !JS.strictEqual(hostRead(callback, "id"), hostRead(instance, "uid"))) {
        index += 1;
        continue;
      }
      if (checkRecursiveUpdates(seen, callback)) {
        index += 1;
        continue;
      }
      hostArrayRemove(JS.assume(schedulerQueue), index);
      int flags = schedulerFlags(callback);
      if ((flags & 4) != 0) setSchedulerFlags(callback, flags & -2);
      hostCall0(callback);
      if ((schedulerFlags(callback) & 4) == 0) {
        setSchedulerFlags(callback, schedulerFlags(callback) & -2);
      }
      continue;
    }
    index += 1;
  }
}

export void flushPostFlushCbs(JsValue seen = JS.undefined()) {
  if (pendingPostFlushCbs.length == 0) return;
  JsValue deduped = hostArrayFrom(hostCreateSet(JS.assume(pendingPostFlushCbs)));
  hostArraySort(deduped, JS.method2((JsValue _self, JsValue left, JsValue right) =>
    schedulerId(left) - schedulerId(right)
  ));
  pendingPostFlushCbs = [];
  if (!JS.isNullish(activePostFlushCbs)) {
    int nestedLength = valueLength(deduped);
    for (int nestedIndex = 0; nestedIndex < nestedLength; nestedIndex++) {
      hostWrite(activePostFlushCbs, valueLength(activePostFlushCbs), hostRead(deduped, nestedIndex));
    }
    return;
  }
  activePostFlushCbs = deduped;
  if (JS.isUndefined(seen)) seen = hostCreateMap();
  postFlushIndex = 0;
  while (postFlushIndex < valueLength(activePostFlushCbs)) {
    JsValue callback = hostRead(activePostFlushCbs, postFlushIndex);
    if (!checkRecursiveUpdates(seen, callback)) {
      int flags = schedulerFlags(callback);
      if ((flags & 4) != 0) setSchedulerFlags(callback, flags & -2);
      if ((schedulerFlags(callback) & 8) == 0) hostCall0(callback);
      setSchedulerFlags(callback, schedulerFlags(callback) & -2);
    }
    postFlushIndex += 1;
  }
  activePostFlushCbs = null;
  postFlushIndex = 0;
}

void flushJobs(JsValue seen) {
  if (JS.isUndefined(seen)) seen = hostCreateMap();
  bool failed = false;
  JsValue failure = JS.undefined();
  try {
    flushIndex = 0;
    while (flushIndex < schedulerQueue.length) {
      JsValue job = schedulerQueue[flushIndex];
      if ((schedulerFlags(job) & 8) == 0 && !checkRecursiveUpdates(seen, job)) {
        int flags = schedulerFlags(job);
        if ((flags & 4) != 0) setSchedulerFlags(job, flags & -2);
        hostCall0(job);
        if ((schedulerFlags(job) & 4) == 0) {
          setSchedulerFlags(job, schedulerFlags(job) & -2);
        }
      }
      flushIndex += 1;
    }
  } catch (JsValue error) {
    failed = true;
    failure = error;
    hostWarn("Unhandled error during execution of scheduler flush");
  } finally {
    while (flushIndex < schedulerQueue.length) {
      setSchedulerFlags(schedulerQueue[flushIndex], schedulerFlags(schedulerQueue[flushIndex]) & -2);
      flushIndex += 1;
    }
    flushIndex = -1;
    schedulerQueue = [];
    flushPostFlushCbs(seen);
    currentFlushPromise = null;
    if (schedulerQueue.length > 0 || pendingPostFlushCbs.length > 0) flushJobs(seen);
  }
  if (failed) throw failure;
}

// VNodes and rendering helpers ------------------------------------------------

export JsValue Fragment = hostSymbolFor("v-fgt");
export JsValue Text = hostSymbolFor("v-txt");
export JsValue Comment = hostSymbolFor("v-cmt");
export JsValue Static = hostSymbolFor("v-stc");
export JsValue Teleport = JS.object("name", "Teleport", "__isTeleport", true);

export JsValue[] blockStack = [];
export JsValue currentBlock = null;
export int isBlockTreeEnabled = 1;
JsValue vnodeArgsTransformer = JS.undefined();
export JsValue currentRenderingInstance = null;
export JsValue currentScopeId = null;
JsValue internalObjectPrototype = hostCreateObject();

export JsValue createInternalObject() {
  return hostObjectCreate(internalObjectPrototype);
}

bool isInternalObject(JsValue value) {
  return isObjectValue(value) && JS.strictEqual(hostGetPrototype(value), internalObjectPrototype);
}

export void openBlock(bool disableTracking = false) {
  currentBlock = null;
  if (!disableTracking) currentBlock = hostCreateArray(0);
  blockStack.push(currentBlock);
}

export void closeBlock() {
  blockStack.pop();
  currentBlock = null;
  if (blockStack.length > 0) currentBlock = blockStack[blockStack.length - 1];
}

export void setBlockTracking(int value, bool inVOnce = false) {
  isBlockTreeEnabled += value;
  if (value < 0 && !JS.isNullish(currentBlock) && inVOnce) {
    hostWrite(currentBlock, "hasOnce", true);
  }
}

export bool isVNode(JsValue value) {
  return value.truthy() && JS.strictEqual(hostRead(value, "__v_isVNode"), true);
}

JsValue normalizeKey(JsValue props) {
  JsValue key = hostRead(props, "key");
  if (JS.isNullish(key)) return null;
  return key;
}

JsValue normalizeRef(JsValue props) {
  JsValue reference = hostRead(props, "ref");
  if (reference is float) reference = hostString(reference);
  if (JS.isNullish(reference)) return null;
  if (
    reference is string ||
    dependencyIsRef(reference) ||
    isFunctionValue(reference)
  ) {
    return JS.object(
      "i", currentRenderingInstance,
      "r", reference,
      "k", hostRead(props, "ref_key"),
      "f", hostRead(props, "ref_for").truthy()
    );
  }
  return reference;
}

int numberOr(JsValue value, int fallback) {
  if (JS.isUndefined(value)) return fallback;
  return hostNumber(value).toInt();
}

export JsValue createBaseVNode(
  JsValue type,
  JsValue props = JS.undefined(),
  JsValue children = JS.undefined(),
  JsValue patchFlagValue = JS.undefined(),
  JsValue dynamicProps = JS.undefined(),
  JsValue shapeFlagValue = JS.undefined(),
  bool isBlockNode = false,
  bool needFullChildrenNormalization = false
) {
  if (JS.isUndefined(props)) props = null;
  if (JS.isUndefined(children)) children = null;
  if (JS.isUndefined(dynamicProps)) dynamicProps = null;
  int patchFlag = numberOr(patchFlagValue, 0);
  int shapeFlag = 1;
  if (JS.strictEqual(type, Fragment)) shapeFlag = 0;
  if (!JS.isUndefined(shapeFlagValue)) shapeFlag = hostNumber(shapeFlagValue).toInt();
  JsValue key = null;
  JsValue reference = null;
  if (!JS.isNullish(props)) {
    key = normalizeKey(props);
    reference = normalizeRef(props);
  }
  JsValue vnode = JS.object(
    "__v_isVNode", true,
    "__v_skip", true,
    "type", type,
    "props", props,
    "key", key,
    "ref", reference,
    "scopeId", currentScopeId,
    "slotScopeIds", null,
    "children", children,
    "component", null,
    "suspense", null,
    "ssContent", null,
    "ssFallback", null,
    "dirs", null,
    "transition", null,
    "el", null,
    "anchor", null,
    "target", null,
    "targetStart", null,
    "targetAnchor", null,
    "staticCount", 0,
    "shapeFlag", shapeFlag,
    "patchFlag", patchFlag,
    "dynamicProps", dynamicProps,
    "dynamicChildren", null,
    "appContext", null,
    "ctx", currentRenderingInstance
  );
  if (needFullChildrenNormalization) {
    normalizeChildren(vnode, children);
    if ((shapeFlag & 128) != 0) {
      JsValue normalize = hostRead(type, "normalize");
      if (isFunctionValue(normalize)) hostCall1(normalize, vnode);
    }
  } else if (children.truthy()) {
    int childFlag = 16;
    if (children is string) childFlag = 8;
    hostWrite(vnode, "shapeFlag", shapeFlag | childFlag);
  }
  JsValue validatedKey = hostRead(vnode, "key");
  if (!JS.isNullish(validatedKey) && !JS.strictEqual(validatedKey, validatedKey)) {
    hostWarn("VNode created with invalid key (NaN). VNode type:");
  }
  if (!JS.isNullish(props) && (shapeFlag & 1) != 0) {
    JsValue overwriting = null;
    if (!JS.isNullish(hostRead(props, "innerHTML"))) overwriting = "innerHTML";
    else if (!JS.isNullish(hostRead(props, "textContent"))) overwriting = "textContent";
    if (!JS.isNullish(overwriting)) {
      bool hasChildren = dependencyIsArray(children) && valueLength(children) > 0;
      if (children is string) hasChildren = hostString(children) != "";
      if (hasChildren) {
        string property = hostString(overwriting);
        hostWarn(
          "The `" + property + "` prop on <" + hostString(type) + "> will override its children. Remove either the `" + property + "` prop or the children."
        );
      }
    }
  }
  if (
    isBlockTreeEnabled > 0 &&
    !isBlockNode &&
    !JS.isNullish(currentBlock) &&
    (patchFlag > 0 || (shapeFlag & 6) != 0) &&
    patchFlag != 32
  ) {
    hostWrite(currentBlock, valueLength(currentBlock), vnode);
  }
  return vnode;
}

export { createBaseVNode as createElementVNode };

export JsValue guardReactiveProps(JsValue props) {
  if (!props.truthy()) return null;
  if (dependencyIsProxy(props) || isInternalObject(props)) {
    return hostAssign(hostCreateObject(), props);
  }
  return props;
}

int inferShapeFlag(JsValue type) {
  if (type is string) return 1;
  if (isObjectValue(type)) {
    if (hostRead(type, "__isSuspense").truthy()) return 128;
    if (hostRead(type, "__isTeleport").truthy()) return 64;
    return 4;
  }
  if (isFunctionValue(type)) return 2;
  return 0;
}

JsValue createVNodeCore(
  JsValue type,
  JsValue props,
  JsValue children,
  JsValue patchFlagValue,
  JsValue dynamicProps,
  bool isBlockNode
) {
  if (!type.truthy()) {
    hostWarn("Invalid vnode type when creating vnode: " + hostString(type) + ".");
    type = Comment;
  }
  if (isVNode(type)) {
    JsValue cloned = cloneVNode(type, props, true, false);
    if (children.truthy()) normalizeChildren(cloned, children);
    if (isBlockTreeEnabled > 0 && !isBlockNode && !JS.isNullish(currentBlock)) {
      if ((hostNumber(hostRead(cloned, "shapeFlag")).toInt() & 6) != 0) {
        int oldIndex = hostArrayIndexOf(currentBlock, type);
        hostWrite(currentBlock, oldIndex, cloned);
      } else {
        hostWrite(currentBlock, valueLength(currentBlock), cloned);
      }
    }
    hostWrite(cloned, "patchFlag", -2);
    return cloned;
  }
  if (isFunctionValue(type) && hostHasProperty(type, "__vccOpts")) {
    type = hostRead(type, "__vccOpts");
  }
  if (!JS.isNullish(props)) {
    props = guardReactiveProps(props);
    JsValue klass = hostRead(props, "class");
    if (klass.truthy() && !(klass is string)) {
      hostWrite(props, "class", dependencyNormalizeClass(klass));
    }
    JsValue style = hostRead(props, "style");
    if (isObjectValue(style)) {
      if (dependencyIsProxy(style) && !dependencyIsArray(style)) {
        style = hostAssign(hostCreateObject(), style);
      }
      hostWrite(props, "style", dependencyNormalizeStyle(style));
    }
  }
  int shapeFlag = inferShapeFlag(type);
  if ((shapeFlag & 4) != 0 && dependencyIsProxy(type)) type = dependencyToRaw(type);
  return createBaseVNode(
    type,
    props,
    children,
    patchFlagValue,
    dynamicProps,
    shapeFlag,
    isBlockNode,
    true
  );
}

export JsValue createVNode(
  JsValue type = JS.undefined(),
  JsValue props = JS.undefined(),
  JsValue children = JS.undefined(),
  JsValue patchFlag = JS.undefined(),
  JsValue dynamicProps = JS.undefined(),
  bool isBlockNode = false
) {
  if (!JS.isUndefined(vnodeArgsTransformer)) {
    JsValue transformed = hostCall2(
      vnodeArgsTransformer,
      hostArraySlice(arguments, 0),
      currentRenderingInstance
    );
    return createVNodeCore(
      hostRead(transformed, 0),
      hostRead(transformed, 1),
      hostRead(transformed, 2),
      hostRead(transformed, 3),
      hostRead(transformed, 4),
      hostRead(transformed, 5).truthy()
    );
  }
  return createVNodeCore(type, props, children, patchFlag, dynamicProps, isBlockNode);
}

export void transformVNodeArgs(JsValue transformer) {
  vnodeArgsTransformer = transformer;
}

JsValue setupBlock(JsValue vnode) {
  JsValue dynamicChildren = null;
  if (isBlockTreeEnabled > 0) {
    dynamicChildren = currentBlock;
    if (JS.isNullish(dynamicChildren)) dynamicChildren = dependencyEmptyArray;
  }
  hostWrite(
    vnode,
    "dynamicChildren",
    dynamicChildren
  );
  closeBlock();
  if (isBlockTreeEnabled > 0 && !JS.isNullish(currentBlock)) {
    hostWrite(currentBlock, valueLength(currentBlock), vnode);
  }
  return vnode;
}

export JsValue createElementBlock(
  JsValue type,
  JsValue props,
  JsValue children,
  JsValue patchFlag,
  JsValue dynamicProps,
  JsValue shapeFlag
) {
  return setupBlock(createBaseVNode(
    type, props, children, patchFlag, dynamicProps, shapeFlag, true, false
  ));
}

export JsValue createBlock(
  JsValue type,
  JsValue props,
  JsValue children,
  JsValue patchFlag,
  JsValue dynamicProps
) {
  return setupBlock(createVNode(type, props, children, patchFlag, dynamicProps, true));
}

JsValue cloneChildrenDeep(JsValue children) {
  int length = valueLength(children);
  JsValue result = hostCreateArray(length);
  for (int index = 0; index < length; index++) {
    hostWrite(result, index, deepCloneVNode(hostRead(children, index)));
  }
  return result;
}

JsValue deepCloneVNode(JsValue vnode) {
  JsValue cloned = cloneVNode(vnode, JS.undefined(), false, false);
  JsValue children = hostRead(vnode, "children");
  if (dependencyIsArray(children)) hostWrite(cloned, "children", cloneChildrenDeep(children));
  return cloned;
}

export JsValue cloneVNode(
  JsValue vnode,
  JsValue extraProps,
  bool mergeRef = false,
  bool cloneTransition = false
) {
  JsValue props = hostRead(vnode, "props");
  JsValue reference = hostRead(vnode, "ref");
  int patchFlag = hostNumber(hostRead(vnode, "patchFlag")).toInt();
  JsValue children = hostRead(vnode, "children");
  JsValue transition = hostRead(vnode, "transition");
  JsValue mergedProps = props;
  if (!JS.isNullish(extraProps)) {
    JsValue baseProps = props;
    if (JS.isNullish(baseProps)) baseProps = hostCreateObject();
    mergedProps = mergeTwoProps(baseProps, extraProps);
  }
  JsValue nextRef = reference;
  if (!JS.isNullish(extraProps) && hostRead(extraProps, "ref").truthy()) {
    JsValue normalized = normalizeRef(extraProps);
    if (mergeRef && !JS.isNullish(reference)) {
      nextRef = hostArrayConcat(reference, normalized);
    } else {
      nextRef = normalized;
    }
  }
  if (patchFlag == -1 && dependencyIsArray(children)) children = cloneChildrenDeep(children);
  int nextPatchFlag = patchFlag;
  if (!JS.isNullish(extraProps) && !JS.strictEqual(hostRead(vnode, "type"), Fragment)) {
    nextPatchFlag = patchFlag | 16;
    if (patchFlag == -1) nextPatchFlag = 16;
  }
  JsValue clonedKey = null;
  if (!JS.isNullish(mergedProps)) clonedKey = normalizeKey(mergedProps);
  JsValue clonedContent = hostRead(vnode, "ssContent");
  if (clonedContent.truthy()) clonedContent = cloneVNode(clonedContent, JS.undefined(), false, false);
  JsValue clonedFallback = hostRead(vnode, "ssFallback");
  if (clonedFallback.truthy()) clonedFallback = cloneVNode(clonedFallback, JS.undefined(), false, false);
  JsValue cloned = JS.object(
    "__v_isVNode", true,
    "__v_skip", true,
    "type", hostRead(vnode, "type"),
    "props", mergedProps,
    "key", clonedKey,
    "ref", nextRef,
    "scopeId", hostRead(vnode, "scopeId"),
    "slotScopeIds", hostRead(vnode, "slotScopeIds"),
    "children", children,
    "target", hostRead(vnode, "target"),
    "targetStart", hostRead(vnode, "targetStart"),
    "targetAnchor", hostRead(vnode, "targetAnchor"),
    "staticCount", hostRead(vnode, "staticCount"),
    "shapeFlag", hostRead(vnode, "shapeFlag"),
    "patchFlag", nextPatchFlag,
    "dynamicProps", hostRead(vnode, "dynamicProps"),
    "dynamicChildren", hostRead(vnode, "dynamicChildren"),
    "appContext", hostRead(vnode, "appContext"),
    "dirs", hostRead(vnode, "dirs"),
    "transition", transition,
    "component", hostRead(vnode, "component"),
    "suspense", hostRead(vnode, "suspense"),
    "ssContent", clonedContent,
    "ssFallback", clonedFallback,
    "placeholder", hostRead(vnode, "placeholder"),
    "el", hostRead(vnode, "el"),
    "anchor", hostRead(vnode, "anchor"),
    "ctx", hostRead(vnode, "ctx"),
    "ce", hostRead(vnode, "ce")
  );
  if (!JS.isNullish(transition) && cloneTransition) {
    JsValue clone = hostRead(transition, "clone");
    if (isFunctionValue(clone)) {
      JsValue transitionArgs = hostCreateArray(1);
      hostWrite(transitionArgs, 0, cloned);
      hostWrite(cloned, "transition", hostApply(clone, transition, transitionArgs));
    }
  }
  return cloned;
}

export JsValue createTextVNode(
  JsValue text = JS.undefined(),
  JsValue flag = JS.undefined()
) {
  if (JS.isUndefined(text)) text = " ";
  if (JS.isUndefined(flag)) flag = 0;
  return createVNode(Text, null, text, flag, null, false);
}

export JsValue createStaticVNode(JsValue content, JsValue numberOfNodes) {
  JsValue vnode = createVNode(Static, null, content, 0, null, false);
  hostWrite(vnode, "staticCount", numberOfNodes);
  return vnode;
}

export JsValue createCommentVNode(
  JsValue text = JS.undefined(),
  bool asBlock = false
) {
  if (JS.isUndefined(text)) text = "";
  if (asBlock) {
    openBlock(false);
    return createBlock(Comment, null, text, JS.undefined(), JS.undefined());
  }
  return createVNode(Comment, null, text, 0, null, false);
}

export JsValue cloneIfMounted(JsValue child) {
  if (
    (JS.isNullish(hostRead(child, "el")) && hostNumber(hostRead(child, "patchFlag")).toInt() != -1) ||
    hostRead(child, "memo").truthy()
  ) return child;
  return cloneVNode(child, JS.undefined(), false, false);
}

export JsValue normalizeVNode(JsValue child) {
  if (JS.isNullish(child) || child is bool) {
    return createVNode(Comment, null, null, 0, null, false);
  }
  if (dependencyIsArray(child)) {
    return createVNode(Fragment, null, hostArraySlice(child, 0), 0, null, false);
  }
  if (isVNode(child)) return cloneIfMounted(child);
  return createVNode(Text, null, hostString(child), 0, null, false);
}

export void normalizeChildren(JsValue vnode, JsValue children) {
  int childType = 0;
  int shapeFlag = hostNumber(hostRead(vnode, "shapeFlag")).toInt();
  if (JS.isNullish(children)) {
    children = null;
  } else if (dependencyIsArray(children)) {
    childType = 16;
  } else if (isObjectValue(children)) {
    if ((shapeFlag & 65) != 0) {
      JsValue slot = hostRead(children, "default");
      if (slot.truthy()) {
        bool compiled = hostRead(slot, "_c").truthy();
        if (compiled) hostWrite(slot, "_d", false);
        normalizeChildren(vnode, hostCall0(slot));
        if (compiled) hostWrite(slot, "_d", true);
      }
      return;
    }
    childType = 32;
    JsValue slotFlag = hostRead(children, "_");
    if (!slotFlag.truthy() && !isInternalObject(children)) {
      hostWrite(children, "_ctx", currentRenderingInstance);
    } else if (hostNumber(slotFlag).toInt() == 3 && !JS.isNullish(currentRenderingInstance)) {
      JsValue parentSlots = hostRead(currentRenderingInstance, "slots");
      if (hostNumber(hostRead(parentSlots, "_")).toInt() == 1) {
        hostWrite(children, "_", 1);
      } else {
        hostWrite(children, "_", 2);
        hostWrite(vnode, "patchFlag", hostNumber(hostRead(vnode, "patchFlag")).toInt() | 1024);
      }
    }
  } else if (isFunctionValue(children)) {
    if ((shapeFlag & 65) != 0) {
      JsValue slots = JS.object("default", children);
      normalizeChildren(vnode, slots);
      return;
    }
    children = JS.object("default", children, "_ctx", currentRenderingInstance);
    childType = 32;
  } else {
    children = hostString(children);
    if ((shapeFlag & 64) != 0) {
      childType = 16;
      JsValue textChildren = hostCreateArray(1);
      hostWrite(textChildren, 0, createTextVNode(children, 0));
      children = textChildren;
    } else {
      childType = 8;
    }
  }
  hostWrite(vnode, "children", children);
  hostWrite(vnode, "shapeFlag", shapeFlag | childType);
}

JsValue mergeTwoProps(JsValue first, JsValue second) {
  JsValue sources = hostCreateArray(2);
  hostWrite(sources, 0, first);
  hostWrite(sources, 1, second);
  return mergePropsFrom(sources);
}

JsValue mergePropsFrom(JsValue sources) {
  JsValue result = hostCreateObject();
  int sourceLength = valueLength(sources);
  for (int sourceIndex = 0; sourceIndex < sourceLength; sourceIndex++) {
    JsValue source = hostRead(sources, sourceIndex);
    JsValue sourceKeys = hostEnumerableKeys(source);
    for (int keyIndex = 0; keyIndex < valueLength(sourceKeys); keyIndex++) {
      string key = JS.assume(hostRead(sourceKeys, keyIndex));
      JsValue incoming = hostRead(source, key);
      if (key == "class") {
        JsValue existingClass = hostRead(result, "class");
        if (!JS.strictEqual(existingClass, incoming)) {
          JsValue classes = hostCreateArray(2);
          hostWrite(classes, 0, existingClass);
          hostWrite(classes, 1, incoming);
          hostWrite(result, "class", dependencyNormalizeClass(classes));
        }
      } else if (key == "style") {
        JsValue styles = hostCreateArray(2);
        hostWrite(styles, 0, hostRead(result, "style"));
        hostWrite(styles, 1, incoming);
        hostWrite(result, "style", dependencyNormalizeStyle(styles));
      } else if (dependencyIsOn(key)) {
        JsValue existing = hostRead(result, key);
        if (
          incoming.truthy() &&
          !JS.strictEqual(existing, incoming) &&
          !(dependencyIsArray(existing) && hostArrayIncludes(existing, incoming))
        ) {
          JsValue mergedHandler = incoming;
          if (existing.truthy()) mergedHandler = hostArrayConcat(existing, incoming);
          hostWrite(result, key, mergedHandler);
        } else if (
          JS.isNullish(incoming) &&
          JS.isNullish(existing) &&
          !dependencyIsModelListener(key)
        ) {
          hostWrite(result, key, incoming);
        }
      } else if (key != "") {
        hostWrite(result, key, incoming);
      }
    }
  }
  return result;
}

export JsValue mergeProps() {
  return mergePropsFrom(arguments);
}

export bool isSameVNodeType(JsValue left, JsValue right) {
  return JS.strictEqual(hostRead(left, "type"), hostRead(right, "type")) &&
    JS.strictEqual(hostRead(left, "key"), hostRead(right, "key"));
}

export JsValue renderHyperscript(JsValue type, JsValue propsOrChildren, JsValue children) {
  setBlockTracking(-1, false);
  try {
    int length = valueLength(arguments);
    if (length == 2) {
      if (isObjectValue(propsOrChildren) && !dependencyIsArray(propsOrChildren)) {
        if (isVNode(propsOrChildren)) {
          JsValue childList = hostCreateArray(1);
          hostWrite(childList, 0, propsOrChildren);
          return createVNode(type, null, childList, 0, null, false);
        }
        return createVNode(type, propsOrChildren, null, 0, null, false);
      }
      return createVNode(type, null, propsOrChildren, 0, null, false);
    }
    if (length > 3) {
      children = hostArraySlice(arguments, 2);
    } else if (length == 3 && isVNode(children)) {
      JsValue childList = hostCreateArray(1);
      hostWrite(childList, 0, children);
      children = childList;
    }
    return createVNode(type, propsOrChildren, children, 0, null, false);
  } finally {
    setBlockTracking(1, false);
  }
}

export JsValue renderList(JsValue source, JsValue renderItem, JsValue cache, JsValue cacheIndex) {
  JsValue result = JS.undefined();
  JsValue cached = JS.undefined();
  if (!JS.isNullish(cache)) cached = hostRead(cache, cacheIndex);
  bool sourceIsArray = dependencyIsArray(source);
  if (sourceIsArray || source is string) {
    bool reactiveArray = sourceIsArray && dependencyIsReactive(source);
    bool needsWrap = false;
    bool readonlySource = false;
    if (reactiveArray) {
      needsWrap = !dependencyIsShallow(source);
      readonlySource = dependencyIsReadonly(source);
      source = dependencyShallowReadArray(source);
    }
    int length = valueLength(source);
    result = hostCreateArray(length);
    for (int index = 0; index < length; index++) {
      JsValue item = hostRead(source, index);
      if (needsWrap) {
        item = dependencyToReactive(item);
        if (readonlySource) item = dependencyToReadonly(item);
      }
      JsValue oldItem = JS.undefined();
      if (!JS.isNullish(cached)) oldItem = hostRead(cached, index);
      hostWrite(result, index, hostCall4(
        renderItem,
        item,
        index,
        JS.undefined(),
        oldItem
      ));
    }
  } else if (source is float) {
    if (!hostNumberIsInteger(source) || source < 0.0) {
      hostWarn("The v-for range expects a positive integer value but got " + hostString(source) + ".");
      result = hostCreateArray(0);
    } else {
      int length = source.toInt();
      result = hostCreateArray(length);
      for (int index = 0; index < length; index++) {
        JsValue oldItem = JS.undefined();
        if (!JS.isNullish(cached)) oldItem = hostRead(cached, index);
        hostWrite(result, index, hostCall4(
          renderItem,
          index + 1,
          index,
          JS.undefined(),
          oldItem
        ));
      }
    }
  } else if (isObjectValue(source)) {
    JsValue iterable = hostRead(source, hostIteratorSymbol());
    if (iterable.truthy()) {
      JsValue values = hostArrayFrom(source);
      int length = valueLength(values);
      result = hostCreateArray(length);
      for (int index = 0; index < length; index++) {
        JsValue oldItem = JS.undefined();
        if (!JS.isNullish(cached)) oldItem = hostRead(cached, index);
        hostWrite(result, index, hostCall4(
          renderItem,
          hostRead(values, index),
          index,
          JS.undefined(),
          oldItem
        ));
      }
    } else {
      JsValue keys = hostObjectKeys(source);
      int length = valueLength(keys);
      result = hostCreateArray(length);
      for (int index = 0; index < length; index++) {
        JsValue key = hostRead(keys, index);
        JsValue oldItem = JS.undefined();
        if (!JS.isNullish(cached)) oldItem = hostRead(cached, index);
        hostWrite(result, index, hostCall4(
          renderItem,
          hostRead(source, key),
          key,
          index,
          oldItem
        ));
      }
    }
  } else {
    result = hostCreateArray(0);
  }
  if (!JS.isNullish(cache)) hostWrite(cache, cacheIndex, result);
  return result;
}

bool hasUppercaseAscii(string key) {
  for (int index = 0; index < key.length; index++) {
    string character = key.slice(index, index + 1);
    if (character >= "A" && character <= "Z") return true;
  }
  return false;
}

export JsValue toHandlers(JsValue object, bool preserveCaseIfNecessary) {
  JsValue result = hostCreateObject();
  if (!isObjectValue(object)) {
    hostWarn("v-on with no argument expects an object value.");
    return result;
  }
  JsValue keys = hostEnumerableKeys(object);
  for (int index = 0; index < valueLength(keys); index++) {
    string key = JS.assume(hostRead(keys, index));
    string handlerKey = dependencyToHandlerKey(key);
    if (preserveCaseIfNecessary && hasUppercaseAscii(key)) handlerKey = "on:" + key;
    hostWrite(result, handlerKey, hostRead(object, key));
  }
  return result;
}

export JsValue withMemo(JsValue memo, JsValue render, JsValue cache, JsValue index) {
  JsValue cached = hostRead(cache, index);
  if (cached.truthy() && isMemoSame(cached, memo)) return cached;
  JsValue result = hostCall0(render);
  hostWrite(result, "memo", hostArraySlice(memo, 0));
  hostWrite(result, "cacheIndex", index);
  hostWrite(cache, index, result);
  return result;
}

export bool isMemoSame(JsValue cached, JsValue memo) {
  JsValue previous = hostRead(cached, "memo");
  int length = valueLength(previous);
  if (length != valueLength(memo)) return false;
  for (int index = 0; index < length; index++) {
    JsValue left = hostRead(previous, index);
    JsValue right = hostRead(memo, index);
    if (!JS.strictEqual(left, right) && (JS.strictEqual(left, left) || JS.strictEqual(right, right))) {
      return false;
    }
  }
  if (isBlockTreeEnabled > 0 && !JS.isNullish(currentBlock)) {
    hostWrite(currentBlock, valueLength(currentBlock), cached);
  }
  return true;
}

// Renderer ------------------------------------------------------------------

bool isReservedVNodeProp(string key) {
  return key == "key" || key == "ref" || key == "ref_for" || key == "ref_key" ||
    key.startsWith("onVnode");
}

int smallerInt(int left, int right) {
  if (left < right) return left;
  return right;
}

JsValue increasingSequence(JsValue values) {
  int length = valueLength(values);
  JsValue predecessors = hostArraySlice(values, 0);
  JsValue result = hostCreateArray(0);
  if (length == 0) return result;
  hostWrite(result, 0, 0);
  for (int index = 0; index < length; index++) {
    int value = hostNumber(hostRead(values, index)).toInt();
    if (value != 0) {
      int resultLength = valueLength(result);
      int last = hostNumber(hostRead(result, resultLength - 1)).toInt();
      if (hostNumber(hostRead(values, last)).toInt() < value) {
        hostWrite(predecessors, index, last);
        hostWrite(result, resultLength, index);
      } else {
        int low = 0;
        int high = resultLength - 1;
        while (low < high) {
          int middle = (low + high) >> 1;
          int resultIndex = hostNumber(hostRead(result, middle)).toInt();
          if (hostNumber(hostRead(values, resultIndex)).toInt() < value) low = middle + 1;
          else high = middle;
        }
        int selected = hostNumber(hostRead(result, low)).toInt();
        if (value < hostNumber(hostRead(values, selected)).toInt()) {
          if (low > 0) hostWrite(predecessors, index, hostRead(result, low - 1));
          hostWrite(result, low, index);
        }
      }
    }
  }
  int cursor = valueLength(result);
  int valueIndex = hostNumber(hostRead(result, cursor - 1)).toInt();
  while (cursor > 0) {
    cursor -= 1;
    hostWrite(result, cursor, valueIndex);
    valueIndex = hostNumber(hostRead(predecessors, valueIndex)).toInt();
  }
  return result;
}

class RendererKernel {
  JsValue options;
  JsValue insert;
  JsValue remove;
  JsValue patchProp;
  JsValue createElement;
  JsValue createText;
  JsValue createComment;
  JsValue setText;
  JsValue setElementText;
  JsValue parentNode;
  JsValue nextSibling;
  JsValue setScopeId;
  JsValue insertStaticContent;
  bool flushing;

  init(JsValue options) {
    this.options = options;
    this.insert = hostRead(options, "insert");
    this.remove = hostRead(options, "remove");
    this.patchProp = hostRead(options, "patchProp");
    this.createElement = hostRead(options, "createElement");
    this.createText = hostRead(options, "createText");
    this.createComment = hostRead(options, "createComment");
    this.setText = hostRead(options, "setText");
    this.setElementText = hostRead(options, "setElementText");
    this.parentNode = hostRead(options, "parentNode");
    this.nextSibling = hostRead(options, "nextSibling");
    this.setScopeId = hostRead(options, "setScopeId");
    this.insertStaticContent = hostRead(options, "insertStaticContent");
    this.flushing = false;
  }

  JsValue normalizedChild(JsValue children, int index, bool optimized) {
    JsValue raw = hostRead(children, index);
    JsValue child = normalizeVNode(raw);
    if (optimized && isVNode(raw)) child = cloneIfMounted(raw);
    hostWrite(children, index, child);
    return child;
  }

  void invokeHooks(JsValue hooks, JsValue first, JsValue second, int count) {
    if (JS.isNullish(hooks)) return;
    if (dependencyIsArray(hooks)) {
      int length = valueLength(hooks);
      for (int index = 0; index < length; index++) {
        JsValue hook = hostRead(hooks, index);
        if (count == 0) hostCall0(hook);
        else if (count == 1) hostCall1(hook, first);
        else hostCall2(hook, first, second);
      }
    } else {
      if (count == 0) hostCall0(hooks);
      else if (count == 1) hostCall1(hooks, first);
      else hostCall2(hooks, first, second);
    }
  }

  void invokeDirectiveHooks(JsValue vnode, JsValue oldVNode, JsValue parentComponent, string name) {
    JsValue bindings = hostRead(vnode, "dirs");
    if (!dependencyIsArray(bindings)) return;
    JsValue oldBindings = hostRead(oldVNode, "dirs");
    int length = valueLength(bindings);
    for (int index = 0; index < length; index++) {
      JsValue binding = hostRead(bindings, index);
      if (dependencyIsArray(oldBindings) && index < valueLength(oldBindings)) {
        hostWrite(binding, "oldValue", hostRead(hostRead(oldBindings, index), "value"));
      }
      JsValue hook = hostRead(hostRead(binding, "dir"), name);
      if (isFunctionValue(hook)) hostCall4(hook, hostRead(vnode, "el"), binding, vnode, oldVNode);
    }
  }

  void setSingleRef(JsValue rawRef, JsValue vnode, bool unmounting) {
    if (dependencyIsArray(rawRef)) {
      int length = valueLength(rawRef);
      for (int index = 0; index < length; index++) this.setSingleRef(hostRead(rawRef, index), vnode, unmounting);
      return;
    }
    JsValue owner = hostRead(rawRef, "i");
    JsValue reference = hostRead(rawRef, "r");
    if (JS.isNullish(owner)) return;
    JsValue value = null;
    if (!unmounting) {
      int shapeFlag = hostNumber(hostRead(vnode, "shapeFlag")).toInt();
      if ((shapeFlag & 6) != 0) value = hostRead(hostRead(vnode, "component"), "proxy");
      else value = hostRead(vnode, "el");
    }
    JsValue refs = hostRead(owner, "refs");
    if (reference is string) {
      if (hostRead(rawRef, "f").truthy()) {
        JsValue existing = hostRead(refs, reference);
        if (!unmounting) {
          if (!dependencyIsArray(existing)) {
            existing = hostCreateArray(0);
            hostWrite(refs, reference, existing);
          }
          if (!hostArrayIncludes(existing, value)) hostWrite(existing, valueLength(existing), value);
        }
      } else hostWrite(refs, reference, value);
      JsValue setupState = hostRead(owner, "setupState");
      if (hostHasOwn(setupState, reference)) hostWrite(setupState, reference, value);
    } else if (dependencyIsRef(reference)) hostWrite(reference, "value", value);
    else if (isFunctionValue(reference)) hostCall2(reference, value, refs);
  }

  JsValue firstHostNode(JsValue vnode) {
    if ((hostNumber(hostRead(vnode, "shapeFlag")).toInt() & 6) != 0) {
      JsValue component = hostRead(vnode, "component");
      if (!JS.isNullish(component)) return this.firstHostNode(hostRead(component, "subTree"));
    }
    return hostRead(vnode, "el");
  }

  JsValue lastHostNode(JsValue vnode) {
    if ((hostNumber(hostRead(vnode, "shapeFlag")).toInt() & 6) != 0) {
      JsValue component = hostRead(vnode, "component");
      if (!JS.isNullish(component)) return this.lastHostNode(hostRead(component, "subTree"));
    }
    JsValue anchor = hostRead(vnode, "anchor");
    if (JS.isNullish(anchor)) return hostRead(vnode, "el");
    return anchor;
  }

  JsValue nextHostNode(JsValue vnode) {
    return hostCall1(this.nextSibling, this.lastHostNode(vnode));
  }

  void moveVNode(JsValue vnode, JsValue container, JsValue anchor) {
    int shapeFlag = hostNumber(hostRead(vnode, "shapeFlag")).toInt();
    if ((shapeFlag & 6) != 0) {
      JsValue component = hostRead(vnode, "component");
      if (!JS.isNullish(component)) this.moveVNode(hostRead(component, "subTree"), container, anchor);
      return;
    }
    if (JS.strictEqual(hostRead(vnode, "type"), Fragment)) {
      hostCall3(this.insert, hostRead(vnode, "el"), container, anchor);
      JsValue children = hostRead(vnode, "children");
      if (dependencyIsArray(children)) {
        int length = valueLength(children);
        for (int index = 0; index < length; index++) {
          this.moveVNode(hostRead(children, index), container, anchor);
        }
      }
      hostCall3(this.insert, hostRead(vnode, "anchor"), container, anchor);
      return;
    }
    hostCall3(this.insert, hostRead(vnode, "el"), container, anchor);
  }

  void mountChildren(
    JsValue children,
    JsValue container,
    JsValue anchor,
    JsValue parentComponent,
    JsValue namespace,
    bool optimized,
    int start
  ) {
    int length = valueLength(children);
    for (int index = start; index < length; index++) {
      JsValue child = this.normalizedChild(children, index, optimized);
      this.patch(null, child, container, anchor, parentComponent, namespace, optimized);
    }
  }

  void patchProps(JsValue element, JsValue oldProps, JsValue newProps, JsValue parentComponent, JsValue namespace) {
    if (JS.strictEqual(oldProps, newProps)) return;
    JsValue oldObject = oldProps;
    if (JS.isNullish(oldObject)) oldObject = hostCreateObject();
    JsValue newObject = newProps;
    if (JS.isNullish(newObject)) newObject = hostCreateObject();
    if (!JS.isNullish(oldProps)) {
      JsValue oldKeys = hostEnumerableKeys(oldProps);
      int oldLength = valueLength(oldKeys);
      for (int index = 0; index < oldLength; index++) {
        string key = JS.assume(hostRead(oldKeys, index));
        if (!isReservedVNodeProp(key) && !hostHasProperty(newObject, key)) {
          hostCall6(this.patchProp, element, key, hostRead(oldProps, key), null, namespace, parentComponent);
        }
