void processRendererComponent(
  RendererKernel renderer,
  JsValue oldVNode,
  JsValue vnode,
  JsValue container,
  JsValue anchor,
  JsValue parent,
  JsValue namespace,
  bool optimized
) {
  if (JS.isNullish(oldVNode)) {
    JsValue instance = createComponentInstance(vnode, parent, null);
    hostWrite(instance, "_renderer", JS.assume(renderer));
