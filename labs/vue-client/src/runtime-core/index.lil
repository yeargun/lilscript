JsValue resolveAssetValue(string kind, string name, bool maybeSelfReference) {
  JsValue instance = currentRenderingInstance;
  if (JS.isNullish(instance)) instance = currentInstance;
  if (JS.isNullish(instance)) {
    hostWarn("resolve" + dependencyCapitalize(kind.slice(0, kind.length - 1)) + " can only be used in render() or setup().");
    return JS.undefined();
  }
  JsValue component = hostRead(instance, "type");
  if (kind == "components") {
    JsValue selfName = getComponentName(component, false);
    if (selfName.truthy()) {
      string normalizedSelf = dependencyCamelize(hostString(selfName));
      string normalizedName = dependencyCamelize(name);
      if (normalizedSelf == normalizedName || dependencyCapitalize(normalizedSelf) == dependencyCapitalize(normalizedName)) return component;
    }
  }
  JsValue local = hostRead(instance, kind);
  JsValue global = hostRead(hostRead(instance, "appContext"), kind);
  string camel = dependencyCamelize(name);
  string pascal = dependencyCapitalize(camel);
  JsValue value = hostRead(local, name);
  if (!value.truthy()) value = hostRead(local, camel);
  if (!value.truthy()) value = hostRead(local, pascal);
  if (!value.truthy()) value = hostRead(global, name);
  if (!value.truthy()) value = hostRead(global, camel);
  if (!value.truthy()) value = hostRead(global, pascal);
  if (value.truthy()) return value;
  if (maybeSelfReference && kind == "components") return component;
  hostWarn("Failed to resolve " + kind.slice(0, kind.length - 1) + ": " + name);
  return JS.undefined();
}

export JsValue resolveComponent(string name, bool maybeSelfReference = false) {
  JsValue value = resolveAssetValue("components", name, maybeSelfReference);
  if (JS.isUndefined(value)) return name;
  return value;
}

export JsValue resolveDirective(string name) {
  return resolveAssetValue("directives", name, false);
}

export JsValue resolveDynamicComponent(JsValue component) {
  if (component is string) {
    JsValue resolved = resolveAssetValue("components", component, false);
    if (!JS.isUndefined(resolved)) return resolved;
  }
  if (component.truthy()) return component;
  return Comment;
}

export JsValue withDirectives(JsValue vnode, JsValue directives) {
