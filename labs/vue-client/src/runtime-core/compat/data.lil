import { isPlainObject as dataIsPlainObject } from "../../package/shared.lil";
import { DeprecationTypes, warnDeprecation } from "./compatConfig";

export JsValue deepMergeData(JsValue to, JsValue from) {
  for (string key in from) {
    JsValue toValue = to[key];
    JsValue fromValue = from[key];
    if (JS.in(key, to) && dataIsPlainObject(toValue) && dataIsPlainObject(fromValue)) {
      warnDeprecation(JS.string(DeprecationTypes["OPTIONS_DATA_MERGE"]), null, key);
      deepMergeData(toValue, fromValue);
    } else {
      to[key] = fromValue;
    }
  }
  return to;
}
