import extern {
  extend as sharedExtend,
  hasOwn as sharedHasOwn,
  isArray as sharedIsArray,
  isFunction as sharedIsFunction
} from "../../../packages/vuelil/shared.js";
import {
  Array as compatArray,
  Object as compatObject,
  console as compatConsole,
  globalThis as compatGlobal
} from "../../shared/makeMap";
import {
  formatComponentName as compatFormatComponentName,
  getComponentName as compatGetComponentName,
  getCurrentInstance as compatGetCurrentInstance,
  isRuntimeOnly as compatIsRuntimeOnly
} from "../component";
import { warn as compatWarn } from "../warning";

extern JsValue sharedExtend;
extern bool sharedHasOwn(JsValue value, JsValue key);
extern bool sharedIsArray(JsValue value);
extern bool sharedIsFunction(JsValue value);

bool COMPAT_DEV = true;
bool COMPAT_TEST = false;

export JsValue DeprecationTypes = JS.object(
  "GLOBAL_MOUNT", "GLOBAL_MOUNT",
  "GLOBAL_MOUNT_CONTAINER", "GLOBAL_MOUNT_CONTAINER",
  "GLOBAL_EXTEND", "GLOBAL_EXTEND",
  "GLOBAL_PROTOTYPE", "GLOBAL_PROTOTYPE",
