import {read_FEATURE_OPTIONS_API as vue_read_FEATURE_OPTIONS_API, read_FEATURE_PROD_DEVTOOLS as vue_read_FEATURE_PROD_DEVTOOLS, read_FEATURE_PROD_HYDRATION_MISMATCH_DETAILS as vue_read_FEATURE_PROD_HYDRATION_MISMATCH_DETAILS} from "../package/build-flags.lil";
import { getGlobalThis } from "../shared/general";
import { console } from "../shared/makeMap";

define bool DEV = true;

export void initFeatureFlags() {
  string[] needWarn = [];

  if (JS.typeOf(vue_read_FEATURE_OPTIONS_API()) != "boolean") {
    if (DEV) needWarn.push("__VUE_OPTIONS_API__");
    getGlobalThis()["__VUE_OPTIONS_API__"] = true;
  }

  if (JS.typeOf(vue_read_FEATURE_PROD_DEVTOOLS()) != "boolean") {
    if (DEV) needWarn.push("__VUE_PROD_DEVTOOLS__");
    getGlobalThis()["__VUE_PROD_DEVTOOLS__"] = false;
  }

  if (JS.typeOf(vue_read_FEATURE_PROD_HYDRATION_MISMATCH_DETAILS()) != "boolean") {
    if (DEV) needWarn.push("__VUE_PROD_HYDRATION_MISMATCH_DETAILS__");
    getGlobalThis()["__VUE_PROD_HYDRATION_MISMATCH_DETAILS__"] = false;
  }

  if (DEV && needWarn.length > 0) {
    bool multi = needWarn.length > 1;
    string flags = JS.string(JS.invoke(JS.assume(needWarn), "join", ", "));
    string plural = "";
    string verb = "is";
    if (multi) {
      plural = "s";
      verb = "are";
    }
    JS.invoke(
      console,
      "warn",
      "Feature flag" + plural + " " + flags + " " + verb +
        " not explicitly defined. You are running the esm-bundler build of Vue, " +
        "which expects these compile-time feature flags to be globally injected " +
        "via the bundler config in order to get better tree-shaking in the " +
        "production bundle.\n\nFor more details, see https://link.vuejs.org/feature-flags."
    );
  }
}
