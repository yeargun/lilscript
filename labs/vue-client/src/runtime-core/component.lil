import {
  EMPTY_OBJ,
  NOOP,
  extend,
  getGlobalThis,
  isArray,
  isFunction,
  isObject,
  isPromise
} from "../shared/general";
import { makeMap } from "../shared/makeMap";
import { ShapeFlags } from "../shared/shapeFlags";
import { EffectScope } from "../reactivity/effectScope";
import { TrackOpTypes } from "../reactivity/constants";
import { track } from "../reactivity/dep";
import { pauseTracking, resetTracking } from "../reactivity/effect";
import { isRef, proxyRefs } from "../reactivity/ref";
import { markRaw, shallowReadonly } from "../reactivity/reactive";
import { isVNode } from "./vnode";
import {
  PublicInstanceProxyHandlers,
  RuntimeCompiledPublicInstanceProxyHandlers,
  createDevRenderContext,
  exposePropsOnRenderContext,
  exposeSetupStateOnRenderContext,
  publicPropertiesMap
} from "./componentPublicInstance";
import { initProps, normalizePropsOptions } from "./componentProps";
import { initSlots } from "./componentSlots";
import { warn } from "./warning";
import { ErrorCodes, callWithErrorHandling, handleError } from "./errorHandling";
import { createAppContext } from "./apiCreateApp";
import { validateDirectiveName } from "./directives";
import { applyOptions, resolveMergedOptions } from "./componentOptions";
import { emit, normalizeEmitsOptions } from "./componentEmits";
import { markAttrsAccessed } from "./componentRenderUtils";
import { currentRenderingInstance } from "./componentRenderContext";
import { endMeasure, startMeasure } from "./profiling";
