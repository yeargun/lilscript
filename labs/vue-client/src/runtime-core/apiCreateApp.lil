    "mixins", JS.array(),
    "components", appCreateObject(),
    "directives", appCreateObject(),
    "provides", appCreateNullObject(),
    "optionsCache", appCreateWeakMap(),
    "propsCache", appCreateWeakMap(),
    "emitsCache", appCreateWeakMap()
