    "app", null,
    "config", JS.object(
      "isNativeTag", NO,
      "performance", false,
      "globalProperties", appCreateObject(),
      "optionMergeStrategies", appCreateObject(),
      "errorHandler", JS.undefined(),
      "warnHandler", JS.undefined(),
      "compilerOptions", appCreateObject()
