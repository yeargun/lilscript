        vnode["appContext"] = context;
        if (JS.strictEqual(namespace, true)) namespace = "svg";
        else if (JS.strictEqual(namespace, false)) namespace = JS.undefined();

        context["reload"] = JS.method0((JsValue _reloadSelf) => {
          JsValue cloned = cloneVNode(vnode, JS.undefined(), false, false);
          cloned["el"] = null;
