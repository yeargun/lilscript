      string name = JS.string(nameValue);
      if (APP_DEV) validateComponentName(name, context["config"]);
      if (!component.truthy()) return context["components"][name];
      if (APP_DEV && context["components"][name].truthy()) {
        warn("Component \"" + name + "\" has already been registered in target app.");
      }
