        int nextPosition = newEnd + 1;
        JsValue anchor = parentAnchor;
        if (nextPosition < newLength) anchor = newChildren[nextPosition]["el"];
        while (index <= newEnd) {
          JsValue child = newChildren[index];
          if (optimized) child = cloneIfMounted(child);
          else child = normalizeVNode(child);
          newChildren[index] = child;
          this.patch(
            null, child, container, anchor, parentComponent, parentSuspense,
            namespace, slotScopeIds, optimized
          );
          index += 1;
        }
      }
      return;
    }
    if (index > newEnd) {
      while (index <= oldEnd) {
        this.unmount(oldChildren[index], parentComponent, parentSuspense, true, false);
        index += 1;
      }
      return;
    }

    int oldStart = index;
    int newStart = index;
    JsValue keyToNewIndexMap = JS.construct(Map);
    for (index = newStart; index <= newEnd; index++) {
      JsValue nextChild = newChildren[index];
      if (optimized) nextChild = cloneIfMounted(nextChild);
      else nextChild = normalizeVNode(nextChild);
      newChildren[index] = nextChild;
      if (!JS.isNullish(nextChild["key"])) {
        if (DEV && JS.invoke(keyToNewIndexMap, "has", nextChild["key"]).truthy()) {
