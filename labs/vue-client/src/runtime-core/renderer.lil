  }

  void unmountChildren(
    JsValue children,
    JsValue parentComponent,
    JsValue parentSuspense,
    bool doRemove,
    bool optimized,
    int start
  ) {
    for (int index = start; index < rendererLength(children); index++) {
      this.unmount(children[index], parentComponent, parentSuspense, doRemove, optimized);
    }
  }

  JsValue getNextHostNode(JsValue vnode) {
    int shapeFlag = rendererNumber(vnode["shapeFlag"]);
    if ((shapeFlag & rendererNumber(ShapeFlags["COMPONENT"])) != 0) {
      return this.getNextHostNode(vnode["component"]["subTree"]);
    }
    if (
      RENDERER_FEATURE_SUSPENSE &&
      (shapeFlag & rendererNumber(ShapeFlags["SUSPENSE"])) != 0
    ) return JS.call(vnode["suspense"]["next"], vnode["suspense"]);
