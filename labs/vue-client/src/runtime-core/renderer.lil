  void patchChildren(
    JsValue oldVNode,
    JsValue vnode,
    JsValue container,
    JsValue anchor,
    JsValue parentComponent,
    JsValue parentSuspense,
    JsValue namespace,
    JsValue slotScopeIds,
    bool optimized
  ) {
    JsValue oldChildren = null;
    int previousShapeFlag = 0;
    if (oldVNode.truthy()) {
      oldChildren = oldVNode["children"];
      previousShapeFlag = rendererNumber(oldVNode["shapeFlag"]);
    }
    JsValue children = vnode["children"];
    int patchFlag = rendererNumber(vnode["patchFlag"]);
    int shapeFlag = rendererNumber(vnode["shapeFlag"]);
    if (patchFlag > 0) {
      if ((patchFlag & rendererNumber(PatchFlags["KEYED_FRAGMENT"])) != 0) {
        this.patchKeyedChildren(
          oldChildren, children, container, anchor, parentComponent, parentSuspense,
          namespace, slotScopeIds, optimized
