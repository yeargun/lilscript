      }), parentSuspense);
    }
  }

  void removeVNode(JsValue vnode) {
    JsValue type = vnode["type"];
    JsValue element = vnode["el"];
    JsValue anchor = vnode["anchor"];
    JsValue transition = vnode["transition"];
    if (JS.strictEqual(type, Fragment)) {
      int patchFlag = rendererNumber(vnode["patchFlag"]);
