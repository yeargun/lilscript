        DEV && patchFlag > 0 &&
        (patchFlag & rendererNumber(PatchFlags["DEV_ROOT_FRAGMENT"])) != 0 &&
        transition.truthy() && !transition["persisted"].truthy()
      ) {
        JsValue children = vnode["children"];
        for (int index = 0; index < rendererLength(children); index++) {
          JsValue child = children[index];
          if (JS.strictEqual(child["type"], Comment)) {
            JS.call(this.hostRemove, JS.undefined(), child["el"]);
