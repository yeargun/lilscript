    if ((shapeFlag & rendererNumber(ShapeFlags["TEXT_CHILDREN"])) != 0) {
      if ((previousShapeFlag & rendererNumber(ShapeFlags["ARRAY_CHILDREN"])) != 0) {
        this.unmountChildren(oldChildren, parentComponent, parentSuspense, false, false, 0);
      }
      if (!JS.strictEqual(children, oldChildren)) {
        JS.call(this.hostSetElementText, JS.undefined(), container, children);
      }
    } else if ((previousShapeFlag & rendererNumber(ShapeFlags["ARRAY_CHILDREN"])) != 0) {
      if ((shapeFlag & rendererNumber(ShapeFlags["ARRAY_CHILDREN"])) != 0) {
        this.patchKeyedChildren(
          oldChildren, children, container, anchor, parentComponent, parentSuspense,
          namespace, slotScopeIds, optimized
        );
      } else {
        this.unmountChildren(oldChildren, parentComponent, parentSuspense, true, false, 0);
      }
    } else {
      if ((previousShapeFlag & rendererNumber(ShapeFlags["TEXT_CHILDREN"])) != 0) {
        JS.call(this.hostSetElementText, JS.undefined(), container, "");
      }
      if ((shapeFlag & rendererNumber(ShapeFlags["ARRAY_CHILDREN"])) != 0) {
        this.mountChildren(
          children, container, anchor, parentComponent, parentSuspense,
          namespace, slotScopeIds, optimized, 0
        );
      }
    }
  }

  void patchUnkeyedChildren(
    JsValue oldChildren,
    JsValue newChildren,
    JsValue container,
    JsValue anchor,
    JsValue parentComponent,
    JsValue parentSuspense,
    JsValue namespace,
    JsValue slotScopeIds,
    bool optimized
  ) {
    if (!oldChildren.truthy()) oldChildren = EMPTY_ARR;
    if (!newChildren.truthy()) newChildren = EMPTY_ARR;
    int oldLength = rendererLength(oldChildren);
    int newLength = rendererLength(newChildren);
    int commonLength = oldLength;
    if (newLength < commonLength) commonLength = newLength;
    for (int index = 0; index < commonLength; index++) {
      JsValue nextChild = newChildren[index];
      if (optimized) nextChild = cloneIfMounted(nextChild);
      else nextChild = normalizeVNode(nextChild);
      newChildren[index] = nextChild;
      this.patch(
        oldChildren[index], nextChild, container, null, parentComponent,
        parentSuspense, namespace, slotScopeIds, optimized
      );
    }
    if (oldLength > newLength) {
      this.unmountChildren(
        oldChildren, parentComponent, parentSuspense, true, false, commonLength
      );
    } else {
      this.mountChildren(
        newChildren, container, anchor, parentComponent, parentSuspense,
        namespace, slotScopeIds, optimized, commonLength
      );
    }
  }

  void patchKeyedChildren(
    JsValue oldChildren,
    JsValue newChildren,
    JsValue container,
    JsValue parentAnchor,
    JsValue parentComponent,
    JsValue parentSuspense,
    JsValue namespace,
    JsValue slotScopeIds,
    bool optimized
  ) {
    int index = 0;
    int newLength = rendererLength(newChildren);
    int oldEnd = rendererLength(oldChildren) - 1;
    int newEnd = newLength - 1;
    while (index <= oldEnd && index <= newEnd) {
      JsValue oldVNode = oldChildren[index];
      JsValue newVNode = newChildren[index];
      if (optimized) newVNode = cloneIfMounted(newVNode);
      else newVNode = normalizeVNode(newVNode);
      newChildren[index] = newVNode;
      if (!isSameVNodeType(oldVNode, newVNode)) break;
      this.patch(
        oldVNode, newVNode, container, null, parentComponent, parentSuspense,
        namespace, slotScopeIds, optimized
      );
      index += 1;
    }
    while (index <= oldEnd && index <= newEnd) {
      JsValue oldVNode = oldChildren[oldEnd];
      JsValue newVNode = newChildren[newEnd];
      if (optimized) newVNode = cloneIfMounted(newVNode);
      else newVNode = normalizeVNode(newVNode);
      newChildren[newEnd] = newVNode;
      if (!isSameVNodeType(oldVNode, newVNode)) break;
      this.patch(
        oldVNode, newVNode, container, null, parentComponent, parentSuspense,
        namespace, slotScopeIds, optimized
