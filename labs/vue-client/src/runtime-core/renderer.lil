    if (!this.isFlushing) {
      this.isFlushing = true;
      flushPreFlushCbs(instance);
      flushPostFlushCbs();
      this.isFlushing = false;
    }
  }

  JsValue facade() {
    RendererKernel state = this;
    JsValue render = JS.method3((JsValue _self, JsValue vnode, JsValue container, JsValue namespace) => {
      state.renderRoot(vnode, container, namespace);
      return JS.undefined();
    });
    return JS.object(
      "render", render,
      "hydrate", this.hydrate,
      "createApp", createAppAPI(render, this.hydrate)
    );
  }
}

JsValue baseCreateRenderer(JsValue options, JsValue createHydrationFns = JS.undefined()) {
  RendererKernel renderer = new RendererKernel(options, createHydrationFns);
  return renderer.facade();
}

export JsValue createRenderer(JsValue options) {
  return baseCreateRenderer(options);
}

export JsValue createHydrationRenderer(JsValue options) {
  return baseCreateRenderer(options, createHydrationFunctions);
}
