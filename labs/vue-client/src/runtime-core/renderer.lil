    } else {
      JsValue oldVNode = container["_vnode"];
      if (!oldVNode.truthy()) oldVNode = null;
      bool optimized = vnode["dynamicChildren"].truthy();
      if (DEV && isHmrUpdating) optimized = false;
      this.patch(oldVNode, vnode, container, null, null, null, namespace, null, optimized);
    }
