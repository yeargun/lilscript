          this.move(nextChild, container, anchor, rendererNumber(MoveType["REORDER"]), null);
        } else {
          sequenceIndex -= 1;
        }
      }
    }
  }

  void move(
    JsValue vnode,
    JsValue container,
    JsValue anchor,
    int moveType,
    JsValue parentSuspense
