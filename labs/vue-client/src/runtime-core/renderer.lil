    JsValue job = instance["job"];
    JsValue subTree = instance["subTree"];
    JsValue unmounted = instance["um"];
    invalidateMount(instance["m"]);
    invalidateMount(instance["a"]);
    if (beforeUnmount.truthy()) invokeArrayFns(beforeUnmount);
    if (
      RENDERER_COMPAT &&
      isCompatEnabled(JS.string(DeprecationTypes["INSTANCE_EVENT_HOOKS"]), instance)
