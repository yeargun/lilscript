      }
      if ((patchFlag & rendererNumber(PatchFlags["UNKEYED_FRAGMENT"])) != 0) {
        this.patchUnkeyedChildren(
          oldChildren, children, container, anchor, parentComponent, parentSuspense,
          namespace, slotScopeIds, optimized
