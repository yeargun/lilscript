    int patched = 0;
    int toBePatched = newEnd - newStart + 1;
    bool moved = false;
    int maximumNewIndex = 0;
    JsValue newIndexToOldIndexMap = JS.construct(Array, toBePatched);
    for (index = 0; index < toBePatched; index++) newIndexToOldIndexMap[index] = 0;

    for (index = oldStart; index <= oldEnd; index++) {
      JsValue previousChild = oldChildren[index];
      if (patched >= toBePatched) {
        this.unmount(previousChild, parentComponent, parentSuspense, true, false);
        continue;
      }
      int newIndex = -1;
      if (!JS.isNullish(previousChild["key"])) {
        JsValue mapped = JS.invoke(keyToNewIndexMap, "get", previousChild["key"]);
        if (!JS.isUndefined(mapped)) newIndex = rendererNumber(mapped);
      } else {
        for (int search = newStart; search <= newEnd; search++) {
          if (
            rendererNumber(newIndexToOldIndexMap[search - newStart]) == 0 &&
            isSameVNodeType(previousChild, newChildren[search])
          ) {
            newIndex = search;
            break;
          }
        }
      }
      if (newIndex < 0) {
        this.unmount(previousChild, parentComponent, parentSuspense, true, false);
      } else {
        newIndexToOldIndexMap[newIndex - newStart] = index + 1;
        if (newIndex >= maximumNewIndex) maximumNewIndex = newIndex;
        else moved = true;
        this.patch(
          previousChild, newChildren[newIndex], container, null, parentComponent,
          parentSuspense, namespace, slotScopeIds, optimized
        );
        patched += 1;
      }
    }
    JsValue increasingNewIndexSequence = EMPTY_ARR;
    if (moved) increasingNewIndexSequence = getSequence(newIndexToOldIndexMap);
    int sequenceIndex = rendererLength(increasingNewIndexSequence) - 1;
    for (index = toBePatched - 1; index >= 0; index--) {
      int nextIndex = newStart + index;
      JsValue nextChild = newChildren[nextIndex];
      JsValue anchor = parentAnchor;
      if (nextIndex + 1 < newLength) {
        JsValue anchorVNode = newChildren[nextIndex + 1];
        anchor = anchorVNode["el"];
        if (!anchor.truthy()) anchor = resolveAsyncComponentAnchor(anchorVNode);
      }
      if (rendererNumber(newIndexToOldIndexMap[index]) == 0) {
        this.patch(
          null, nextChild, container, anchor, parentComponent, parentSuspense,
          namespace, slotScopeIds, optimized
