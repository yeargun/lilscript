    if (element.truthy()) teleportEnd = element[TeleportEndKey];
    if (teleportEnd.truthy()) return JS.call(this.hostNextSibling, JS.undefined(), teleportEnd);
    return element;
  }

  void renderRoot(JsValue vnode, JsValue container, JsValue namespace) {
    JsValue instance = JS.undefined();
    if (JS.isNullish(vnode)) {
      if (container["_vnode"].truthy()) {
        this.unmount(container["_vnode"], null, null, true, false);
