    if (vnodeHook.truthy() || shouldInvokeDirs || shouldInvalidateMemo) {
      JsValue unmountedHook = vnodeHook;
      JS.call(queuePostRenderEffect, JS.undefined(), JS.method0((JsValue _self) => {
        if (unmountedHook.truthy()) invokeVNodeHook(unmountedHook, parentComponent, vnode);
