        this.removeFragment(element, anchor);
      }
      return;
    }
    if (JS.strictEqual(type, Static)) {
      this.removeStaticNode(vnode);
      return;
    }
    RendererKernel state = this;
    JsValue performRemove = JS.method0((JsValue _self) => {
      JS.call(state.hostRemove, JS.undefined(), element);
      if (transition.truthy() && !transition["persisted"].truthy() &&
        transition["afterLeave"].truthy()) {
        JS.call(transition["afterLeave"], transition);
      }
      return JS.undefined();
    });
    int shapeFlag = rendererNumber(vnode["shapeFlag"]);
    if (
      (shapeFlag & rendererNumber(ShapeFlags["ELEMENT"])) != 0 &&
      transition.truthy() && !transition["persisted"].truthy()
    ) {
      JsValue leave = transition["leave"];
      JsValue delayLeave = transition["delayLeave"];
      JsValue performLeave = JS.method0((JsValue _self) => {
        JS.call(leave, transition, element, performRemove);
        return JS.undefined();
      });
      if (delayLeave.truthy()) {
        JS.call(delayLeave, transition, vnode["el"], performRemove, performLeave);
      } else {
        JS.call(performLeave, JS.undefined());
      }
    } else {
      JS.call(performRemove, JS.undefined());
    }
  }

  void removeFragment(JsValue current, JsValue end) {
    JsValue next = JS.undefined();
    while (!JS.strictEqual(current, end)) {
      next = JS.call(this.hostNextSibling, JS.undefined(), current);
      JS.call(this.hostRemove, JS.undefined(), current);
      current = next;
    }
    JS.call(this.hostRemove, JS.undefined(), end);
  }

  void unmountComponent(JsValue instance, JsValue parentSuspense, bool doRemove) {
