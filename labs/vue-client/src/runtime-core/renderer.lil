import { EffectFlags, ReactiveEffect, pauseTracking, resetTracking } from "../reactivity/effect";
import { DEV, TEST } from "../reactivity/constants";
import {
  EMPTY_ARR,
  EMPTY_OBJ,
  NOOP,
  def,
  getGlobalThis,
  invokeArrayFns,
  isArray,
  isReservedProp
} from "../shared/general";
import { PatchFlags } from "../shared/patchFlags";
import { ShapeFlags } from "../shared/shapeFlags";
import { createAppAPI } from "./apiCreateApp";
import { isAsyncWrapper } from "./apiAsyncComponent";
import {
  createComponentInstance,
  setupComponent
} from "./component";
import {
  filterSingleRoot,
  renderComponentRoot,
  shouldUpdateComponent,
  updateHOCHostEl
} from "./componentRenderUtils";
import { updateProps } from "./componentProps";
import { updateSlots } from "./componentSlots";
import { leaveCbKey } from "./components/BaseTransition";
import { isKeepAlive } from "./components/KeepAlive";
import { TeleportEndKey } from "./components/Teleport";
import { isSuspense, queueEffectWithSuspense } from "./components/Suspense";
import { DeprecationTypes, isCompatEnabled } from "./compat/compatConfig";
import {
  devtoolsComponentAdded,
  devtoolsComponentRemoved,
  devtoolsComponentUpdated,
  setDevtoolsHook
} from "./devtools";
import { invokeDirectiveHook } from "./directives";
import { initFeatureFlags } from "./featureFlags";
import {
  isHmrUpdating,
  registerHMR,
  setHmrUpdating,
  unregisterHMR
} from "./hmr";
import { createHydrationFunctions } from "./hydration";
import { endMeasure, startMeasure } from "./profiling";
import { setRef } from "./rendererTemplateRef";
import {
  SchedulerJobFlags,
  flushPostFlushCbs,
  flushPreFlushCbs,
  queueJob,
  queuePostFlushCb
} from "./scheduler";
import {
  Comment,
  Fragment,
  Static,
  Text,
  cloneIfMounted,
  createVNode,
  invokeVNodeHook,
  isSameVNodeType,
  normalizeVNode
} from "./vnode";
import { popWarningContext, pushWarningContext, warn } from "./warning";

extern JsValue Array;
extern JsValue JSON;
extern JsValue Map;

bool RENDERER_FEATURE_SUSPENSE = true;
bool RENDERER_COMPAT = false;
bool RENDERER_ESM_BUNDLER = false;
bool RENDERER_FEATURE_PROD_DEVTOOLS = false;
string rendererAsyncAnchorKey = "place" + "holder";

export JsValue MoveType = JS.object(
  "ENTER", 0,
  "LEAVE", 1,
  "REORDER", 2,
  "0", "ENTER",
  "1", "LEAVE",
  "2", "REORDER"
);

export JsValue queuePostRenderEffect = JS.method2((JsValue _self, JsValue fn, JsValue suspense) => {
  if (RENDERER_FEATURE_SUSPENSE) {
    if (TEST) queueEffectWithSuspense(fn, suspense);
    else queueEffectWithSuspense(fn, suspense);
  } else {
    queuePostFlushCb(fn);
  }
  return JS.undefined();
});

int rendererLength(JsValue value) {
  return JS.number(value["length"]).toInt();
}

int rendererNumber(JsValue value) {
  return JS.number(value).toInt();
}

bool rendererArray(JsValue value) {
  return JS.call(isArray, JS.undefined(), value).truthy();
}

bool rendererReservedProp(string key) {
  return JS.call(isReservedProp, JS.undefined(), key).truthy();
}

JsValue resolveChildrenNamespace(JsValue vnode, JsValue currentNamespace) {
  JsValue type = vnode["type"];
  JsValue props = vnode["props"];
  bool leaveNamespace =
    (JS.strictEqual(currentNamespace, "svg") && JS.strictEqual(type, "foreignObject")) ||
    (JS.strictEqual(currentNamespace, "mathml") &&
      JS.strictEqual(type, "annotation-xml") &&
      props.truthy() && props["encoding"].truthy() &&
      JS.string(props["encoding"]).includes("html"));
  if (leaveNamespace) return JS.undefined();
  return currentNamespace;
}

void toggleRecurse(JsValue instance, bool allowed) {
  JsValue effect = instance["effect"];
  JsValue job = instance["job"];
  int effectFlags = rendererNumber(effect["flags"]);
  int jobFlags = rendererNumber(job["flags"]);
  if (allowed) {
    effect["flags"] = effectFlags | rendererNumber(EffectFlags["ALLOW_RECURSE"]);
    job["flags"] = jobFlags | rendererNumber(SchedulerJobFlags["ALLOW_RECURSE"]);
  } else {
    effect["flags"] = effectFlags & -33;
    job["flags"] = jobFlags & -5;
  }
}

export JsValue needTransition(JsValue parentSuspense, JsValue transition) {
  bool suspenseReady = !parentSuspense.truthy() || !parentSuspense["pendingBranch"].truthy();
  if (!suspenseReady) return false;
  if (!transition.truthy()) return transition;
  return !transition["persisted"].truthy();
}

export void traverseStaticChildren(JsValue oldVNode, JsValue vnode, bool shallow = false) {
  JsValue oldChildren = oldVNode["children"];
  JsValue children = vnode["children"];
  if (!rendererArray(oldChildren) || !rendererArray(children)) return;
  for (int index = 0; index < rendererLength(oldChildren); index++) {
    JsValue oldChild = oldChildren[index];
    JsValue child = children[index];
    int shapeFlag = rendererNumber(child["shapeFlag"]);
    int patchFlag = rendererNumber(child["patchFlag"]);
    if (
      (shapeFlag & rendererNumber(ShapeFlags["ELEMENT"])) != 0 &&
      !child["dynamicChildren"].truthy()
    ) {
      if (patchFlag <= 0 || patchFlag == rendererNumber(PatchFlags["NEED_HYDRATION"])) {
        child = cloneIfMounted(child);
        children[index] = child;
        child["el"] = oldChild["el"];
      }
      if (!shallow && patchFlag != rendererNumber(PatchFlags["BAIL"])) {
        traverseStaticChildren(oldChild, child);
      }
    }
    if (JS.strictEqual(child["type"], Text)) {
      if (patchFlag == rendererNumber(PatchFlags["CACHED"])) {
        child = cloneIfMounted(child);
        children[index] = child;
      }
      child["el"] = oldChild["el"];
    }
    if (JS.strictEqual(child["type"], Comment) && !child["el"].truthy()) {
      child["el"] = oldChild["el"];
    }
    if (DEV && child["el"].truthy()) child["el"]["__vnode"] = child;
  }
}

JsValue getSequence(JsValue values) {
  JsValue predecessors = JS.invoke(values, "slice");
  JsValue result = JS.array(0);
  int length = rendererLength(values);
  int index = 0;
  int resultIndex = 0;
  int low = 0;
  int high = 0;
  int middle = 0;
  for (index = 0; index < length; index++) {
    int value = rendererNumber(values[index]);
    if (value != 0) {
      resultIndex = rendererNumber(result[rendererLength(result) - 1]);
      if (rendererNumber(values[resultIndex]) < value) {
        predecessors[index] = resultIndex;
        JS.invoke(result, "push", index);
        continue;
      }
      low = 0;
      high = rendererLength(result) - 1;
      while (low < high) {
        middle = (low + high) >> 1;
        if (rendererNumber(values[result[middle]]) < value) low = middle + 1;
        else high = middle;
      }
      if (value < rendererNumber(values[result[low]])) {
        if (low > 0) predecessors[index] = result[low - 1];
        result[low] = index;
      }
    }
  }
  low = rendererLength(result);
  high = rendererNumber(result[low - 1]);
  while (low > 0) {
    low -= 1;
    result[low] = high;
    high = rendererNumber(predecessors[high]);
  }
  return result;
}

JsValue locateNonHydratedAsyncRoot(JsValue instance) {
  JsValue subComponent = instance["subTree"]["component"];
  if (subComponent.truthy()) {
    if (subComponent["asyncDep"].truthy() && !subComponent["asyncResolved"].truthy()) {
      return subComponent;
    }
    return locateNonHydratedAsyncRoot(subComponent);
  }
  return JS.undefined();
}

export void invalidateMount(JsValue hooks) {
  if (!hooks.truthy()) return;
  for (int index = 0; index < rendererLength(hooks); index++) {
    int flags = rendererNumber(hooks[index]["flags"]);
    hooks[index]["flags"] = flags | rendererNumber(SchedulerJobFlags["DISPOSED"]);
  }
}

JsValue resolveAsyncComponentAnchor(JsValue anchorVNode) {
  if (anchorVNode[rendererAsyncAnchorKey].truthy()) return anchorVNode[rendererAsyncAnchorKey];
  JsValue instance = anchorVNode["component"];
  if (instance.truthy()) return resolveAsyncComponentAnchor(instance["subTree"]);
  return null;
}

class RendererKernel {
  JsValue options;
  JsValue hostInsert;
  JsValue hostRemove;
  JsValue hostPatchProp;
  JsValue hostCreateElement;
  JsValue hostCreateText;
  JsValue hostCreateComment;
  JsValue hostSetText;
  JsValue hostSetElementText;
  JsValue hostParentNode;
  JsValue hostNextSibling;
  JsValue hostSetScopeId;
  JsValue hostInsertStaticContent;
  JsValue patchFn;
  JsValue unmountFn;
  JsValue removeFn;
  JsValue moveFn;
  JsValue mountComponentFn;
  JsValue mountChildrenFn;
  JsValue patchChildrenFn;
  JsValue patchBlockChildrenFn;
  JsValue nextFn;
  JsValue setupRenderEffectFn;
  JsValue internals;
  JsValue hydrate;
  JsValue hydrateNode;
  bool isFlushing;

  init(JsValue rendererOptions, JsValue createHydrationFns = JS.undefined()) {
    if (RENDERER_ESM_BUNDLER && !TEST) initFeatureFlags();
    JsValue target = getGlobalThis();
    target["__VUE__"] = true;
    if (DEV || RENDERER_FEATURE_PROD_DEVTOOLS) {
      setDevtoolsHook(target["__VUE_DEVTOOLS_GLOBAL_HOOK__"], target);
    }

    this.options = rendererOptions;
    this.hostInsert = rendererOptions["insert"];
    this.hostRemove = rendererOptions["remove"];
    this.hostPatchProp = rendererOptions["patchProp"];
    this.hostCreateElement = rendererOptions["createElement"];
    this.hostCreateText = rendererOptions["createText"];
    this.hostCreateComment = rendererOptions["createComment"];
    this.hostSetText = rendererOptions["setText"];
    this.hostSetElementText = rendererOptions["setElementText"];
    this.hostParentNode = rendererOptions["parentNode"];
    this.hostNextSibling = rendererOptions["nextSibling"];
    this.hostSetScopeId = rendererOptions["setScopeId"];
    if (!this.hostSetScopeId.truthy()) this.hostSetScopeId = NOOP;
    this.hostInsertStaticContent = rendererOptions["insertStaticContent"];
    this.hydrate = JS.undefined();
    this.hydrateNode = JS.undefined();
    this.isFlushing = false;

    RendererKernel state = this;
    this.patchFn = JS.methodRest((JsValue _self, JsValue args) => {
      state.patchFromArgs(args);
      return JS.undefined();
    });
    this.unmountFn = JS.methodRest((JsValue _self, JsValue args) => {
      state.unmountFromArgs(args);
      return JS.undefined();
    });
    this.removeFn = JS.method1((JsValue _self, JsValue vnode) => {
      state.removeVNode(vnode);
      return JS.undefined();
    });
    this.moveFn = JS.methodRest((JsValue _self, JsValue args) => {
      state.moveFromArgs(args);
      return JS.undefined();
    });
    this.mountComponentFn = JS.methodRest((JsValue _self, JsValue args) => {
      state.mountComponentFromArgs(args);
      return JS.undefined();
    });
    this.mountChildrenFn = JS.methodRest((JsValue _self, JsValue args) => {
      state.mountChildrenFromArgs(args);
      return JS.undefined();
    });
    this.patchChildrenFn = JS.methodRest((JsValue _self, JsValue args) => {
      state.patchChildrenFromArgs(args);
      return JS.undefined();
    });
    this.patchBlockChildrenFn = JS.methodRest((JsValue _self, JsValue args) => {
      state.patchBlockChildren(
        args[0], args[1], args[2], args[3], args[4], args[5], args[6]
      );
      return JS.undefined();
    });
    this.nextFn = JS.method1((JsValue _self, JsValue vnode) => state.getNextHostNode(vnode));
    this.setupRenderEffectFn = JS.methodRest((JsValue _self, JsValue args) => {
      state.setupRenderEffect(
        args[0], args[1], args[2], args[3], args[4], args[5], args[6].truthy()
      );
      return JS.undefined();
    });
    this.internals = JS.object(
      "p", this.patchFn,
      "um", this.unmountFn,
      "r", this.removeFn,
      "m", this.moveFn,
      "mt", this.mountComponentFn,
      "mc", this.mountChildrenFn,
      "pc", this.patchChildrenFn,
      "pbc", this.patchBlockChildrenFn,
      "n", this.nextFn,
      "o", rendererOptions
    );
    if (createHydrationFns.truthy()) {
      JsValue hydrationFunctions = JS.call(createHydrationFns, JS.undefined(), this.internals);
      this.hydrate = hydrationFunctions[0];
      this.hydrateNode = hydrationFunctions[1];
    }
  }

  void patchFromArgs(JsValue args) {
    JsValue anchor = null;
    JsValue parentComponent = null;
    JsValue parentSuspense = null;
    JsValue namespace = JS.undefined();
    JsValue slotScopeIds = null;
    if (rendererLength(args) > 3 && !JS.isUndefined(args[3])) anchor = args[3];
    if (rendererLength(args) > 4 && !JS.isUndefined(args[4])) parentComponent = args[4];
    if (rendererLength(args) > 5 && !JS.isUndefined(args[5])) parentSuspense = args[5];
    if (rendererLength(args) > 6) namespace = args[6];
    if (rendererLength(args) > 7 && !JS.isUndefined(args[7])) slotScopeIds = args[7];
    bool optimized = false;
    if (rendererLength(args) > 8 && !JS.isUndefined(args[8])) optimized = args[8].truthy();
    else if (DEV && isHmrUpdating) optimized = false;
    else optimized = args[1]["dynamicChildren"].truthy();
    this.patch(
      args[0], args[1], args[2], anchor, parentComponent, parentSuspense,
      namespace, slotScopeIds, optimized
    );
  }

  void unmountFromArgs(JsValue args) {
    bool doRemove = false;
    bool optimized = false;
    if (rendererLength(args) > 3) doRemove = args[3].truthy();
    if (rendererLength(args) > 4) optimized = args[4].truthy();
    this.unmount(args[0], args[1], args[2], doRemove, optimized);
  }

  void moveFromArgs(JsValue args) {
    JsValue parentSuspense = null;
    if (rendererLength(args) > 4 && !JS.isUndefined(args[4])) parentSuspense = args[4];
    this.move(args[0], args[1], args[2], rendererNumber(args[3]), parentSuspense);
  }

  void mountComponentFromArgs(JsValue args) {
    this.mountComponent(
      args[0], args[1], args[2], args[3], args[4], args[5], args[6].truthy()
    );
  }

  void mountChildrenFromArgs(JsValue args) {
    int start = 0;
    if (rendererLength(args) > 8 && !JS.isUndefined(args[8])) start = rendererNumber(args[8]);
    this.mountChildren(
      args[0], args[1], args[2], args[3], args[4], args[5], args[6],
      args[7].truthy(), start
    );
  }

  void patchChildrenFromArgs(JsValue args) {
    bool optimized = false;
    if (rendererLength(args) > 8) optimized = args[8].truthy();
    this.patchChildren(
      args[0], args[1], args[2], args[3], args[4], args[5], args[6], args[7], optimized
    );
  }

  void patch(
    JsValue oldVNode,
    JsValue vnode,
    JsValue container,
    JsValue anchor,
    JsValue parentComponent,
    JsValue parentSuspense,
    JsValue namespace,
    JsValue slotScopeIds,
    bool optimized
  ) {
    if (JS.strictEqual(oldVNode, vnode)) return;
    if (oldVNode.truthy() && !isSameVNodeType(oldVNode, vnode)) {
      anchor = this.getNextHostNode(oldVNode);
      this.unmount(oldVNode, parentComponent, parentSuspense, true, false);
      oldVNode = null;
    }
    if (rendererNumber(vnode["patchFlag"]) == rendererNumber(PatchFlags["BAIL"])) {
      optimized = false;
      vnode["dynamicChildren"] = null;
    }

    JsValue type = vnode["type"];
    JsValue reference = vnode["ref"];
    int shapeFlag = rendererNumber(vnode["shapeFlag"]);
    if (JS.strictEqual(type, Text)) {
      this.processText(oldVNode, vnode, container, anchor);
    } else if (JS.strictEqual(type, Comment)) {
      this.processCommentNode(oldVNode, vnode, container, anchor);
    } else if (JS.strictEqual(type, Static)) {
      if (!oldVNode.truthy()) this.mountStaticNode(vnode, container, anchor, namespace);
      else if (DEV) this.patchStaticNode(oldVNode, vnode, container, namespace);
    } else if (JS.strictEqual(type, Fragment)) {
      this.processFragment(
        oldVNode, vnode, container, anchor, parentComponent, parentSuspense,
        namespace, slotScopeIds, optimized
      );
    } else if ((shapeFlag & rendererNumber(ShapeFlags["ELEMENT"])) != 0) {
      this.processElement(
        oldVNode, vnode, container, anchor, parentComponent, parentSuspense,
        namespace, slotScopeIds, optimized
      );
    } else if ((shapeFlag & rendererNumber(ShapeFlags["COMPONENT"])) != 0) {
      this.processComponent(
        oldVNode, vnode, container, anchor, parentComponent, parentSuspense,
        namespace, slotScopeIds, optimized
      );
    } else if ((shapeFlag & rendererNumber(ShapeFlags["TELEPORT"])) != 0) {
      JS.call(
        type["process"], type, oldVNode, vnode, container, anchor, parentComponent,
        parentSuspense, namespace, slotScopeIds, optimized, this.internals
      );
    } else if (
      RENDERER_FEATURE_SUSPENSE &&
      (shapeFlag & rendererNumber(ShapeFlags["SUSPENSE"])) != 0
    ) {
      JS.call(
        type["process"], type, oldVNode, vnode, container, anchor, parentComponent,
        parentSuspense, namespace, slotScopeIds, optimized, this.internals
      );
    } else if (DEV) {
      JS.call(warn, JS.undefined(), "Invalid VNode type:", type, "(" + JS.typeOf(type) + ")");
    }

    if (!JS.isNullish(reference) && parentComponent.truthy()) {
      JsValue oldRef = null;
      if (oldVNode.truthy()) oldRef = oldVNode["ref"];
      setRef(reference, oldRef, parentSuspense, vnode, false);
    } else if (JS.isNullish(reference) && oldVNode.truthy() && !JS.isNullish(oldVNode["ref"])) {
      setRef(oldVNode["ref"], null, parentSuspense, oldVNode, true);
    }
  }

  void processText(JsValue oldVNode, JsValue vnode, JsValue container, JsValue anchor) {
    if (!oldVNode.truthy()) {
      JsValue element = JS.call(this.hostCreateText, JS.undefined(), vnode["children"]);
      vnode["el"] = element;
      JS.call(this.hostInsert, JS.undefined(), element, container, anchor);
    } else {
      JsValue element = oldVNode["el"];
      vnode["el"] = element;
      if (!JS.strictEqual(vnode["children"], oldVNode["children"])) {
        JS.call(this.hostSetText, JS.undefined(), element, vnode["children"]);
      }
    }
  }

  void processCommentNode(JsValue oldVNode, JsValue vnode, JsValue container, JsValue anchor) {
    if (!oldVNode.truthy()) {
      JsValue text = vnode["children"];
      if (!text.truthy()) text = "";
      JsValue element = JS.call(this.hostCreateComment, JS.undefined(), text);
      vnode["el"] = element;
      JS.call(this.hostInsert, JS.undefined(), element, container, anchor);
    } else {
      vnode["el"] = oldVNode["el"];
    }
  }

  void mountStaticNode(JsValue vnode, JsValue container, JsValue anchor, JsValue namespace) {
    JsValue inserted = JS.call(
      this.hostInsertStaticContent,
      JS.undefined(),
      vnode["children"], container, anchor, namespace, vnode["el"], vnode["anchor"]
    );
    vnode["el"] = inserted[0];
    vnode["anchor"] = inserted[1];
  }

  void patchStaticNode(JsValue oldVNode, JsValue vnode, JsValue container, JsValue namespace) {
    if (!JS.strictEqual(vnode["children"], oldVNode["children"])) {
      JsValue anchor = JS.call(this.hostNextSibling, JS.undefined(), oldVNode["anchor"]);
      this.removeStaticNode(oldVNode);
      JsValue inserted = JS.call(
        this.hostInsertStaticContent,
        JS.undefined(),
        vnode["children"], container, anchor, namespace
      );
      vnode["el"] = inserted[0];
      vnode["anchor"] = inserted[1];
    } else {
      vnode["el"] = oldVNode["el"];
      vnode["anchor"] = oldVNode["anchor"];
    }
  }

  void moveStaticNode(JsValue vnode, JsValue container, JsValue nextSibling) {
    JsValue element = vnode["el"];
    JsValue anchor = vnode["anchor"];
    JsValue next = JS.undefined();
    while (element.truthy() && !JS.strictEqual(element, anchor)) {
      next = JS.call(this.hostNextSibling, JS.undefined(), element);
      JS.call(this.hostInsert, JS.undefined(), element, container, nextSibling);
      element = next;
    }
    JS.call(this.hostInsert, JS.undefined(), anchor, container, nextSibling);
  }

  void removeStaticNode(JsValue vnode) {
    JsValue element = vnode["el"];
    JsValue anchor = vnode["anchor"];
    JsValue next = JS.undefined();
    while (element.truthy() && !JS.strictEqual(element, anchor)) {
      next = JS.call(this.hostNextSibling, JS.undefined(), element);
      JS.call(this.hostRemove, JS.undefined(), element);
      element = next;
    }
    JS.call(this.hostRemove, JS.undefined(), anchor);
  }

  void processElement(
    JsValue oldVNode,
    JsValue vnode,
    JsValue container,
    JsValue anchor,
    JsValue parentComponent,
    JsValue parentSuspense,
    JsValue namespace,
    JsValue slotScopeIds,
    bool optimized
  ) {
    if (JS.strictEqual(vnode["type"], "svg")) namespace = "svg";
    else if (JS.strictEqual(vnode["type"], "math")) namespace = "mathml";
    if (!oldVNode.truthy()) {
      this.mountElement(
        vnode, container, anchor, parentComponent, parentSuspense,
        namespace, slotScopeIds, optimized
      );
    } else {
      JsValue customElement = null;
      if (oldVNode["el"].truthy() && oldVNode["el"]["_isVueCE"].truthy()) {
        customElement = oldVNode["el"];
      }
      try {
        if (customElement.truthy()) JS.call(customElement["_beginPatch"], customElement);
        this.patchElement(
          oldVNode, vnode, parentComponent, parentSuspense,
          namespace, slotScopeIds, optimized
        );
      } finally {
        if (customElement.truthy()) JS.call(customElement["_endPatch"], customElement);
      }
    }
  }

  void mountElement(
    JsValue vnode,
    JsValue container,
    JsValue anchor,
    JsValue parentComponent,
    JsValue parentSuspense,
    JsValue namespace,
    JsValue slotScopeIds,
    bool optimized
  ) {
    JsValue props = vnode["props"];
    int shapeFlag = rendererNumber(vnode["shapeFlag"]);
    JsValue transition = vnode["transition"];
    JsValue dirs = vnode["dirs"];
    JsValue customizedBuiltIn = JS.undefined();
    if (props.truthy()) customizedBuiltIn = props["is"];
    JsValue element = JS.call(
      this.hostCreateElement,
      JS.undefined(),
      vnode["type"], namespace, customizedBuiltIn, props
    );
    vnode["el"] = element;
    if ((shapeFlag & rendererNumber(ShapeFlags["TEXT_CHILDREN"])) != 0) {
      JS.call(this.hostSetElementText, JS.undefined(), element, vnode["children"]);
    } else if ((shapeFlag & rendererNumber(ShapeFlags["ARRAY_CHILDREN"])) != 0) {
      this.mountChildren(
        vnode["children"], element, null, parentComponent, parentSuspense,
        resolveChildrenNamespace(vnode, namespace), slotScopeIds, optimized, 0
      );
    }
    if (dirs.truthy()) invokeDirectiveHook(vnode, null, parentComponent, "created");
    this.setScopeId(element, vnode, vnode["scopeId"], slotScopeIds, parentComponent);
    JsValue vnodeHook = null;
    if (props.truthy()) {
      for (string key in props) {
        if (key != "value" && !rendererReservedProp(key)) {
          JS.call(
            this.hostPatchProp,
            JS.undefined(),
            element, key, null, props[key], namespace, parentComponent
          );
        }
      }
      if (JS.in("value", props)) {
        JS.call(this.hostPatchProp, JS.undefined(), element, "value", null, props["value"], namespace);
      }
      vnodeHook = props["onVnodeBeforeMount"];
      if (vnodeHook.truthy()) invokeVNodeHook(vnodeHook, parentComponent, vnode);
    }
    if (DEV || RENDERER_FEATURE_PROD_DEVTOOLS) {
      def(element, "__vnode", vnode, true);
      def(element, "__vueParentComponent", parentComponent, true);
    }
    if (dirs.truthy()) invokeDirectiveHook(vnode, null, parentComponent, "beforeMount");
    bool callTransition = needTransition(parentSuspense, transition).truthy();
    if (callTransition) JS.call(transition["beforeEnter"], transition, element);
    JS.call(this.hostInsert, JS.undefined(), element, container, anchor);
    vnodeHook = null;
    if (props.truthy()) vnodeHook = props["onVnodeMounted"];
    if (vnodeHook.truthy() || callTransition || dirs.truthy()) {
      JsValue mountedHook = vnodeHook;
      bool hmr = DEV && isHmrUpdating;
