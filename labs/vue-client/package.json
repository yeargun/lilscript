{
  "name": "lilscript-vue-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "npm run setup:compiler && npm run setup:upstream",
    "setup:compiler": "node tooling/ensure-compiler.mjs",
    "setup:upstream": "node tooling/setup-upstream.mjs",
    "build:shared": "node scripts/build-shared.mjs",
    "build:reactivity": "node scripts/build-reactivity.mjs",
    "build:runtime-core": "node scripts/build-runtime-core.mjs",
    "build:runtime-dom": "node scripts/build-runtime-dom.mjs",
    "build:runtime-test": "node scripts/build-runtime-test.mjs",
    "build:server-renderer": "node scripts/build-server-renderer.mjs",
    "build:compiler-core": "node scripts/build-compiler-core.mjs",
    "build:compiler-dom": "node scripts/build-compiler-dom.mjs",
    "build:vue-compat": "node scripts/build-vue-compat.mjs",
    "build:vue": "node scripts/build-vue.mjs",
    "build:compatibility": "npx --yes node@24 scripts/build-compatibility.mjs",
    "build:compiler-ssr": "node scripts/build-compiler-ssr.mjs",
    "build:compiler-sfc": "node scripts/build-compiler-sfc.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:shared": "node --test tests/shared.test.mjs",
    "test:reactivity": "node --test tests/reactivity-core.test.mjs",
    "test:runtime-core": "node --test tests/runtime-core-core.test.mjs",
    "test:runtime-test": "node --test tests/runtime-test.test.mjs",
    "test:server-renderer": "node --test tests/server-renderer.test.mjs",
    "test:compiler-core": "node --test tests/compiler-core.test.mjs",
    "test:compiler-dom": "node --test tests/compiler-dom.test.mjs",
    "test:compiler-ssr": "node --test tests/compiler-ssr.test.mjs",
    "test:compiler-sfc": "npm run build:compiler-sfc && node --test tests/compiler-sfc.test.mjs",
    "test:declarations": "npm run build:compatibility && npx --yes node@24 --test tests/package-parity.test.mjs",
    "test:package-parity": "npx --yes node@24 --test tests/package-parity.test.mjs",
    "test:compiler-dom:nesting": "node --test tests/compiler-dom-html-nesting.test.mjs",
    "test:source-parity": "node --test tests/source-parity.test.mjs",
    "test:upstream:shared": "npx --yes node@24 scripts/test-upstream-candidate.mjs --suite shared",
    "test:upstream:shared:reference": "node scripts/test-upstream-reference.mjs --suite shared",
    "test:upstream:reactivity": "node tests/reactivity-upstream.runner.mjs",
    "test:upstream:runtime-core": "node tests/runtime-core-upstream.runner.mjs",
    "test:upstream:runtime-dom": "node tests/runtime-dom-upstream.runner.mjs",
    "test:upstream:runtime-test": "node tests/runtime-test-upstream.runner.mjs",
    "test:upstream:server-renderer": "node tests/server-renderer-upstream.runner.mjs",
    "test:upstream:compiler-core": "node tests/compiler-core-upstream.runner.mjs",
    "test:upstream:compiler-dom": "node tests/compiler-dom-upstream.runner.mjs",
    "test:upstream:vue-compat": "npx --yes node@24 tests/vue-compat-upstream.runner.mjs",
    "test:upstream:vue": "npx --yes node@24 tests/vue-upstream.runner.mjs",
    "test:upstream:compiler-ssr": "node tests/compiler-ssr-upstream.runner.mjs",
    "test:upstream:compiler-sfc": "node tests/compiler-sfc-upstream.runner.mjs",
    "test:scope": "node --test tests/scope.test.mjs",
    "audit:scope": "node scripts/audit-scope.mjs",
    "audit:source-parity": "node scripts/audit-source-parity.mjs",
    "check:foundation": "npm run audit:scope && npm run audit:source-parity && npm run build:shared && npm run build:reactivity && npm run build:runtime-core && npm run build:runtime-dom && npm run build:runtime-test && npm run build:compiler-core && npm run build:compiler-dom && npm run build:vue-compat && npm run build:compiler-ssr && npm run build:server-renderer && npm run build:vue && npm run build:compatibility && npm test && npm run test:upstream:shared && npm run test:upstream:reactivity && npm run test:upstream:runtime-core && npm run test:upstream:runtime-dom && npm run test:upstream:runtime-test && npm run test:upstream:server-renderer && npm run test:upstream:compiler-core && npm run test:upstream:compiler-dom && npm run test:upstream:vue-compat && npm run test:upstream:compiler-ssr && npm run test:upstream:vue",
    "check": "node scripts/check-complete.mjs",
    "build:project-comparison": "node scripts/build-project-comparison.mjs",
    "measure": "npm run build:project-comparison && node scripts/measure.mjs",
    "benchmark": "npx --yes node@24 scripts/benchmark.mjs",
    "test:performance": "node --test tests/performance-protocol.test.mjs",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "dependencies": {
    "@vue/consolidate": "^1.0.0",
    "@vue/reactivity": "3.5.42",
    "@vue/shared": "3.5.42",
    "estree-walker": "^2.0.2",
    "hash-sum": "^2.0.0",
    "lru-cache": "^10.1.0",
    "magic-string": "^0.30.21",
    "merge-source-map": "^1.1.0",
    "minimatch": "^10.2.6",
    "postcss": "^8.5.23",
    "postcss-modules": "^6.0.1",
    "postcss-selector-parser": "^7.1.4",
    "pug": "^3.0.4",
    "sass": "^1.102.0",
    "source-map-js": "^1.2.1",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-sfc": "^3.5.42",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "typescript": "~6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
