void unchangedTrackerSourcesSkipDownstreamMemos() {
  Signal<int> source = createIntSignal(1);
  StringBox order = new StringBox("");
  BoolSignalBox late = new BoolSignalBox();
  Signal<int> conditional = createIntMemo(() => {
    order.append("conditional");
    if (source.read() > 1) {
      late.read();
    }
    return 0;
  });
  Signal<bool> first = createMemo(
    true,
    () => {
      order.append("first");
      return source.read() < 3;
    },
    (bool previous, bool next) => previous == next
  );
  Signal<bool> second = createMemo(
    true,
    () => {
      order.append("second");
      return first.read();
    },
    (bool previous, bool next) => previous == next
  );
  Signal<bool> finalMemo = createMemo(
    true,
    () => {
      order.append("final");
      return second.read();
    },
    (bool previous, bool next) => previous == next
  );
  late.set(finalMemo);
  order.set("");
  source.write(2);
  bool unchanged = order.value == "conditionalfirst" && conditional.read() == 0;
  order.set("");
  source.write(3);
  report(
    81,
    unchanged && order.value == "conditionalfirstsecondfinal" && !finalMemo.read()
  );
}

