void diamondMemoRunsOnce() {
  Signal<int> source = createIntSignal(0);
  Signal<int> left = createIntMemo(() => source.read() + 1);
  Signal<int> right = createIntMemo(() => source.read() + 2);
  IntBox computes = new IntBox(0);
  Signal<int> total = createIntMemo(() => {
    computes.increment();
    return left.read() + right.read();
  });
  computes.set(0);
  source.write(1);
  report(15, computes.value == 1 && total.read() == 5);
}

void memoChangesDependencies() {
  Signal<bool> enabled = createBoolSignal(true);
  Signal<int> left = createIntSignal(1);
  Signal<int> right = createIntSignal(2);
  IntBox computes = new IntBox(0);
  Signal<int> selected = createIntMemo(() => {
    computes.increment();
    if (enabled.read()) {
      return left.read();
    }
    return right.read();
  });
  computes.set(0);
  right.write(4);
  bool ignoredInactive = computes.value == 0 && selected.read() == 1;
  enabled.write(false);
  computes.set(0);
  left.write(5);
  bool removedOld = computes.value == 0;
  right.write(6);
  report(16, ignoredInactive && removedOld && computes.value == 1 && selected.read() == 6);
}

void nestedBatchesFlushOnce() {
  Signal<int> source = createIntSignal(0);
  IntBox runs = new IntBox(0);
  createEffect(() => {
    source.read();
    runs.increment();
  });
  batch(() => {
    source.write(1);
    batch(() => {
      source.write(2);
      return 0;
    });
    source.write(3);
    return 0;
  });
  report(17, runs.value == 2 && source.read() == 3);
}

