void report(int caseId, bool passed) {
  if (diagnosticPendingEffects() > 1000000) {
    takeNextEffect();
  }
  print("case:" + caseId + ":" + passed);
}

class IntBox {
  int value;

  init(int value) {
    this.value = value;
  }

  void increment() {
    this.value += 1;
  }

  void set(int value) {
    this.value = value;
  }
}

class StringBox {
  string value;

  init(string value) {
    this.value = value;
  }

  void set(string value) {
    this.value = value;
  }

  void append(string value) {
    this.value = this.value + value;
  }
}

class GreetingProps {
  string greeting;
  Signal<string> name;

  init(string greeting, Signal<string> name) {
    this.greeting = greeting;
    this.name = name;
  }
}

class OwnerBox {
  OwnerHandle? value;

  init() {
    this.value = null;
  }

  void set(OwnerHandle? value) {
    this.value = value;
  }
}

class DisposeBox {
  func()->void value;

  init() {
    this.value = () => {};
  }

  void set(func()->void value) {
    this.value = value;
  }

  void run() {
    func()->void value = this.value;
    value();
  }
}

class IntSignalBox {
  Signal<int> value;

  init() {
    this.value = createIntSignal(0);
  }

  void set(Signal<int> value) {
    this.value = value;
  }

  int read() {
    return this.value.read();
  }
}

class BoolSignalBox {
  Signal<bool> value;

  init() {
    this.value = createBoolSignal(false);
  }

  void set(Signal<bool> value) {
    this.value = value;
  }

  bool read() {
    return this.value.read();
  }
}

class MappedRow {
  int value;
  Signal<int> index;

  init(int value, Signal<int> index) {
    this.value = value;
    this.index = index;
  }

  int currentIndex() {
    return this.index.read();
  }
}

class IndexedRow {
  Signal<int> value;
  int index;

  init(Signal<int> value, int index) {
    this.value = value;
    this.index = index;
  }

  int currentValue() {
    return this.value.read();
  }
}

class IntAccessorBox {
  func()->int value;

  init(func()->int value) {
    this.value = value;
  }

  int read() {
    func()->int value = this.value;
    return value();
  }
}

class StringProducer {
  func(string)->string setter;
  bool active;
  int cleanupRuns;

  init() {
    this.setter = (string value) => value;
    this.active = false;
    this.cleanupRuns = 0;
  }

  func()->void connect(func(string)->string setter) {
    this.setter = setter;
    this.active = true;
    setter("connected");
    return () => {
      this.active = false;
      this.cleanupRuns += 1;
    };
  }

  void emit(string value) {
    if (this.active) {
      func(string)->string setter = this.setter;
      setter(value);
    }
  }
}

class StringFutureSource {
  Future<string>[] requests;

  init() {
    this.requests = [];
  }

  Future<string> fetch(string key) {
    Future<string> request = new Future("");
    this.requests.push(request);
    return request;
  }

  void resolve(int index, string value) {
    this.requests[index].resolve(value);
  }

  void reject(int index, string error) {
    this.requests[index].reject(error);
  }
}

Signal<int[]> createIntArraySignal(int[] initial) {
  return createSignal(
    initial,
    (int[] previous, int[] next) => previous == next
  );
}

void signalReadAndUpdate() {
  Signal<int> signal = createIntSignal(5);
  bool initial = signal.read() == 5;
  signal.write(10);
  report(1, initial && signal.read() == 10);
}

void signalComparator() {
  Signal<int> signal = createIntSignalWithEquals(5, (int previous, int next) => previous > next);
  signal.write(3);
  report(2, signal.read() == 5);
}

void defaultSignalComparatorSkipsEqualWrites() {
  Signal<string> signal = createSignal("same");
  IntBox runs = new IntBox(0);
  func()->void dispose = createRoot((func()->void dispose) => {
    createEffect(() => {
      signal.read();
      runs.increment();
    });
    return dispose;
  });
  signal.write("same");
  bool skippedInitial = runs.value == 1;
  signal.write("next");
  signal.write("next");
  report(106, skippedInitial && runs.value == 2);
  dispose();
}

void memoReceivesInitialValue() {
  Signal<string> memo = createRoot((func()->void dispose) => {
    Signal<string> created = createMemoWithPrevious(
      "Hello",
      (string previous) => previous + " John"
    );
    return created;
  });
  report(107, memo.read() == "Hello John");
}

void onTracksMultipleExplicitDependencies() {
  Signal<string> text = createSignal("thoughts");
  Signal<int> count = createSignal(3);
  StringBox observed = new StringBox("");
  func()->void dispose = createRoot((func()->void dispose) => {
    createEffect(on2(
      text,
      count,
      (string textValue, int countValue) => {
        observed.set(textValue + "-" + countValue);
      }
    ));
    return dispose;
  });
  bool initial = observed.value == "thoughts-3";
  count.write(4);
  bool countUpdated = observed.value == "thoughts-4";
  text.write("minds");
  report(108, initial && countUpdated && observed.value == "minds-4");
  dispose();
}

void deferredOnReceivesInitialAccumulator() {
  Signal<string> source = createSignal("thoughts");
  StringBox observed = new StringBox("");
  func()->void dispose = createRoot((func()->void dispose) => {
    createEffect(onWithInitial(
      source,
      "numbers",
      (string value, string previous) => {
        string next = previous + "-" + value;
        observed.set(next);
        return next;
      }
    ));
    return dispose;
  });
  bool deferred = observed.value == "";
  source.write("minds");
  report(109, deferred && observed.value == "numbers-minds");
  dispose();
}

void cleanupsDisposeInReverseRegistrationOrder() {
  StringBox order = new StringBox("");
  func()->void dispose = createRoot((func()->void dispose) => {
    onCleanup(() => order.append("a"));
    onCleanup(() => order.append("b"));
    onCleanup(() => order.append("c"));
    return dispose;
  });
  dispose();
  report(110, order.value == "cba");
}

void staleOwnerHandlesCannotAttachToReusedRoots() {
  OwnerBox stale = new OwnerBox();
  OwnerBox fresh = new OwnerBox();
  func()->void disposeStale = createRoot((func()->void dispose) => {
    stale.set(getOwner());
    return dispose;
  });
  disposeStale();
  func()->void disposeFresh = createRoot((func()->void dispose) => {
    fresh.set(getOwner());
    return dispose;
  });
  IntBox detached = new IntBox(0);
  runWithOwner(stale.value, () => {
    if (getOwner() == null) {
      detached.set(1);
    }
    return 0;
  });
  bool reusedSafely = false;
  OwnerHandle? staleValue = stale.value;
  OwnerHandle? freshValue = fresh.value;
  if (staleValue != null && freshValue != null) {
    reusedSafely = staleValue.kind == 0 && freshValue.kind != 0 &&
      staleValue.id == freshValue.id &&
      staleValue != freshValue;
  }
  report(111, reusedSafely && detached.value == 1);
  disposeFresh();
}

void disposedEffectSlotsAreReusedWithoutRevivingHandles() {
  OwnerBox stale = new OwnerBox();
  OwnerBox fresh = new OwnerBox();
  func()->void disposeStale = createRoot((func()->void dispose) => {
    createEffect(() => stale.set(getListener()));
    return dispose;
  });
  disposeStale();
  func()->void disposeFresh = createRoot((func()->void dispose) => {
    createEffect(() => fresh.set(getListener()));
    return dispose;
  });
  bool reusedSafely = false;
  OwnerHandle? staleValue = stale.value;
  OwnerHandle? freshValue = fresh.value;
  if (staleValue != null && freshValue != null) {
    reusedSafely = staleValue.kind == 0 && freshValue.kind != 0 &&
      staleValue.id == freshValue.id &&
      staleValue != freshValue;
  }
  report(112, reusedSafely);
  disposeFresh();
}

void repeatedReadsRunOnce() {
  Signal<int> signal = createIntSignal(0);
  IntBox runs = new IntBox(0);
  func()->void dispose = createRoot((func()->void dispose) => {
    createEffect(() => {
      runs.increment();
      for (int index = 0; index < 100; index++) {
        signal.read();
      }
    });
    return dispose;
  });
  signal.write(1);
  report(3, runs.value == 2);
  dispose();
}

void disposedEffectsStop() {
  Signal<int> signal = createIntSignal(0);
  IntBox runs = new IntBox(0);
  func()->void dispose = createRoot((func()->void dispose) => {
    createEffect(() => {
      signal.read();
      runs.increment();
    });
    return dispose;
  });
  signal.write(1);
  dispose();
  signal.write(2);
  report(4, runs.value == 2);
}

void conditionalDependencies() {
  Signal<bool> enabled = createBoolSignal(true);
  Signal<int> value = createIntSignal(0);
  IntBox runs = new IntBox(0);
  func()->void dispose = createRoot((func()->void dispose) => {
    createEffect(() => {
      runs.increment();
      if (enabled.read()) {
        value.read();
      }
    });
    return dispose;
  });
  value.write(1);
  enabled.write(false);
  value.write(2);
  bool inactiveSkipped = runs.value == 3;
  enabled.write(true);
  value.write(3);
  report(5, inactiveSkipped && runs.value == 5);
  dispose();
}

void memoUpdates() {
  Signal<int> source = createIntSignal(2);
  Signal<int> memo = createIntMemo(() => source.read() * 3);
  bool initial = memo.read() == 6;
  source.write(4);
  report(6, initial && memo.read() == 12);
}

void unchangedMemoDoesNotPropagate() {
  Signal<int> source = createIntSignalWithEquals(1, (int previous, int next) => false);
  Signal<int> memo = createIntMemo(() => source.read() % 2);
  IntBox runs = new IntBox(0);
  createEffect(() => {
    memo.read();
    runs.increment();
  });
  source.write(3);
  report(7, runs.value == 1);
}

void effectsRunImmediatelyAndUpdate() {
