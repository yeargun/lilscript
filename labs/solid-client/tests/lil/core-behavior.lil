  Context<int> context = createContext(1);
  IntBox inherited = new IntBox(0);
  IntBox overridden = new IntBox(0);
  context.provide(4, () => {
    createEffect(() => inherited.set(useContext(context)));
    context.provide(9, () => overridden.set(useContext(context)));
  });
