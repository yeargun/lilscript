  IntBox cleanups = new IntBox(0);
  func()->void dispose = createRoot((func()->void dispose) => {
    onCleanup(() => cleanups.increment());
    return dispose;
  });
  dispose();
  dispose();
  report(19, cleanups.value == 1);
}

void cleanupRegistersAgainAfterRerun() {
  Signal<int> source = createIntSignal(0);
  IntBox cleanups = new IntBox(0);
  createEffect(() => {
    source.read();
    onCleanup(() => cleanups.increment());
  });
  source.write(1);
  source.write(2);
  report(20, cleanups.value == 2);
}

void genericStringSignalUpdates() {
  Signal<string> signal = createSignal(
    "first",
    (string previous, string next) => previous == next
  );
  signal.update((string value) => value + "-second");
  report(21, signal.read() == "first-second");
}

void genericBoolMemoUpdates() {
  Signal<bool> source = createSignal(
    false,
    (bool previous, bool next) => previous == next
  );
  Signal<bool> memo = createMemo(
    true,
    () => !source.read(),
    (bool previous, bool next) => previous == next
  );
  bool initial = memo.read();
  source.write(true);
  report(22, initial && !memo.read());
}

void genericUntrackReturnsString() {
  Signal<string> source = createSignal(
    "tracked",
    (string previous, string next) => previous == next
  );
  IntBox runs = new IntBox(0);
  createEffect(() => {
    string value = untrack(() => source.read());
    if (value == "tracked") {
      runs.increment();
    }
  });
  source.write("changed");
  report(23, runs.value == 1);
}

void reactionIsOneShotAndRearms() {
  Signal<string> source = createSignal(
    "thoughts",
    (string previous, string next) => previous == next
  );
  IntBox runs = new IntBox(0);
  func(func()->void)->void track = createReaction(() => runs.increment());
  track(() => {
    source.read();
  });
  bool initial = runs.value == 0;
  source.write("mind");
  source.write("body");
  bool oneShot = runs.value == 1;
  track(() => {
    source.read();
  });
  source.write("everything");
  report(24, initial && oneShot && runs.value == 2);
}

