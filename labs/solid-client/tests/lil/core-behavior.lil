void mapArrayDisposesRemovedRows() {
  Signal<int[]> source = createIntArraySignal([1, 2, 3]);
  IntBox cleanups = new IntBox(0);
  DisposeBox rootDispose = new DisposeBox();
  func()->MappedRow[] mapped = createRoot((func()->void dispose) => {
    rootDispose.set(dispose);
    return mapArray(source, (int value, Signal<int> index) => {
      onCleanup(() => cleanups.increment());
      return new MappedRow(value, index);
    });
  });
  mapped();
  source.write([1, 3]);
  mapped();
  bool removed = cleanups.value == 1;
  rootDispose.run();
  report(51, removed && cleanups.value == 3);
}

void mapArrayKeepsDuplicateRowsStable() {
  Signal<int[]> source = createIntArraySignal([1, 1, 2]);
  func()->MappedRow[] mapped = mapArray(
    source,
    (int value, Signal<int> index) => new MappedRow(value, index)
  );
  MappedRow[] initial = mapped();
  MappedRow firstOne = initial[0];
  MappedRow secondOne = initial[1];
  MappedRow two = initial[2];
  source.write([1, 2, 1]);
  MappedRow[] reordered = mapped();
  bool chained =
    reordered[0] == firstOne && reordered[1] == two && reordered[2] == secondOne &&
      firstOne.currentIndex() == 0 && two.currentIndex() == 1 &&
      secondOne.currentIndex() == 2;
  source.write([2, 1, 3]);
  MappedRow[] beforeSuffixDuplicate = mapped();
  MappedRow preservedOne = beforeSuffixDuplicate[1];
  MappedRow preservedThree = beforeSuffixDuplicate[2];
  source.write([1, 1, 3]);
  MappedRow[] suffixDuplicate = mapped();
  report(
    52,
    chained && suffixDuplicate[0] != preservedOne &&
      suffixDuplicate[1] == preservedOne && suffixDuplicate[2] == preservedThree &&
      suffixDuplicate[0].currentIndex() == 0 &&
      preservedOne.currentIndex() == 1 && preservedThree.currentIndex() == 2
  );
}

string|int doubledFallbackValue(int value, Signal<int> index) {
  return value * 2;
}

string renderFallbackValue(string|int value) {
  if (value is string) {
    return value;
  } else {
    return "item-" + value;
  }
}

void mapArrayFallbackHasOwnedLifecycle() {
  Signal<int[]> source = createIntArraySignal([]);
  IntBox creates = new IntBox(0);
  IntBox cleanups = new IntBox(0);
  DisposeBox rootDispose = new DisposeBox();
  func()->(string|int)[] mapped = createRoot((func()->void dispose) => {
    rootDispose.set(dispose);
    return mapArrayWithFallback(
      source,
      doubledFallbackValue,
      () => {
        creates.increment();
        onCleanup(() => cleanups.increment());
        return "empty";
      }
    );
  });
  (string|int)[] empty = mapped();
  mapped();
  bool reused =
    empty.length == 1 && renderFallbackValue(empty[0]) == "empty" && creates.value == 1;
  source.write([4]);
  (string|int)[] item = mapped();
  bool replaced =
    item.length == 1 && renderFallbackValue(item[0]) == "item-8" && cleanups.value == 1;
  source.write([]);
  mapped();
  bool recreated = creates.value == 2;
  rootDispose.run();
  report(53, reused && replaced && recreated && cleanups.value == 2);
}

