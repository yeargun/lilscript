}

void computedRunsImmediatelyAndUpdates() {
  Signal<int> source = createIntSignal(0);
  IntBox runs = new IntBox(0);
  IntBox duringRoot = new IntBox(0);
  createRoot((func()->void dispose) => {
    createComputed(() => {
      source.read();
      runs.increment();
    });
    if (runs.value == 1) {
      duringRoot.set(1);
    }
    return 0;
  });
  source.write(1);
  report(37, duringRoot.value == 1 && runs.value == 2);
}

