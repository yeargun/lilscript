    return dispose;
  });
  createRootWithOwner((func()->void childDispose) => {
    createEffect(() => {
      source.read();
      runs.increment();
    });
    return 0;
  }, parent.value, true);
  source.write(1);
  bool active = runs.value == 2;
  parentDispose();
  source.write(2);
  report(59, active && runs.value == 2);
}

