  bool initial = observed.value == -1;
  source.write(5);
  report(26, initial && observed.value == 5);
}

void onMountRunsCallback() {
  IntBox runs = new IntBox(0);
  createRoot((func()->void dispose) => {
    onMount(() => runs.increment());
    return 0;
  });
  report(27, runs.value == 1);
}

void untrackPreservesOwnership() {
  Signal<int> source = createIntSignal(0);
  IntBox runs = new IntBox(0);
  func()->void dispose = createRoot((func()->void dispose) => {
    untrackInt(() => {
      createEffect(() => {
        source.read();
        runs.increment();
      });
      return 0;
    });
    return dispose;
  });
  source.write(1);
  dispose();
  source.write(2);
  report(28, runs.value == 2);
}

void onMountDefersUntilRootReturns() {
  IntBox phase = new IntBox(0);
  IntBox duringRoot = new IntBox(0);
  createRoot((func()->void dispose) => {
    onMount(() => phase.set(2));
    if (phase.value == 0) {
      duringRoot.set(1);
    }
    return 0;
  });
  report(29, duringRoot.value == 1 && phase.value == 2);
}

void onMountCleanupBelongsToRoot() {
  IntBox cleanups = new IntBox(0);
  func()->void dispose = createRoot((func()->void dispose) => {
    onMount(() => {
      onCleanup(() => cleanups.increment());
    });
    return dispose;
  });
  bool before = cleanups.value == 0;
  dispose();
  report(30, before && cleanups.value == 1);
}

void getOwnerCapturesCurrentRoot() {
  IntBox valid = new IntBox(0);
  createRoot((func()->void dispose) => {
    OwnerHandle? owner = getOwner();
    if (owner != null) {
      if (owner.kind == 1) {
        valid.set(1);
      }
    }
    return 0;
  });
  report(31, valid.value == 1);
}

void nestedRootsRetainParentOwner() {
  IntBox matches = new IntBox(0);
  createRoot((func()->void dispose) => {
    OwnerHandle? outer = getOwner();
    if (outer != null) {
      createRoot((func()->void nestedDispose) => {
        OwnerHandle? current = getOwner();
        if (current != null) {
          OwnerHandle? parent = current.owner;
          if (parent != null) {
            if (parent == outer) {
              matches.set(1);
            }
          }
        }
        return 0;
      });
    }
    return 0;
  });
  report(32, matches.value == 1);
}

void runWithOwnerSchedulesAndDisposes() {
  OwnerBox owner = new OwnerBox();
  IntBox effectRuns = new IntBox(0);
  IntBox cleanupRuns = new IntBox(0);
  IntBox duringCallback = new IntBox(0);
  func()->void dispose = createRoot((func()->void dispose) => {
    owner.set(getOwner());
    return dispose;
  });
  runWithOwner(owner.value, () => {
    createEffect(() => effectRuns.increment());
    onCleanup(() => cleanupRuns.increment());
    if (effectRuns.value == 0 && cleanupRuns.value == 0) {
      duringCallback.set(1);
    }
    return 0;
  });
  bool after = effectRuns.value == 1 && cleanupRuns.value == 0;
  dispose();
  report(33, duringCallback.value == 1 && after && cleanupRuns.value == 1);
}

void runWithOwnerDoesNotTrack() {
  OwnerBox owner = new OwnerBox();
  createRoot((func()->void dispose) => {
    owner.set(getOwner());
    return 0;
  });
  Signal<int> source = createIntSignal(0);
  IntBox runs = new IntBox(0);
  createEffect(() => {
    runs.increment();
    runWithOwner(owner.value, () => {
      source.read();
      return 0;
    });
  });
  source.write(1);
  report(34, runs.value == 1);
}

void getOwnerIsNullOutsideOwnership() {
  report(43, getOwner() == null);
}

void listenerReflectsTrackingAndUntrack() {
  IntBox tracked = new IntBox(0);
  IntBox muted = new IntBox(0);
  bool outside = getListener() == null;
  createEffect(() => {
    OwnerHandle? listener = getListener();
    OwnerHandle? owner = getOwner();
    if (listener != null) {
      if (owner != null) {
        if (listener == owner) {
          tracked.set(1);
        }
      }
    }
    muted.set(untrackInt(() => {
      if (getListener() == null) {
        return 1;
      }
      return 0;
    }));
  });
  report(44, outside && tracked.value == 1 && muted.value == 1);
}

void rootReturnsCallbackResultAndProvidesDisposer() {
  DisposeBox disposer = new DisposeBox();
  IntBox cleanups = new IntBox(0);
  int result = createRoot((func()->void dispose) => {
    disposer.set(dispose);
    onCleanup(() => cleanups.increment());
    return 17;
  });
  bool before = cleanups.value == 0;
  disposer.run();
  report(45, result == 17 && before && cleanups.value == 1);
}

void cleanupReturnsRegisteredCallback() {
  DisposeBox returned = new DisposeBox();
  IntBox runs = new IntBox(0);
  func()->void dispose = createRoot((func()->void dispose) => {
    returned.set(onCleanup(() => runs.increment()));
    return dispose;
  });
  returned.run();
  bool manual = runs.value == 1;
  dispose();
  report(46, manual && runs.value == 2);
}

void runWithOwnerReturnsCallbackResult() {
  string result = runWithOwner(null, () => {
    if (getOwner() == null) {
      return "detached";
    }
    return "owned";
  });
  report(47, result == "detached");
}

void batchReturnsCallbackResult() {
