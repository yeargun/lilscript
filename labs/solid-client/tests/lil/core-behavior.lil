void hostSchedulerDrivesOneFlushForQueuedTasks() {
  DisposeBox scheduled = new DisposeBox();
  IntBox scheduleCalls = new IntBox(0);
  StringBox order = new StringBox("");
  enableScheduling((func()->void callback) => {
    scheduleCalls.increment();
    scheduled.set(callback);
  });
  requestCallback((bool didTimeout) => order.append("first"), 10);
  requestCallback((bool didTimeout) => order.append("second"), 20);
  bool pending = scheduleCalls.value == 1 && order.value == "";
  scheduled.run();
  enableScheduling((func()->void callback) => {});
  report(85, pending && order.value == "firstsecond");
}

void resourceLoadsInitialFuture() {
  Signal<string> source = createSignal(
    "1",
    (string previous, string next) => previous == next
  );
  StringFutureSource futures = new StringFutureSource();
  Resource<string,string> resource = createResource(
    source,
    (string key) => futures.fetch(key),
    "Loading",
    (string previous, string next) => previous == next
  );
  bool pending =
    resource.value.read() == "Loading" &&
    resource.loading.read() &&
    resource.state.read() == "pending";
  futures.resolve(0, "John");
  bool stillPending = resource.value.read() == "Loading";
  flushCallbacks();
  report(
    86,
    pending &&
    stillPending &&
    resource.value.read() == "John" &&
    !resource.loading.read() &&
    resource.state.read() == "ready"
  );
}

void resourceIgnoresOutOfOrderResults() {
  Signal<string> source = createSignal(
    "1",
    (string previous, string next) => previous == next
  );
  StringFutureSource futures = new StringFutureSource();
  Resource<string,string> resource = createResource(
    source,
    (string key) => futures.fetch(key),
    "Loading",
    (string previous, string next) => previous == next
  );
  source.write("2");
  source.write("3");
  futures.resolve(2, "Jake");
  futures.resolve(1, "Jo");
  futures.resolve(0, "John");
  flushCallbacks();
  report(87, resource.value.read() == "Jake" && !resource.loading.read());
}

void resourceMutatesAndRefetches() {
  Signal<string> source = createSignal(
    "1",
    (string previous, string next) => previous == next
  );
  StringFutureSource futures = new StringFutureSource();
  Resource<string,string> resource = createResource(
    source,
    (string key) => futures.fetch(key),
    "Loading",
    (string previous, string next) => previous == next
  );
  futures.resolve(0, "John");
  flushCallbacks();
  resource.mutate("Manual");
  bool mutated = resource.value.read() == "Manual";
  resource.refetch();
  bool refreshing = resource.loading.read() && resource.state.read() == "refreshing";
  futures.resolve(1, "Fresh");
  flushCallbacks();
  report(
    88,
    mutated && refreshing && resource.value.read() == "Fresh" && resource.state.read() == "ready"
  );
}

void disposedResourcesIgnoreFutureResults() {
  Signal<string> source = createSignal(
    "1",
    (string previous, string next) => previous == next
  );
  StringFutureSource futures = new StringFutureSource();
  DisposeBox rootDispose = new DisposeBox();
  Resource<string,string> resource = createRoot((func()->void dispose) => {
    rootDispose.set(dispose);
    return createResource(
      source,
      (string key) => futures.fetch(key),
      "Loading",
      (string previous, string next) => previous == next
    );
  });
  rootDispose.run();
  futures.resolve(0, "Ignored");
  flushCallbacks();
  report(89, resource.value.read() == "Loading");
}

void resourceRecordsFutureRejections() {
  Signal<string> source = createSignal(
    "1",
    (string previous, string next) => previous == next
  );
  StringFutureSource futures = new StringFutureSource();
  Resource<string,string> resource = createResource(
    source,
    (string key) => futures.fetch(key),
    "Loading",
    (string previous, string next) => previous == next
  );
  futures.reject(0, "Because I said so");
  bool pending = resource.state.read() == "pending";
  flushCallbacks();
  report(
    90,
    pending &&
    resource.state.read() == "errored" &&
    resource.error.read() == "Because I said so" &&
    !resource.loading.read() &&
    resource.value.read() == "Loading"
  );
}

void resourceIgnoresStaleFutureRejections() {
  Signal<string> source = createSignal(
    "1",
    (string previous, string next) => previous == next
  );
  StringFutureSource futures = new StringFutureSource();
  Resource<string,string> resource = createResource(
    source,
    (string key) => futures.fetch(key),
    "Loading",
    (string previous, string next) => previous == next
  );
  source.write("2");
  futures.resolve(1, "Current");
  futures.reject(0, "Stale");
  flushCallbacks();
  report(
    91,
    resource.state.read() == "ready" &&
    resource.error.read() == "" &&
    resource.value.read() == "Current"
  );
}

void resourcesRecoverAfterRejection() {
  Signal<string> source = createSignal(
    "1",
    (string previous, string next) => previous == next
  );
  StringFutureSource futures = new StringFutureSource();
  Resource<string,string> resource = createResource(
    source,
    (string key) => futures.fetch(key),
    "Loading",
    (string previous, string next) => previous == next
  );
  futures.reject(0, "Failure");
  flushCallbacks();
  bool failed = resource.state.read() == "errored";
  source.write("2");
  bool retrying =
    resource.state.read() == "pending" &&
    resource.loading.read() &&
    resource.error.read() == "";
  futures.resolve(1, "Recovered");
  flushCallbacks();
  report(
    92,
    failed &&
    retrying &&
    resource.state.read() == "ready" &&
    resource.value.read() == "Recovered"
  );
}

string greetingComponent(GreetingProps props) {
  return props.greeting + " " + props.name.read();
}

string cleanupComponent(IntBox cleanups) {
  onCleanup(() => cleanups.increment());
  return "owned";
}

void componentInvocationIsUntracked() {
  Signal<string> name = createSignal(
    "dynamic",
    (string previous, string next) => previous == next
  );
  GreetingProps props = new GreetingProps("Hi", name);
  IntBox runs = new IntBox(0);
  StringBox output = new StringBox("");
  createEffect(() => {
    runs.increment();
    output.set(createComponent(greetingComponent, props));
  });
  name.write("changed");
  report(93, runs.value == 1 && output.value == "Hi dynamic");
}

void componentInvocationPreservesOwnership() {
  IntBox cleanups = new IntBox(0);
  DisposeBox rootDispose = new DisposeBox();
  string output = createRoot((func()->void dispose) => {
    rootDispose.set(dispose);
    return createComponent(cleanupComponent, cleanups);
  });
  bool created = output == "owned" && cleanups.value == 0;
  rootDispose.run();
  report(94, created && cleanups.value == 1);
}

void contextProviderReturnsAndReleasesItsValue() {
  Context<string> context = createContext("light");
  OwnerBox providerOwner = new OwnerBox();
  StringBox provided = new StringBox("");
  func()->void dispose = createRoot((func()->void dispose) => {
    provided.set(context.provide("dark", () => {
      providerOwner.set(getOwner());
      return useContext(context);
    }));
    return dispose;
  });
  dispose();
  string after = runWithOwner(
    providerOwner.value,
    () => useContext(context)
  );
  report(95, provided.value == "dark" && after == "light");
}

void showCachesTheActiveBooleanBranch() {
  Signal<bool> visible = createBoolSignal(false);
  IntBox childRuns = new IntBox(0);
  IntBox fallbackRuns = new IntBox(0);
  Signal<string> output = show(
    visible,
    "",
    () => {
      childRuns.increment();
      return "shown";
    },
    () => {
      fallbackRuns.increment();
      return "hidden";
    },
    (string previous, string next) => previous == next
  );
  bool initial = output.read() == "hidden" && fallbackRuns.value == 1;
  visible.write(true);
  bool shown = output.read() == "shown" && childRuns.value == 1;
  visible.write(true);
  bool cached = childRuns.value == 1;
  visible.write(false);
  report(
    96,
    initial && shown && cached && output.read() == "hidden" &&
      fallbackRuns.value == 2
  );
}

void showOwnsAndDisposesBranchWork() {
  Signal<bool> visible = createBoolSignal(false);
  IntBox childCleanups = new IntBox(0);
  IntBox fallbackCleanups = new IntBox(0);
  DisposeBox rootDispose = new DisposeBox();
  Signal<string> output = createRoot((func()->void dispose) => {
    rootDispose.set(dispose);
    return show(
      visible,
      "",
      () => {
        onCleanup(() => childCleanups.increment());
        return "shown";
      },
      () => {
        onCleanup(() => fallbackCleanups.increment());
        return "hidden";
      },
      (string previous, string next) => previous == next
    );
  });
  visible.write(true);
  bool entered = output.read() == "shown" && fallbackCleanups.value == 1;
  visible.write(false);
  bool left = output.read() == "hidden" && childCleanups.value == 1;
  rootDispose.run();
  report(97, entered && left && fallbackCleanups.value == 2);
}

void keyedShowTracksKeysButNotChildReads() {
  Signal<int> key = createIntSignal(1);
  Signal<int> incidental = createIntSignal(0);
  IntBox childRuns = new IntBox(0);
  IntBox fallbackRuns = new IntBox(0);
  Signal<string> output = showKeyedInt(
    key,
    "",
    (int value) => {
      childRuns.increment();
      return value + ":" + incidental.read();
    },
    () => {
      fallbackRuns.increment();
      return "hidden";
    },
    (string previous, string next) => previous == next
  );
  bool initial = output.read() == "1:0" && childRuns.value == 1;
  incidental.write(1);
  bool untracked = output.read() == "1:0" && childRuns.value == 1;
  key.write(2);
  bool keyed = output.read() == "2:1" && childRuns.value == 2;
  key.write(0);
  report(
    98,
    initial && untracked && keyed && output.read() == "hidden" &&
      fallbackRuns.value == 1
  );
}

void forEachPreservesKeyedRows() {
  Signal<int[]> source = createIntArraySignal([1, 2]);
  func()->MappedRow[] rows = forEach(
    source,
    (int value, Signal<int> index) => new MappedRow(value, index)
  );
  MappedRow[] initial = rows();
  MappedRow first = initial[0];
  MappedRow second = initial[1];
  source.write([2, 1]);
  MappedRow[] reordered = rows();
  report(
    99,
    reordered[0] == second && reordered[1] == first &&
      second.currentIndex() == 0 && first.currentIndex() == 1
  );
}

void indexEachPreservesPositionalRows() {
  Signal<int[]> source = createIntArraySignal([1, 2]);
  IntBox maps = new IntBox(0);
  func()->IndexedRow[] rows = indexEach(
    source,
    (Signal<int> value, int index) => {
      maps.increment();
      return new IndexedRow(value, index);
    }
  );
  IndexedRow[] initial = rows();
  IndexedRow first = initial[0];
  IndexedRow second = initial[1];
  source.write([4, 5]);
  IndexedRow[] updated = rows();
  report(
    100,
    maps.value == 2 && updated[0] == first && updated[1] == second &&
      first.currentValue() == 4 && second.currentValue() == 5
  );
}

void mappedRowsOutliveTrackingEffectReruns() {
  Signal<int[]> source = createIntArraySignal([1, 2]);
  IntBox maps = new IntBox(0);
  IntBox runs = new IntBox(0);
  IntBox cleanups = new IntBox(0);
  func()->void dispose = createRoot((func()->void dispose) => {
    func()->MappedRow[] rows = mapArray(
      source,
      (int value, Signal<int> index) => {
        maps.increment();
        onCleanup(() => cleanups.increment());
        return new MappedRow(value, index);
      }
    );
    createEffect(() => {
      rows();
      runs.increment();
    });
    return dispose;
  });
  source.write([2, 1]);
  bool retained = maps.value == 2 && runs.value == 2 && cleanups.value == 0;
  dispose();
  report(101, retained && cleanups.value == 2);
}

void switchSelectsFirstMatchAndPrunesConditions() {
  Signal<int> a = createIntSignal(0);
  Signal<int> b = createIntSignal(0);
  Signal<int> c = createIntSignal(0);
  IntBox aEvals = new IntBox(0);
  IntBox bEvals = new IntBox(0);
  IntBox cEvals = new IntBox(0);
  BoolMatch<string>[] matches = [
    new BoolMatch(
      () => {
        aEvals.increment();
        return a.read() != 0;
      },
      () => "a"
    ),
    new BoolMatch(
      () => {
        bEvals.increment();
        return b.read() != 0;
      },
      () => "b"
    ),
    new BoolMatch(
      () => {
        cEvals.increment();
        return c.read() != 0;
      },
      () => "c"
    )
  ];
  Signal<string> output = switchBool(
    matches,
    "",
    () => "fallback",
    (string previous, string next) => previous == next
  );
  bool initial = output.read() == "fallback" &&
    aEvals.value == 1 && bEvals.value == 1 && cEvals.value == 1;
  c.write(5);
  bool third = output.read() == "c" &&
    aEvals.value == 1 && bEvals.value == 1 && cEvals.value == 2;
  a.write(1);
  bool first = output.read() == "a" &&
    aEvals.value == 2 && bEvals.value == 1 && cEvals.value == 2;
  b.write(3);
  c.write(4);
  bool lowerSkipped = output.read() == "a" &&
    aEvals.value == 2 && bEvals.value == 1 && cEvals.value == 2;
  a.write(0);
  bool second = output.read() == "b" &&
    aEvals.value == 3 && bEvals.value == 2 && cEvals.value == 2;
  b.write(0);
  c.write(0);
  report(
    102,
    initial && third && first && lowerSkipped && second &&
      output.read() == "fallback"
  );
}

void nonKeyedSwitchCachesBranchAndExposesAccessor() {
  Signal<int> key = createIntSignal(0);
  IntBox childRuns = new IntBox(0);
  IntBox fallbackRuns = new IntBox(0);
  IntMatch<IntAccessorBox>[] matches = [
    new IntMatch(
      () => key.read(),
      (func()->int value) => {
        childRuns.increment();
        return new IntAccessorBox(value);
      }
    )
  ];
  IntAccessorBox empty = new IntAccessorBox(() => 0);
  Signal<IntAccessorBox> output = switchInt(
    matches,
    empty,
    () => {
      fallbackRuns.increment();
      return empty;
    },
    (IntAccessorBox previous, IntAccessorBox next) => previous == next
  );
  bool initial = output.read() == empty && fallbackRuns.value == 1;
  key.write(1);
  IntAccessorBox active = output.read();
  bool entered = active.read() == 1 && childRuns.value == 1;
  key.write(2);
  bool cached = output.read() == active && active.read() == 2 &&
    childRuns.value == 1;
  key.write(0);
  report(
    103,
    initial && entered && cached && output.read() == empty &&
      fallbackRuns.value == 2
  );
}

void keyedSwitchRecreatesAndDisposesBranches() {
  Signal<int> first = createIntSignal(0);
  Signal<int> second = createIntSignal(0);
  IntBox childRuns = new IntBox(0);
  IntBox cleanups = new IntBox(0);
  DisposeBox rootDispose = new DisposeBox();
  Signal<string> output = createRoot((func()->void dispose) => {
    rootDispose.set(dispose);
    KeyedIntMatch<string>[] matches = [
      new KeyedIntMatch(
        () => first.read(),
        (int value) => {
          childRuns.increment();
          onCleanup(() => cleanups.increment());
          return "first:" + value;
        }
      ),
      new KeyedIntMatch(
        () => second.read(),
        (int value) => {
          childRuns.increment();
          onCleanup(() => cleanups.increment());
          return "second:" + value;
        }
      )
    ];
    return switchKeyedInt(
      matches,
      "",
      () => "fallback",
      (string previous, string next) => previous == next
    );
  });
  second.write(2);
  bool secondSelected = output.read() == "second:2" && childRuns.value == 1;
  first.write(1);
  bool firstSelected = output.read() == "first:1" &&
    childRuns.value == 2 && cleanups.value == 1;
  first.write(3);
  bool keyed = output.read() == "first:3" &&
    childRuns.value == 3 && cleanups.value == 2;
  second.write(4);
  bool lowerSkipped = output.read() == "first:3" && childRuns.value == 3;
  rootDispose.run();
  report(
    104,
    secondSelected && firstSelected && keyed && lowerSkipped &&
      cleanups.value == 3
  );
}

void childrenResolveLargeNestedArrays() {
  int[] items = [];
  for (int index = 0; index < 100000; index++) {
    items.push(index);
  }
  Signal<int[]> resolved = createRoot((func()->void dispose) => {
    return children(() => {
      int[][] nested = [];
      nested.push(items);
      return nested;
    });
  });
  int[] values = resolved.read();
  report(
    105,
    values.length == items.length && values[0] == 0 && values[99999] == 99999
  );
}


void observableDeliversAndUnsubscribes() {
  Signal<string> source = createSignal(
    "Hi",
    (string previous, string next) => previous == next
  );
  Observable<string> stream = observable(() => source.read());
  StringBox observed = new StringBox("missing");
  Subscription subscription = stream.subscribe((string value) => observed.set(value));
  bool initial = observed.value == "Hi";
  source.write("John");
  bool updated = observed.value == "John";
  subscription.unsubscribe();
  subscription.unsubscribe();
  source.write("Benjamin");
  report(68, initial && updated && observed.value == "John" && subscription.closed);
}

void observableSubscriptionBelongsToOwner() {
  Signal<int> source = createIntSignal(1);
  Observable<int> stream = observable(() => source.read());
  IntBox observed = new IntBox(0);
  func()->void dispose = createRoot((func()->void dispose) => {
    stream.subscribe((int value) => observed.set(value));
    return dispose;
  });
  source.write(2);
  bool active = observed.value == 2;
  dispose();
  source.write(3);
  report(69, active && observed.value == 2);
}

void observableObserversAreUntracked() {
  Signal<int> source = createIntSignal(1);
  Signal<int> incidental = createIntSignal(0);
  Observable<int> stream = observable(() => source.read());
  IntBox runs = new IntBox(0);
  stream.subscribe((int value) => {
    incidental.read();
    runs.increment();
  });
  incidental.write(1);
  bool ignored = runs.value == 1;
  source.write(2);
  report(70, ignored && runs.value == 2);
}

void fromProducerUpdatesAndCleansUp() {
  StringProducer producer = new StringProducer();
  DisposeBox rootDispose = new DisposeBox();
  Signal<string> value = createRoot((func()->void dispose) => {
    rootDispose.set(dispose);
    return from(
      (func(string)->string setter) => producer.connect(setter),
      "initial"
    );
  });
  bool initial = value.read() == "connected";
  producer.emit("next");
  bool updated = value.read() == "next";
  rootDispose.run();
  producer.emit("ignored");
  report(
    71,
    initial && updated && value.read() == "next" && producer.cleanupRuns == 1
  );
}

void fromObservableMirrorsValues() {
  Signal<string> source = createSignal(
    "Hi",
    (string previous, string next) => previous == next
  );
  Observable<string> stream = observable(() => source.read());
  Signal<string> mirrored = createRoot((func()->void dispose) => {
    return fromObservable(stream, "initial");
  });
  bool initial = mirrored.read() == "Hi";
  source.write("John");
  report(72, initial && mirrored.read() == "John");
}

void contextUsesDefaultAndProvider() {
  Context<string> context = createContext("default");
  StringBox observed = new StringBox("missing");
  bool fallbackBefore = useContext(context) == "default";
  context.provide("provided", () => observed.set(useContext(context)));
  bool fallbackAfter = useContext(context) == "default";
  report(35, fallbackBefore && observed.value == "provided" && fallbackAfter);
}

