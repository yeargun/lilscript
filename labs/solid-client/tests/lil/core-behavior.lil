void nestedEffectsAreReplaced() {
  Signal<int> outer = createIntSignal(0);
  Signal<int> inner = createIntSignal(0);
  IntBox innerRuns = new IntBox(0);
  func()->void dispose = createRoot((func()->void dispose) => {
    createEffect(() => {
      outer.read();
      createEffect(() => {
        inner.read();
        innerRuns.increment();
      });
    });
    return dispose;
  });
  outer.write(1);
  inner.write(1);
  report(14, innerRuns.value == 3);
