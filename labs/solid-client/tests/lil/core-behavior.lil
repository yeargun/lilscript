void interceptingMemosRunDownstreamOnce() {
  Signal<int> first = createIntSignal(1);
  Signal<bool> second = createBoolSignal(false);
  Signal<bool> left = createMemo(
    true,
    () => first.read() > 0,
    (bool previous, bool next) => previous == next
  );
  Signal<bool> right = createMemo(
    true,
    () => first.read() > 0,
    (bool previous, bool next) => previous == next
  );
  Signal<int> center = createIntMemo(() => first.read());
  Signal<bool> joined = createMemo(
    false,
    () => first.read() > 0 && second.read(),
    (bool previous, bool next) => previous == next
  );
  IntBox runs = new IntBox(0);
  Signal<int> downstream = createIntMemo(() => {
    left.read();
    right.read();
    center.read();
    joined.read();
    runs.increment();
    return runs.value;
  });
  second.write(true);
  bool secondUpdate = runs.value == 2;
  first.write(2);
  report(77, secondUpdate && runs.value == 3 && downstream.read() == 3);
}

