  Signal<int> second = createIntMemo(() => source.read());
  Signal<int> third = createIntMemo(() => source.read());
  Signal<int> lowerOne = createIntMemo(() => first.read() + second.read() + third.read());
  Signal<int> lowerTwo = createIntMemo(() => first.read() + second.read() + third.read());
  Signal<int> lowerThree = createIntMemo(() => first.read() + second.read() + third.read());
  IntBox runs = new IntBox(0);
  Signal<int> total = createIntMemo(() => {
    runs.increment();
    return lowerOne.read() + lowerTwo.read() + lowerThree.read();
  });
