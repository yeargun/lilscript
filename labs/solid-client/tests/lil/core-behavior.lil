void computedPrecedesDeferredUserEffects() {
  Signal<int> source = createIntSignal(0);
  IntBox observed = new IntBox(-1);
  IntBox deferred = new IntBox(0);
  createRoot((func()->void dispose) => {
    createEffect(() => observed.set(source.read()));
    createComputed(() => {
      source.write(5);
    });
    if (observed.value == -1) {
      deferred.set(1);
    }
    return 0;
  });
  report(39, deferred.value == 1 && observed.value == 5);
}

void selectorInvalidatesOnlyChangedKeys() {
  Signal<int> source = createIntSignal(-1);
  Selector<int> selector = createSelector(
    source,
    (int key, int value) => key == value
  );
  IntBox zeroRuns = new IntBox(0);
  IntBox oneRuns = new IntBox(0);
  createEffect(() => {
    selector.selected(0);
    zeroRuns.increment();
  });
  createEffect(() => {
    selector.selected(1);
    oneRuns.increment();
  });
  source.write(0);
  bool selectedZero = zeroRuns.value == 2 && oneRuns.value == 1;
  source.write(1);
  bool selectedOne = zeroRuns.value == 3 && oneRuns.value == 2;
  source.write(2);
  report(40, selectedZero && selectedOne && zeroRuns.value == 3 && oneRuns.value == 3);
}

void selectorSupportsDuplicateSubscribers() {
  Signal<int> source = createIntSignal(-1);
  Selector<int> selector = createSelector(
    source,
    (int key, int value) => key == value
  );
  IntBox runs = new IntBox(0);
  createEffect(() => {
    selector.selected(3);
    runs.increment();
  });
  createEffect(() => {
    selector.selected(3);
    runs.increment();
  });
  source.write(3);
  bool selected = runs.value == 4;
  source.write(6);
  report(41, selected && runs.value == 6);
}

void selectorUsesCustomEquality() {
  Signal<int> source = createIntSignal(0);
  Selector<int> selector = createSelector(
    source,
    (int key, int value) => key % 2 == value % 2
  );
  IntBox runs = new IntBox(0);
  createEffect(() => {
    selector.selected(0);
    runs.increment();
  });
  source.write(2);
  bool equivalentSkipped = runs.value == 1;
  source.write(3);
  report(42, equivalentSkipped && runs.value == 2);
}

