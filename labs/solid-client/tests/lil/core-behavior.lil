  source.write(4);
  report(9, runs.value == 1);
}

void batchGroupsWrites() {
  Signal<int> left = createIntSignal(0);
  Signal<int> right = createIntSignal(0);
  IntBox runs = new IntBox(0);
  IntBox total = new IntBox(0);
  createEffect(() => {
    runs.increment();
    total.set(left.read() + right.read());
  });
  batch(() => {
    left.write(2);
    right.write(3);
    return 0;
  });
  report(10, runs.value == 2 && total.value == 5);
}

