void schedulerOrdersAndCancelsCallbacks() {
  StringBox order = new StringBox("");
  Task cancelled = requestCallback(
    (bool didTimeout) => order.append("cancelled"),
    0
  );
  cancelCallback(cancelled);
  requestCallback((bool didTimeout) => order.append("late"));
  requestCallback((bool didTimeout) => order.append("early"), 10);
  requestCallback((bool didTimeout) => order.append("middle"), 40);
  bool deferred = order.value == "";
  flushCallbacks();
  report(83, deferred && order.value == "earlymiddlelate");
}

void deferredSignalsCoalesceUntilSchedulerFlush() {
