// The `none` lane prints 4; the default preset and the reference interpreter
// print 2. Two is the only possible answer: one gate, two call sites, one call.
//
// Delete the class -- which nothing references -- and the `none` lane prints 2.
int calls = 0;
bool probe(int v) { calls++; return (v & 1) == 0; }

class Unused { int value; init(int v) { this.value = v; } }

int go(int x) {
  int a = 1;
  int b = x;
  bool gate = probe(a) && ((a ^ b) < 0) || probe(b);
  int old = b++;
  b += old;
  if (gate) { --b; } else { ++b; }
  return b;
}

print(go(5));
print(calls);
