extern int profileIterations();
int run(int count) {
    Regex[] patterns=[newline,blockCode,fences,hr,heading,lheading,lheadingGfm,def,list,html,paragraph,blockquote,gfmTable,paragraphGfm,blockText,htmlPed,defPed,headingPed,lheadingPed,paragraphPed,escapeRe,inlineCode,br,inlineText,punctuation,blockSkip,emStrongLDelim,emStrongLDelimGfm,emStrongLDelimPedantic,emStrongRDelimAst,emStrongRDelimAstGfm,emStrongRDelimAstPedantic,emStrongRDelimUnd,emStrongRDelimUndPedantic,delLDelim,delRDelim,anyPunctuation,autolink,tag,link,reflink,nolink,reflinkSearch,urlRe,backpedal,textGfm,brBreaks,textBreaks,linkPed,reflinkPed,otherCodeRemoveIndent,otherOutputLinkReplace,otherIndentCodeCompensation,otherBeginningSpace,otherEndingHash,otherStartingSpaceChar,otherEndingSpaceChar,otherNonSpaceChar,otherNewLineCharGlobal,otherTabCharGlobal,otherMultipleSpaceGlobal,otherBlankLine,otherDoubleBlankLine,otherBlockquoteStart,otherBlockquoteSetextReplace,otherBlockquoteSetextReplace2,otherListReplaceNesting,otherListIsTask,otherListReplaceTask,otherListTaskCheckbox,otherAnyLine,otherHrefBrackets,otherTableDelimiter,otherTableAlignChars,otherTableRowBlankLine,otherTableAlignRight,otherTableAlignCenter,otherTableAlignLeft,otherStartATag,otherEndATag,otherStartPreScriptTag,otherEndPreScriptTag,otherStartAngleBracket,otherEndAngleBracket,otherPedanticHrefTitle,otherUnicodeAlphaNumeric,otherEscapeTest,otherEscapeTestNoEncode,otherPercentDecode,otherSlashPipe,otherCarriageReturn,otherSpaceLine,otherNotSpaceStart,nextBullet0,nextBullet1,nextBullet2,nextBullet3,hrIndent0,hrIndent1,hrIndent2,hrIndent3,fencesBegin0,fencesBegin1,fencesBegin2,fencesBegin3,headingBegin0,headingBegin1,headingBegin2,headingBegin3,htmlBegin0,htmlBegin1,htmlBegin2,htmlBegin3,blockquoteBegin0,blockquoteBegin1,blockquoteBegin2,blockquoteBegin3];
    string[] inputs=["# heading\n", "## two ##\n", "ordinary text\nnext line\n", "---\n", "```js\nconst a=1;\n```\n", "> quote\n> text\n", "1. first\n2. second\n", "- first\n\n", "<div>hello</div>\n\n", "[name]: https://example.test \"title\"\n", "[link](https://example.test)", "![alt](image.png)", "<x@y.test>", "*em* **strong** _test_", "~~gone~~", "`code`", "a | b\n---|---\nx | y\n", "Stra\u00dfe \u03a3 \ud83d\ude00\n", "\\*escaped\\*", "\n\n", "    code\n", "<https://example.test/a>", "plain &amp; entity", ""];
