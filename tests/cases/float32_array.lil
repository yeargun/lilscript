ArrayBuffer buffer = new ArrayBuffer(16);
Float32Array values = new Float32Array(buffer);
print(buffer.byteLength);
print(values.length);
print(values.byteLength);
print(values.byteOffset);
print(values.buffer == buffer);

values[0] = 1.25;
values[1] = 1.0 / 3.0;
print(values[0]);
print(values[1] != 1.0 / 3.0);

Float32Array window = values.subarray(1, 3);
print(window.length);
print(window.byteOffset);
window[0] = 2.5;
print(values[1]);

Float32Array copied = values.slice(1, 3);
print(copied.length);
copied[0] = 3.5;
print(copied[0]);
print(values[1]);

SharedArrayBuffer shared = new SharedArrayBuffer(8);
Float32Array sharedValues = new Float32Array(shared);
sharedValues[1] = 4.5;
print(sharedValues.length);
print(sharedValues[1]);
