float positive = 1.5;
float negative = -1.5;
float negativeZero = -0.0;
print(positive.round());
print(negative.round());
print(negativeZero.round().atan2(-1.0) < 0.0);
print(9.0.sqrt());
print(0.0.sin());
print(0.0.cos());
print(1.0.acos());
print(0.0.exp());
print(1.0.log());
print(0.0.tan());
float angle = 1.0.atan2(0.0);
print(angle > 1.5 && angle < 1.6);
print(3.0.hypot(4.0));
print(3.9.toInt());
print((-3.9).toInt());
print(4294967297.0.toInt());
print(2147483648.0.toInt());
float infinity = 1.0 / 0.0;
print(infinity.toInt());
