extern int read();int h1(int x){if(x<0){return 0;}return x+1;}int h2(int x){if(x<0){return 0;}return x+2;}int h3(int x){if(x<0){return 0;}return x+3;}int h4(int x){if(x<0){return 0;}return x+4;}int left(int x){return h1(x)+h2(x)+h3(x)+h4(x);}int right(int x){return h1(x)+h2(x)+h3(x)+h4(x)+1;}int g1(int x){if(x<0){return 0;}return x+5;}int g2(int x){if(x<0){return 0;}return x+6;}int g3(int x){if(x<0){return 0;}return x+7;}int g4(int x){if(x<0){return 0;}return x+8;}int outerLeft(int x){return g1(x)+g2(x)+g3(x)+g4(x)+left(x)+right(x);}int outerRight(int x){return g1(x)+g2(x)+g3(x)+g4(x)+2;}print(outerLeft(read())+outerRight(read()));
