// motionlil's development-only diagnostics: empty bodies reached through
// exported function-typed bindings. A direct call of an empty body is
// dropped. A call through the binding is dropped once initialization order
// (M6.5) proves the binding initialized where it is read: `clamp` runs only
// after the bindings settle. Either way the arguments' own effects (`noted`)
// run.
void warningImpl(bool check,string message,string? code){}
void invariantImpl(bool check,string message,string? code){}
export func(bool,string,string?)->void warning=warningImpl;
export func(bool,string,string?)->void invariant=invariantImpl;
bool noted(bool value){print("noted");return value;}
int clamp(int value){
  warningImpl(value>10,"clamped",null);
  warning(value>10,"clamped",null);
  invariant(noted(value>=0),"negative",null);
  if(value>10){return 10;}
  return value;
}
print(clamp(12));
print(clamp(3));
