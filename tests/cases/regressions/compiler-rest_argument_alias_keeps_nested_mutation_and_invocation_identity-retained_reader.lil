// The test imported the exported `make` from a Node module; here the program also hands
// `make` to the host driver `drive` (see .host.js).
extern JsValue invoke(JsValue callback);
extern int slot();
extern void drive(func(JsValue)->JsValue make);
export JsValue make(JsValue enclosing) {
    JsValue method = JS.methodRest((JsValue _self, JsValue incoming) => {
        JsValue saved = incoming;
        return invoke(() => {
            JsValue selected = invoke(() => saved[slot()]);
            saved = null;
            return [selected, () => saved];
        });
    });
    return [method, () => enclosing];
}
drive(make);
