{
  "Variable declaration": {
    "prefix": "var",
    "body": ["${1:int} ${2:name} = ${3:0};"],
    "description": "Declare an initialized LilScript binding"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "${1:int} ${2:name}(${3:int} ${4:value}) {",
      "  return ${5:value};",
      "}"
    ],
    "description": "Declare a typed LilScript function"
  },
  "Async function": {
    "prefix": "asyncfn",
    "body": [
      "async ${1:int} ${2:name}(${3:int} ${4:value}) {",
      "  return await Task.resolve(${5:${4:value}});",
      "}"
    ],
    "description": "Declare a typed JavaScript-target async function"
  },
  "Generator function": {
    "prefix": "genfn",
    "body": [
      "generator ${1:int} ${2:values}(${3:int} ${4:stop}) {",
      "  for (int index = 0; index < ${4:stop}; index++) {",
      "    yield index;",
      "  }",
      "}"
    ],
    "description": "Declare a typed JavaScript-target generator"
  },
  "Try catch finally": {
    "prefix": "try",
    "body": [
      "try {",
      "  ${1}",
      "} catch (auto ${2:error}) {",
      "  ${3}",
      "} finally {",
      "  ${4}",
      "}"
    ],
    "description": "Handle a JavaScript-target exception with guaranteed cleanup"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "  ${2:int} ${3:field};",
      "}"
    ],
    "description": "Declare an LilScript struct"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "  ${2:int} ${3:field};",
      "",
      "  init(${2:int} ${3:field}) {",
      "    this.${3:field} = ${3:field};",
      "  }",
      "}"
    ],
    "description": "Declare an LilScript class and constructor"
  },
  "Derived class": {
    "prefix": "extends",
    "body": [
      "class ${1:Child} extends ${2:Base} {",
      "  init(${3:int} ${4:value}) {",
      "    super(${4:value});",
      "  }",
      "}"
    ],
    "description": "Declare flattened non-virtual single inheritance"
  },
  "Typed map": {
    "prefix": "map",
    "body": ["map((${1:int} ${2:value}) => ${3:${2:value}})"],
    "description": "Map an array with a typed callback"
  },
  "Map declaration": {
    "prefix": "mapdecl",
    "body": ["Map<${1:string}, ${2:int}> ${3:values} = new Map();"],
    "description": "Declare a typed map"
  },
  "Set declaration": {
    "prefix": "setdecl",
    "body": ["Set<${1:int}> ${2:values} = new Set();"],
    "description": "Declare a typed set"
  },
  "Byte view": {
    "prefix": "u8array",
    "body": ["Uint8Array ${1:bytes} = new Uint8Array(${2:length});"],
    "description": "Declare an unsigned byte buffer view"
  },
  "Extern function": {
    "prefix": "extern",
    "body": ["extern ${1:int} ${2:hostFunction}(${3:int} ${4:value});"],
    "description": "Declare a typed host function"
  },
  "Extern host interface": {
    "prefix": "externclass",
    "body": [
      "extern class ${1:Document} {",
      "  ${2:string} ${3:title};",
      "  ${4:void} ${5:method}(${6:string} ${7:value});",
      "}"
    ],
    "description": "Declare a typed JavaScript host interface"
  },
  "Extern host global": {
    "prefix": "externglobal",
    "body": ["extern ${1:Document} ${2:document};"],
    "description": "Declare a typed JavaScript host global"
  },
  "Named import": {
    "prefix": "import",
    "body": ["import { ${1:name} } from \"${2:./module}\";"],
    "description": "Import named exports from a LilScript module"
  },
  "Exported function": {
    "prefix": "exportfn",
    "body": [
      "export ${1:int} ${2:name}(${3:int} ${4:value}) {",
      "  return ${5:value};",
      "}"
    ],
    "description": "Declare a module-exported function"
  },
  "Pure function": {
    "prefix": "purefn",
    "body": [
      "pure ${1:int} ${2:name}(${3:int} ${4:value}) {",
      "  return ${5:value};",
      "}"
    ],
    "description": "Declare a compiler-checked side-effect-free function"
  }
}
